---
/**
 * Root Portal - pagayo.com
 * Minimale portal: gecentreerde branding + login/registratie.
 *
 * i18n-ready: Alle teksten uit content/pages/nl/portal.json
 */

export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PortalHeader from '../components/layout/PortalHeader.astro';
import PortalFooter from '../components/layout/PortalFooter.astro';
import portalContent from '../content/pages/nl/portal.json';
import { urls } from '../config/urls';
import { resolveCountryName } from '@pagayo/config/brand';
import '../styles/pagayo-design.css';

const { title, description, lang, badge, actions, footer, seo } = portalContent;

// Landnaam detectie via middleware visitorContext (cf-ipcountry op Cloudflare, 'XX' fallback)
// In dev mode: geen cf-ipcountry header → fallback 'NL' voor lokale preview
const isDev = import.meta.env.DEV;
const visitorCountry = Astro.locals.visitorContext?.country;
const countryCode = (visitorCountry && visitorCountry !== 'XX') ? visitorCountry : (isDev ? 'NL' : '');
const countryName = resolveCountryName(countryCode, isDev ? 'NL' : '');

// Environment-aware URLs: localhost in dev, production URLs in prod
const actionUrls = {
  signIn: urls.signIn,
  createAccount: urls.createAccount,
};
---

<BaseLayout 
  title={title}
  description={description}
  lang={lang}
  alternates={seo.alternates}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
  twitterCard={seo.twitterCard}
  noIndex={seo.noIndex}
  structuredData={[{ type: seo.structuredData.type as 'WebSite', data: { name: seo.structuredData.name, url: seo.structuredData.url } }]}
>
  <main class="portal" data-theme="light">
    <PortalHeader countryName={countryName} />

    <div class="portal-globe" aria-hidden="true">
      <canvas class="portal-globe__canvas"></canvas>
    </div>

    <!-- Centered portal -->
    <div class="portal-center">
      <div class="portal-brand">
        <h1 class="portal-brand__name">
          <span class="portal-brand__p">P</span>agayo<span class="portal-brand__dot">.</span>
        </h1>
        <p class="portal-brand__tagline">{description}</p>
        <span class="portal-brand__badge">{badge}</span>
      </div>

      <div class="portal-actions">
        <a href={actionUrls.signIn} class="btn btn--primary btn--lg">
          {actions.signIn.label}
        </a>
      </div>
    </div>

    <PortalFooter copyright={footer.copyright} fixedToViewport />
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const canvas = document.querySelector('.portal-globe__canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const container = canvas.parentElement;
    if (!container) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const totalDots = 2400;
    const points = [];

    function normalizedDeltaLon(a, b) {
      let d = Math.abs(a - b);
      if (d > 180) d = 360 - d;
      return d;
    }

    const landMasses = [
      { lon: -102, lat: 47, rx: 34, ry: 20 },
      { lon: -72, lat: 20, rx: 18, ry: 12 },
      { lon: -60, lat: -14, rx: 24, ry: 32 },
      { lon: -42, lat: 72, rx: 14, ry: 9 },
      { lon: 12, lat: 50, rx: 22, ry: 12 },
      { lon: 22, lat: 8, rx: 26, ry: 30 },
      { lon: 47, lat: 28, rx: 17, ry: 12 },
      { lon: 78, lat: 22, rx: 13, ry: 11 },
      { lon: 98, lat: 42, rx: 40, ry: 20 },
      { lon: 136, lat: -24, rx: 20, ry: 14 },
      { lon: 122, lat: 11, rx: 12, ry: 10 },
      { lon: 137, lat: 37, rx: 9, ry: 7 }
    ];

    function isLand(latDeg, lonDeg) {
      for (const mass of landMasses) {
        const dx = normalizedDeltaLon(lonDeg, mass.lon) / mass.rx;
        const dy = Math.abs(latDeg - mass.lat) / mass.ry;
        if ((dx * dx) + (dy * dy) <= 1) return true;
      }
      return false;
    }

    for (let i = 0; i < totalDots; i += 1) {
      const y = 1 - (2 * i + 1) / totalDots;
      const radius = Math.sqrt(1 - y * y);
      const theta = i * 2.399963229728653;
      points.push({
        x: Math.cos(theta) * radius,
        y,
        z: Math.sin(theta) * radius
      });
    }

    let cssWidth = 0;
    let cssHeight = 0;
    let sphereRadius = 0;
    let pixelRatio = 1;
    let angle = 0;
    let raf = 0;
    let lastTs = 0;

    function resize() {
      const rect = container.getBoundingClientRect();
      cssWidth = Math.max(1, rect.width);
      cssHeight = Math.max(1, rect.height);
      sphereRadius = Math.min(cssWidth, cssHeight) * 0.46;
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.round(cssWidth * pixelRatio);
      canvas.height = Math.round(cssHeight * pixelRatio);
      canvas.style.width = `${cssWidth}px`;
      canvas.style.height = `${cssHeight}px`;
      ctx.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    }

    function drawSphereBase(cx, cy) {
      const bg = ctx.createRadialGradient(
        cx - sphereRadius * 0.2,
        cy - sphereRadius * 0.24,
        sphereRadius * 0.12,
        cx,
        cy,
        sphereRadius * 1.08
      );
      bg.addColorStop(0, '#0e2746');
      bg.addColorStop(0.58, '#081d3a');
      bg.addColorStop(1, '#040f21');

      ctx.beginPath();
      ctx.arc(cx, cy, sphereRadius, 0, Math.PI * 2);
      ctx.fillStyle = bg;
      ctx.fill();
    }

    function drawFrame(ts) {
      const cx = cssWidth * 0.5;
      const cy = cssHeight * 0.5;

      if (!reduceMotion.matches) {
        const dt = lastTs ? ts - lastTs : 16;
        angle += dt * 0.00021;
      }
      lastTs = ts;

      ctx.clearRect(0, 0, cssWidth, cssHeight);
      drawSphereBase(cx, cy);

      const cosA = Math.cos(angle);
      const sinA = Math.sin(angle);
      const projected = [];

      for (const p of points) {
        const x = p.x * cosA + p.z * sinA;
        const z = -p.x * sinA + p.z * cosA;
        const y = p.y;

        if (z < -0.96) continue;

        const depth = (z + 1) * 0.5;
        const scale = 0.72 + depth * 0.45;
        const sx = cx + x * sphereRadius * scale;
        const sy = cy + y * sphereRadius * scale;

        const dx = sx - cx;
        const dy = sy - cy;
        if ((dx * dx) + (dy * dy) > sphereRadius * sphereRadius) continue;

        const lon = (Math.atan2(x, z) * 180) / Math.PI;
        const lat = (Math.asin(y) * 180) / Math.PI;
        const land = isLand(lat, lon);

        projected.push({ sx, sy, z, depth, land });
      }

      projected.sort((a, b) => a.z - b.z);

      for (const dot of projected) {
        const radius = dot.land ? (0.64 + dot.depth * 1.5) : (0.54 + dot.depth * 1.05);
        const alpha = dot.land ? (0.3 + dot.depth * 0.62) : (0.12 + dot.depth * 0.22);

        ctx.beginPath();
        ctx.arc(dot.sx, dot.sy, radius, 0, Math.PI * 2);
        ctx.fillStyle = dot.land
          ? `rgba(192, 224, 255, ${alpha.toFixed(3)})`
          : `rgba(109, 169, 235, ${alpha.toFixed(3)})`;
        ctx.fill();
      }

      ctx.beginPath();
      ctx.arc(cx, cy, sphereRadius * 0.998, 0, Math.PI * 2);
      const rim = ctx.createLinearGradient(cx - sphereRadius, cy, cx + sphereRadius, cy);
      rim.addColorStop(0, 'rgba(122, 190, 255, 0.28)');
      rim.addColorStop(0.5, 'rgba(122, 190, 255, 0.08)');
      rim.addColorStop(1, 'rgba(122, 190, 255, 0.2)');
      ctx.strokeStyle = rim;
      ctx.lineWidth = 1;
      ctx.stroke();

      const shadow = ctx.createRadialGradient(
        cx + sphereRadius * 0.2,
        cy + sphereRadius * 0.15,
        sphereRadius * 0.24,
        cx,
        cy,
        sphereRadius * 1.05
      );
      shadow.addColorStop(0, 'rgba(0, 0, 0, 0)');
      shadow.addColorStop(0.7, 'rgba(0, 0, 0, 0.12)');
      shadow.addColorStop(1, 'rgba(0, 0, 0, 0.52)');

      ctx.beginPath();
      ctx.arc(cx, cy, sphereRadius, 0, Math.PI * 2);
      ctx.fillStyle = shadow;
      ctx.fill();

      if (!reduceMotion.matches) {
        raf = window.requestAnimationFrame(drawFrame);
      }
    }

    function render() {
      if (raf) window.cancelAnimationFrame(raf);
      raf = window.requestAnimationFrame(drawFrame);
    }

    resize();
    render();

    const observer = new ResizeObserver(() => {
      resize();
      render();
    });
    observer.observe(container);

    const motionChange = () => {
      lastTs = 0;
      render();
    };

    if (typeof reduceMotion.addEventListener === 'function') {
      reduceMotion.addEventListener('change', motionChange);
    } else {
      reduceMotion.addListener(motionChange);
    }

    window.addEventListener('beforeunload', () => {
      if (raf) window.cancelAnimationFrame(raf);
      observer.disconnect();
      if (typeof reduceMotion.removeEventListener === 'function') {
        reduceMotion.removeEventListener('change', motionChange);
      } else {
        reduceMotion.removeListener(motionChange);
      }
    }, { once: true });
  })();
</script>

<style is:global>
  body:has(.portal) {
    background: #ffffff !important;
    overflow: hidden;
  }
</style>

<style>
  .portal {
    --bg-deep: #ffffff;
    --bg-surface: #f6f8fa;
    --bg-hover: #e8ecf2;
    --accent: #2563eb;
    --accent-dim: #004ed1;
    --accent-light: #60a5fa;
    --accent-glow: rgb(37 99 235 / 0.14);
    --text-primary: #0f172a;
    --text-secondary: rgb(15 23 42 / 0.75);
    --text-muted: rgb(15 23 42 / 0.5);
    --border: rgb(15 23 42 / 0.15);
    --border-strong: rgb(15 23 42 / 0.375);
  }

  .portal {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.25rem 1.25rem 5rem;
    color: var(--text-primary);
    position: relative;
    overflow: clip;
    background:
      radial-gradient(1200px 740px at 50% 56%, rgba(7, 30, 65, 0.18), transparent 58%),
      radial-gradient(1040px 520px at 8% -12%, rgba(37, 99, 235, 0.14), transparent 64%),
      radial-gradient(940px 500px at 94% -16%, rgba(96, 165, 250, 0.16), transparent 60%),
      linear-gradient(180deg, #edf3ff 0%, #d6e2fb 48%, #e7efff 100%);
    background-size: 112% 112%, 125% 125%, 125% 125%, 100% 100%;
    animation: portal-gradient-drift 26s ease-in-out infinite alternate;
  }

  .portal-globe {
    position: absolute;
    top: 60%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(1080px, 146vw, 1880px);
    aspect-ratio: 1;
    z-index: 0;
    pointer-events: none;
    animation: portal-globe-float 20s ease-in-out infinite alternate;
    will-change: transform;
    filter: drop-shadow(0 0 72px rgba(37, 99, 235, 0.18));
  }

  .portal-globe__canvas {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
  }

  .portal::before,
  .portal::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .portal::before {
    width: 32rem;
    height: 32rem;
    left: -14rem;
    top: 28%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.12) 0%, rgba(37, 99, 235, 0) 70%);
    animation: portal-blob-left 23s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  .portal::after {
    width: 24rem;
    height: 24rem;
    right: -8rem;
    top: 54%;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 70%);
    animation: portal-blob-right 27s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  @keyframes portal-gradient-drift {
    0% {
      background-position: 50% 64%, 0% 0%, 100% 0%, 0% 0%;
    }
    100% {
      background-position: 50% 67%, 7% 5%, 93% 7%, 0% 0%;
    }
  }

  @keyframes portal-globe-float {
    0% {
      transform: translate(-50%, -50%) scale(1);
    }
    100% {
      transform: translate(-50%, -52%) scale(1.03);
    }
  }

  @keyframes portal-blob-left {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.84;
    }
    100% {
      transform: translate3d(4.5rem, -2.6rem, 0) scale(1.08);
      opacity: 1;
    }
  }

  @keyframes portal-blob-right {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.9;
    }
    100% {
      transform: translate3d(-3.8rem, 2.2rem, 0) scale(1.1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal,
    .portal::before,
    .portal::after,
    .portal-globe {
      animation: none !important;
    }
  }

  .portal-center {
    position: relative;
    z-index: 1;
    width: min(760px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.4rem;
    padding: 3.25rem 2.4rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, #ffffff 100%);
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 28px;
    box-shadow:
      0 24px 54px -40px rgba(15, 23, 42, 0.6),
      0 14px 28px -24px rgba(37, 99, 235, 0.46);
    backdrop-filter: blur(8px);
  }

  .portal-brand {
    text-align: center;
  }

  .portal-brand__name {
    font-family: var(--font-sans);
    font-size: clamp(3.2rem, 8.2vw, 5.35rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin: 0 0 0.9rem;
    color: var(--text-primary);
  }

  .portal-brand__p,
  .portal-brand__dot {
    color: var(--accent);
  }

  .portal-brand__tagline {
    font-family: var(--font-sans);
    font-size: clamp(1.02rem, 2.2vw, 1.38rem);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: 31rem;
    text-wrap: balance;
  }

  .portal-brand__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.4rem;
    padding: 0.58rem 1.55rem;
    font-family: var(--font-sans);
    font-size: clamp(1.04rem, 2.6vw, 1.28rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: rgba(37, 99, 235, 0.12);
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-radius: 999px;
  }

  .portal-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
  }

  .portal-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-weight: var(--font-medium);
    line-height: 1;
    white-space: nowrap;
    border-radius: 10px;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .portal-actions .btn--lg {
    height: 50px;
    padding: 0 1.95rem;
    font-size: var(--text-base);
    min-width: 136px;
  }

  .portal-actions .btn--primary {
    background: linear-gradient(135deg, var(--accent) 0%, #1d4ed8 100%);
    color: #ffffff;
    border-color: rgba(37, 99, 235, 0.56);
    box-shadow: 0 16px 30px -22px rgba(37, 99, 235, 0.8);
  }

  .portal-actions .btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 20px 36px -20px rgba(37, 99, 235, 0.72);
  }

  .portal-actions .btn--primary:active {
    background: var(--accent-dim);
    border-color: var(--accent-dim);
    transform: scale(0.98);
  }

  @media (max-width: 768px) {
    .portal {
      padding-top: 6rem;
      padding-bottom: 4.5rem;
    }

    .portal-globe {
      width: clamp(820px, 190vw, 1200px);
      top: 62%;
    }

    .portal-center {
      width: 100%;
      padding: 2.4rem 1.3rem;
      border-radius: 20px;
    }

    .portal-brand__tagline {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .portal {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .portal-globe {
      width: 210vw;
      top: 63%;
    }

    .portal-center {
      gap: 2rem;
      padding: 2.15rem 1rem;
      border-radius: 16px;
    }

    .portal-actions {
      width: 100%;
    }

    .portal-actions .btn {
      width: 100%;
    }
  }
</style>
