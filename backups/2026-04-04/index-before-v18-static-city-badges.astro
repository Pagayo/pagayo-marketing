---
/**
 * Root Portal - pagayo.com
 * Minimale portal: gecentreerde branding + login/registratie.
 *
 * i18n-ready: Alle teksten uit content/pages/nl/portal.json
 */

export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PortalHeader from '../components/layout/PortalHeader.astro';
import PortalFooter from '../components/layout/PortalFooter.astro';
import portalContent from '../content/pages/nl/portal.json';
import { urls } from '../config/urls';
import { resolveCountryName } from '@pagayo/config/brand';
import '../styles/pagayo-design.css';

const { title, description, lang, badge, actions, footer, seo } = portalContent;

// Landnaam detectie via middleware visitorContext (cf-ipcountry op Cloudflare, 'XX' fallback)
// In dev mode: geen cf-ipcountry header → fallback 'NL' voor lokale preview
const isDev = import.meta.env.DEV;
const visitorCountry = Astro.locals.visitorContext?.country;
const countryCode = (visitorCountry && visitorCountry !== 'XX') ? visitorCountry : (isDev ? 'NL' : '');
const countryName = resolveCountryName(countryCode, isDev ? 'NL' : '');

// Environment-aware URLs: localhost in dev, production URLs in prod
const actionUrls = {
  signIn: urls.signIn,
  createAccount: urls.createAccount,
};
---

<BaseLayout 
  title={title}
  description={description}
  lang={lang}
  alternates={seo.alternates}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
  twitterCard={seo.twitterCard}
  noIndex={seo.noIndex}
  structuredData={[{ type: seo.structuredData.type as 'WebSite', data: { name: seo.structuredData.name, url: seo.structuredData.url } }]}
>
  <main class="portal" data-theme="light">
    <PortalHeader countryName={countryName} />

    <div class="portal-globe" aria-hidden="true">
      <canvas class="portal-globe__canvas"></canvas>
      <div class="portal-flows">
        <svg class="portal-flows__lines" viewBox="0 0 1000 1000" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path class="portal-flows__line portal-flows__line--1" d="M112 282 C 242 166, 388 188, 498 340 S 756 548, 888 420" pathLength="100" />
          <path class="portal-flows__line portal-flows__line--2" d="M82 548 C 236 446, 382 352, 510 286 S 742 160, 904 220" pathLength="100" />
          <path class="portal-flows__line portal-flows__line--3" d="M190 746 C 314 656, 412 560, 514 464 S 710 278, 824 168" pathLength="100" />
          <path class="portal-flows__line portal-flows__line--4" d="M108 372 C 230 404, 376 456, 504 548 S 716 716, 850 760" pathLength="100" />
        </svg>

        <div class="portal-flow-badge portal-flow-badge--1">
          <span class="portal-flow-badge__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 8.5L12 4L20 8.5M4 8.5V16L12 20.5M4 8.5L12 13M20 8.5V16L12 20.5M20 8.5L12 13M12 13V20.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="portal-flow-badge__amount">€365 EUR</span>
        </div>

        <div class="portal-flow-badge portal-flow-badge--2">
          <span class="portal-flow-badge__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 8.5L12 4L20 8.5M4 8.5V16L12 20.5M4 8.5L12 13M20 8.5V16L12 20.5M20 8.5L12 13M12 13V20.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="portal-flow-badge__amount">$615 USD</span>
        </div>

        <div class="portal-flow-badge portal-flow-badge--3">
          <span class="portal-flow-badge__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 8.5L12 4L20 8.5M4 8.5V16L12 20.5M4 8.5L12 13M20 8.5V16L12 20.5M20 8.5L12 13M12 13V20.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="portal-flow-badge__amount">¥8,200 JPY</span>
        </div>

        <div class="portal-flow-badge portal-flow-badge--4">
          <span class="portal-flow-badge__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 8.5L12 4L20 8.5M4 8.5V16L12 20.5M4 8.5L12 13M20 8.5V16L12 20.5M20 8.5L12 13M12 13V20.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="portal-flow-badge__amount">£420 GBP</span>
        </div>
      </div>
    </div>

    <!-- Centered portal -->
    <div class="portal-center">
      <div class="portal-brand">
        <h1 class="portal-brand__name">
          <span class="portal-brand__p">P</span>agayo<span class="portal-brand__dot">.</span>
        </h1>
        <p class="portal-brand__tagline">{description}</p>
        <span class="portal-brand__badge">{badge}</span>
      </div>

      <div class="portal-actions">
        <a href={actionUrls.signIn} class="btn btn--primary btn--lg">
          {actions.signIn.label}
        </a>
      </div>
    </div>

    <PortalFooter copyright={footer.copyright} fixedToViewport />
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const canvas = document.querySelector('.portal-globe__canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const container = canvas.parentElement;
    if (!container) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const rotationSpeed = 0.000084;
    const northTiltDeg = 14;
    const northTiltRad = (northTiltDeg * Math.PI) / 180;
    const worldMaskUrl = '/world_alpha_mini.jpg';
    const points = [];
    const maskBands = Array.from({ length: 181 }, () => new Uint8Array(720));
    const keyCities = [
      { name: 'Amsterdam', lat: 52.3676, lon: 4.9041 },
      { name: 'Rotterdam', lat: 51.9244, lon: 4.4777 },
      { name: 'London', lat: 51.5072, lon: -0.1276 },
      { name: 'Dublin', lat: 53.3498, lon: -6.2603 },
      { name: 'Paris', lat: 48.8566, lon: 2.3522 },
      { name: 'Brussels', lat: 50.8503, lon: 4.3517 },
      { name: 'Madrid', lat: 40.4168, lon: -3.7038 },
      { name: 'Lisbon', lat: 38.7223, lon: -9.1393 },
      { name: 'Berlin', lat: 52.52, lon: 13.405 },
      { name: 'Copenhagen', lat: 55.6761, lon: 12.5683 },
      { name: 'Oslo', lat: 59.9139, lon: 10.7522 },
      { name: 'Stockholm', lat: 59.3293, lon: 18.0686 },
      { name: 'Warsaw', lat: 52.2297, lon: 21.0122 },
      { name: 'Vienna', lat: 48.2082, lon: 16.3738 },
      { name: 'Zurich', lat: 47.3769, lon: 8.5417 },
      { name: 'Rome', lat: 41.9028, lon: 12.4964 },
      { name: 'Athens', lat: 37.9838, lon: 23.7275 },
      { name: 'Istanbul', lat: 41.0082, lon: 28.9784 },
      { name: 'Moscow', lat: 55.7558, lon: 37.6173 },
      { name: 'Dubai', lat: 25.2048, lon: 55.2708 },
      { name: 'Riyadh', lat: 24.7136, lon: 46.6753 },
      { name: 'Tel Aviv', lat: 32.0853, lon: 34.7818 },
      { name: 'Cairo', lat: 30.0444, lon: 31.2357 },
      { name: 'Lagos', lat: 6.5244, lon: 3.3792 },
      { name: 'Nairobi', lat: -1.2921, lon: 36.8219 },
      { name: 'Johannesburg', lat: -26.2041, lon: 28.0473 },
      { name: 'Cape Town', lat: -33.9249, lon: 18.4241 },
      { name: 'Mumbai', lat: 19.076, lon: 72.8777 },
      { name: 'Delhi', lat: 28.6139, lon: 77.209 },
      { name: 'Bengaluru', lat: 12.9716, lon: 77.5946 },
      { name: 'Karachi', lat: 24.8607, lon: 67.0011 },
      { name: 'Dhaka', lat: 23.8103, lon: 90.4125 },
      { name: 'Bangkok', lat: 13.7563, lon: 100.5018 },
      { name: 'Singapore', lat: 1.3521, lon: 103.8198 },
      { name: 'Jakarta', lat: -6.2088, lon: 106.8456 },
      { name: 'Hong Kong', lat: 22.3193, lon: 114.1694 },
      { name: 'Shanghai', lat: 31.2304, lon: 121.4737 },
      { name: 'Beijing', lat: 39.9042, lon: 116.4074 },
      { name: 'Seoul', lat: 37.5665, lon: 126.978 },
      { name: 'Tokyo', lat: 35.6762, lon: 139.6503 },
      { name: 'Osaka', lat: 34.6937, lon: 135.5023 },
      { name: 'Sydney', lat: -33.8688, lon: 151.2093 },
      { name: 'Melbourne', lat: -37.8136, lon: 144.9631 },
      { name: 'Auckland', lat: -36.8509, lon: 174.7645 },
      { name: 'New York', lat: 40.7128, lon: -74.006 },
      { name: 'Toronto', lat: 43.6532, lon: -79.3832 },
      { name: 'Chicago', lat: 41.8781, lon: -87.6298 },
      { name: 'San Francisco', lat: 37.7749, lon: -122.4194 },
      { name: 'Los Angeles', lat: 34.0522, lon: -118.2437 },
      { name: 'Sao Paulo', lat: -23.5558, lon: -46.6396 }
    ];
    const cityMarkers = keyCities.map((city, index) => {
      const latRad = (city.lat * Math.PI) / 180;
      const lonRad = (city.lon * Math.PI) / 180;
      return {
        ...city,
        x: Math.sin(lonRad) * Math.cos(latRad),
        y: Math.sin(latRad),
        z: Math.cos(lonRad) * Math.cos(latRad),
        phase: index * 0.47
      };
    });
    let maskReady = false;

    function normalizedDeltaLon(a, b) {
      let d = Math.abs(a - b);
      if (d > 180) d = 360 - d;
      return d;
    }

    const landMasses = [
      { lon: -102, lat: 47, rx: 34, ry: 20 },
      { lon: -72, lat: 20, rx: 18, ry: 12 },
      { lon: -60, lat: -14, rx: 24, ry: 32 },
      { lon: -42, lat: 72, rx: 14, ry: 9 },
      { lon: 12, lat: 50, rx: 22, ry: 12 },
      { lon: 22, lat: 8, rx: 26, ry: 30 },
      { lon: 47, lat: 28, rx: 17, ry: 12 },
      { lon: 78, lat: 22, rx: 13, ry: 11 },
      { lon: 98, lat: 42, rx: 40, ry: 20 },
      { lon: 136, lat: -24, rx: 20, ry: 14 },
      { lon: 122, lat: 11, rx: 12, ry: 10 },
      { lon: 137, lat: 37, rx: 9, ry: 7 }
    ];

    function isLand(latDeg, lonDeg) {
      for (const mass of landMasses) {
        const dx = normalizedDeltaLon(lonDeg, mass.lon) / mass.rx;
        const dy = Math.abs(latDeg - mass.lat) / mass.ry;
        if ((dx * dx) + (dy * dy) <= 1) return true;
      }
      return false;
    }

    function wrapLonBin(bin) {
      if (bin < 0) return bin + 720;
      if (bin >= 720) return bin - 720;
      return bin;
    }

    function maskHasLand(latDeg, lonDeg) {
      const latBand = Math.max(-90, Math.min(90, Math.round(latDeg)));
      const lonNorm = ((lonDeg + 180 + 360) % 360) - 180;
      const lonBin = wrapLonBin(Math.floor((lonNorm + 180) * 2));

      // Sample nearby latitude bands as well to avoid visible horizontal mask artifacts.
      for (let latOffset = -2; latOffset <= 2; latOffset += 1) {
        const row = maskBands[latBand + latOffset + 90];
        if (!row) continue;

        if (
          row[lonBin] ||
          row[wrapLonBin(lonBin - 1)] ||
          row[wrapLonBin(lonBin + 1)] ||
          row[wrapLonBin(lonBin - 2)] ||
          row[wrapLonBin(lonBin + 2)]
        ) {
          return true;
        }
      }

      return false;
    }

    function pointLand(latDeg, lonDeg) {
      if (maskReady) return maskHasLand(latDeg, lonDeg);
      return isLand(latDeg, lonDeg);
    }

    function setPointStyle(point) {
      const hue = 204 + ((point.lon + 180) / 360) * 110;
      point.landFrontColor = `hsl(${hue.toFixed(1)} 84% 59%)`;
      point.landBackColor = `hsl(${hue.toFixed(1)} 66% 42%)`;
    }

    function createPoints(count) {
      points.length = 0;
      for (let i = 0; i < count; i += 1) {
        const y = 1 - (2 * i + 1) / count;
        const radius = Math.sqrt(1 - y * y);
        const theta = i * 2.399963229728653;
        const x = Math.cos(theta) * radius;
        const z = Math.sin(theta) * radius;
        const lon = (Math.atan2(x, z) * 180) / Math.PI;
        const lat = (Math.asin(y) * 180) / Math.PI;
        points.push({
          x,
          y,
          z,
          lat,
          lon,
          land: pointLand(lat, lon)
        });
        setPointStyle(points[points.length - 1]);
      }
    }

    function refreshPointLandMask() {
      for (const p of points) {
        p.land = pointLand(p.lat, p.lon);
        setPointStyle(p);
      }
    }

    function buildMaskFromImage(image) {
      const offscreen = document.createElement('canvas');
      offscreen.width = image.width;
      offscreen.height = image.height;
      const offctx = offscreen.getContext('2d');
      if (!offctx) return;

      offctx.drawImage(image, 0, 0);
      const { data, width, height } = offctx.getImageData(0, 0, offscreen.width, offscreen.height);

      for (let y = 0; y < height; y += 1) {
        const lat = 90 - (y / (height - 1)) * 180;
        const latBand = Math.max(-90, Math.min(90, Math.round(lat)));
        const row = maskBands[latBand + 90];

        for (let x = 0; x < width; x += 1) {
          const idx = (y * width + x) * 4;
          const r = data[idx];
          const g = data[idx + 1];
          const b = data[idx + 2];
          const isDarkLand = r < 96 && g < 96 && b < 96;
          if (!isDarkLand) continue;

          const lon = -180 + (x / (width - 1)) * 360;
          const lonBin = wrapLonBin(Math.floor((lon + 180) * 2));
          row[lonBin] = 1;
        }
      }

      maskReady = true;
      refreshPointLandMask();
      render();
    }

    function loadWorldMask() {
      const image = new Image();
      image.decoding = 'async';
      image.onload = () => buildMaskFromImage(image);
      image.onerror = () => {
        maskReady = false;
        refreshPointLandMask();
        render();
      };
      image.src = worldMaskUrl;
    }

    let dotsPerFrame = 0;

    function dotsForViewport(width) {
      if (width >= 1200) return 84000;
      if (width >= 900) return 48000;
      return 12000;
    }

    const amsterdamLongitudeDeg = 4.9041;
    const startAngleOffset = (-amsterdamLongitudeDeg * Math.PI) / 180;

    let cssWidth = 0;
    let cssHeight = 0;
    let sphereRadius = 0;
    let pixelRatio = 1;
    let angle = 0;
    let raf = 0;
    let startTs = 0;

    function resize() {
      const rect = container.getBoundingClientRect();
      cssWidth = Math.max(1, rect.width);
      cssHeight = Math.max(1, rect.height);
      sphereRadius = Math.min(cssWidth, cssHeight) * 0.46;
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.round(cssWidth * pixelRatio);
      canvas.height = Math.round(cssHeight * pixelRatio);
      canvas.style.width = `${cssWidth}px`;
      canvas.style.height = `${cssHeight}px`;
      ctx.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    }

    function drawFrame(ts) {
      const cx = cssWidth * 0.5;
      const cy = cssHeight * 0.5;
      const mobileDotScale = cssWidth <= 768 ? 0.74 : 1;

      if (!startTs) startTs = ts;
      if (!reduceMotion.matches) {
        angle = startAngleOffset + ((ts - startTs) * rotationSpeed);
      } else {
        angle = startAngleOffset;
      }

      ctx.clearRect(0, 0, cssWidth, cssHeight);

      const cosA = Math.cos(angle);
      const sinA = Math.sin(angle);
      const cosTilt = Math.cos(northTiltRad);
      const sinTilt = Math.sin(northTiltRad);

      for (const p of points) {
        if (!p.land) continue;

        const x = p.x * cosA + p.z * sinA;
        const z = -p.x * sinA + p.z * cosA;
        const y = p.y;

        const yTilt = y * cosTilt - z * sinTilt;
        const zTilt = y * sinTilt + z * cosTilt;

        if (zTilt < -0.96) continue;

        const depth = (zTilt + 1) * 0.5;
        const scale = 0.72 + depth * 0.45;
        const sx = cx + x * sphereRadius * scale;
        const sy = cy - yTilt * sphereRadius * scale;

        const dx = sx - cx;
        const dy = sy - cy;
        if ((dx * dx) + (dy * dy) > sphereRadius * sphereRadius) continue;

        const radius = (0.58 + depth * 1.28) * mobileDotScale;
        const backSide = depth < 0.45;
        const color = backSide ? p.landBackColor : p.landFrontColor;

        ctx.beginPath();
        ctx.arc(sx, sy, radius, 0, Math.PI * 2);
        ctx.globalAlpha = 1;
        ctx.fillStyle = color;
        ctx.fill();
      }

      // Key city markers: white core dot + pulsing ring.
      const markerScale = cssWidth <= 768 ? 0.58 : 1;
      for (const marker of cityMarkers) {
        const x = marker.x * cosA + marker.z * sinA;
        const z = -marker.x * sinA + marker.z * cosA;
        const y = marker.y;

        const yTilt = y * cosTilt - z * sinTilt;
        const zTilt = y * sinTilt + z * cosTilt;

        if (zTilt < -0.1) continue;

        const depth = (zTilt + 1) * 0.5;
        const scale = 0.72 + depth * 0.45;
        const sx = cx + x * sphereRadius * scale;
        const sy = cy - yTilt * sphereRadius * scale;

        const dx = sx - cx;
        const dy = sy - cy;
        if ((dx * dx) + (dy * dy) > sphereRadius * sphereRadius) continue;

        const pulse = 0.5 + 0.5 * Math.sin(ts * 0.004 + marker.phase);
        const coreRadius = (1.8 + depth * 1.2) * markerScale;
        const ringRadius = coreRadius + 2 + pulse * 2.4;
        const ringAlpha = 0.35 + depth * 0.45;

        ctx.beginPath();
        ctx.arc(sx, sy, ringRadius, 0, Math.PI * 2);
        ctx.globalAlpha = ringAlpha;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = cssWidth <= 768 ? 0.8 : 1;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(sx, sy, coreRadius, 0, Math.PI * 2);
        ctx.globalAlpha = 0.95;
        ctx.fillStyle = '#ffffff';
        ctx.fill();
      }

      ctx.globalAlpha = 1;

      if (!reduceMotion.matches) {
        raf = window.requestAnimationFrame(drawFrame);
      }
    }

    function render() {
      if (raf) window.cancelAnimationFrame(raf);
      raf = window.requestAnimationFrame(drawFrame);
    }

    resize();
    dotsPerFrame = dotsForViewport(cssWidth);
    createPoints(dotsPerFrame);
    render();
    loadWorldMask();

    const observer = new ResizeObserver(() => {
      resize();
      const nextDots = dotsForViewport(cssWidth);
      if (nextDots !== dotsPerFrame) {
        dotsPerFrame = nextDots;
        createPoints(dotsPerFrame);
      }
      render();
    });
    observer.observe(container);

    const motionChange = () => {
      startTs = performance.now() - ((angle - startAngleOffset) / rotationSpeed);
      render();
    };

    if (typeof reduceMotion.addEventListener === 'function') {
      reduceMotion.addEventListener('change', motionChange);
    } else {
      reduceMotion.addListener(motionChange);
    }

    window.addEventListener('beforeunload', () => {
      if (raf) window.cancelAnimationFrame(raf);
      observer.disconnect();
      if (typeof reduceMotion.removeEventListener === 'function') {
        reduceMotion.removeEventListener('change', motionChange);
      } else {
        reduceMotion.removeListener(motionChange);
      }
    }, { once: true });
  })();
</script>

<style is:global>
  body:has(.portal) {
    background: #ffffff !important;
    overflow: hidden;
  }
</style>

<style>
  .portal {
    --bg-deep: #ffffff;
    --bg-surface: #f6f8fa;
    --bg-hover: #e8ecf2;
    --accent: #2563eb;
    --accent-dim: #004ed1;
    --accent-light: #60a5fa;
    --accent-glow: rgb(37 99 235 / 0.14);
    --text-primary: #0f172a;
    --text-secondary: rgb(15 23 42 / 0.75);
    --text-muted: rgb(15 23 42 / 0.5);
    --border: rgb(15 23 42 / 0.15);
    --border-strong: rgb(15 23 42 / 0.375);
  }

  .portal {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.25rem 1.25rem 5rem;
    color: var(--text-primary);
    position: relative;
    overflow: clip;
    background:
      radial-gradient(1200px 740px at 50% 56%, rgba(7, 30, 65, 0.18), transparent 58%),
      radial-gradient(1040px 520px at 8% -12%, rgba(37, 99, 235, 0.14), transparent 64%),
      radial-gradient(940px 500px at 94% -16%, rgba(96, 165, 250, 0.16), transparent 60%),
      linear-gradient(180deg, #edf3ff 0%, #d6e2fb 48%, #e7efff 100%);
    background-size: 112% 112%, 125% 125%, 125% 125%, 100% 100%;
    animation: portal-gradient-drift 26s ease-in-out infinite alternate;
  }

  .portal-globe {
    position: fixed;
    top: 66px;
    left: 50%;
    transform: translateX(-50%);
    width: min(clamp(980px, 130vw, 1640px), calc(100vh - 7.5rem));
    aspect-ratio: 1;
    z-index: 0;
    pointer-events: none;
    animation: none;
    will-change: transform;
    filter: none;
  }

  .portal-globe__canvas {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
  }

  .portal-flows {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .portal-flows__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .portal-flows__line {
    fill: none;
    stroke-linecap: round;
    stroke-width: 1.5;
    opacity: 0.9;
  }

  .portal-flows__line--1 {
    stroke: rgba(232, 70, 255, 0.82);
  }

  .portal-flows__line--2 {
    stroke: rgba(138, 106, 255, 0.78);
  }

  .portal-flows__line--3 {
    stroke: rgba(255, 122, 172, 0.78);
  }

  .portal-flows__line--4 {
    stroke: rgba(210, 110, 255, 0.7);
  }

  .portal-flow-badge {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.46rem;
    padding: 0.34rem 0.62rem 0.34rem 0.34rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 12px 30px -18px rgba(15, 23, 42, 0.65);
    color: #0f172a;
    font-family: var(--font-sans);
