---
/**
 * Abonnementen Feature Page — pagayo.com/nl/abonnementen
 * Marketing pagina over het abonnementensysteem van Pagayo.
 * Gebruikt dezelfde lichte portal-header/footer als de homepage.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalHeader from '../../components/layout/PortalHeader.astro';
import PortalFooter from '../../components/layout/PortalFooter.astro';
import { urls } from '../../config/urls';
import portalContent from '../../content/pages/nl/portal.json';
import { resolveCountryName } from '@pagayo/config/brand';
import '../../styles/global.css';
import '../../styles/pagayo-design.css';

const { footer } = portalContent;

const isDev = import.meta.env.DEV;
const visitorCountry = Astro.locals.visitorContext?.country;
const countryCode = (visitorCountry && visitorCountry !== 'XX') ? visitorCountry : (isDev ? 'NL' : '');
const countryName = resolveCountryName(countryCode, isDev ? 'NL' : '');
---

<BaseLayout
  title="Abonnementen — Pagayo"
  description="Bied je klanten flexibele abonnementen aan. Wekelijks, maandelijks of jaarlijks. Eén dashboard, alle kanalen."
  lang="nl"
>
  <div class="page" data-theme="light">
    <PortalHeader countryName={countryName} />

    <main>
      <!-- Hero Section -->
      <section class="hero">
        <div class="container">
          <span class="badge">Abonnementen</span>
          <h1 class="hero__title">
            Abonnementen die meegroeien<br />met je bedrijf
          </h1>
          <p class="hero__subtitle">
            Bied je klanten flexibele abonnementen aan — wekelijks, maandelijks of jaarlijks.
            Beheer alles vanuit één dashboard. Automatische facturatie, slimme herinneringen
            en real-time inzicht in je terugkerende omzet.
          </p>
          <div class="hero__actions">
            <a href={urls.createAccount} class="btn btn--primary">Start gratis</a>
            <a href="#hoe-het-werkt" class="btn btn--ghost">Bekijk hoe het werkt</a>
          </div>
        </div>
      </section>

      <!-- Features Grid -->
      <section class="features">
        <div class="container">
          <h2 class="section-title">Alles wat je nodig hebt voor abonnementen</h2>
          <p class="section-subtitle">
            Van eenvoudige maandelijkse lidmaatschappen tot complexe familieabonnementen met
            QR-toegang — Pagayo ondersteunt het allemaal.
          </p>
          <div class="features__grid">
            <!-- Flexibele intervallen -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <h3>Flexibele intervallen</h3>
              <p>Wekelijks, maandelijks, per kwartaal, halfjaarlijks of jaarlijks. Jij kiest het ritme dat bij je klanten past.</p>
            </div>

            <!-- Automatische facturatie -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--dark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              </div>
              <h3>Automatische facturatie</h3>
              <p>Betalingen worden automatisch verwerkt via Stripe of Mollie. Geen handmatig werk, geen gemiste incasso's.</p>
            </div>

            <!-- Familie- en groepsabonnementen -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--lightblue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3>Familie- en groepsabonnementen</h3>
              <p>Eén abonnement, meerdere leden. Elk gezinslid of groepslid krijgt een eigen profiel en toegangspas.</p>
            </div>

            <!-- QR-codes voor toegang -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><line x1="21" y1="14" x2="21" y2="14.01"/><line x1="21" y1="21" x2="21" y2="21.01"/><line x1="17" y1="21" x2="17" y2="21.01"/></svg>
              </div>
              <h3>QR-codes voor toegang</h3>
              <p>Elk lid ontvangt een persoonlijke QR-code. Scan bij binnenkomst voor snelle en betrouwbare toegangscontrole.</p>
            </div>

            <!-- Self-service portaal -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--dark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              </div>
              <h3>Self-service portaal</h3>
              <p>Klanten beheren hun abonnement zelf: pauzeren, upgraden, betaalgegevens wijzigen of opzeggen — zonder jouw tussenkomst.</p>
            </div>

            <!-- Real-time dashboard -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--lightblue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
              <h3>Real-time dashboard</h3>
              <p>Zie direct hoeveel actieve abonnees je hebt, wat je terugkerende omzet is en welke abonnementen aandacht nodig hebben.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Hoe het werkt -->
      <section class="how-it-works" id="hoe-het-werkt">
        <div class="container">
          <h2 class="section-title">Hoe het werkt</h2>
          <p class="section-subtitle">In drie stappen van nul naar terugkerende omzet.</p>
          <div class="steps">
            <div class="step">
              <div class="step__number">1</div>
              <h3>Maak je abonnementsplan</h3>
              <p>Kies een naam, prijs en interval. Voeg optioneel een proefperiode toe. Klaar in minder dan een minuut.</p>
            </div>
            <div class="step__connector"></div>
            <div class="step">
              <div class="step__number">2</div>
              <h3>Klanten schrijven zich in</h3>
              <p>Via je webshop, kassasysteem of een directe link. De betaling wordt automatisch verwerkt bij inschrijving.</p>
            </div>
            <div class="step__connector"></div>
            <div class="step">
              <div class="step__number">3</div>
              <h3>Beheer en groei</h3>
              <p>Volg je abonnees in real-time. Automatische verlengingen, herinneringen bij mislukte betalingen en inzicht in churn.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Voordelen -->
      <section class="benefits">
        <div class="container">
          <h2 class="section-title">Waarom abonnementen via Pagayo</h2>
          <div class="benefits__grid">
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Eén platform voor alles</strong>
                <p>Abonnementen, losse verkoop, kassa en webshop — allemaal in hetzelfde dashboard.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Geen apart abonnementsysteem</strong>
                <p>Abonnementbetalingen worden gewoon orders in je admin. Geen losse tools of exports nodig.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Gratis starten</strong>
                <p>Begin met abonnementen op het gratis plan. Betaal pas als je groeit.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Wereldwijd inzetbaar</strong>
                <p>Actief in bijna alle landen. Ondersteunt meerdere valuta's en betaalmethoden.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Automatische verlengingen</strong>
                <p>Abonnementen worden automatisch verlengd. Bij een mislukte betaling ontvangt je klant een herinnering.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Veilig en betrouwbaar</strong>
                <p>Alle betalingen via gecertificeerde providers. Volledig audit trail van elke abonnementswijziging.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section">
        <div class="container">
          <div class="cta-card">
            <h2>Klaar om terugkerende omzet op te bouwen?</h2>
            <p>Maak een gratis account aan en stel je eerste abonnement in. Geen creditcard nodig.</p>
            <a href={urls.createAccount} class="btn btn--primary btn--lg">Start gratis met abonnementen</a>
          </div>
        </div>
      </section>
    </main>

    <PortalFooter copyright={footer.copyright} />
  </div>
</BaseLayout>

<style>
  .page {
    --bg-deep: #ffffff;
    --bg-surface: #f6f8fa;
    --bg-hover: #e8ecf2;
    --accent: #2563eb;
    --accent-dim: #004ed1;
    --accent-glow: rgb(37 99 235 / 0.14);
    --accent-light: #60a5fa;
    --text-primary: #0f172a;
    --text-secondary: rgb(15 23 42 / 0.75);
    --text-muted: rgb(15 23 42 / 0.5);
    --bg-page: #ffffff;
    --bg-section: #f8fafc;
    --border: rgb(15 23 42 / 0.15);
    --border-strong: rgb(15 23 42 / 0.375);
    --border-color: #e2e8f0;

    min-height: 100vh;
    color: var(--text-primary);
    background:
      radial-gradient(1200px 520px at 8% -8%, rgba(37, 99, 235, 0.11), transparent 62%),
      radial-gradient(900px 440px at 92% -16%, rgba(96, 165, 250, 0.16), transparent 58%),
      linear-gradient(180deg, #ffffff 0%, #f7faff 44%, #ffffff 100%);
    overflow-x: clip;
  }

  main {
    position: relative;
  }

  .container {
    max-width: var(--container-2xl, 1400px);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero {
    position: relative;
    padding: 156px 0 118px;
    text-align: center;
    isolation: isolate;
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: -1;
  }

  .hero::before {
    width: 34rem;
    height: 34rem;
    top: -14rem;
    left: -8rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, rgba(37, 99, 235, 0) 72%);
  }

  .hero::after {
    width: 28rem;
    height: 28rem;
    right: -5rem;
    top: -12rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.2) 0%, rgba(96, 165, 250, 0) 70%);
  }

  .hero .container {
    max-width: 1020px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.15rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 999px;
    margin-bottom: 1.35rem;
  }

  .hero__title {
    font-size: clamp(2.65rem, 6.1vw, 4.55rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--text-primary);
    margin-bottom: 1.6rem;
    text-wrap: balance;
  }

  .hero__subtitle {
    font-size: clamp(1.07rem, 1.45vw, 1.38rem);
    line-height: 1.72;
    color: var(--text-secondary);
    max-width: 760px;
    margin: 0 auto 2.7rem;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.78rem 1.52rem;
    font-size: 0.98rem;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn--primary {
    color: #fff;
    background: linear-gradient(135deg, var(--accent) 0%, #1d4ed8 100%);
    border-color: rgba(37, 99, 235, 0.55);
    box-shadow: 0 12px 30px -18px rgba(37, 99, 235, 0.7);
  }

  .btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 36px -18px rgba(37, 99, 235, 0.65);
  }

  .btn--ghost {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.86);
    border-color: rgba(15, 23, 42, 0.14);
  }

  .btn--ghost:hover {
    background: #ffffff;
    border-color: rgba(37, 99, 235, 0.24);
    transform: translateY(-1px);
  }

  .btn--lg {
    padding: 0.9rem 2.05rem;
    font-size: 1.04rem;
  }

  .section-title {
    font-size: clamp(1.95rem, 4.2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-align: center;
    margin-bottom: 0.85rem;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .section-subtitle {
    font-size: clamp(1rem, 1.22vw, 1.18rem);
    line-height: 1.75;
    color: var(--text-secondary);
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem;
  }

  .features {
    padding: 0 0 102px;
  }

  .features .container {
    background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 24px;
    padding: 4rem 3rem;
    box-shadow:
      0 28px 56px -40px rgba(15, 23, 42, 0.45),
      0 10px 24px -18px rgba(37, 99, 235, 0.32);
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .feature-card {
    position: relative;
    padding: 1.7rem;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 16px;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .feature-card::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    right: 1.2rem;
    top: 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(37, 99, 235, 0.85), rgba(96, 165, 250, 0.45));
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(37, 99, 235, 0.24);
    box-shadow: 0 22px 36px -28px rgba(37, 99, 235, 0.55);
  }

  .feature-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    margin-bottom: 1.15rem;
  }

  .feature-card__icon--blue {
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
  }

  .feature-card__icon--dark {
    background: rgba(15, 23, 42, 0.08);
    color: #0f172a;
  }

  .feature-card__icon--lightblue {
    background: rgba(96, 165, 250, 0.14);
    color: #2563eb;
  }

  .feature-card h3 {
    font-size: 1.06rem;
    font-weight: 700;
    margin-bottom: 0.62rem;
    color: var(--text-primary);
  }

  .feature-card p {
    font-size: 0.95rem;
    line-height: 1.62;
    color: var(--text-secondary);
  }

  .how-it-works {
    padding: 12px 0 104px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .step {
    position: relative;
    text-align: left;
    padding: 2rem 1.6rem;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 16px;
    box-shadow: 0 18px 30px -28px rgba(15, 23, 42, 0.45);
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .step:hover {
    transform: translateY(-3px);
    border-color: rgba(37, 99, 235, 0.25);
  }

  .step__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    font-size: 1.04rem;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, var(--accent) 0%, #1d4ed8 100%);
    border-radius: 999px;
    margin-bottom: 1.15rem;
  }

  .step h3 {
    font-size: 1.02rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--text-primary);
  }

  .step p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .step__connector {
    display: none;
  }

  .benefits {
    position: relative;
    padding: 106px 0;
    background: linear-gradient(155deg, #0a2540 0%, #12325f 100%);
    overflow: hidden;
  }

  .benefits::before {
    content: '';
    position: absolute;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    top: -16rem;
    right: -10rem;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.22) 0%, rgba(96, 165, 250, 0) 70%);
    pointer-events: none;
  }

  .benefits .section-title {
    color: #ffffff;
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .benefit {
    display: flex;
    gap: 1rem;
    padding: 1.35rem 1.4rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 14px;
    backdrop-filter: blur(3px);
    transition: transform var(--transition-base), background-color var(--transition-base), border-color var(--transition-base);
  }

  .benefit:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.26);
  }

  .benefit__check {
    color: #93c5fd;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .benefit strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.24rem;
  }

  .benefit p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.84);
    margin: 0;
  }

  .cta-section {
    padding: 104px 0 96px;
  }

  .cta-card {
    text-align: center;
    padding: 4.3rem 2.3rem;
