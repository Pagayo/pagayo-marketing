---
/**
 * Abonnementen Feature Page — pagayo.com/nl/abonnementen
 * Marketing pagina over het abonnementensysteem van Pagayo.
 * Gebruikt HeaderDynamic + FooterDynamic (NOOIT eigen nav/footer bouwen).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderDynamic from '../../components/HeaderDynamic.astro';
import FooterDynamic from '../../components/FooterDynamic.astro';
import { urls } from '../../config/urls';
import '../../styles/global.css';

const nlCountry = {
  name: 'Nederland',
  region: 'europe',
  code: 'NL',
  nav: { cta: 'Start gratis' },
  footer: {
    tagline: 'Order-first commerce voor Nederland.',
    copyright: `© ${new Date().getFullYear()} Pagayo. Alle rechten voorbehouden.`,
  },
};
---

<BaseLayout
  title="Abonnementen — Pagayo"
  description="Bied je klanten flexibele abonnementen aan. Wekelijks, maandelijks of jaarlijks. Eén dashboard, alle kanalen."
  lang="nl"
>
  <HeaderDynamic country={nlCountry} />

  <div class="page" data-theme="light">
    <main>
      <!-- Hero Section -->
      <section class="hero">
        <div class="container">
          <span class="badge">Abonnementen</span>
          <h1 class="hero__title">
            Abonnementen die meegroeien<br />met je bedrijf
          </h1>
          <p class="hero__subtitle">
            Bied je klanten flexibele abonnementen aan — wekelijks, maandelijks of jaarlijks.
            Beheer alles vanuit één dashboard. Automatische facturatie, slimme herinneringen
            en real-time inzicht in je terugkerende omzet.
          </p>
          <div class="hero__actions">
            <a href={urls.createAccount} class="btn btn--primary">Start gratis</a>
            <a href="#hoe-het-werkt" class="btn btn--ghost">Bekijk hoe het werkt</a>
          </div>
        </div>
      </section>

      <!-- Features Grid -->
      <section class="features">
        <div class="container">
          <h2 class="section-title">Alles wat je nodig hebt voor abonnementen</h2>
          <p class="section-subtitle">
            Van eenvoudige maandelijkse lidmaatschappen tot complexe familieabonnementen met
            QR-toegang — Pagayo ondersteunt het allemaal.
          </p>
          <div class="features__grid">
            <!-- Flexibele intervallen -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <h3>Flexibele intervallen</h3>
              <p>Wekelijks, maandelijks, per kwartaal, halfjaarlijks of jaarlijks. Jij kiest het ritme dat bij je klanten past.</p>
            </div>

            <!-- Automatische facturatie -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--dark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              </div>
              <h3>Automatische facturatie</h3>
              <p>Betalingen worden automatisch verwerkt via Stripe of Mollie. Geen handmatig werk, geen gemiste incasso's.</p>
            </div>

            <!-- Familie- en groepsabonnementen -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--lightblue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3>Familie- en groepsabonnementen</h3>
              <p>Eén abonnement, meerdere leden. Elk gezinslid of groepslid krijgt een eigen profiel en toegangspas.</p>
            </div>

            <!-- QR-codes voor toegang -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><line x1="21" y1="14" x2="21" y2="14.01"/><line x1="21" y1="21" x2="21" y2="21.01"/><line x1="17" y1="21" x2="17" y2="21.01"/></svg>
              </div>
              <h3>QR-codes voor toegang</h3>
              <p>Elk lid ontvangt een persoonlijke QR-code. Scan bij binnenkomst voor snelle en betrouwbare toegangscontrole.</p>
            </div>

            <!-- Self-service portaal -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--dark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              </div>
              <h3>Self-service portaal</h3>
              <p>Klanten beheren hun abonnement zelf: pauzeren, upgraden, betaalgegevens wijzigen of opzeggen — zonder jouw tussenkomst.</p>
            </div>

            <!-- Real-time dashboard -->
            <div class="feature-card">
              <div class="feature-card__icon feature-card__icon--lightblue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
              <h3>Real-time dashboard</h3>
              <p>Zie direct hoeveel actieve abonnees je hebt, wat je terugkerende omzet is en welke abonnementen aandacht nodig hebben.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Hoe het werkt -->
      <section class="how-it-works" id="hoe-het-werkt">
        <div class="container">
          <h2 class="section-title">Hoe het werkt</h2>
          <p class="section-subtitle">In drie stappen van nul naar terugkerende omzet.</p>
          <div class="steps">
            <div class="step">
              <div class="step__number">1</div>
              <h3>Maak je abonnementsplan</h3>
              <p>Kies een naam, prijs en interval. Voeg optioneel een proefperiode toe. Klaar in minder dan een minuut.</p>
            </div>
            <div class="step__connector"></div>
            <div class="step">
              <div class="step__number">2</div>
              <h3>Klanten schrijven zich in</h3>
              <p>Via je webshop, kassasysteem of een directe link. De betaling wordt automatisch verwerkt bij inschrijving.</p>
            </div>
            <div class="step__connector"></div>
            <div class="step">
              <div class="step__number">3</div>
              <h3>Beheer en groei</h3>
              <p>Volg je abonnees in real-time. Automatische verlengingen, herinneringen bij mislukte betalingen en inzicht in churn.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Voordelen -->
      <section class="benefits">
        <div class="container">
          <h2 class="section-title">Waarom abonnementen via Pagayo</h2>
          <div class="benefits__grid">
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Eén platform voor alles</strong>
                <p>Abonnementen, losse verkoop, kassa en webshop — allemaal in hetzelfde dashboard.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Geen apart abonnementsysteem</strong>
                <p>Abonnementbetalingen worden gewoon orders in je admin. Geen losse tools of exports nodig.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Gratis starten</strong>
                <p>Begin met abonnementen op het gratis plan. Betaal pas als je groeit.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Wereldwijd inzetbaar</strong>
                <p>Actief in bijna alle landen. Ondersteunt meerdere valuta's en betaalmethoden.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Automatische verlengingen</strong>
                <p>Abonnementen worden automatisch verlengd. Bij een mislukte betaling ontvangt je klant een herinnering.</p>
              </div>
            </div>
            <div class="benefit">
              <svg class="benefit__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <strong>Veilig en betrouwbaar</strong>
                <p>Alle betalingen via gecertificeerde providers. Volledig audit trail van elke abonnementswijziging.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section">
        <div class="container">
          <div class="cta-card">
            <h2>Klaar om terugkerende omzet op te bouwen?</h2>
            <p>Maak een gratis account aan en stel je eerste abonnement in. Geen creditcard nodig.</p>
            <a href={urls.createAccount} class="btn btn--primary btn--lg">Start gratis met abonnementen</a>
          </div>
        </div>
      </section>
    </main>
  </div>

  <FooterDynamic country={nlCountry} />
</BaseLayout>

<style>
  /* ─── Page tokens ─── */
  .page {
    --accent: #2563eb;
    --accent-light: #60a5fa;
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --bg-page: #ffffff;
    --bg-section: #f8fafc;
    --border-color: #e2e8f0;

    background: var(--bg-page);
    color: var(--text-primary);
    min-height: 100vh;
  }

  /* ─── Container ─── */
  .container {
    max-width: var(--container-2xl, 1400px);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ─── Hero ─── */
  .hero {
    padding: 140px 0 80px;
    text-align: center;
  }

  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(37, 99, 235, 0.08);
    border-radius: 100px;
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ─── Buttons ─── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn--primary {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn--primary:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
    box-shadow: 0 0 16px rgba(37, 99, 235, 0.2);
  }

  .btn--ghost {
    color: var(--text-primary);
    background: transparent;
    border-color: var(--border-color);
  }

  .btn--ghost:hover {
    background: var(--bg-section);
    border-color: #cbd5e1;
  }

  .btn--lg {
    padding: 0.875rem 2rem;
    font-size: 1.05rem;
  }

  /* ─── Section titles ─── */
  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.7;
    color: var(--text-secondary);
    text-align: center;
    max-width: 620px;
    margin: 0 auto 3rem;
  }

  /* ─── Features Grid ─── */
  .features {
    padding: 80px 0;
    background: var(--bg-section);
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .feature-card {
    padding: 2rem;
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .feature-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .feature-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    margin-bottom: 1.25rem;
  }

  .feature-card__icon--blue {
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
  }

  .feature-card__icon--dark {
    background: rgba(15, 23, 42, 0.08);
    color: #0f172a;
  }

  .feature-card__icon--lightblue {
    background: rgba(96, 165, 250, 0.12);
    color: #3b82f6;
  }

  .feature-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .feature-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* ─── How it works ─── */
  .how-it-works {
    padding: 80px 0;
  }

  .steps {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    max-width: 960px;
    margin: 0 auto;
  }

  .step {
    flex: 1;
    text-align: center;
    padding: 0 1.5rem;
  }

  .step__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
    background: var(--accent);
    border-radius: 50%;
    margin-bottom: 1.25rem;
  }

  .step h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .step p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .step__connector {
    width: 60px;
    height: 2px;
    background: var(--border-color);
    margin-top: 24px;
    flex-shrink: 0;
  }

  /* ─── Benefits ─── */
  .benefits {
    padding: 80px 0;
    background: var(--bg-section);
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .benefit {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 10px;
  }

  .benefit__check {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .benefit strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .benefit p {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ─── CTA Section ─── */
  .cta-section {
    padding: 80px 0;
  }

  .cta-card {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--text-primary);
    color: #fff;
    border-radius: 16px;
  }

  .cta-card h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .cta-card p {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 2rem;
  }

  .cta-card .btn--primary {
    background: #fff;
    color: var(--text-primary);
    border-color: #fff;
  }

  .cta-card .btn--primary:hover {
    background: #f1f5f9;
    border-color: #f1f5f9;
    box-shadow: none;
  }

  /* ─── Responsive: tablet ─── */
  @media (max-width: 1024px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ─── Responsive: mobile ─── */
  @media (max-width: 768px) {
    .hero {
      padding: 120px 0 60px;
    }

    .features__grid {
      grid-template-columns: 1fr;
    }

    .steps {
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }

    .step__connector {
      width: 2px;
      height: 40px;
      margin: 0;
    }

    .benefits__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 1rem;
    }

    .hero__actions {
      flex-direction: column;
      align-items: center;
    }

    .hero__actions .btn {
      width: 100%;
      max-width: 300px;
    }

    .cta-card {
      padding: 3rem 1.5rem;
    }
  }
</style>
