---
/**
 * Root Portal - pagayo.com
 * Minimale portal: gecentreerde branding + login/registratie.
 *
 * i18n-ready: Alle teksten uit content/pages/nl/portal.json
 */

export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import portalContent from '../content/pages/nl/portal.json';
import { urls } from '../config/urls';
import { resolveCountryName } from '@pagayo/config/brand';
import '../styles/pagayo-design.css';

const { title, description, lang, badge, actions, footer, seo } = portalContent;

// Landnaam detectie via middleware visitorContext (cf-ipcountry op Cloudflare, 'XX' fallback)
// In dev mode: geen cf-ipcountry header → fallback 'NL' voor lokale preview
const isDev = import.meta.env.DEV;
const visitorCountry = Astro.locals.visitorContext?.country;
const countryCode = (visitorCountry && visitorCountry !== 'XX') ? visitorCountry : (isDev ? 'NL' : '');
const countryName = resolveCountryName(countryCode, isDev ? 'NL' : '');

// Environment-aware URLs: localhost in dev, production URLs in prod
const actionUrls = {
  signIn: urls.signIn,
  createAccount: urls.createAccount,
};
---

<BaseLayout 
  title={title}
  description={description}
  lang={lang}
  alternates={seo.alternates}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
  twitterCard={seo.twitterCard}
  noIndex={seo.noIndex}
  structuredData={[{ type: seo.structuredData.type as 'WebSite', data: { name: seo.structuredData.name, url: seo.structuredData.url } }]}
>
  <main class="portal" data-theme="light">
    <!-- Navigation -->
    <nav class="main-nav">
      <a href="/" class="main-nav__logo">
        <span class="logo-p">P</span>agayo<span class="logo-dot">.</span>{countryName && <span class="logo-country">{countryName}</span>}
      </a>
      <button class="main-nav__menu" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </nav>

    <!-- Centered portal -->
    <div class="portal-center">
      <div class="portal-brand">
        <h1 class="portal-brand__name">
          <span class="portal-brand__p">P</span>agayo<span class="portal-brand__dot">.</span>
        </h1>
        <p class="portal-brand__tagline">{description}</p>
        <span class="portal-brand__badge">{badge}</span>
      </div>

      <div class="portal-actions">
        <a href={actionUrls.signIn} class="btn btn--primary btn--lg">
          {actions.signIn.label}
        </a>
      </div>
    </div>

    <!-- Footer -->
    <footer class="portal-footer">
      <span class="portal-footer__copy">{footer.copyright}</span>
    </footer>
  </main>
</BaseLayout>

<style is:global>
  body:has(.portal) {
    background: #ffffff !important;
    overflow: hidden;
  }
</style>

<style>
  /* ─── Portal Token Scope (fresh theme SSoT) ─── */
  .portal {
    --bg-deep: #ffffff;
    --bg-surface: #f6f8fa;
    --bg-hover: #e8ecf2;
    --accent: #2563eb;
    --accent-dim: #004ed1;
    --accent-glow: rgb(37 99 235 / 0.12);
    --text-primary: #0f172a;
    --text-secondary: rgb(15 23 42 / 0.75);
    --text-muted: rgb(15 23 42 / 0.5);
    --border: rgb(15 23 42 / 0.15);
    --border-strong: rgb(15 23 42 / 0.375);
  }

  /* ─── Full-viewport centered layout ─── */
  .portal {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg-deep) !important;
    color: var(--text-primary);
    position: relative;
  }

  /* ─── Navigation ─── */
  /* pagayo-design.css uses @layer, but marketing globals are unlayered.
     Unlayered CSS always wins over @layer — so we must repeat nav essentials here. */
  .main-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-6);
    height: 56px;
    background: var(--bg-deep);
    border-bottom: 1px solid var(--border);
    z-index: 100;
  }

  .main-nav__logo {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .main-nav__logo .logo-p,
  .main-nav__logo .logo-dot {
    color: var(--accent);
    font-weight: 800;
  }

  .logo-country {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-left: 0.5rem;
    letter-spacing: 0;
  }

  .main-nav__menu {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.5rem;
  }

  .main-nav__menu:hover {
    color: var(--accent);
    background: var(--bg-hover);
  }

  /* ─── Centered Brand ─── */
  .portal-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .portal-brand {
    text-align: center;
  }

  .portal-brand__name {
    font-family: var(--font-sans);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0 0 0.75rem;
    color: var(--text-primary);
  }

  .portal-brand__p,
  .portal-brand__dot {
    color: var(--accent);
  }

  .portal-brand__tagline {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    max-width: 360px;
  }

  .portal-brand__badge {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.5rem 1.5rem;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-glow);
    border-radius: 100px;
  }

  /* ─── Action Buttons ─── */
  .portal-actions {
    display: flex;
    gap: var(--space-3);
  }

  /* @pagayo/design uses @layer which has lower cascade priority than unlayered.
     Astro's scoped <style> is unlayered. We must repeat the SSoT btn values
     here so the unlayered cascade wins. Values MUST match primary.css + _base.css. */
  .portal-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-weight: var(--font-medium);
    line-height: 1;
    white-space: nowrap;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .portal-actions .btn--lg {
    height: 48px;
    padding: 0 var(--space-6);
    font-size: var(--text-base);
    min-width: 100px;
  }

  .portal-actions .btn--primary {
    background: var(--accent);
    color: var(--bg-deep);
    border-color: var(--accent);
  }

  .portal-actions .btn--primary:hover {
    background: var(--accent-light, #4f79ff);
    border-color: var(--accent-light, #4f79ff);
    box-shadow: var(--shadow-glow-sm, 0 0 10px rgba(37, 99, 235, 0.15));
  }

  .portal-actions .btn--primary:active {
    background: var(--accent-dim);
    border-color: var(--accent-dim);
    transform: scale(0.98);
  }

  /* ─── Footer ─── */
  .portal-footer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding: var(--space-4);
  }

  .portal-footer__copy {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* ─── Responsive ─── */
  @media (max-width: 480px) {
    .portal-actions {
      flex-direction: column;
      width: 100%;
      padding: 0 var(--space-6);
    }

    .portal-actions .btn {
      width: 100%;
    }

    .portal-brand__tagline {
      padding: 0 var(--space-4);
    }
  }
</style>
