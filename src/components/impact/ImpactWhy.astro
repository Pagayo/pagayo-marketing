---
import type { Messages } from '../../lib/i18n';

interface Props {
  impact: Messages['impactPage'];
}

const { impact: t } = Astro.props;
const why = t.why;
---

<section class="section impact-why fade-in" aria-labelledby="impact-why-title">
  <div class="container">
    <div class="impact-why-grid">

      <div class="impact-why-problem">
        <span class="section-label impact-why-label--problem">{why.problemLabel}</span>
        <h2 class="headline-lg" id="impact-why-title">
          {why.headline.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h2>

        <p class="impact-why-subhead">{why.subhead}</p>

        <ul class="impact-why-list">
          {why.problems.map((item) => (
            <li>
              <span class="impact-why-icon">{item.icon}</span>
              <div>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="impact-why-solution">
        <span class="section-label impact-label">{why.solutionLabel}</span>
        <h3 class="headline-md">{why.solutionHeadline}</h3>

        <ul class="impact-solution-list">
          {why.solutionPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>

        <blockquote class="impact-why-quote">
          "{why.quote}"
        </blockquote>
      </div>

    </div>
  </div>
</section>
