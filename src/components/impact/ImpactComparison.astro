---
const rows = [
  { traditional: 'Training curriculum',           pagayo: 'A running business from day one' },
  { traditional: 'Self-reported surveys',          pagayo: 'Live transaction data, verified per order' },
  { traditional: 'Shopify + WhatsApp + Excel',    pagayo: 'One platform — webshop, POS, payouts, reporting' },
  { traditional: 'Grants based on applications',  pagayo: 'Sponsorship tied to measurable outcomes' },
  { traditional: 'Quarterly narrative reports',   pagayo: 'Real-time dashboard, always current' },
  { traditional: 'Founders left without tooling after program ends', pagayo: '81% still transacting 12 months after grant period' },
];
---

<section class="section impact-comparison fade-in" aria-labelledby="impact-comparison-title">
  <div class="container">
    <div class="section-header center impact-comparison-header">
      <span class="section-label impact-label">Traditional vs Pagayo</span>
      <h2 class="headline-lg" id="impact-comparison-title">
        Why a separate grant + Shopify<br />
        <span class="impact-headline-accent">doesn't solve the problem.</span>
      </h2>
      <p class="text-lg">
        The issue isn't access to e-commerce tools. It's that no single platform
        connects the entrepreneur's daily operations to the sponsor's accountability needs.
      </p>
    </div>

    <div class="impact-comparison-table" role="table" aria-label="Traditional approach compared to Pagayo">
      <div class="impact-comparison-row impact-comparison-row--head" role="row">
        <div role="columnheader" class="impact-col-traditional">Traditional Approach</div>
        <div role="columnheader" class="impact-col-pagayo">Pagayo</div>
      </div>
      {rows.map((row) => (
        <div class="impact-comparison-row" role="row">
          <div role="cell" class="impact-col-traditional">
            <span class="impact-col-x" aria-hidden="true">✕</span>
            {row.traditional}
          </div>
          <div role="cell" class="impact-col-pagayo">
            <span class="impact-col-check" aria-hidden="true">✓</span>
            {row.pagayo}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
