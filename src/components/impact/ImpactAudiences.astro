---
import i18nEn from '../../content/i18n/en.json';

const t = i18nEn.impactPage.audiences;
---

<section class="section impact-audiences fade-in" aria-labelledby="impact-audiences-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label impact-label">Sponsors</span>
      <h2 class="headline-lg" id="impact-audiences-title">{t.headline}</h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="impact-audiences-grid">
      {t.cards.map((card) => (
        <article class="impact-audience-card">
          <div class="impact-audience-icon" aria-hidden="true">{card.icon}</div>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
