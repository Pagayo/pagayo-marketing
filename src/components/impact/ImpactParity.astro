---
import type { Messages } from '../../lib/i18n';

interface Props {
  impact: Messages['impactPage'];
}

const { impact } = Astro.props;
const t = impact.parity;
---

<section class="impact-parity fade-in" aria-labelledby="impact-parity-title">
  <div class="impact-parity-bg" aria-hidden="true">
    <div class="impact-parity-orb impact-parity-orb--west"></div>
    <div class="impact-parity-orb impact-parity-orb--east"></div>
    <div class="impact-parity-line" aria-hidden="true"></div>
  </div>

  <div class="container impact-parity-inner">
    <div class="impact-parity-statement">
      <p class="impact-parity-eyebrow">One platform. Two cities. No compromise.</p>
      <h2 class="impact-parity-headline" id="impact-parity-title">
        {t.headline}
      </h2>
      <p class="impact-parity-intro">{t.intro}</p>
    </div>

    <div class="impact-parity-grid">
      <article class="impact-parity-card impact-parity-card--west">
        <div class="impact-parity-card-top">
          <div class="impact-parity-city">{t.amsterdam.city}</div>
          <div class="impact-parity-region">{t.amsterdam.region}</div>
        </div>
        <ul>
          {t.amsterdam.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <div class="impact-parity-bridge" aria-hidden="true">
        <div class="impact-parity-equals">=</div>
        <div class="impact-parity-stack-label">Same Pagayo stack</div>
        <div class="impact-parity-stack-sub">webshop · POS · payouts · reporting</div>
      </div>

      <article class="impact-parity-card impact-parity-card--east">
        <div class="impact-parity-card-top">
          <div class="impact-parity-city">{t.nairobi.city}</div>
          <div class="impact-parity-region">{t.nairobi.region}</div>
        </div>
        <ul>
          {t.nairobi.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    </div>

    <p class="impact-parity-footnote">
      Unlike tools built exclusively for development markets, Pagayo runs on the same
      infrastructure in both cities. When your cohort graduates, they keep the same platform —
      no migration, no downgrade.
    </p>
  </div>
</section>
