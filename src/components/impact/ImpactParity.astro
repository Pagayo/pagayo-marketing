---
import i18nEn from '../../content/i18n/en.json';

const t = i18nEn.impactPage.parity;
---

<section class="impact-parity fade-in" aria-labelledby="impact-parity-title">
  <div class="impact-parity-bg" aria-hidden="true">
    <div class="impact-parity-orb impact-parity-orb--west"></div>
    <div class="impact-parity-orb impact-parity-orb--east"></div>
    <div class="impact-parity-line" aria-hidden="true"></div>
  </div>

  <div class="container impact-parity-inner">
    <div class="impact-parity-statement">
      <p class="impact-parity-eyebrow">One platform. Two cities. No compromise.</p>
      <h2 class="impact-parity-headline" id="impact-parity-title">
        {t.headline}
      </h2>
      <p class="impact-parity-intro">{t.intro}</p>
    </div>

    <div class="impact-parity-grid">
      <article class="impact-parity-card impact-parity-card--west">
        <div class="impact-parity-card-top">
          <div class="impact-parity-city">{t.amsterdam.city}</div>
          <div class="impact-parity-region">{t.amsterdam.region}</div>
        </div>
        <ul>
          {t.amsterdam.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <div class="impact-parity-bridge" aria-hidden="true">
        <div class="impact-parity-equals">=</div>
        <div class="impact-parity-stack-label">Same Pagayo stack</div>
        <div class="impact-parity-stack-sub">webshop · POS · payouts · reporting</div>
      </div>

      <article class="impact-parity-card impact-parity-card--east">
        <div class="impact-parity-card-top">
          <div class="impact-parity-city">{t.nairobi.city}</div>
          <div class="impact-parity-region">{t.nairobi.region}</div>
        </div>
        <ul>
          {t.nairobi.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    </div>

    <p class="impact-parity-footnote">
      Unlike tools built exclusively for development markets, Pagayo runs on the same
      infrastructure in both cities. When your cohort graduates, they keep the same platform —
      no migration, no downgrade.
    </p>
  </div>
</section>

<style>
  .impact-parity {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 10vw, 8rem) 0;
    background: var(--bg-deep);
  }

  .impact-parity-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .impact-parity-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .impact-parity-orb--west {
    width: 600px;
    height: 600px;
    background: var(--pagayo-purple);
    opacity: 0.09;
    top: -100px;
    left: -200px;
  }

  .impact-parity-orb--east {
    width: 600px;
    height: 600px;
    background: var(--ngo-amber);
    opacity: 0.08;
    bottom: -100px;
    right: -200px;
  }

  .impact-parity-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(251, 191, 36, 0.15) 30%,
      rgba(251, 191, 36, 0.15) 70%,
      transparent
    );
  }

  .impact-parity-inner {
    position: relative;
  }

  .impact-parity-statement {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .impact-parity-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ngo-amber);
    margin-bottom: 1rem;
  }

  .impact-parity-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .impact-parity-intro {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .impact-parity-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .impact-parity-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 2.25rem;
  }

  .impact-parity-card--west {
    border-top: 3px solid var(--pagayo-purple);
  }

  .impact-parity-card--east {
    border-top: 3px solid var(--ngo-amber);
  }

  .impact-parity-card-top {
    margin-bottom: 1.5rem;
  }

  .impact-parity-city {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .impact-parity-region {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .impact-parity-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .impact-parity-card li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 0.3rem 0;
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .impact-parity-card li::before {
    content: '✓';
    color: var(--ngo-amber);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .impact-parity-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 0.5rem;
  }

  .impact-parity-equals {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--ngo-amber-glow);
    color: var(--ngo-amber);
    border: 1px solid rgba(251, 191, 36, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .impact-parity-stack-label {
    font-size: 0.72rem;
    color: var(--ngo-amber);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    font-weight: 700;
    max-width: 5rem;
    line-height: 1.3;
  }

  .impact-parity-stack-sub {
    font-size: 0.65rem;
    color: var(--text-muted);
    text-align: center;
    max-width: 5rem;
    line-height: 1.4;
  }

  .impact-parity-footnote {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .impact-parity-grid {
      grid-template-columns: 1fr;
    }

    .impact-parity-line {
      display: none;
    }

    .impact-parity-bridge {
      flex-direction: row;
      justify-content: flex-start;
      gap: 1rem;
      padding: 0;
    }

    .impact-parity-stack-label,
    .impact-parity-stack-sub {
      max-width: none;
      text-align: left;
    }
  }
</style>
