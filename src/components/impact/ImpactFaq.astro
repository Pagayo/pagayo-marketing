---
import type { Messages } from '../../lib/i18n';

interface Props {
  impact: Messages['impactPage'];
}

const { impact } = Astro.props;
const t = impact.faq;
---

<section class="section impact-faq fade-in" aria-labelledby="impact-faq-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label impact-label">FAQ</span>
      <h2 class="headline-lg" id="impact-faq-title">{t.headline}</h2>
    </div>

    <div class="impact-faq-list">
      {t.items.map((item) => (
        <details class="impact-faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
