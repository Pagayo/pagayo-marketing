---
import type { Messages } from '../../lib/i18n';

interface Props {
  impact: Messages['impactPage'];
}

const { impact: t } = Astro.props;
const p = t.pilot;
---

<section class="section impact-pilot fade-in" aria-labelledby="impact-pilot-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label impact-label">{p.sectionLabel}</span>
      <h2 class="headline-lg" id="impact-pilot-title">
        {p.headline.split('\n').map((line, i) => (
          <>
            {i > 0 && <br />}
            {i === 1 ? <span class="impact-headline-accent">{line}</span> : line}
          </>
        ))}
      </h2>
      <p class="text-lg impact-pilot-note">{p.intro}</p>
    </div>

    {p.cases.map((caseStudy, caseIndex) => (
      <div class={`impact-pilot-case ${caseIndex > 0 ? 'impact-pilot-case--second' : ''}`.trim()}>
        <header class="impact-pilot-header">
          <div class="impact-pilot-meta">
            <div class="impact-pilot-tag">{caseStudy.tag}</div>
            <div class="impact-pilot-duration">{caseStudy.duration}</div>
          </div>
          <div class="impact-pilot-sponsor-type">{caseStudy.sponsorType}</div>
        </header>

        <div class="impact-pilot-stats">
          {caseStudy.heroStats.map((stat) => (
            <div class="impact-pilot-stat impact-pilot-stat--hero">
              <div class="impact-pilot-stat-number">{stat.number}</div>
              <div class="impact-pilot-stat-label">{stat.label}</div>
              <div class="impact-pilot-stat-sub">{stat.sub}</div>
              <div class="impact-pilot-stat-benchmark">{stat.benchmark}</div>
            </div>
          ))}
          {caseStudy.stats.map((stat) => (
            <div class="impact-pilot-stat">
              <div class="impact-pilot-stat-number">{stat.number}</div>
              <div class="impact-pilot-stat-label">{stat.label}</div>
            </div>
          ))}
        </div>

        <ul class="impact-pilot-highlights">
          {caseStudy.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}

    <p class="impact-pilot-disclaimer">
      {p.disclaimer}
      <a href="/contact">{p.disclaimerLink}</a>
    </p>
  </div>
</section>
