---
import i18nEn from '../../content/i18n/en.json';

const t = i18nEn.impactPage.metrics;
---

<section class="section impact-metrics fade-in" aria-labelledby="impact-metrics-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label impact-label">Dashboard</span>
      <h2 class="headline-lg" id="impact-metrics-title">{t.headline}</h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="impact-metrics-grid">
      {t.items.map((item) => (
        <div class="impact-metric-card">
          <h3>{item.label}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
