---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['howItWorks'];
}

const { content: t } = Astro.props;
---

<section class="section pb-how fade-in" aria-labelledby="pb-how-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-how-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-how-steps">
      {t.steps.map((step, i) => (
        <div class="pb-how-step">
          <div class="pb-how-step-number" aria-hidden="true">{step.number}</div>
          <div class="pb-how-step-content">
            <h3>{step.title}</h3>
            <p class="pb-how-step-desc">{step.description}</p>
            <p class="pb-how-step-detail">{step.detail}</p>
          </div>
          {i < t.steps.length - 1 && (
            <div class="pb-how-connector" aria-hidden="true"></div>
          )}
        </div>
      ))}
    </div>

    <div class="pb-how-timeline-note">
      <span class="pb-how-badge">{t.timelineBadge}</span>
    </div>
  </div>
</section>
