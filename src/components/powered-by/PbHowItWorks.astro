---
const steps = [
  {
    number: '01',
    title: 'Configure your network',
    description: 'Set your brand, your sector settings, and your member invitation flow. We set up your partner dashboard. No development required, no IT project, no waiting. Most networks are fully configured within a week.',
    detail: 'Your configuration: brand identity, sector defaults, pricing structure, dashboard access levels.',
  },
  {
    number: '02',
    title: 'Invite your members',
    description: 'Send your members a single invitation link. They register, complete a short onboarding, and launch their commerce presence — webshop, POS, QR ordering, subscriptions — on day one. You see each activation in real time.',
    detail: 'Your members do not need technical knowledge. The onboarding flow is five minutes.',
  },
  {
    number: '03',
    title: 'Watch your network grow',
    description: 'Every transaction, every active member, every new channel — visible in your partner dashboard. You advise based on data. You support with context. Your position in their business deepens with every order they process.',
    detail: 'Network dashboard: member activation rate, total network GMV, channel mix, top performers.',
  },
];
---

<section class="section pb-how fade-in" aria-labelledby="pb-how-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">How It Works</span>
      <h2 class="headline-lg" id="pb-how-title">
        Three steps from network<br />
        <span class="pb-headline-accent">to platform.</span>
      </h2>
      <p class="text-lg">
        No IT department. No development timeline. No onboarding marathon.
        You configure once. Your members activate themselves.
      </p>
    </div>

    <div class="pb-how-steps">
      {steps.map((step, i) => (
        <div class="pb-how-step">
          <div class="pb-how-step-number" aria-hidden="true">{step.number}</div>
          <div class="pb-how-step-content">
            <h3>{step.title}</h3>
            <p class="pb-how-step-desc">{step.description}</p>
            <p class="pb-how-step-detail">{step.detail}</p>
          </div>
          {i < steps.length - 1 && (
            <div class="pb-how-connector" aria-hidden="true"></div>
          )}
        </div>
      ))}
    </div>

    <div class="pb-how-timeline-note">
      <span class="pb-how-badge">Typical timeline: 2–4 weeks from kick-off to first active members.</span>
    </div>
  </div>
</section>

<style>
  .pb-how-steps {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .pb-how-step {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.5rem;
    position: relative;
  }

  .pb-how-step-number {
    font-size: 2.5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--pb-network);
    opacity: 0.35;
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
    flex-shrink: 0;
  }

  .pb-how-step-content {
    padding: 1.5rem 0 2.5rem;
    border-left: 2px solid var(--border);
    padding-left: 1.5rem;
    margin-left: -3rem;
  }

  .pb-how-step:last-child .pb-how-step-content {
    padding-bottom: 0;
    border-left-color: transparent;
  }

  .pb-how-step-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .pb-how-step-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .pb-how-step-detail {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.85rem;
    display: inline-block;
  }

  .pb-how-timeline-note {
    margin-top: 2.5rem;
    text-align: center;
  }

  .pb-how-badge {
    display: inline-block;
    background: var(--pb-network-glow);
    color: var(--pb-network);
    border: 1px solid rgba(96, 165, 250, 0.2);
    border-radius: var(--radius-pill);
    padding: 0.4rem 1.1rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .pb-how-step {
      grid-template-columns: 1fr;
    }

    .pb-how-step-number {
      font-size: 1.75rem;
      opacity: 0.5;
      padding-bottom: 0;
    }

    .pb-how-step-content {
      border-left: none;
      padding-left: 0;
      margin-left: 0;
      padding-top: 0;
    }
  }
</style>
