---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['solution'];
}

const { content: t } = Astro.props;
---

<section class="section pb-solution fade-in" aria-labelledby="pb-solution-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-solution-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-solution-grid">
      <div class="pb-solution-card pb-solution-card--not">
        <div class="pb-solution-card-header">
          <span class="pb-solution-icon pb-solution-icon--no">✕</span>
          <h3>{t.notThisHeading}</h3>
        </div>
        <ul>
          {t.notThis.map((item) => (
            <li>
              <span class="pb-solution-marker pb-solution-marker--no" aria-hidden="true">✕</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="pb-solution-card pb-solution-card--yes">
        <div class="pb-solution-card-header">
          <span class="pb-solution-icon pb-solution-icon--yes">✓</span>
          <h3>{t.butThisHeading}</h3>
        </div>
        <ul>
          {t.butThis.map((item) => (
            <li>
              <span class="pb-solution-marker pb-solution-marker--yes" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pb-solution-badge-wrap">
      <div class="pb-solution-badge">
        <span class="pb-solution-badge-network">{t.badgeNetwork}</span>
        <span class="pb-solution-badge-divider" aria-hidden="true">—</span>
        <span class="pb-solution-badge-powered">{t.badgePowered}</span>
      </div>
      <p class="pb-solution-badge-caption">{t.badgeCaption}</p>
    </div>
  </div>
</section>
