---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['whyNow'];
}

const { content: t } = Astro.props;
---

<section class="section pb-why-now fade-in" aria-labelledby="pb-why-now-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-why-now-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
    </div>

    <div class="pb-why-now-body">

      <div class="pb-why-now-signals">
        {t.signals.map((s) => (
          <div class="pb-signal-card">
            <div class="pb-signal-stat">{s.stat}</div>
            <div class="pb-signal-content">
              <p class="pb-signal-label">{s.label}</p>
              <p class="pb-signal-context">{s.context}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="pb-why-now-argument">
        <div class="pb-argument-block">
          <h3>{t.happeningTitle}</h3>
          {t.happeningParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <div class="pb-argument-block">
          <h3>{t.waitTitle}</h3>
          <ul class="pb-wait-list">
            {t.waitItems.map((item) => (
              <li>
                <span class="pb-wait-icon" aria-hidden="true">→</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <blockquote class="pb-why-now-quote">
          {t.quoteLine1}<br />
          {t.quoteLine2}
        </blockquote>
      </div>

    </div>
  </div>
</section>
