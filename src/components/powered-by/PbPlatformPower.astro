---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['platformPower'];
}

const { content: t } = Astro.props;
---

<section class="section pb-platform-power fade-in" aria-labelledby="pb-platform-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-platform-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-eras">
      {t.eras.map((era) => (
        <div class={`pb-era-card ${era.status === 'now' ? 'pb-era-card--now' : 'pb-era-card--past'}`}>
          <span class="pb-era-when">{era.when}</span>
          <h3>{era.what}</h3>
          <p>{era.detail}</p>
          {'badge' in era && era.badge && (
            <span class="pb-era-badge">{era.badge}</span>
          )}
        </div>
      ))}
    </div>

    <div class="pb-platform-divider" aria-hidden="true">
      <div class="pb-platform-divider-line"></div>
      <span class="pb-platform-divider-label">{t.dividerLabel}</span>
      <div class="pb-platform-divider-line"></div>
    </div>

    <div class="pb-platform-advantages">
      {t.advantages.map((adv) => (
        <div class="pb-platform-adv-card">
          <span class="pb-platform-adv-icon" aria-hidden="true">{adv.icon}</span>
          <h3>{adv.title}</h3>
          <p>{adv.description}</p>
        </div>
      ))}
    </div>

    <div class="pb-platform-insight">
      <p class="pb-platform-insight-text">{t.insightText}</p>
      <p class="pb-platform-insight-sub">{t.insightSub}</p>
    </div>
  </div>
</section>
