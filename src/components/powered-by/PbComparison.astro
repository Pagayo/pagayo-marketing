---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['comparison'];
}

const { content: t } = Astro.props;
---

<section class="section pb-comparison fade-in" aria-labelledby="pb-comparison-title">
  <div class="container">
    <div class="section-header center pb-comparison-header">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-comparison-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-comparison-table" role="table" aria-label={t.tableAriaLabel}>
      <div class="pb-comparison-row pb-comparison-row--head" role="row">
        <div role="columnheader" class="pb-col-traditional">{t.colTraditional}</div>
        <div role="columnheader" class="pb-col-powered">{t.colPowered}</div>
      </div>
      {t.rows.map((row) => (
        <div class="pb-comparison-row" role="row">
          <div role="cell" class="pb-col-traditional">
            <span class="pb-col-x" aria-hidden="true">✕</span>
            {row.traditional}
          </div>
          <div role="cell" class="pb-col-powered">
            <span class="pb-col-check" aria-hidden="true">✓</span>
            {row.powered}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
