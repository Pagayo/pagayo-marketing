---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['pricing'];
  contact: PoweredByContent['contact'];
}

const { content: t, contact } = Astro.props;
---

<section class="section pb-pricing-v2 fade-in" aria-labelledby="pb-pricing-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-pricing-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-pricing-tiers">
      {t.tiers.map((tier) => (
        <div class={`pb-tier-card ${tier.featured ? 'pb-tier-card--featured' : ''}`}>
          {tier.featured && (
            <div class="pb-tier-badge">{t.featuredBadge}</div>
          )}
          <div class="pb-tier-header">
            <h3>{tier.name}</h3>
            <p class="pb-tier-tagline">{tier.tagline}</p>
          </div>
          <p class="pb-tier-for">{tier.forWho}</p>
          <ul class="pb-tier-includes">
            {tier.what.map((item) => (
              <li>
                <span class="pb-tier-check" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <div class="pb-tier-cta-wrap">
            <span class="pb-tier-cta-note">{tier.cta}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="pb-pricing-structure">
      <div class="pb-pricing-structure-header">
        <h3>{t.structureTitle}</h3>
      </div>
      <div class="pb-pricing-structure-body">
        <div class="pb-pricing-struct-item">
          <span class="pb-pricing-struct-label">{t.structureItems[0].label}</span>
          <p>{t.structureItems[0].description}</p>
        </div>
        <div class="pb-pricing-struct-divider" aria-hidden="true">+</div>
        <div class="pb-pricing-struct-item">
          <span class="pb-pricing-struct-label">{t.structureItems[1].label}</span>
          <p>{t.structureItems[1].description}</p>
        </div>
      </div>
      <p class="pb-pricing-struct-note">{t.structureNote}</p>
    </div>

    <div class="pb-pricing-cta">
      <h3>{t.ctaTitle}</h3>
      <p>{t.ctaBody}</p>
      <div class="pb-pricing-cta-buttons">
        <a href={contact.proposal} class="btn btn-pb btn-lg">{t.ctaProposal}</a>
        <a href={contact.demo} class="btn btn-secondary">{t.ctaDemo}</a>
      </div>
    </div>
  </div>
</section>
