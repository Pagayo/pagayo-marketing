---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['problem'];
}

const { content: t } = Astro.props;
---

<section class="section pb-problem fade-in" aria-labelledby="pb-problem-title">
  <div class="container">
    <div class="pb-problem-grid">

      <div class="pb-problem-left">
        <span class="section-label pb-problem-label">{t.sectionLabel}</span>
        <h2 class="headline-lg" id="pb-problem-title">
          {t.headlineTop}<br />
          {t.headlineBottom}
        </h2>

        <p class="pb-problem-subhead">{t.subhead}</p>

        <ul class="pb-problem-list">
          {t.problems.map((item) => (
            <li>
              <span class="pb-problem-icon">{item.icon}</span>
              <div>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="pb-problem-solution">
        <span class="section-label pb-network-label">{t.solutionLabel}</span>
        <h3 class="headline-md">{t.solutionHeadline}</h3>

        <ul class="pb-solution-list">
          {t.solutionItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <blockquote class="pb-quote">
          "{t.quote}"
        </blockquote>
      </div>

    </div>
  </div>
</section>
