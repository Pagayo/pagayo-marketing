---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['ecosystem'];
}

const { content: t } = Astro.props;

const propLabelKeys = [
  'whatItIs',
  'relationships',
  'valueSource',
  'yourRole',
  'retentionDriver',
  'growth',
  'data',
  'position',
] as const;

const networkProps = propLabelKeys.map((key, i) => ({
  label: t.propLabels[key],
  value: t.networkProps[i],
}));

const ecosystemProps = propLabelKeys.map((key, i) => ({
  label: t.propLabels[key],
  value: t.ecosystemProps[i],
}));
---

<section class="section pb-ecosystem fade-in" aria-labelledby="pb-ecosystem-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-ecosystem-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-ecosystem-compare">
      <div class="pb-ecosystem-col pb-ecosystem-col--network">
        <div class="pb-ecosystem-col-header">
          <span class="pb-ecosystem-col-state">{t.beforeLabel}</span>
          <h3>{t.beforeTitle}</h3>
          <p>{t.beforeDesc}</p>
        </div>
        <ul class="pb-ecosystem-props">
          {networkProps.map((prop) => (
            <li>
              <span class="pb-prop-label">{prop.label}</span>
              <span class="pb-prop-value pb-prop-value--network">{prop.value}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="pb-ecosystem-arrow" aria-hidden="true">
        <div class="pb-ecosystem-arrow-line"></div>
        <div class="pb-ecosystem-arrow-label">{t.arrowLabel}</div>
        <div class="pb-ecosystem-arrow-tip">→</div>
      </div>

      <div class="pb-ecosystem-col pb-ecosystem-col--ecosystem">
        <div class="pb-ecosystem-col-header">
          <span class="pb-ecosystem-col-state pb-ecosystem-col-state--after">{t.afterLabel}</span>
          <h3>{t.afterTitle}</h3>
          <p>{t.afterDesc}</p>
        </div>
        <ul class="pb-ecosystem-props">
          {ecosystemProps.map((prop) => (
            <li>
              <span class="pb-prop-label">{prop.label}</span>
              <span class="pb-prop-value pb-prop-value--ecosystem">{prop.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pb-ecosystem-statement">
      <div class="pb-ecosystem-statement-inner">
        <h3>{t.statementHeadline}</h3>
        <p>{t.statementBody}</p>
        <div class="pb-ecosystem-transformation">
          <div class="pb-transformation-step">
            <span class="pb-transformation-label">{t.transformationToday}</span>
            <span class="pb-transformation-role">{t.transformationTodayRole}</span>
          </div>
          <span class="pb-transformation-arrow" aria-hidden="true">→</span>
          <div class="pb-transformation-step">
            <span class="pb-transformation-label">{t.transformationWith}</span>
            <span class="pb-transformation-role pb-transformation-role--platform">{t.transformationWithRole}</span>
          </div>
          <span class="pb-transformation-arrow" aria-hidden="true">→</span>
          <div class="pb-transformation-step">
            <span class="pb-transformation-label">{t.transformationSector}</span>
            <span class="pb-transformation-role pb-transformation-role--leader">{t.transformationSectorRole}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
