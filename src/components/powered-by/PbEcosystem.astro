---
const networkProps = [
  { label: 'What it is', value: 'A list of members' },
  { label: 'Relationships', value: 'Maintained by people, one meeting at a time' },
  { label: 'Value source', value: 'The product or service you provide' },
  { label: 'Your role', value: 'Supplier with a relationship advantage' },
  { label: 'Retention driver', value: 'Price, inertia, personal relationships' },
  { label: 'Growth', value: 'Linear — requires more people and more effort' },
  { label: 'Data', value: 'What they tell you, when they call you' },
  { label: 'Position', value: 'Negotiated, renewed, at risk' },
];

const ecosystemProps = [
  { label: 'What it is', value: 'Members connected through shared infrastructure' },
  { label: 'Relationships', value: 'Reinforced by every transaction, every day' },
  { label: 'Value source', value: 'The platform + the network around it' },
  { label: 'Your role', value: 'The operating layer your sector depends on' },
  { label: 'Retention driver', value: 'Operational dependency — switching means rebuilding' },
  { label: 'Growth', value: 'Compound — every new member makes the network more valuable' },
  { label: 'Data', value: 'Every transaction, in real time, across the entire network' },
  { label: 'Position', value: 'Structural — built into how your sector operates' },
];
---

<section class="section pb-ecosystem fade-in" aria-labelledby="pb-ecosystem-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">The Transformation</span>
      <h2 class="headline-lg" id="pb-ecosystem-title">
        From network<br />
        <span class="pb-headline-accent">to ecosystem.</span>
      </h2>
      <p class="text-lg">
        A network and an ecosystem look similar from the outside.
        Inside, they are fundamentally different — in how they create value, how they retain it, and how they grow.
      </p>
    </div>

    <div class="pb-ecosystem-compare">
      <div class="pb-ecosystem-col pb-ecosystem-col--network">
        <div class="pb-ecosystem-col-header">
          <span class="pb-ecosystem-col-state">Before</span>
          <h3>Network</h3>
          <p>A set of relationships you maintain through effort.</p>
        </div>
        <ul class="pb-ecosystem-props">
          {networkProps.map((prop) => (
            <li>
              <span class="pb-prop-label">{prop.label}</span>
              <span class="pb-prop-value pb-prop-value--network">{prop.value}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="pb-ecosystem-arrow" aria-hidden="true">
        <div class="pb-ecosystem-arrow-line"></div>
        <div class="pb-ecosystem-arrow-label">Powered by Pagayo</div>
        <div class="pb-ecosystem-arrow-tip">→</div>
      </div>

      <div class="pb-ecosystem-col pb-ecosystem-col--ecosystem">
        <div class="pb-ecosystem-col-header">
          <span class="pb-ecosystem-col-state pb-ecosystem-col-state--after">After</span>
          <h3>Ecosystem</h3>
          <p>An operating layer your members depend on to run their business.</p>
        </div>
        <ul class="pb-ecosystem-props">
          {ecosystemProps.map((prop) => (
            <li>
              <span class="pb-prop-label">{prop.label}</span>
              <span class="pb-prop-value pb-prop-value--ecosystem">{prop.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pb-ecosystem-statement">
      <div class="pb-ecosystem-statement-inner">
        <h3>
          Pagayo does not make you a software company.<br />
          It makes your organisation the infrastructure your sector operates on.
        </h3>
        <p>
          The organisations that will define their sector over the next decade are not the ones with
          the best product catalogue or the most experienced sales team.
          They are the ones that own the platform their market runs on.
          That position, once established, compounds automatically.
          Your members' growth becomes your growth.
          Their transactions are your intelligence.
          Their success makes your platform harder to leave.
        </p>
        <div class="pb-ecosystem-transformation">
          <div class="pb-transformation-step">
            <span class="pb-transformation-label">Today</span>
            <span class="pb-transformation-role">Supplier</span>
          </div>
          <span class="pb-transformation-arrow" aria-hidden="true">→</span>
          <div class="pb-transformation-step">
            <span class="pb-transformation-label">With Powered by Pagayo</span>
            <span class="pb-transformation-role pb-transformation-role--platform">Platform Owner</span>
          </div>
          <span class="pb-transformation-arrow" aria-hidden="true">→</span>
          <div class="pb-transformation-step">
            <span class="pb-transformation-label">In your sector</span>
            <span class="pb-transformation-role pb-transformation-role--leader">Category Leader</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pb-ecosystem-compare {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    align-items: start;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .pb-ecosystem-col {
    padding: 0;
  }

  .pb-ecosystem-col--network {
    background: var(--bg-card);
  }

  .pb-ecosystem-col--ecosystem {
    background: rgba(96, 165, 250, 0.04);
    border-left: 1px solid rgba(96, 165, 250, 0.2);
  }

  .pb-ecosystem-col-header {
    padding: 1.75rem 1.75rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .pb-ecosystem-col--ecosystem .pb-ecosystem-col-header {
    border-bottom-color: rgba(96, 165, 250, 0.15);
  }

  .pb-ecosystem-col-state {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.6rem;
  }

  .pb-ecosystem-col-state--after {
    background: var(--pb-network-glow);
    color: var(--pb-network);
    border-color: rgba(96, 165, 250, 0.25);
  }

  .pb-ecosystem-col-header h3 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
    letter-spacing: -0.01em;
  }

  .pb-ecosystem-col-header p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .pb-ecosystem-props {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .pb-ecosystem-props li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .pb-ecosystem-col--ecosystem .pb-ecosystem-props li {
    border-bottom-color: rgba(96, 165, 250, 0.1);
  }

  .pb-ecosystem-props li:last-child {
    border-bottom: none;
  }

  .pb-prop-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }

  .pb-prop-value {
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .pb-prop-value--network {
    color: var(--text-muted);
  }

  .pb-prop-value--ecosystem {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .pb-ecosystem-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 2rem 0.75rem;
    gap: 0.5rem;
  }

  .pb-ecosystem-arrow-line {
    width: 1px;
    flex: 1;
    min-height: 40px;
    background: var(--border);
  }

  .pb-ecosystem-arrow-label {
    font-size: 0.7rem;
    color: var(--pb-network);
    font-weight: 600;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    letter-spacing: 0.05em;
  }

  .pb-ecosystem-arrow-tip {
    font-size: 1rem;
    color: var(--pb-network);
    transform: rotate(90deg);
  }

  .pb-ecosystem-statement {
    margin-top: 2.5rem;
  }

  .pb-ecosystem-statement-inner {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    max-width: 100%;
  }

  .pb-ecosystem-statement-inner h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .pb-ecosystem-statement-inner p {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0 0 2rem;
    max-width: 680px;
  }

  .pb-ecosystem-transformation {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pb-transformation-step {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 0.75rem 1.25rem;
  }

  .pb-transformation-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .pb-transformation-role {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pb-transformation-role--platform {
    color: var(--pb-network);
  }

  .pb-transformation-role--leader {
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .pb-transformation-arrow {
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .pb-ecosystem-compare {
      grid-template-columns: 1fr;
    }

    .pb-ecosystem-col--ecosystem {
      border-left: none;
      border-top: 1px solid rgba(96, 165, 250, 0.2);
    }

    .pb-ecosystem-arrow {
      flex-direction: row;
      justify-content: center;
      padding: 0.75rem;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .pb-ecosystem-arrow-line {
      width: 60px;
      height: 1px;
      flex: none;
      min-height: auto;
    }

    .pb-ecosystem-arrow-label {
      writing-mode: horizontal-tb;
    }

    .pb-ecosystem-arrow-tip {
      transform: none;
    }
  }
</style>
