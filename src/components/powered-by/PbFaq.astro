---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['faq'];
}

const { content: t } = Astro.props;
---

<section class="section pb-faq fade-in" aria-labelledby="pb-faq-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-faq-title">{t.headline}</h2>
    </div>

    <div class="pb-faq-list">
      {t.items.map((item) => (
        <details class="pb-faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
