---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['model'];
}

const { content: t } = Astro.props;
---

<section class="section pb-model fade-in" aria-labelledby="pb-model-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-model-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-model-grid">
      <div class="pb-model-column">
        <div class="pb-model-col-header">
          <span class="pb-model-col-role">{t.youBringRole}</span>
          <h3>{t.youBringTitle}</h3>
        </div>
        <ul class="pb-model-list">
          {t.youBring.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="pb-model-column pb-model-column--center">
        <div class="pb-model-col-header">
          <span class="pb-model-col-role pb-model-col-role--pagayo">{t.pagayoBringsRole}</span>
          <h3>{t.pagayoBringsTitle}</h3>
        </div>
        <ul class="pb-model-list">
          {t.weBring.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="pb-model-column">
        <div class="pb-model-col-header">
          <span class="pb-model-col-role">{t.membersGetRole}</span>
          <h3>{t.membersGetTitle}</h3>
        </div>
        <ul class="pb-model-list">
          {t.theyGet.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pb-model-flywheel">
      <h3 class="pb-model-flywheel-title">{t.flywheelTitle}</h3>
      <div class="pb-model-flywheel-steps">
        {t.flywheelSteps.map((step, i) => (
          <>
            <div class="pb-model-flywheel-step">
              <span class="pb-model-flywheel-num">{i + 1}</span>
              <span>{step}</span>
            </div>
            {i < t.flywheelSteps.length - 1 && (
              <span class="pb-model-flywheel-arrow" aria-hidden="true">→</span>
            )}
          </>
        ))}
      </div>
      <p class="pb-model-flywheel-caption">{t.flywheelCaption}</p>
    </div>
  </div>
</section>
