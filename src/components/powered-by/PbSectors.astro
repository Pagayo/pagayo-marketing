---
const sectors = [
  {
    icon: '✂️',
    name: 'Beauty Network',
    scale: '500 salons',
    description: 'A hair care wholesaler powers every salon in their distribution network with a webshop, online booking integration, and product subscription capability.',
    memberWin: 'Salons sell product bundles, appointment packages, and gift vouchers online.',
    networkWin: 'The wholesaler sees sell-through data, repurchase patterns, and product performance across every salon in real time.',
  },
  {
    icon: '🍽️',
    name: 'Restaurant Network',
    scale: '300 restaurants',
    description: 'A horeca collective gives every member restaurant a QR ordering system, takeaway webshop, and delivery channel — under the collective\'s brand.',
    memberWin: 'Restaurants add online ordering without a separate tech contract. Revenue from channels they did not have before.',
    networkWin: 'The collective negotiates better supplier terms with verified network GMV data. Every transaction strengthens the collective\'s position.',
  },
  {
    icon: '🌾',
    name: 'Farmers Cooperative',
    scale: '1,000 producers',
    description: 'A producer cooperative gives every farm their own farm shop — CSA box subscriptions, market pre-orders, local delivery. The cooperative owns the platform.',
    memberWin: 'Farmers sell direct to consumers without building their own webshop. Subscription revenue they could not access before.',
    networkWin: 'The cooperative owns the customer data, the distribution infrastructure, and the brand relationship with end consumers.',
  },
  {
    icon: '🏪',
    name: 'Franchise Group',
    scale: '150 locations',
    description: 'A franchise group gives every franchisee a localised commerce platform within the brand\'s framework. The franchisor controls range, pricing floors, and brand compliance centrally.',
    memberWin: 'Franchisees run their local commerce without building a separate online presence. Everything integrated with their daily operations.',
    networkWin: 'The franchisor has one view of every location\'s performance, inventory, and customer behaviour. Compliance enforced by the platform, not by audits.',
  },
  {
    icon: '⚽',
    name: 'Sports Federation',
    scale: '400 clubs',
    description: 'A sports federation gives every affiliated club a commerce platform for memberships, merchandise, event tickets, and facility access.',
    memberWin: 'Clubs monetise their community with subscriptions, merchandise, and event ticketing — all in one place, no technical setup required.',
    networkWin: 'The federation sees aggregate revenue across the sport, identifies underperforming clubs early, and benchmarks commercial best practices across the network.',
  },
];
---

<section class="section pb-sectors fade-in" aria-labelledby="pb-sectors-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">Sector Examples</span>
      <h2 class="headline-lg" id="pb-sectors-title">
        Every network has the same problem.<br />
        <span class="pb-headline-accent">Every sector has the same answer.</span>
      </h2>
      <p class="text-lg">
        The specifics differ. The commercial logic does not.
        You have a network. Your members need commerce infrastructure. Pagayo connects both.
      </p>
    </div>

    <div class="pb-sectors-list">
      {sectors.map((sector, i) => (
        <article class="pb-sector-card" style={`--sector-delay: ${i * 0.05}s`}>
          <div class="pb-sector-header">
            <span class="pb-sector-icon" aria-hidden="true">{sector.icon}</span>
            <div class="pb-sector-meta">
              <h3>{sector.name}</h3>
              <span class="pb-sector-scale">{sector.scale}</span>
            </div>
          </div>
          <p class="pb-sector-desc">{sector.description}</p>
          <div class="pb-sector-wins">
            <div class="pb-sector-win">
              <span class="pb-sector-win-label">Member win</span>
              <p>{sector.memberWin}</p>
            </div>
            <div class="pb-sector-win pb-sector-win--network">
              <span class="pb-sector-win-label pb-sector-win-label--network">Network win</span>
              <p>{sector.networkWin}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pb-sectors-list {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .pb-sectors-list > :last-child:nth-child(odd) {
    grid-column: 1 / -1;
    max-width: 640px;
    margin: 0 auto;
    width: 100%;
  }

  .pb-sector-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s;
  }

  .pb-sector-card:hover {
    border-color: rgba(96, 165, 250, 0.3);
  }

  .pb-sector-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pb-sector-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .pb-sector-meta h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.2rem;
    line-height: 1.2;
  }

  .pb-sector-scale {
    font-size: 0.8rem;
    color: var(--pb-network);
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .pb-sector-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .pb-sector-wins {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin-top: auto;
  }

  .pb-sector-win {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .pb-sector-win p {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .pb-sector-win-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }

  .pb-sector-win-label--network {
    color: var(--pb-network);
  }

  .pb-sector-win--network p {
    color: var(--text-secondary);
  }

  @media (max-width: 800px) {
    .pb-sectors-list {
      grid-template-columns: 1fr;
    }

    .pb-sectors-list > :last-child:nth-child(odd) {
      max-width: none;
    }
  }
</style>
