---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['sectors'];
}

const { content: t } = Astro.props;
---

<section class="section pb-sectors fade-in" aria-labelledby="pb-sectors-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-sectors-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-sectors-list">
      {t.items.map((sector, i) => (
        <article class="pb-sector-card" style={`--sector-delay: ${i * 0.05}s`}>
          <div class="pb-sector-header">
            <span class="pb-sector-icon" aria-hidden="true">{sector.icon}</span>
            <div class="pb-sector-meta">
              <h3>{sector.name}</h3>
              <span class="pb-sector-scale">{sector.scale}</span>
            </div>
          </div>
          <p class="pb-sector-desc">{sector.description}</p>
          <div class="pb-sector-wins">
            <div class="pb-sector-win">
              <span class="pb-sector-win-label">{t.memberWinLabel}</span>
              <p>{sector.memberWin}</p>
            </div>
            <div class="pb-sector-win pb-sector-win--network">
              <span class="pb-sector-win-label pb-sector-win-label--network">{t.networkWinLabel}</span>
              <p>{sector.networkWin}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
