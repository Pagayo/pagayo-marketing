---
const memberCapabilities = [
  { icon: '🛒', title: 'Webshop', desc: 'Their own branded webshop, their own products, their own domain. Live in minutes.' },
  { icon: '🖥️', title: 'Point of Sale', desc: 'Take payments anywhere — in store, at markets, at events. No separate hardware required.' },
  { icon: '📱', title: 'QR Ordering', desc: 'Tables, pop-ups, pick-up points, events. Customers scan and order directly.' },
  { icon: '🔄', title: 'Subscriptions', desc: 'Recurring revenue, membership plans, loyalty programmes. Automated billing, automated renewal.' },
  { icon: '💳', title: 'Payments', desc: 'Stripe-powered. Every payment method. Every currency. Everything in one dashboard.' },
  { icon: '📦', title: 'Order Management', desc: 'One view of every order, regardless of channel. Inventory, fulfilment, returns.' },
];

const networkCapabilities = [
  { icon: '📊', title: 'Network Dashboard', desc: 'Every member, their activity, their growth. One view across the entire network.' },
  { icon: '✅', title: 'Activation Tracking', desc: 'See who is live, who is not, and what is blocking the ones who are not.' },
  { icon: '📈', title: 'Network Analytics', desc: 'Aggregate GMV, channel mix, top performers, sector benchmarks. Data your competitors do not have.' },
  { icon: '🔍', title: 'Retention Intelligence', desc: 'Identify members whose activity is declining before they leave. Intervene early.' },
  { icon: '🏷️', title: 'Your Brand as the Platform', desc: 'Members experience your network as the platform. Pagayo is the engine underneath.' },
  { icon: '🔗', title: 'Ecosystem Data', desc: 'More active members means better sector insights. The data flywheel compounds as the network grows.' },
];
---

<section class="section pb-deliverables fade-in" aria-labelledby="pb-members-title">
  <div class="container">

    <div class="pb-deliverables-block">
      <div class="section-header center">
        <span class="section-label pb-network-label">For Your Members</span>
        <h2 class="headline-lg" id="pb-members-title">
          A full commerce business.<br />
          <span class="pb-headline-accent">From day one.</span>
        </h2>
        <p class="text-lg">
          Your members do not get a trial account or a starter tool.
          They get a complete commerce platform — every channel, every capability, operational from the moment they activate.
        </p>
      </div>

      <div class="pb-capabilities-grid">
        {memberCapabilities.map((cap) => (
          <article class="pb-capability-card">
            <div class="pb-capability-icon" aria-hidden="true">{cap.icon}</div>
            <h3>{cap.title}</h3>
            <p>{cap.desc}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="pb-deliverables-divider" aria-hidden="true"></div>

    <div class="pb-deliverables-block">
      <div class="section-header center">
        <span class="section-label pb-network-label">For Your Network</span>
        <h2 class="headline-lg" id="pb-network-title">
          The network dashboard<br />
          <span class="pb-headline-accent">your competitors do not have.</span>
        </h2>
        <p class="text-lg">
          Full visibility into your network is the most underestimated commercial advantage in your sector.
          No one else has it. You will.
        </p>
      </div>

      <div class="pb-capabilities-grid">
        {networkCapabilities.map((cap) => (
          <article class="pb-capability-card pb-capability-card--network">
            <div class="pb-capability-icon" aria-hidden="true">{cap.icon}</div>
            <h3>{cap.title}</h3>
            <p>{cap.desc}</p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .pb-deliverables-block {
    padding: var(--section-padding) 0;
  }

  .pb-deliverables-block:first-child {
    padding-top: 0;
  }

  .pb-deliverables-divider {
    height: 1px;
    background: var(--border);
    margin: 0 auto;
    max-width: 480px;
  }

  .pb-capabilities-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pb-capability-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: border-color 0.2s;
  }

  .pb-capability-card--network {
    border-color: rgba(96, 165, 250, 0.15);
  }

  .pb-capability-card:hover {
    border-color: rgba(96, 165, 250, 0.35);
  }

  .pb-capability-icon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    display: block;
  }

  .pb-capability-card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .pb-capability-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 900px) {
    .pb-capabilities-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .pb-capabilities-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
