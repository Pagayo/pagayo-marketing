---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['deliverables'];
}

const { content: t } = Astro.props;
const members = t.members;
const network = t.network;
---

<section class="section pb-deliverables fade-in" aria-labelledby="pb-members-title">
  <div class="container">

    <div class="pb-deliverables-block">
      <div class="section-header center">
        <span class="section-label pb-network-label">{members.sectionLabel}</span>
        <h2 class="headline-lg" id="pb-members-title">
          {members.headlineTop}<br />
          <span class="pb-headline-accent">{members.headlineAccent}</span>
        </h2>
        <p class="text-lg">{members.intro}</p>
      </div>

      <div class="pb-capabilities-grid">
        {members.capabilities.map((cap) => (
          <article class="pb-capability-card">
            <div class="pb-capability-icon" aria-hidden="true">{cap.icon}</div>
            <h3>{cap.title}</h3>
            <p>{cap.desc}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="pb-deliverables-divider" aria-hidden="true"></div>

    <div class="pb-deliverables-block">
      <div class="section-header center">
        <span class="section-label pb-network-label">{network.sectionLabel}</span>
        <h2 class="headline-lg" id="pb-network-title">
          {network.headlineTop}<br />
          <span class="pb-headline-accent">{network.headlineAccent}</span>
        </h2>
        <p class="text-lg">{network.intro}</p>
      </div>

      <div class="pb-capabilities-grid">
        {network.capabilities.map((cap) => (
          <article class="pb-capability-card pb-capability-card--network">
            <div class="pb-capability-icon" aria-hidden="true">{cap.icon}</div>
            <h3>{cap.title}</h3>
            <p>{cap.desc}</p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>
