---
import Button from '../ui/Button.astro';
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['cta'];
  contact: PoweredByContent['contact'];
}

const { content: t, contact } = Astro.props;
---

<section class="section pb-page-cta fade-in">
  <div class="pb-page-cta-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="pb-page-cta-inner">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p>{t.body}</p>
      <div class="pb-cta-buttons">
        <div class="pb-cta-block">
          <Button href={contact.proposal} variant="pb" size="lg">{t.proposal}</Button>
          <span class="pb-cta-hint">{t.proposalHint}</span>
        </div>
        <div class="pb-cta-block">
          <Button href={contact.demo} variant="secondary" size="lg">{t.demo}</Button>
          <span class="pb-cta-hint">{t.demoHint}</span>
        </div>
      </div>
      <p class="pb-cta-note">
        {t.founderExplorePrefix}
        <a href={contact.founderRegister}>{t.founderExplore}</a>
      </p>
    </div>
  </div>
</section>
