---
import type { PoweredByContent } from '../../lib/powered-by-page';

interface Props {
  content: PoweredByContent['execBuyer'];
  contactExec: string;
}

const { content: t, contactExec } = Astro.props;
---

<section class="section pb-exec-buyer fade-in" aria-labelledby="pb-exec-title">
  <div class="container">
    <div class="section-header center">
      <span class="section-label pb-network-label">{t.sectionLabel}</span>
      <h2 class="headline-lg" id="pb-exec-title">
        {t.headlineTop}<br />
        <span class="pb-headline-accent">{t.headlineAccent}</span>
      </h2>
      <p class="text-lg">{t.intro}</p>
    </div>

    <div class="pb-exec-questions">
      {t.questions.map((item, i) => (
        <div class="pb-exec-item">
          <div class="pb-exec-question-wrap">
            <span class="pb-exec-number" aria-hidden="true">0{i + 1}</span>
            <h3 class="pb-exec-question">{item.q}</h3>
          </div>
          <div class="pb-exec-answer-wrap">
            <p class="pb-exec-answer">{item.a}</p>
            <p class="pb-exec-emphasis">{item.emphasis}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="pb-exec-close">
      <div class="pb-exec-close-inner">
        <h3>{t.closeTitle}</h3>
        <p class="pb-exec-close-statement">{t.closeStatement}</p>
        <div class="pb-exec-roles">
          {t.roles.map((role) => (
            <span class="pb-exec-role-tag">{role}</span>
          ))}
        </div>
        <p class="pb-exec-close-cta">
          {t.closeCtaPrefix}
          <a href={contactExec}>{t.closeCtaLink}</a>
        </p>
      </div>
    </div>
  </div>
</section>
