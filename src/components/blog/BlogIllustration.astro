---
type IllustrationKey = "ssr-hydration" | "engineering" | "product" | "industry";

interface Props {
  slug: string;
  category: string;
  className?: string;
}

const { slug, category, className = "" } = Astro.props as Props;

function resolveIllustration(slugValue: string, categoryValue: string): IllustrationKey {
  if (slugValue === "ssr-hydration") return "ssr-hydration";
  switch (categoryValue) {
    case "Product":
      return "product";
    case "Industry":
      return "industry";
    default:
      return "engineering";
  }
}

const illustration = resolveIllustration(slug, category);
const uid = slug.replace(/[^a-z0-9-]/gi, "") || "blog";
---

<div class={`blog-illustration-frame ${className}`.trim()} aria-hidden="true">
  {illustration === "ssr-hydration" && (
    <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id={`${uid}-glow`} cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="#635BFF" stop-opacity="0.32" />
          <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
        </radialGradient>
        <linearGradient id={`${uid}-merge`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#818cf8" />
          <stop offset="100%" stop-color="#06b6d4" />
        </linearGradient>
      </defs>
      <rect width="400" height="320" fill={`url(#${uid}-glow)`} />
      <!-- Server panel -->
      <rect x="40" y="36" width="320" height="108" rx="14" fill="#0f172a" stroke="#635BFF" stroke-width="1.5" />
      <text x="60" y="62" fill="#818cf8" font-size="10" font-weight="700" font-family="ui-monospace, monospace">SERVER HTML</text>
      <rect x="60" y="74" width="200" height="8" rx="2" fill="#1e293b" />
      <rect x="60" y="90" width="160" height="8" rx="2" fill="#1e293b" />
      <rect x="60" y="106" width="120" height="8" rx="2" fill="#334155" />
      <rect x="60" y="122" width="80" height="8" rx="2" fill="#334155" />
      <rect x="280" y="74" width="60" height="54" rx="8" fill="rgba(99,91,255,0.15)" stroke="#635BFF" stroke-width="1" />
      <text x="310" y="106" text-anchor="middle" fill="#818cf8" font-size="9" font-family="ui-monospace, monospace">SSR</text>
      <!-- Hydration bridge -->
      <line x1="200" y1="152" x2="200" y2="168" stroke={`url(#${uid}-merge)`} stroke-width="2" />
      <polygon points="200,168 194,158 206,158" fill="#06b6d4" />
      <circle cx="200" cy="178" r="14" fill="rgba(6,182,212,0.2)" stroke="#06b6d4" stroke-width="1.5" />
      <text x="200" y="182" text-anchor="middle" fill="#67e8f9" font-size="8" font-weight="700" font-family="ui-monospace, monospace">H</text>
      <!-- Client panel -->
      <rect x="40" y="196" width="320" height="88" rx="14" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
      <text x="60" y="222" fill="#67e8f9" font-size="10" font-weight="700" font-family="ui-monospace, monospace">CLIENT JS</text>
      <circle cx="80" cy="248" r="6" fill="#635BFF" />
      <circle cx="110" cy="248" r="6" fill="#818cf8" />
      <circle cx="140" cy="248" r="6" fill="#06b6d4" />
      <line x1="86" y1="248" x2="104" y2="248" stroke="#475569" stroke-width="1" />
      <line x1="116" y1="248" x2="134" y2="248" stroke="#475569" stroke-width="1" />
      <rect x="170" y="238" width="170" height="28" rx="6" fill="rgba(6,182,212,0.12)" stroke="#06b6d4" stroke-width="1" />
      <text x="255" y="256" text-anchor="middle" fill="#cbd5e1" font-size="9" font-family="ui-monospace, monospace">hydrate · attach · listen</text>
    </svg>
  )}

  {illustration === "engineering" && (
    <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id={`${uid}-eng-glow`} cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="#635BFF" stop-opacity="0.28" />
          <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="400" height="320" fill={`url(#${uid}-eng-glow)`} />
      <rect x="60" y="50" width="280" height="220" rx="14" fill="#0f172a" stroke="#635BFF" stroke-width="1.5" />
      <text x="80" y="82" fill="#818cf8" font-size="10" font-weight="700" font-family="ui-monospace, monospace">EDGE WORKER</text>
      {[0, 1, 2, 3].map((row) =>
        [0, 1, 2].map((col) => {
          const isActive = row === 0 && col === 1;
          return (
            <rect
              x={80 + col * 88}
              y={96 + row * 44}
              width="72"
              height="32"
              rx="6"
              fill={isActive ? "rgba(99,91,255,0.25)" : "#1e293b"}
              stroke={isActive ? "#635BFF" : "#334155"}
              stroke-width="1"
            />
          );
        })
      )}
      <line x1="200" y1="200" x2="200" y2="240" stroke="#475569" stroke-width="1.5" />
      <rect x="120" y="240" width="160" height="20" rx="4" fill="rgba(6,182,212,0.15)" stroke="#06b6d4" stroke-width="1" />
      <text x="200" y="254" text-anchor="middle" fill="#67e8f9" font-size="9" font-family="ui-monospace, monospace">cache → kv → d1</text>
    </svg>
  )}

  {illustration === "product" && (
    <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id={`${uid}-prod-glow`} cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.28" />
          <stop offset="100%" stop-color="#06b6d4" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="400" height="320" fill={`url(#${uid}-prod-glow)`} />
      <rect x="80" y="60" width="240" height="200" rx="16" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
      <rect x="100" y="84" width="80" height="80" rx="8" fill="#1e293b" stroke="#334155" />
      <rect x="196" y="88" width="104" height="10" rx="2" fill="#334155" />
      <rect x="196" y="108" width="72" height="10" rx="2" fill="#1e293b" />
      <rect x="196" y="136" width="104" height="28" rx="6" fill="rgba(99,91,255,0.2)" stroke="#635BFF" stroke-width="1" />
      <text x="248" y="154" text-anchor="middle" fill="#818cf8" font-size="10" font-weight="700" font-family="system-ui">Add to cart</text>
      <rect x="100" y="196" width="200" height="44" rx="8" fill="rgba(6,182,212,0.12)" stroke="#06b6d4" stroke-width="1" />
      <text x="200" y="222" text-anchor="middle" fill="#67e8f9" font-size="10" font-family="ui-monospace, monospace">ONE ORDER · ALL CHANNELS</text>
    </svg>
  )}

  {illustration === "industry" && (
    <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id={`${uid}-ind-glow`} cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.22" />
          <stop offset="100%" stop-color="#fbbf24" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="400" height="320" fill={`url(#${uid}-ind-glow)`} />
      <circle cx="200" cy="160" r="90" fill="none" stroke="#1e293b" stroke-width="1" />
      <circle cx="200" cy="160" r="60" fill="none" stroke="#334155" stroke-width="1" stroke-dasharray="4 6" />
      <line x1="200" y1="160" x2="200" y2="70" stroke="#635BFF" stroke-width="1" stroke-opacity="0.5" />
      <line x1="200" y1="160" x2="290" y2="120" stroke="#635BFF" stroke-width="1" stroke-opacity="0.5" />
      <line x1="200" y1="160" x2="260" y2="220" stroke="#635BFF" stroke-width="1" stroke-opacity="0.5" />
      <line x1="200" y1="160" x2="140" y2="220" stroke="#635BFF" stroke-width="1" stroke-opacity="0.5" />
      <line x1="200" y1="160" x2="110" y2="120" stroke="#635BFF" stroke-width="1" stroke-opacity="0.5" />
      <circle cx="200" cy="70" r="8" fill="#635BFF" />
      <circle cx="290" cy="120" r="6" fill="#818cf8" />
      <circle cx="260" cy="220" r="6" fill="#818cf8" />
      <circle cx="140" cy="220" r="6" fill="#818cf8" />
      <circle cx="110" cy="120" r="6" fill="#818cf8" />
      <circle cx="200" cy="160" r="10" fill="#06b6d4" />
      <text x="200" y="300" text-anchor="middle" fill="#94a3b8" font-size="9" font-family="ui-monospace, monospace">global commerce network</text>
    </svg>
  )}
</div>
