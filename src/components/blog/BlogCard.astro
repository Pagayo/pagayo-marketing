---
import BlogIllustration from "./BlogIllustration.astro";

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  authorName: string;
  authorRole: string;
  variant?: "featured" | "default";
  readLabel?: string;
}

const {
  slug,
  title,
  description,
  category,
  authorName,
  authorRole,
  variant = "default",
  readLabel = "Read article",
} = Astro.props as Props;

const authorInitials = authorName
  .split(" ")
  .slice(0, 2)
  .map((part) => part.charAt(0).toUpperCase())
  .join("");
---

<article class={`blog-card blog-card--${variant} fade-in`}>
  <a href={`/blog/${slug}`} class="blog-card-link">
    <div class="blog-card-body">
      <span class="blog-category-pill">{category}</span>
      <h2 class="blog-card-title">{title}</h2>
      <div class="blog-card-author-row">
        <span class="blog-card-avatar" aria-hidden="true">{authorInitials}</span>
        <div class="blog-card-author-info">
          <span class="blog-card-author">{authorName}</span>
          <span class="blog-card-role">{authorRole}</span>
        </div>
      </div>
      <p class="blog-card-excerpt">{description}</p>
      <span class="blog-card-cta">{readLabel} →</span>
    </div>
    <BlogIllustration slug={slug} category={category} className="blog-card-visual" />
  </a>
</article>
