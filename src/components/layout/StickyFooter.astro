---
import type { Locale, Messages } from '../../lib/i18n';

interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const nav = t.nav;
---
<div class="sticky-footer" id="sticky-footer">
  <div class="sticky-footer-inner">
    <a href="https://start.pagayo.app/login" class="btn btn-secondary sticky-footer-btn">{nav.login}</a>
    <a href="https://start.pagayo.app/register" class="btn btn-secondary sticky-footer-btn">{nav.start}</a>
  </div>
</div>
