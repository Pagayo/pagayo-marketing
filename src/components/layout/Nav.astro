---
import i18nEn from '../../content/i18n/en.json';

const nav = i18nEn.nav;
---
<nav class="nav scrolled" id="nav">
  <div class="container">
    <a href="/" class="nav-logo">Pagayo<span>.</span></a>

    <ul class="nav-links">
      <li><a href="#features">{nav.features}</a></li>
      <li><a href="#gyms">{nav.gyms}</a></li>
      <li><a href="#pricing">{nav.pricing}</a></li>
      <li><a href="#impact">{nav.impact}</a></li>
      <li><a href="#partners">{nav.partners}</a></li>
    </ul>

    <div class="nav-actions">
      <select class="nav-lang" aria-label="Language">
        <option value="en">EN</option>
        <option value="nl">NL</option>
        <option value="de">DE</option>
        <option value="fr">FR</option>
        <option value="es">ES</option>
      </select>
      <a href="https://start.pagayo.app/login" class="btn btn-secondary nav-btn">{nav.login}</a>
      <a href="https://start.pagayo.app/register" class="btn btn-primary nav-btn">{nav.start}</a>
    </div>

    <button class="nav-toggle" aria-label="Menu">&#9776;</button>
  </div>
</nav>
