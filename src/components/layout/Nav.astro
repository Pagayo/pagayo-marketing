    <a href="/" class="nav-logo">Pagayo<span>.</span><span class="nav-country" id="nav-country"></span></a>

    <ul class="nav-links" id="nav-links">
      <li><a href="/one-stack">{nav.oneStack}</a></li>
      <li><a href="/features">{nav.features}</a></li>
      <li><a href="/how-we-build">{nav.howWeBuild}</a></li>
      <li><a href="/pricing">{nav.pricing}</a></li>
