---
import type { Locale, Messages } from '../../lib/i18n';
import { hrefFor, localizedPath, type LocalizedPageId } from '../../lib/locale-routes';

interface Props {
  locale: Locale;
  t: Messages;
  alternatePageId?: LocalizedPageId;
}

const { locale, t, alternatePageId } = Astro.props;
const f = t.footer;
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="nav-logo">Pagayo<span>.</span></div>
        <p>{f.brandTagline}</p>
      </div>

      <div class="footer-col">
        <h4>{f.productHeading}</h4>
        <ul>
          <li><a href="/features">{f.features}</a></li>
          <li><a href={hrefFor('pricing', locale)}>{f.pricing}</a></li>
          <li><a href={hrefFor('howWeBuild', locale)}>{f.howWeBuild}</a></li>
          <li><a href="/changelog">{f.changelog}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{f.programsHeading}</h4>
        <ul>
          <li><a href={hrefFor('impact', locale)}>{f.impactEngine}</a></li>
          <li><a href="/powered-by">{f.poweredBy}</a></li>
          <li><a href="/partners">{f.partners}</a></li>
          <li><a href="/success-stories">{f.successStories}</a></li>
          <li><a href="/blog">{f.blog}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{f.companyHeading}</h4>
        <ul>
          <li><a href="/about">{f.about}</a></li>
          <li><a href={hrefFor('howWeBuild', locale)}>{f.howWeBuildLink}</a></li>
          <li><a href="/build-log">{f.buildLog}</a></li>
          <li><a href="/built-on-giants">{f.builtOnGiants}</a></li>
          <li><a href="/one-stack">{f.oneStack}</a></li>
          <li><a href="/privacy-policy">{f.privacyPolicy}</a></li>
          <li><a href="/terms-of-service">{f.termsOfService}</a></li>
          <li><a href="/contact">{f.contact}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>{f.copyright}</span>
      <select
        class="footer-lang"
        aria-label={f.languageLabel}
        data-footer-lang
        data-current-page={alternatePageId ?? ''}
      >
        <option value="en" data-href={alternatePageId ? localizedPath(alternatePageId, 'en') : '/'} selected={locale === 'en'}>EN</option>
        <option value="nl" data-href={alternatePageId ? localizedPath(alternatePageId, 'nl') : '/nl/'} selected={locale === 'nl'}>NL</option>
        <option value="de" data-href={alternatePageId ? localizedPath(alternatePageId, 'de') : '/'} disabled>DE</option>
      </select>
      <div class="footer-social">
        <a href="#" aria-label="Twitter/X">𝕏</a>
        <a href="#" aria-label="LinkedIn">in</a>
        <a href="#" aria-label="TikTok">♪</a>
        <a href="#" aria-label="Instagram">📷</a>
      </div>
    </div>
  </div>
</footer>
