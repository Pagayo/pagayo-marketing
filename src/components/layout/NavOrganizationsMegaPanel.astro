---
import i18nEn from '../../content/i18n/en.json';

const menu = i18nEn.nav.organizationsMenu;
---

<div
  class="nav-mega-panel"
  id="nav-orgs-menu"
  data-nav-mega-panel
  role="region"
  aria-labelledby="nav-orgs-trigger"
  aria-hidden="true"
>
  <div class="container nav-mega-inner">
    <div class="nav-mega-grid">
      <a href="/organizations" class="nav-mega-card nav-mega-card--org">
        <span class="nav-mega-label">{menu.organization.label}</span>
        <h3 class="nav-mega-title">{menu.organization.title}</h3>
        <p class="nav-mega-desc">{menu.organization.description}</p>
        <span class="btn btn-org btn-sm">{menu.organization.cta}</span>
      </a>

      <a href="/impact" class="nav-mega-card nav-mega-card--impact">
        <span class="nav-mega-label">{menu.impact.label}</span>
        <h3 class="nav-mega-title">{menu.impact.title}</h3>
        <p class="nav-mega-desc">{menu.impact.description}</p>
        <span class="btn btn-ngo btn-sm">{menu.impact.cta}</span>
      </a>

      <a href="/powered-by" class="nav-mega-card nav-mega-card--powered">
        <span class="nav-mega-label">{menu.poweredBy.label}</span>
        <h3 class="nav-mega-title">{menu.poweredBy.title}</h3>
        <p class="nav-mega-desc">{menu.poweredBy.description}</p>
        <span class="btn btn-pb btn-sm">{menu.poweredBy.cta}</span>
      </a>
    </div>
  </div>
</div>
