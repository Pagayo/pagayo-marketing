---
import type { Messages } from '../../lib/i18n';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
const { nav } = t;
---

<li class="nav-mega-item">
  <button
    type="button"
    class="nav-mega-trigger"
    data-nav-mega-trigger
    aria-expanded="false"
    aria-controls="nav-orgs-menu"
    aria-haspopup="true"
    id="nav-orgs-trigger"
  >
    {nav.organizations}
    <span class="nav-mega-chevron" aria-hidden="true"></span>
  </button>
</li>
