---
import FinalCta from '../sections/FinalCta.astro';
import type { BuiltOnGiantsContent } from '../../lib/built-on-giants-page';
import type { Locale } from '../../lib/i18n';

interface Props {
  content: BuiltOnGiantsContent;
  locale?: Locale;
}

const { content: t, locale = 'en' } = Astro.props;
const giants = t.giants;
---

<main class="giants-page">

    <!-- Hero -->
    <section class="hero section giants-hero" id="hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-orb hero-orb-3"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse"></span>
          {t.hero.badge}
        </div>

        <h1 class="headline-xl">
          {t.hero.headlineTop}<br />
          <span class="text-gradient">{t.hero.headlineGradient}</span>.
        </h1>

        <p>
          {t.hero.intro}
        </p>

        <!-- Constellation of giants -->
        <div class="constellation" aria-hidden="true">
          <svg viewBox="0 0 800 220" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="conLine" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#6366f1" stop-opacity="0.05" />
                <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#6366f1" stop-opacity="0.05" />
              </linearGradient>
            </defs>
            <path d="M 60 110 Q 200 30, 340 110 T 620 110 T 740 110"
              stroke="url(#conLine)" stroke-width="1.5" fill="none" />
            <g transform="translate(60,110)">
              <circle r="22" fill="rgba(243, 128, 32, 0.15)" stroke="#F38020" stroke-width="1.5" />
              <text y="5" text-anchor="middle" fill="#F38020" font-size="11" font-weight="600" font-family="ui-monospace, monospace">CF</text>
            </g>
            <g transform="translate(200,80)">
              <circle r="22" fill="rgba(99, 91, 255, 0.18)" stroke="#635BFF" stroke-width="1.5" />
              <text y="5" text-anchor="middle" fill="#818cf8" font-size="11" font-weight="600" font-family="ui-monospace, monospace">St</text>
            </g>
            <g transform="translate(340,110)">
              <circle r="22" fill="rgba(139, 148, 158, 0.2)" stroke="#8b949e" stroke-width="1.5" />
              <text y="5" text-anchor="middle" fill="#c9d1d9" font-size="11" font-weight="600" font-family="ui-monospace, monospace">Gh</text>
            </g>
            <g transform="translate(480,80)">
              <circle r="22" fill="rgba(16, 163, 127, 0.18)" stroke="#10a37f" stroke-width="1.5" />
              <text y="5" text-anchor="middle" fill="#10a37f" font-size="11" font-weight="600" font-family="ui-monospace, monospace">AI</text>
            </g>
            <g transform="translate(620,110)">
              <circle r="22" fill="rgba(6, 182, 212, 0.18)" stroke="#06b6d4" stroke-width="1.5" />
              <text y="5" text-anchor="middle" fill="#06b6d4" font-size="11" font-weight="600" font-family="ui-monospace, monospace">Cu</text>
            </g>
            <g transform="translate(740,110)">
              <circle r="22" fill="rgba(217, 119, 87, 0.18)" stroke="#d97757" stroke-width="1.5" />
              <text y="5" text-anchor="middle" fill="#d97757" font-size="11" font-weight="600" font-family="ui-monospace, monospace">Cl</text>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <!-- Giants showcase -->
    <section class="section giants-showcase">
      <div class="container">
        {giants.map((g, idx) => (
          <article
            class={`giant-row ${idx % 2 === 1 ? 'reverse' : ''}`}
            id={g.slug}
            style={`--accent: ${g.accent}; --accent-soft: ${g.accentSoft};`}
          >
            <div class="giant-text">
              <div class="giant-meta">
                <span class="giant-tag">{g.tag}</span>
                <span class="giant-role">{g.role}</span>
              </div>
              <h2 class="giant-name">{g.name}</h2>
              <p class="giant-tagline">{g.tagline}</p>
              <p class="giant-body">{g.body}</p>
              <ul class="giant-bullets">
                {g.bullets.map((b) => (
                  <li><span class="bullet-dot"></span>{b}</li>
                ))}
              </ul>
              <a class="giant-link" href={`/${g.slug}`}>
                {t.giantLinkTemplate.replace('{name}', g.name)}
              </a>
            </div>

            <div class="giant-visual">
              <div class="visual-frame">
                {g.slug === 'cloudflare' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="cfGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#F38020" stop-opacity="0.45" />
                        <stop offset="100%" stop-color="#F38020" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <circle cx="200" cy="160" r="120" fill="url(#cfGlow)" />
                    <circle cx="200" cy="160" r="85" fill="none" stroke="#F38020" stroke-width="1.2" stroke-opacity="0.55" />
                    <ellipse cx="200" cy="160" rx="85" ry="32" fill="none" stroke="#F38020" stroke-width="1" stroke-opacity="0.35" />
                    <ellipse cx="200" cy="160" rx="55" ry="85" fill="none" stroke="#F38020" stroke-width="1" stroke-opacity="0.35" />
                    <ellipse cx="200" cy="160" rx="85" ry="60" fill="none" stroke="#F38020" stroke-width="1" stroke-opacity="0.25" />
                    <line x1="115" y1="160" x2="285" y2="160" stroke="#F38020" stroke-width="1" stroke-opacity="0.35" />
                    <line x1="200" y1="75" x2="200" y2="245" stroke="#F38020" stroke-width="1" stroke-opacity="0.35" />
                    <circle cx="120" cy="120" r="4" fill="#F38020" />
                    <circle cx="280" cy="135" r="4" fill="#F38020" />
                    <circle cx="160" cy="220" r="4" fill="#F38020" />
                    <circle cx="245" cy="210" r="4" fill="#F38020" />
                    <circle cx="200" cy="80" r="4" fill="#F38020" />
                    <circle cx="200" cy="160" r="6" fill="#F38020" />
                    <circle cx="200" cy="160" r="50" fill="none" stroke="#F38020" stroke-width="0.8" stroke-opacity="0.4" />
                    <circle cx="200" cy="160" r="100" fill="none" stroke="#F38020" stroke-width="0.8" stroke-opacity="0.2" />
                  </svg>
                )}

                {g.slug === 'stripe' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <linearGradient id="stCard1" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#635BFF" />
                        <stop offset="100%" stop-color="#818cf8" />
                      </linearGradient>
                      <linearGradient id="stCard2" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#06b6d4" />
                        <stop offset="100%" stop-color="#6366f1" />
                      </linearGradient>
                      <radialGradient id="stGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.4" />
                        <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <circle cx="200" cy="160" r="140" fill="url(#stGlow)" />
                    <g transform="translate(90,90) rotate(-8 110 70)">
                      <rect width="220" height="135" rx="14" fill="url(#stCard2)" opacity="0.85" />
                      <rect x="22" y="32" width="36" height="26" rx="4" fill="#fff" fill-opacity="0.85" />
                      <rect x="22" y="76" width="120" height="6" rx="3" fill="#fff" fill-opacity="0.55" />
                      <rect x="22" y="90" width="80" height="6" rx="3" fill="#fff" fill-opacity="0.35" />
                    </g>
                    <g transform="translate(110,115) rotate(6 110 70)">
                      <rect width="220" height="135" rx="14" fill="url(#stCard1)" />
                      <rect x="22" y="32" width="36" height="26" rx="4" fill="#fff" fill-opacity="0.95" />
                      <rect x="22" y="76" width="160" height="8" rx="4" fill="#fff" fill-opacity="0.75" />
                      <rect x="22" y="92" width="110" height="6" rx="3" fill="#fff" fill-opacity="0.5" />
                      <text x="172" y="120" text-anchor="end" fill="#fff" font-size="14" font-weight="700" font-family="system-ui">VISA</text>
                    </g>
                    <circle cx="60" cy="60" r="6" fill="#818cf8" />
                    <circle cx="350" cy="80" r="4" fill="#06b6d4" />
                    <circle cx="340" cy="260" r="5" fill="#635BFF" />
                    <circle cx="70" cy="270" r="4" fill="#818cf8" />
                  </svg>
                )}

                {g.slug === 'github' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="ghGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#8b949e" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#8b949e" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#ghGlow)" />
                    <path d="M 60 240 L 60 80" stroke="#c9d1d9" stroke-width="2" stroke-opacity="0.6" />
                    <path d="M 60 200 Q 60 160, 140 160 L 200 160" stroke="#06b6d4" stroke-width="2" stroke-opacity="0.7" fill="none" />
                    <path d="M 200 160 Q 280 160, 280 100 L 280 60" stroke="#10a37f" stroke-width="2" stroke-opacity="0.7" fill="none" />
                    <path d="M 60 130 Q 60 100, 140 100 L 200 100 Q 280 100, 280 160 L 280 240" stroke="#d97757" stroke-width="2" stroke-opacity="0.7" fill="none" />
                    <circle cx="60" cy="240" r="8" fill="#c9d1d9" />
                    <circle cx="60" cy="200" r="8" fill="#c9d1d9" />
                    <circle cx="60" cy="130" r="8" fill="#c9d1d9" />
                    <circle cx="60" cy="80" r="8" fill="#c9d1d9" />
                    <circle cx="200" cy="160" r="8" fill="#06b6d4" />
                    <circle cx="200" cy="100" r="8" fill="#d97757" />
                    <circle cx="280" cy="60" r="8" fill="#10a37f" />
                    <circle cx="280" cy="240" r="8" fill="#d97757" />
                    <text x="80" y="84" fill="#c9d1d9" font-size="11" font-family="ui-monospace, monospace">main</text>
                    <text x="220" y="64" fill="#10a37f" font-size="11" font-family="ui-monospace, monospace">feature/giants</text>
                    <text x="220" y="164" fill="#06b6d4" font-size="11" font-family="ui-monospace, monospace">staging</text>
                    <text x="300" y="244" fill="#d97757" font-size="11" font-family="ui-monospace, monospace">fix/copy</text>
                    <circle cx="340" cy="60" r="14" fill="#10a37f" />
                    <path d="M 333 60 L 338 65 L 347 56" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}

                {g.slug === 'openai' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="oaGlow" cx="50%" cy="50%" r="55%">
                        <stop offset="0%" stop-color="#10a37f" stop-opacity="0.45" />
                        <stop offset="100%" stop-color="#10a37f" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <circle cx="200" cy="160" r="140" fill="url(#oaGlow)" />
                    <g stroke="#10a37f" stroke-width="1.2" fill="none" stroke-opacity="0.55">
                      <polygon points="200,80 240,103 240,150 200,173 160,150 160,103" />
                      <polygon points="120,127 160,150 160,197 120,220 80,197 80,150" />
                      <polygon points="280,127 320,150 320,197 280,220 240,197 240,150" />
                      <polygon points="200,173 240,196 240,243 200,266 160,243 160,196" />
                    </g>
                    <circle cx="200" cy="80" r="6" fill="#10a37f" />
                    <circle cx="240" cy="150" r="6" fill="#10a37f" />
                    <circle cx="160" cy="150" r="6" fill="#10a37f" />
                    <circle cx="200" cy="173" r="8" fill="#10a37f" />
                    <circle cx="120" cy="127" r="5" fill="#10a37f" opacity="0.7" />
                    <circle cx="280" cy="127" r="5" fill="#10a37f" opacity="0.7" />
                    <circle cx="200" cy="266" r="5" fill="#10a37f" opacity="0.7" />
                    <circle cx="80" cy="197" r="4" fill="#10a37f" opacity="0.5" />
                    <circle cx="320" cy="197" r="4" fill="#10a37f" opacity="0.5" />
                    <circle cx="200" cy="173" r="20" fill="none" stroke="#10a37f" stroke-width="1" stroke-opacity="0.5" />
                    <circle cx="200" cy="173" r="40" fill="none" stroke="#10a37f" stroke-width="0.8" stroke-opacity="0.3" />
                  </svg>
                )}

                {g.slug === 'cursor' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="cuGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="#06b6d4" stop-opacity="0" />
                      </radialGradient>
                      <linearGradient id="cuCursor" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#06b6d4" />
                        <stop offset="100%" stop-color="#6366f1" />
                      </linearGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#cuGlow)" />
                    <rect x="50" y="50" width="300" height="220" rx="12" fill="#0f172a" stroke="#06b6d4" stroke-opacity="0.4" stroke-width="1.5" />
                    <rect x="50" y="50" width="300" height="28" rx="12" fill="#1e293b" />
                    <circle cx="68" cy="64" r="4" fill="#f87171" />
                    <circle cx="82" cy="64" r="4" fill="#fbbf24" />
                    <circle cx="96" cy="64" r="4" fill="#34d399" />
                    <text x="200" y="68" text-anchor="middle" fill="#64748b" font-size="10" font-family="ui-monospace, monospace">about.astro</text>
                    <g font-family="ui-monospace, monospace" font-size="11">
                      <text x="70" y="105" fill="#94a3b8">1</text>
                      <text x="92" y="105" fill="#c084fc">const</text>
                      <text x="132" y="105" fill="#67e8f9">pagayo</text>
                      <text x="180" y="105" fill="#94a3b8">=</text>
                      <text x="194" y="105" fill="#fbbf24">{'{'}</text>
                      <text x="70" y="125" fill="#94a3b8">2</text>
                      <text x="100" y="125" fill="#67e8f9">name</text>
                      <text x="135" y="125" fill="#94a3b8">:</text>
                      <text x="146" y="125" fill="#86efac">'Pagayo'</text>
                      <text x="70" y="145" fill="#94a3b8">3</text>
                      <text x="100" y="145" fill="#67e8f9">stack</text>
                      <text x="138" y="145" fill="#94a3b8">:</text>
                      <text x="149" y="145" fill="#86efac">'Cloudflare'</text>
                      <text x="70" y="165" fill="#94a3b8">4</text>
                      <text x="100" y="165" fill="#67e8f9">ships</text>
                      <text x="138" y="165" fill="#94a3b8">:</text>
                      <text x="149" y="165" fill="#86efac">'weekly'</text>
                      <text x="70" y="185" fill="#94a3b8">5</text>
                      <text x="92" y="185" fill="#fbbf24">{'}'}</text>
                    </g>
                    <rect x="124" y="176" width="2.5" height="14" fill="url(#cuCursor)" />
                    <rect x="135" y="178" width="120" height="14" rx="3" fill="#06b6d4" fill-opacity="0.15" stroke="#06b6d4" stroke-opacity="0.5" stroke-width="0.8" stroke-dasharray="3,3" />
                    <text x="142" y="189" fill="#06b6d4" font-size="10" font-family="ui-monospace, monospace" opacity="0.85">.publish()</text>
                    <rect x="50" y="242" width="300" height="28" rx="0" fill="#0b1220" />
                    <circle cx="68" cy="256" r="4" fill="#10a37f" />
                    <text x="80" y="260" fill="#94a3b8" font-size="10" font-family="ui-monospace, monospace">{t.visuals.cursorAgents}</text>
                    <text x="330" y="260" text-anchor="end" fill="#06b6d4" font-size="10" font-family="ui-monospace, monospace">{t.visuals.cursorReady}</text>
                  </svg>
                )}

                {g.slug === 'claude' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="clGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#d97757" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="#d97757" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#clGlow)" />
                    <g transform="translate(60,60)">
                      <rect width="220" height="60" rx="14" fill="#1e293b" stroke="#334155" stroke-width="1" />
                      <rect x="18" y="18" width="160" height="6" rx="3" fill="#cbd5e1" />
                      <rect x="18" y="32" width="120" height="6" rx="3" fill="#94a3b8" />
                    </g>
                    <g transform="translate(120,140)">
                      <rect width="240" height="80" rx="14" fill="#d97757" fill-opacity="0.15" stroke="#d97757" stroke-width="1" />
                      <rect x="18" y="18" width="180" height="6" rx="3" fill="#fbbf24" fill-opacity="0.75" />
                      <rect x="18" y="32" width="200" height="6" rx="3" fill="#fdba74" fill-opacity="0.6" />
                      <rect x="18" y="46" width="140" height="6" rx="3" fill="#fdba74" fill-opacity="0.45" />
                      <circle cx="-16" cy="40" r="14" fill="#d97757" />
                      <text x="-16" y="44" text-anchor="middle" fill="#fff" font-size="11" font-weight="700" font-family="system-ui">C</text>
                    </g>
                    <g transform="translate(120,240)">
                      <rect width="80" height="32" rx="14" fill="#d97757" fill-opacity="0.12" stroke="#d97757" stroke-opacity="0.5" stroke-width="1" />
                      <circle cx="22" cy="16" r="3" fill="#d97757" opacity="0.6" />
                      <circle cx="40" cy="16" r="3" fill="#d97757" opacity="0.8" />
                      <circle cx="58" cy="16" r="3" fill="#d97757" />
                    </g>
                    <g transform="translate(320,80)">
                      <path d="M 0 -14 L 3 -3 L 14 0 L 3 3 L 0 14 L -3 3 L -14 0 L -3 -3 Z" fill="#fbbf24" opacity="0.9" />
                    </g>
                  </svg>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Closing -->
    <section class="section giants-closing fade-in">
      <div class="container narrow">
        <span class="section-label">{t.closing.sectionLabel}</span>
        <h2 class="headline-md">{t.closing.headline}</h2>
        {t.closing.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </section>

    <FinalCta locale={locale} />
  </main>
