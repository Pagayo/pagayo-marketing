---
import Button from '../ui/Button.astro';
---
<section class="hero section" id="hero">
  <div class="hero-bg">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="pulse"></span>
      Independent. Bootstrapped. Free to start.
    </div>

    <h1 class="headline-xl">
      One platform.<br />
      <span class="text-gradient">Every way you sell.</span>
    </h1>

    <p>
      Webshop, register, subscriptions, memberships, sponsored access —
      built on one Order, so the numbers always match. The same platform
      for a shop in Nairobi and a chain in Amsterdam.
    </p>

    <div class="hero-ctas">
      <Button href="https://start.pagayo.app/register" variant="primary" size="lg">Start Free →</Button>
      <Button href="#pricing" variant="secondary" size="lg">See Pricing</Button>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
        <div class="hero-stat-number">0%</div>
        <div class="hero-stat-label">Transaction Fee</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-number">7+</div>
        <div class="hero-stat-label">Sales Channels</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-number">&lt;50ms</div>
        <div class="hero-stat-label">Anywhere on Earth</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-number">€0</div>
        <div class="hero-stat-label">To Get Started</div>
      </div>
    </div>
  </div>
</section>
