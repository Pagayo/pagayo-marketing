---
import Button from '../ui/Button.astro';
import { DEFAULT_LOCALE, loadMessages, type Locale, type Messages } from '../../lib/i18n';
import { hrefFor } from '../../lib/locale-routes';

interface Props {
  locale?: Locale;
  home?: Messages['homePage'];
}

const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const home = Astro.props.home ?? loadMessages(locale).homePage;
const { hero } = home;
const pricingHref = `${hrefFor('pricing', locale)}#pricing`;
---
<section class="hero section" id="hero">
  <div class="hero-bg">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="pulse"></span>
      {hero.badge}
    </div>

    <h1 class="headline-xl">
      {hero.titleTop}<br />
      <span class="text-gradient">{hero.titleGradient}</span>
    </h1>

    <p>{hero.intro}</p>

    <div class="hero-ctas">
      <Button href="https://start.pagayo.app/register" variant="primary" size="lg">{hero.ctaPrimary}</Button>
      <Button href={pricingHref} variant="secondary" size="lg">{hero.ctaSecondary}</Button>
    </div>

    <div class="hero-stats">
      {hero.stats.map((stat) => (
        <div class="hero-stat">
          <div class="hero-stat-number">{stat.number}</div>
          <div class="hero-stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
