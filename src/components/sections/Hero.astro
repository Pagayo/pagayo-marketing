---
import Button from '../ui/Button.astro';
---
<section class="hero section" id="hero">
  <div class="hero-bg">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="pulse"></span>
      Free forever — no credit card required
    </div>

    <h1 class="headline-xl">
      Every sale.<br />
      <span class="text-gradient">One platform.</span>
    </h1>

    <p>
      Webshop, point of sale, WhatsApp, QR&nbsp;ordering —
      all your transactions flow into one&nbsp;dashboard.
      Free forever, or&nbsp;upgrade from just&nbsp;€4/month.
    </p>

    <div class="hero-ctas">
      <Button href="https://start.pagayo.app/register" variant="primary" size="lg">Start Free →</Button>
      <Button href="#pricing" variant="secondary" size="lg">See Pricing</Button>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
        <div class="hero-stat-number">7+</div>
        <div class="hero-stat-label">Sales Channels</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-number">99.99%</div>
        <div class="hero-stat-label">Uptime</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-number">&lt;50ms</div>
        <div class="hero-stat-label">Global Response</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-number">€0</div>
        <div class="hero-stat-label">To Start</div>
      </div>
    </div>
  </div>
</section>
