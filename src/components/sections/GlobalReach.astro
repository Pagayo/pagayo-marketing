---
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['globalReach'];
}

const content = Astro.props.content ?? loadHome('en').globalReach;
---
<section class="section global-section fade-in">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">{content.label}</span>
      <h2 class="headline-lg">
        {content.headline}<br />
        {content.headlineLine2}
      </h2>
      <p class="text-lg">
        {content.intro}
      </p>
    </div>

    <div class="global-map">
      <div class="global-map-dots"></div>
      <div class="global-map-label">
        <div class="number text-gradient">{content.map.number}</div>
        <div class="text">{content.map.label}</div>
      </div>
    </div>

    <div class="global-stats">
      {content.stats.map((stat) => (
        <div class="global-stat">
          <div class="value">{stat.value}</div>
          <div class="label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
