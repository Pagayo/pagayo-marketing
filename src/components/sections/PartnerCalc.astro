---
import Button from '../ui/Button.astro';
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['partnerCalc'];
}

const content = Astro.props.content ?? loadHome('en').partnerCalc;
---
<section class="section fade-in" id="partners" style="background:var(--bg-surface);">
  <div class="container">
    <div class="section-header center">
      <span class="section-label" style="background:var(--partner-violet-glow);color:var(--partner-violet);border-color:rgba(168,85,247,0.2);">
        {content.label}
      </span>
      <h2 class="headline-lg">
        {content.headline}<br />
        <span style="color:var(--partner-violet);">{content.headlineAccent}</span>
      </h2>
      <p class="text-lg">
        {content.intro}
      </p>
    </div>

    <div class="partner-calc">
      <h3>{content.calcTitle}</h3>
      <div class="partner-examples">
        {content.examples.map((example) => (
          <div class={`partner-example ${example.highlight ? 'partner-highlight' : ''}`.trim()}>
            <span class="scenario">{example.scenario}</span>
            <span class="arrow">→</span>
            <span class="earning">{example.earning}</span>
          </div>
        ))}
      </div>
    </div>

    <div style="text-align:center;margin-top:3rem;">
      <Button href={content.ctaHref} variant="partner" size="lg">{content.cta}</Button>
      <p style="margin-top:1rem;font-size:0.85rem;color:var(--text-muted);">
        {content.footnote}
      </p>
    </div>
  </div>
</section>
