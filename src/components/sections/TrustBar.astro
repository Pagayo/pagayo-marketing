---
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['trustBar'];
}

const content = Astro.props.content ?? loadHome('en').trustBar;
---
<div class="logobar">
  <div class="container">
    <div class="logobar-inner">
      {content.items.map((item) => <span class="logobar-item">{item}</span>)}
    </div>
  </div>
</div>
