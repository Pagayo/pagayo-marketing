---
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['manifesto'];
}

const content = Astro.props.content ?? loadHome('en').manifesto;
---
<section class="section manifesto-section fade-in" id="why-pagayo" aria-labelledby="why-pagayo-heading">
  <div class="container manifesto-container">
    <span class="section-label manifesto-label">
      {content.label}
    </span>

    <h2 class="headline-lg manifesto-headline" id="why-pagayo-heading">
      {content.headline}
    </h2>

    <div class="manifesto-body">
      {content.paragraphs.map((p) => <p>{p}</p>)}

      <p class="manifesto-emphasis">
        {content.emphasis}
      </p>

      {content.paragraphsAfter.map((p) => <p>{p}</p>)}

      <p class="manifesto-close">
        {content.close}
      </p>

      <p class="manifesto-ideas">
        {content.ideas.prefix}
        <a href={content.ideas.href}>{content.ideas.linkText}</a>
      </p>
    </div>
  </div>
</section>
