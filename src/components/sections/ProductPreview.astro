---
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['productPreview'];
}

const content = Astro.props.content ?? loadHome('en').productPreview;

function lines(text: string) {
  return text.split('\n');
}
---
<section class="section product-preview fade-in" id="product">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">{content.label}</span>
      <h2 class="headline-lg">
        {lines(content.headline).map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h2>
      <p class="text-lg">
        {content.intro}
      </p>
    </div>

    <div class="browser-frame">
      <div class="browser-topbar">
        <span class="browser-dot"></span>
        <span class="browser-dot"></span>
        <span class="browser-dot"></span>
        <span class="browser-url">{content.browserUrl}</span>
      </div>
      <div class="browser-body">
        <div class="dashboard-mock">
          <div class="mock-sidebar">
            {content.sidebarItems.map((item, i) => (
              <div class={`mock-sidebar-item ${i === 0 ? 'active' : ''}`.trim()}>{item}</div>
            ))}
          </div>
          <div class="mock-main">
            <div class="mock-topbar">
              <div class="mock-title">{content.mockTitle}</div>
              <div style="display:flex;gap:8px;">
                {content.periodTabs.map((tab, i) => (
                  <span
                    style={i === 0
                      ? 'font-size:0.7rem;padding:4px 10px;background:var(--pagayo-purple-glow);color:var(--pagayo-purple-light);border-radius:var(--radius-full);'
                      : 'font-size:0.7rem;padding:4px 10px;background:var(--bg-elevated);color:var(--text-muted);border-radius:var(--radius-full);'}
                  >
                    {tab}
                  </span>
                ))}
              </div>
            </div>
            <div class="mock-cards-row">
              {content.stats.map((stat) => (
                <div class="mock-stat-card">
                  <div class="label">{stat.label}</div>
                  <div class="value">{stat.value}</div>
                  <div class="change">{stat.change}</div>
                </div>
              ))}
            </div>
            <div class="mock-chart">
              <div style="font-size:0.75rem;font-weight:600;color:var(--text-secondary);">{content.chartTitle}</div>
              <div class="mock-chart-visual"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
