<section class="section product-preview fade-in" id="product">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">The Platform</span>
      <h2 class="headline-lg">One dashboard.<br />Every order, in real time.</h2>
      <p class="text-lg">
        Every sale, from every channel, on your own subdomain or custom
        domain. Your data, your money, your customers — directly connected,
        with Pagayo quietly keeping the books straight.
      </p>
    </div>

    <div class="browser-frame">
