            <div class="mock-sidebar-item active">📊 Dashboard</div>
            <div class="mock-sidebar-item">📦 Orders</div>
            <div class="mock-sidebar-item">🛍️ Products</div>
            <div class="mock-sidebar-item">👥 Customers</div>
            <div class="mock-sidebar-item">💳 POS</div>
            <div class="mock-sidebar-item">📱 QR Ordering</div>
            <div class="mock-sidebar-item">🎟️ Subscriptions</div>
            <div class="mock-sidebar-item">📊 Reports</div>
            <div class="mock-sidebar-item">⚙️ Settings</div>
          </div>
          <div class="mock-main">
            <div class="mock-topbar">
              <div class="mock-title">Dashboard</div>
              <div style="display:flex;gap:8px;">
                <span style="font-size:0.7rem;padding:4px 10px;background:var(--pagayo-purple-glow);color:var(--pagayo-purple-light);border-radius:var(--radius-full);">Today</span>
                <span style="font-size:0.7rem;padding:4px 10px;background:var(--bg-elevated);color:var(--text-muted);border-radius:var(--radius-full);">Week</span>
