---
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['featuresGrid'];
}

const content = Astro.props.content ?? loadHome('en').featuresGrid;

function lines(text: string) {
  return text.split('\n');
}
---
<section class="section fade-in" id="features">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">{content.label}</span>
      <h2 class="headline-lg">
        {lines(content.headline).map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h2>
      <p class="text-lg">
        {content.intro}
      </p>
    </div>

    <div class="features-grid">
      {content.items.map((item) => (
        <div class="feature-card">
          <div class="feature-icon">{item.icon}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
