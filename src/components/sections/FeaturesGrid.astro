---
import featuresData from '../../content/features.json';
---
<section class="section fade-in" id="features">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">Features</span>
      <h2 class="headline-lg">Everything you need.<br />Nothing you don't.</h2>
      <p class="text-lg">
        Built for speed, designed for simplicity. Every feature works across
        all sales channels — no plugins, no add-ons, no surprises.
      </p>
    </div>

    <div class="features-grid">
      {featuresData.items.map((item) => (
        <div class="feature-card">
          <div class="feature-icon">{item.icon}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
