---
import featuresData from '../../content/features.json';
---
<section class="section fade-in" id="features">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">What's Inside</span>
      <h2 class="headline-lg">Every tool a serious business needs.<br />Included from day one.</h2>
      <p class="text-lg">
        Orders, products, customers, subscriptions, POS, reporting — all in
        the free plan. Paid plans add capacity and polish; the feature set
        stays the same as you grow.
      </p>
    </div>

    <div class="features-grid">
      {featuresData.items.map((item) => (
        <div class="feature-card">
          <div class="feature-icon">{item.icon}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
