---
import Button from '../ui/Button.astro';
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['motorsGrid'];
}

const content = Astro.props.content ?? loadHome('en').motorsGrid;
---
<section class="section motors fade-in">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">{content.label}</span>
      <h2 class="headline-lg">{content.headline}</h2>
      <p class="text-lg">
        {content.intro}
      </p>
    </div>

    <div class="motors-grid">
      {content.cards.map((card) => (
        <div class={`motor-card ${card.href === '#gyms' ? 'gym' : card.href === '#impact' ? 'ngo' : 'partner'}`.trim()}>
          <div class="motor-icon">{card.icon}</div>
          <span class="motor-tag">{card.tag}</span>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <Button
            href={card.href}
            variant={card.href === '#gyms' ? 'gym' : card.href === '#impact' ? 'ngo' : 'partner'}
          >
            {card.cta}
          </Button>
        </div>
      ))}
    </div>
  </div>
</section>
