---
import Button from '../ui/Button.astro';
---
<section class="section motors fade-in">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">Three Ways to Grow</span>
      <h2 class="headline-lg">Choose your path.</h2>
      <p class="text-lg">
        Whether you run a gym, drive social impact, or want to earn by sharing
        — Pagayo has a path for you.
      </p>
    </div>

    <div class="motors-grid">
      <div class="motor-card gym">
        <div class="motor-icon">🏋️</div>
        <span class="motor-tag">For Businesses</span>
        <h3>Run Your Gym on Pagayo</h3>
        <p>
          Subscriptions, POS, QR check-in, webshop, member management
          — everything you need, 10× cheaper than the competition.
        </p>
        <Button href="#gyms" variant="gym">See Gym Features →</Button>
      </div>

      <div class="motor-card ngo">
        <div class="motor-icon">🌍</div>
        <span class="motor-tag">For Impact</span>
        <h3>Empower Entrepreneurs</h3>
        <p>
          Give aspiring business owners free access to professional tools.
          Track real impact with live dashboards.
        </p>
        <Button href="#impact" variant="ngo">Learn About Impact →</Button>
      </div>

      <div class="motor-card partner">
        <div class="motor-icon">🤝</div>
        <span class="motor-tag">Earn Money</span>
        <h3>Become a Partner</h3>
        <p>
          Share your referral link. Earn 50% commission on every signup.
          No sales experience needed — just share and earn.
        </p>
        <Button href="#partners" variant="partner">Start Earning →</Button>
      </div>
    </div>
  </div>
</section>
