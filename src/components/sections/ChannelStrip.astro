---
import channelsData from '../../content/channels.json';
---
<section class="section fade-in" style="padding-top:0;">
  <div class="container">
    <div class="section-header center">
      <h2 class="headline-md">Wherever the sale happens — it's the same order.</h2>
      <p class="text-lg">
        Webshop, counter, WhatsApp, QR, social, cash. One order model,
        one ledger, one place to look.
      </p>
    </div>

    <div class="channels-strip">
      {channelsData.items.map((item) => (
        <div class="channel-item">
          <div class="channel-icon-box">{item.icon}</div>
          <span class="channel-label">{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
