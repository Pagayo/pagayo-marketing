---
import Button from '../ui/Button.astro';
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['competitorTable'];
}

const content = Astro.props.content ?? loadHome('en').competitorTable;
---
<section class="section gym-section fade-in" id="gyms">
  <div class="container">
    <div class="section-header center">
      <span class="section-label" style="background:var(--gym-green-glow);color:var(--gym-green);border-color:rgba(0,212,170,0.2);">
        {content.label}
      </span>
      <h2 class="headline-lg" set:html={content.headline.replace('90% less', '90%&nbsp;less').replace('90% minder', '90%&nbsp;minder')} />
      <p class="text-lg">
        {content.intro}
      </p>
    </div>

    <table class="gym-competitor-table">
      <thead>
        <tr>
          <th>{content.tableHeaders.platform}</th>
          <th>{content.tableHeaders.priceRange}</th>
          <th>{content.tableHeaders.perMemberFees}</th>
          <th>{content.tableHeaders.note}</th>
        </tr>
      </thead>
      <tbody>
        {content.rows.map((row) => (
          <tr class={row.highlight ? 'pagayo-row' : ''}>
            <td class="competitor-name" style={row.highlight ? 'font-size:1.05rem;' : ''}>{row.platform}</td>
            <td class={row.highlight ? 'pagayo-price' : 'competitor-price'}>{row.price}</td>
            <td style={row.highlight ? 'color:var(--gym-green);' : ''}>{row.perMemberFees}</td>
            <td style={row.highlight ? 'color:var(--gym-green);' : 'color:var(--text-muted);'}>{row.note}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="headline-md" style="margin-top:3rem;margin-bottom:1rem;">{content.checklistHeadline}</h3>

    <div class="gym-features">
      {content.featureChecklist.map((feature) => (
        <div class="gym-feature-item">
          <span class="gym-feature-check">✓</span>
          <span>{feature}</span>
        </div>
      ))}
    </div>

    <div style="text-align:center;margin-top:3rem;">
      <Button href={content.ctaHref} variant="gym" size="lg">{content.cta}</Button>
    </div>
  </div>
</section>
