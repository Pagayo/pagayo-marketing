---
import buildLog from '../../content/build-log.json';

// Newest entries are at the end of the timeline; take the last 4 and reverse.
const recent = [...buildLog.timeline].slice(-4).reverse();
---
<section class="section always-shipping fade-in" id="always-shipping" aria-labelledby="always-shipping-heading">
  <div class="container always-shipping-container">
    <div class="section-header center">
      <span class="section-label">Always shipping</span>
      <h2 class="headline-md" id="always-shipping-heading">
        Pagayo grows every week.
      </h2>
      <p class="text-lg">
        New features, new modules, new improvements ship continuously —
        driven by what the people using Pagayo ask for. Here's what's
        recently landed in the platform.
      </p>
    </div>

    <ul class="shipping-list" aria-label="Recently shipped">
      {recent.map((item) => (
        <li class="shipping-item">
          <span class="shipping-marker">{item.marker}</span>
          <div class="shipping-content">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="shipping-footer">
      <a href="/how-we-build" class="shipping-link">
        How Pagayo is built →
      </a>
      <a href="/build-log" class="shipping-link">
        See the full Build Log →
      </a>
      <p class="shipping-ideas">
        Have an idea? <a href="/contact">Tell us</a> — we read every one.
      </p>
    </div>
  </div>
</section>
