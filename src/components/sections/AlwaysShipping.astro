---
import buildLog from '../../content/build-log.json';

// Newest entries are at the end of the timeline; take the last 4 and reverse.
const recent = [...buildLog.timeline].slice(-4).reverse();
---
<section class="section always-shipping fade-in" id="always-shipping" aria-labelledby="always-shipping-heading">
  <div class="container always-shipping-container">
    <div class="section-header center">
      <span class="section-label">Always shipping</span>
      <h2 class="headline-md" id="always-shipping-heading">
        Pagayo grows every week.
      </h2>
      <p class="text-lg">
        New features, new modules, new improvements ship continuously —
        driven by what the people using Pagayo ask for. Here's what's
        recently landed in the platform.
      </p>
    </div>

    <ul class="shipping-list" aria-label="Recently shipped">
      {recent.map((item) => (
        <li class="shipping-item">
          <span class="shipping-marker">{item.marker}</span>
          <div class="shipping-content">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="shipping-footer">
      <a href="/build-log" class="shipping-link">
        See the full Build Log →
      </a>
      <p class="shipping-ideas">
        Have an idea? <a href="/contact">Tell us</a> — we read every one.
      </p>
    </div>
  </div>
</section>

<style>
  .always-shipping {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .always-shipping-container {
    max-width: 920px;
    margin: 0 auto;
  }

  .shipping-list {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .shipping-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-lg, 12px);
    transition: border-color 0.15s ease;
  }

  .shipping-item:hover {
    border-color: rgba(255, 255, 255, 0.16);
  }

  .shipping-marker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-secondary, #06b6d4);
    padding-top: 0.15rem;
  }

  .shipping-content h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary, #f8fafc);
    margin: 0 0 0.4rem 0;
    line-height: 1.3;
  }

  .shipping-content p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary, #cbd5e1);
    margin: 0;
  }

  .shipping-footer {
    margin-top: 2.5rem;
    text-align: center;
  }

  .shipping-link {
    display: inline-block;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary, #f8fafc);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity 0.15s ease;
  }

  .shipping-link:hover {
    opacity: 0.75;
  }

  .shipping-ideas {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--text-muted, #94a3b8);
  }

  .shipping-ideas a {
    color: var(--text-secondary, #cbd5e1);
    border-bottom: 1px solid currentColor;
    text-decoration: none;
  }

  .shipping-ideas a:hover {
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    .shipping-item {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1rem 1.1rem;
    }
    .shipping-marker {
      padding-top: 0;
    }
  }
</style>
