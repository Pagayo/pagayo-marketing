---
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['alwaysShipping'];
}

const content = Astro.props.content ?? loadHome('en').alwaysShipping;
---
<section class="section always-shipping fade-in" id="always-shipping" aria-labelledby="always-shipping-heading">
  <div class="container always-shipping-container">
    <div class="section-header center">
      <span class="section-label">{content.label}</span>
      <h2 class="headline-md" id="always-shipping-heading">
        {content.headline}
      </h2>
      <p class="text-lg">
        {content.intro}
      </p>
    </div>

    <ul class="shipping-list" aria-label="Recently shipped">
      {content.items.map((item) => (
        <li class="shipping-item">
          <span class="shipping-marker">{item.marker}</span>
          <div class="shipping-content">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="shipping-footer">
      <a href={content.footer.howWeBuildHref} class="shipping-link">
        {content.footer.howWeBuildLink}
      </a>
      <a href={content.footer.buildLogHref} class="shipping-link">
        {content.footer.buildLogLink}
      </a>
      <p class="shipping-ideas">
        {content.footer.ideasPrefix} <a href={content.footer.ideasHref}>{content.footer.ideasLinkText}</a> {content.footer.ideasSuffix}
      </p>
    </div>
  </div>
</section>
