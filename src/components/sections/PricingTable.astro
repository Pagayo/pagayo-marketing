---
import Button from '../ui/Button.astro';
import { DEFAULT_LOCALE, loadMessages, type Locale, type Messages } from '../../lib/i18n';
import { loadPricing } from '../../lib/pricing';

interface Props {
  locale?: Locale;
  pricingPage?: Messages['pricingPage'];
  /** Use h1 on dedicated /pricing route; h2 when embedded on the homepage. */
  headingLevel?: 'h1' | 'h2';
}

const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const pricingPage = Astro.props.pricingPage ?? loadMessages(locale).pricingPage;
const { headingLevel = 'h2' } = Astro.props;
const HeadingTag = headingLevel;

const { free, tiers, billingNote } = loadPricing(locale);
---
<section class="section pricing fade-in" id="pricing" style="padding-top: var(--hero-pt);">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">{pricingPage.sectionLabel}</span>
      <HeadingTag class="headline-lg">{pricingPage.headline}</HeadingTag>
      <p class="text-lg">{pricingPage.intro}</p>
    </div>

    <div class="pricing-billing-note">
      <span class="note-icon">ℹ</span>
      {billingNote}
    </div>

    <div class="pricing-hero-card">
      <div class="pricing-hero-top">
        <div class="pricing-hero-intro">
          <div class="pricing-tier">{free.name}</div>
          <h3>{free.headline}</h3>
          <p class="pricing-desc">{free.description}</p>
          <div class="pricing-hero-price">
            <span class="price-big">€{free.price}</span>
            <span class="price-label">{free.priceLabel}</span>
          </div>
          <Button href="https://start.pagayo.app/register" variant="primary">{free.cta}</Button>
        </div>

        <div class="pricing-hero-features">
          <ul class="feature-col">
            {free.featuresLeft.map((f) => (
              <li>
                <span class="check">✓</span>
                {f.label}
                {f.limit && <span class="limit">({f.limit})</span>}
                {f.test && <span class="test-badge">test</span>}
              </li>
            ))}
          </ul>
          <ul class="feature-col">
            {free.featuresRight.map((f) => (
              <li>
                <span class="check">✓</span>
                {f.label}
                {f.limit && <span class="limit">({f.limit})</span>}
                {f.test && <span class="test-badge">test</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="pricing-grid">
      {tiers.map((tier) => (
        <div class={`pricing-card ${tier.popular ? 'popular' : ''}`.trim()}>
          <div class="pricing-tier">{tier.name}</div>
          <div class="pricing-amount">
            <span class="pricing-currency">€</span>
            <span class="pricing-value">{tier.monthly}</span>
            <span class="pricing-period">/mo</span>
          </div>
          <div class="pricing-annual">{tier.annualLabel}</div>
          <p class="pricing-desc">{tier.description}</p>
          <ul class="pricing-features">
            {tier.features.map((f) => (
              <li>
                <span class="check">✓</span>
                {f.label}
                {f.limit && <span class="limit">({f.limit})</span>}
              </li>
            ))}
          </ul>
          <Button href="https://start.pagayo.app/register" variant={tier.variant === 'secondary' ? 'secondary' : 'primary'}>
            {tier.cta}
          </Button>
        </div>
      ))}
    </div>
  </div>
</section>
