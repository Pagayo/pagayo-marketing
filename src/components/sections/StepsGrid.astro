---
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['stepsGrid'];
}

const content = Astro.props.content ?? loadHome('en').stepsGrid;
---
<section class="section how-it-works fade-in">
  <div class="container">
    <div class="section-header center">
      <span class="section-label">{content.label}</span>
      <h2 class="headline-lg">{content.headline}</h2>
      <p class="text-lg">
        {content.intro}
      </p>
    </div>

    <div class="steps-grid">
      {content.steps.map((step) => (
        <div class="step-card">
          <div class="step-number">{step.number}</div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
