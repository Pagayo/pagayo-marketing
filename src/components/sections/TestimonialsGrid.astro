---
import SuccessStoryCard from '../success-stories/SuccessStoryCard.astro';
import storiesRaw from '../../content/success-stories.json';
import { loadHome, type HomeContent } from '../../lib/home';
import { loadMessages, type Locale } from '../../lib/i18n';
import { parseSuccessStories, resolvePreviewStories } from '../../lib/success-stories-schema';

interface Props {
  showHeader?: boolean;
  sectionId?: string;
  limit?: number;
  showViewAllLink?: boolean;
  locale?: Locale;
  header?: HomeContent['testimonials'];
}

const {
  showHeader = true,
  sectionId = 'success-stories',
  limit,
  showViewAllLink = false,
  locale = 'en',
  header,
} = Astro.props;

const headerContent = header ?? loadHome('en').testimonials;
const t = loadMessages(locale).successStoriesPage;
const data = parseSuccessStories(storiesRaw);

const stories = limit
  ? resolvePreviewStories(data).slice(0, limit)
  : data.continents.flatMap((c) => c.stories);
---
<section class="section testimonials fade-in" id={sectionId}>
  <div class="container">
    {showHeader && (
      <div class="section-header center">
        <span class="section-label">{headerContent.label}</span>
        <h2 class="headline-lg">{headerContent.headline}</h2>
      </div>
    )}

    <div class="testimonials-grid">
      {stories.map((story) => (
        <SuccessStoryCard story={story} />
      ))}
    </div>

    {showViewAllLink && limit && (
      <p class="success-stories-view-all">
        <a href="/success-stories">{t.viewAllStories}</a>
      </p>
    )}
  </div>
</section>
