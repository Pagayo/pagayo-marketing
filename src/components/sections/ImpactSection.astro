---
import Button from '../ui/Button.astro';
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  /** Hide the section header (used on /impact where the hero covers it). */
  showHeader?: boolean;
  /** Homepage teaser: hide pricing tiers and link to full page. */
  compact?: boolean;
  /** Localized compact teaser copy (homepage). */
  teaser?: HomeContent['impactTeaser'];
}

const { showHeader = true, compact = false, teaser } = Astro.props;
const teaserContent = teaser ?? loadHome('en').impactTeaser;
---
<section class="section ngo-section fade-in" id="impact">
  <div class="container">
    {showHeader && compact && (
      <div class="section-header center">
        <span class="section-label impact-label">
          {teaserContent.label}
        </span>
        <h2 class="headline-lg">
          {teaserContent.headline}<br />
          <span class="impact-headline-accent">{teaserContent.headlineAccent}</span>
        </h2>
        <p class="text-lg">
          {teaserContent.intro}
        </p>
      </div>
    )}

    {showHeader && !compact && (
      <div class="section-header center">
        <span class="section-label impact-label">
          Entrepreneurship Infrastructure
        </span>
        <h2 class="headline-lg">
          Provision a cohort.<br />
          <span class="impact-headline-accent">Measure what actually happened.</span>
        </h2>
        <p class="text-lg">
          NGOs, governments, and foundations sponsor cohorts of entrepreneurs.
          Each founder gets a full commerce platform — free for them, live-monitored by you.
          Three steps. Real outcomes. No grant report required.
        </p>
      </div>
    )}

    {!showHeader && (
      <div class="section-header center">
        <span class="section-label impact-label">How it works</span>
        <h2 class="headline-lg">From sponsorship to verified outcomes.</h2>
        <p class="text-lg">
          Three steps — provision a cohort, founders run real businesses, you measure what happened.
        </p>
      </div>
    )}

    <div class="ngo-flow">
      {(compact ? teaserContent.steps : [
        {
          number: 1,
          title: 'You Sponsor a Cohort',
          body: 'Define a group — region, sector, goals. We provision their accounts, fully featured, no credit card required.',
        },
        {
          number: 2,
          title: 'Entrepreneurs Get to Work',
          body: 'Each founder runs a real shop — webshop, POS, WhatsApp, payouts to their own account. The same product European businesses pay for.',
        },
        {
          number: 3,
          title: 'You See What Actually Happened',
          body: 'Live dashboards: revenue earned, orders fulfilled, customers served, jobs created. Outcomes, not slides.',
        },
      ]).map((step) => (
        <div class="ngo-step">
          <div class="ngo-step-number">{step.number}</div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>

    {!compact && (
      <>
        <h3 class="headline-md impact-pricing-title">
          Impact Dashboard Pricing
        </h3>
        <p class="text-lg impact-pricing-intro">
          The platform is free for sponsored entrepreneurs. You pay only for the dashboard — so the funding goes to the people doing the work.
        </p>

        <div class="ngo-tiers">
          <div class="ngo-tier-card">
            <div class="tier-name">Starter</div>
            <div class="tier-price">€1,000/mo</div>
            <div class="tier-unit">Up to 50 entrepreneurs</div>
            <ul>
              <li>Live revenue tracking</li>
              <li>Basic impact metrics</li>
              <li>Monthly PDF reports</li>
              <li>Email support</li>
            </ul>
          </div>
          <div class="ngo-tier-card ngo-tier-card--featured">
            <div class="tier-name">Growth</div>
            <div class="tier-price">€3,000/mo</div>
            <div class="tier-unit">Up to 250 entrepreneurs</div>
            <ul>
              <li>Everything in Starter</li>
              <li>Advanced analytics</li>
              <li>Cohort comparison</li>
              <li>API access for own reporting</li>
              <li>Dedicated account manager</li>
            </ul>
          </div>
          <div class="ngo-tier-card">
            <div class="tier-name">Enterprise</div>
            <div class="tier-price ngo-tier-price--contact">Contact us</div>
            <div class="tier-unit">Unlimited entrepreneurs</div>
            <ul>
              <li>Everything in Growth</li>
              <li>White-label dashboards</li>
              <li>Custom metrics & KPIs</li>
              <li>Multi-region programs</li>
              <li>Integration with donor systems</li>
            </ul>
          </div>
        </div>
      </>
    )}

    <div class="impact-section-cta">
      {compact ? (
        <Button href={teaserContent.ctaHref} variant="ngo" size="lg">{teaserContent.cta}</Button>
      ) : (
        <Button href="/contact" variant="ngo" size="lg">Sponsor a Cohort →</Button>
      )}
    </div>
  </div>
</section>
