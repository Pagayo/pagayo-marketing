---
import Button from '../ui/Button.astro';
---
<section class="section final-cta fade-in">
  <div class="final-cta-bg"></div>
  <div class="container">
    <h2 class="headline-lg">Start selling today.<br />Grow with the platform.</h2>
    <p>
      Free to start. All features included. Yours to leave whenever you want —
      most never do.
    </p>
    <div class="final-cta-buttons">
      <Button href="https://start.pagayo.app/register" variant="primary" size="lg">Start Free →</Button>
      <Button href="#pricing" variant="secondary" size="lg">Compare Plans</Button>
    </div>
    <p class="final-cta-ideas">
      Have an idea, a question, or a feature you wish existed?
      <a href="/contact">Get in touch — we listen.</a>
    </p>
  </div>
</section>
