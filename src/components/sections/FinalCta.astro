---
import Button from '../ui/Button.astro';
---
<section class="section final-cta fade-in">
  <div class="final-cta-bg"></div>
  <div class="container">
    <h2 class="headline-lg">Ready to simplify your business?</h2>
    <p>
      Join thousands of businesses running on Pagayo.
      Start free today — upgrade whenever you want.
    </p>
    <div class="final-cta-buttons">
      <Button href="https://start.pagayo.app/register" variant="primary" size="lg">Create Free Account →</Button>
      <Button href="#pricing" variant="secondary" size="lg">Compare Plans</Button>
    </div>
  </div>
</section>
