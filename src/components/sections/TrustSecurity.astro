---
import { loadHome, type HomeContent } from '../../lib/home';

interface Props {
  content?: HomeContent['trustSecurity'];
}

const content = Astro.props.content ?? loadHome('en').trustSecurity;
---
<section class="section trust-section fade-in">
  <div class="container">
    <div class="trust-grid">
      {content.items.map((item) => (
        <div class="trust-item">
          <div class="trust-icon">{item.icon}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
