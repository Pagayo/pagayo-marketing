---
import FinalCta from '../sections/FinalCta.astro';
import type { OneStackContent } from '../../lib/one-stack-page';
import type { Locale } from '../../lib/i18n';

interface Props {
  content: OneStackContent;
  locale?: Locale;
}

const { content: t, locale = 'en' } = Astro.props;
const pillars = t.pillars;
const benefits = t.benefits.items;
const stats = t.hero.stats;
---

<main class="os-page">

    <!-- ═══════════════════════════════════════════════════════ HERO -->
    <section class="hero section os-hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-orb hero-orb-3"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse"></span>
          {t.hero.badge}
        </div>

        <h1 class="headline-xl">
          {t.hero.headlineTop}<br />
          <span class="text-gradient">{t.hero.headlineGradient}</span>
        </h1>

        <p class="os-hero-intro">
          {t.hero.intro}
        </p>

        <!-- Pillar constellation -->
        <div class="os-constellation" aria-hidden="true">
          <svg viewBox="0 0 860 200" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="osLine" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#6366f1" stop-opacity="0.04" />
                <stop offset="50%" stop-color="#a78bfa" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#6366f1" stop-opacity="0.04" />
              </linearGradient>
            </defs>
            <!-- connecting spine -->
            <path d="M 60 100 L 800 100" stroke="url(#osLine)" stroke-width="1.5" fill="none" />
            <!-- vertical connector lines -->
            {[
              { x: 60,  y1: 100, y2: 60,  label: 'CF', color: '#F38020' },
              { x: 180, y1: 100, y2: 140, label: 'St', color: '#635BFF' },
              { x: 300, y1: 100, y2: 60,  label: 'Gh', color: '#8b949e' },
              { x: 420, y1: 100, y2: 140, label: 'TS', color: '#3b82f6' },
              { x: 540, y1: 100, y2: 60,  label: 'Dz', color: '#34d399' },
              { x: 660, y1: 100, y2: 140, label: 'Cu', color: '#06b6d4' },
              { x: 780, y1: 100, y2: 60,  label: 'Cl', color: '#d97757' },
            ].map((n) => (
              <>
                <line x1={n.x} y1={n.y1} x2={n.x} y2={n.y2}
                  stroke={n.color} stroke-width="1.2" stroke-opacity="0.55" />
                <circle cx={n.x} cy={n.y2} r="20"
                  fill="none" stroke={n.color} stroke-width="1.5" stroke-opacity="0.7" />
                <circle cx={n.x} cy={n.y2} r="20"
                  fill={n.color} fill-opacity="0.1" />
                <text x={n.x} y={n.y2 + 5} text-anchor="middle"
                  fill={n.color} font-size="10" font-weight="700"
                  font-family="ui-monospace, monospace">{n.label}</text>
              </>
            ))}
          </svg>
        </div>

        <div class="os-stats-row">
          {stats.map((s) => (
            <div class="os-stat">
              <span class="os-stat-value">{s.value}</span>
              <span class="os-stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ PRINCIPLE -->
    <section class="section os-principle fade-in">
      <div class="container">
        <div class="os-principle-inner">
          <div class="os-principle-text">
            <span class="section-label">{t.principle.sectionLabel}</span>
            <h2 class="headline-md">{t.principle.headline}</h2>
            {t.principle.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <div class="os-principle-visual" aria-hidden="true">
            <svg viewBox="0 0 340 340" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="osPrinGlow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#a78bfa" stop-opacity="0.35" />
                  <stop offset="100%" stop-color="#a78bfa" stop-opacity="0" />
                </radialGradient>
              </defs>
              <circle cx="170" cy="170" r="140" fill="url(#osPrinGlow)" />
              <!-- outer ring -->
              <circle cx="170" cy="170" r="130" fill="none" stroke="#a78bfa"
                stroke-width="1" stroke-opacity="0.2" stroke-dasharray="4 6" />
              <!-- middle ring -->
              <circle cx="170" cy="170" r="88" fill="none" stroke="#a78bfa"
                stroke-width="1" stroke-opacity="0.3" />
              <!-- spokes to 7 nodes -->
              {[0, 51.4, 102.8, 154.2, 205.6, 257.1, 308.5].map((deg, i) => {
                const colors = ['#F38020','#635BFF','#8b949e','#3b82f6','#34d399','#06b6d4','#d97757'];
                const rad = (deg - 90) * Math.PI / 180;
                const x1 = 170 + 30 * Math.cos(rad);
                const y1 = 170 + 30 * Math.sin(rad);
                const x2 = 170 + 88 * Math.cos(rad);
                const y2 = 170 + 88 * Math.sin(rad);
                return (
                  <>
                    <line x1={x1} y1={y1} x2={x2} y2={y2}
                      stroke={colors[i]} stroke-width="1.5" stroke-opacity="0.65" />
                    <circle cx={x2} cy={y2} r="12" fill={colors[i]} fill-opacity="0.15"
                      stroke={colors[i]} stroke-width="1.5" />
                    <circle cx={x2} cy={y2} r="4" fill={colors[i]} />
                  </>
                );
              })}
              <!-- centre -->
              <circle cx="170" cy="170" r="30" fill="rgba(167,139,250,0.12)"
                stroke="#a78bfa" stroke-width="1.5" />
              <circle cx="170" cy="170" r="8" fill="#a78bfa" />
              <text x="170" y="206" text-anchor="middle" fill="#a78bfa"
                font-size="10" font-weight="600" font-family="ui-monospace,monospace"
                fill-opacity="0.75">Pagayo</text>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ PILLARS -->
    <section class="section os-pillars">
      <div class="container">
        {pillars.map((p, idx) => (
          <article
            class={`os-pillar-row ${idx % 2 === 1 ? 'os-pillar-row--reverse' : ''}`}
            id={p.slug}
            style={`--accent: ${p.accent}; --accent-soft: ${p.accentSoft};`}
          >
            <div class="os-pillar-text">
              <div class="os-pillar-meta">
                <span class="os-pillar-num">{p.num}</span>
                <span class="os-pillar-category">{p.category}</span>
              </div>
              <h2 class="os-pillar-name">{p.name}</h2>
              <p class="os-pillar-tagline">{p.tagline}</p>
              <p class="os-pillar-body">{p.body}</p>
              <div class="os-pillar-foryou">
                <span class="os-foryou-label">{t.forYourShopLabel}</span>
                <span class="os-foryou-text">{p.forYou}</span>
              </div>
              {p.linkSlug && (
                <a class="os-pillar-link" href={`/${p.linkSlug}`}>
                  {t.pillarLinkTemplate.replace('{name}', p.name)}
                </a>
              )}
            </div>

            <div class="os-pillar-visual">
              <div class="os-visual-frame">
                {p.slug === 'cloudflare' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="cfG" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#F38020" stop-opacity="0.45" />
                        <stop offset="100%" stop-color="#F38020" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <circle cx="200" cy="160" r="110" fill="url(#cfG)" />
                    <circle cx="200" cy="160" r="85" fill="none" stroke="#F38020" stroke-width="1.2" stroke-opacity="0.5" />
                    <ellipse cx="200" cy="160" rx="85" ry="32" fill="none" stroke="#F38020" stroke-width="1" stroke-opacity="0.3" />
                    <ellipse cx="200" cy="160" rx="55" ry="85" fill="none" stroke="#F38020" stroke-width="1" stroke-opacity="0.3" />
                    <line x1="115" y1="160" x2="285" y2="160" stroke="#F38020" stroke-width="1" stroke-opacity="0.3" />
                    <line x1="200" y1="75" x2="200" y2="245" stroke="#F38020" stroke-width="1" stroke-opacity="0.3" />
                    {[
                      {cx:120,cy:120},{cx:280,cy:135},{cx:160,cy:220},{cx:245,cy:210},{cx:200,cy:78},
                      {cx:148,cy:108},{cx:265,cy:190}
                    ].map(n => <circle cx={n.cx} cy={n.cy} r="4" fill="#F38020" />)}
                    <circle cx="200" cy="160" r="6" fill="#F38020" />
                    <circle cx="200" cy="160" r="46" fill="none" stroke="#F38020" stroke-width="0.8" stroke-opacity="0.35" />
                    <text x="200" y="270" text-anchor="middle" fill="#F38020"
                      font-size="11" font-weight="600" font-family="ui-monospace,monospace"
                      fill-opacity="0.7">{t.visuals.cloudflareCaption}</text>
                  </svg>
                )}

                {p.slug === 'stripe' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <linearGradient id="stG1" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#635BFF" />
                        <stop offset="100%" stop-color="#818cf8" />
                      </linearGradient>
                      <linearGradient id="stG2" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#06b6d4" />
                        <stop offset="100%" stop-color="#635BFF" />
                      </linearGradient>
                      <radialGradient id="stGl" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <circle cx="200" cy="160" r="140" fill="url(#stGl)" />
                    <g transform="translate(80,80) rotate(-8 110 70)">
                      <rect width="220" height="135" rx="14" fill="url(#stG2)" opacity="0.8" />
                      <rect x="22" y="32" width="36" height="26" rx="4" fill="#fff" fill-opacity="0.8" />
                      <rect x="22" y="76" width="120" height="6" rx="3" fill="#fff" fill-opacity="0.5" />
                    </g>
                    <g transform="translate(100,110) rotate(6 110 70)">
                      <rect width="220" height="135" rx="14" fill="url(#stG1)" />
                      <rect x="22" y="32" width="36" height="26" rx="4" fill="#fff" fill-opacity="0.95" />
                      <rect x="22" y="76" width="160" height="8" rx="4" fill="#fff" fill-opacity="0.7" />
                      <rect x="22" y="92" width="110" height="6" rx="3" fill="#fff" fill-opacity="0.45" />
                      <text x="172" y="120" text-anchor="end" fill="#fff" font-size="14" font-weight="700" font-family="system-ui">VISA</text>
                    </g>
                    <!-- checkmark -->
                    <circle cx="315" cy="75" r="22" fill="#10a37f" fill-opacity="0.9" />
                    <path d="M 305 75 L 313 83 L 326 68" stroke="#fff" stroke-width="3"
                      fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}

                {p.slug === 'github' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="ghGl" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#8b949e" stop-opacity="0.25" />
                        <stop offset="100%" stop-color="#8b949e" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#ghGl)" />
                    <path d="M 70 240 L 70 80" stroke="#c9d1d9" stroke-width="2" stroke-opacity="0.5" />
                    <path d="M 70 200 Q 70 155 155 155 L 210 155" stroke="#06b6d4" stroke-width="2" stroke-opacity="0.7" fill="none" />
                    <path d="M 210 155 Q 285 155 285 100 L 285 65" stroke="#10a37f" stroke-width="2" stroke-opacity="0.7" fill="none" />
                    <path d="M 70 135 Q 70 95 155 95 L 210 95 Q 285 95 285 155 L 285 240" stroke="#d97757" stroke-width="2" stroke-opacity="0.6" fill="none" />
                    {[{x:70,y:240},{x:70,y:200},{x:70,y:135},{x:70,y:80}].map(n =>
                      <circle cx={n.x} cy={n.y} r="7" fill="#c9d1d9" />)}
                    <circle cx="210" cy="155" r="7" fill="#06b6d4" />
                    <circle cx="210" cy="95" r="7" fill="#d97757" />
                    <circle cx="285" cy="65" r="7" fill="#10a37f" />
                    <circle cx="285" cy="240" r="7" fill="#d97757" />
                    <text x="90" y="83" fill="#c9d1d9" font-size="11" font-family="ui-monospace,monospace">main</text>
                    <text x="225" y="68" fill="#10a37f" font-size="11" font-family="ui-monospace,monospace">feature/one-stack</text>
                    <text x="225" y="158" fill="#06b6d4" font-size="11" font-family="ui-monospace,monospace">staging</text>
                    <!-- green check badge -->
                    <circle cx="340" cy="65" r="14" fill="#10a37f" />
                    <path d="M 333 65 L 338 70 L 347 61" stroke="#fff" stroke-width="2.5"
                      fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}

                {p.slug === 'typescript' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="tsGl" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#tsGl)" />
                    <!-- editor window -->
                    <rect x="44" y="44" width="312" height="232" rx="12" fill="#0f172a"
                      stroke="#3b82f6" stroke-width="1.2" stroke-opacity="0.35" />
                    <rect x="44" y="44" width="312" height="26" rx="12" fill="#1e293b" />
                    <circle cx="62" cy="57" r="4" fill="#f87171" />
                    <circle cx="76" cy="57" r="4" fill="#fbbf24" />
                    <circle cx="90" cy="57" r="4" fill="#34d399" />
                    <text x="200" y="61" text-anchor="middle" fill="#64748b"
                      font-size="10" font-family="ui-monospace,monospace">order.ts</text>
                    <!-- code lines -->
                    <g font-family="ui-monospace,monospace" font-size="11">
                      <text x="64" y="96"  fill="#94a3b8">1</text>
                      <text x="82" y="96"  fill="#c084fc">type</text>
                      <text x="118" y="96" fill="#67e8f9">Order</text>
                      <text x="158" y="96" fill="#94a3b8">=</text>
                      <text x="170" y="96" fill="#fbbf24">{'{'}</text>

                      <text x="64" y="115"  fill="#94a3b8">2</text>
                      <text x="98" y="115"  fill="#67e8f9">id</text>
                      <text x="116" y="115" fill="#94a3b8">:</text>
                      <text x="125" y="115" fill="#86efac">string</text>
                      <text x="167" y="115" fill="#94a3b8">;</text>

                      <text x="64" y="134"  fill="#94a3b8">3</text>
                      <text x="98" y="134"  fill="#67e8f9">total</text>
                      <text x="131" y="134" fill="#94a3b8">:</text>
                      <text x="140" y="134" fill="#86efac">number</text>
                      <text x="189" y="134" fill="#94a3b8">;</text>

                      <text x="64" y="153"  fill="#94a3b8">4</text>
                      <text x="98" y="153"  fill="#67e8f9">status</text>
                      <text x="137" y="153" fill="#94a3b8">:</text>
                      <text x="146" y="153" fill="#86efac">'paid'</text>
                      <text x="179" y="153" fill="#94a3b8">|</text>
                      <text x="187" y="153" fill="#86efac">'pending'</text>
                      <text x="244" y="153" fill="#94a3b8">;</text>

                      <text x="64" y="172" fill="#94a3b8">5</text>
                      <text x="82" y="172" fill="#fbbf24">{'}'}</text>

                      <text x="64" y="195" fill="#94a3b8">7</text>
                      <text x="82" y="195" fill="#64748b">{t.visuals.typescriptComment}</text>
                    </g>
                    <!-- error squiggle -->
                    <path d="M 82 200 Q 96 203 110 200 Q 124 197 138 200 Q 152 203 166 200"
                      stroke="#f87171" stroke-width="1.5" fill="none" stroke-opacity="0.75" />
                    <!-- TS badge -->
                    <rect x="316" y="236" width="28" height="28" rx="6" fill="#3b82f6" />
                    <text x="330" y="254" text-anchor="middle" fill="#fff"
                      font-size="11" font-weight="800" font-family="system-ui">TS</text>
                  </svg>
                )}

                {p.slug === 'drizzle' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="dzGl" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#34d399" stop-opacity="0.25" />
                        <stop offset="100%" stop-color="#34d399" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#dzGl)" />
                    <!-- three schema tables -->
                    {[
                      { x: 44,  y: 60,  w: 130, rows: ['id: string', 'total: number', 'status: string', 'createdAt: Date'], title: 'orders', color: '#34d399' },
                      { x: 230, y: 60,  w: 130, rows: ['id: string', 'name: string', 'price: number', 'stock: number'], title: 'products', color: '#06b6d4' },
                      { x: 136, y: 200, w: 130, rows: ['id: string', 'email: string', 'createdAt: Date'], title: 'customers', color: '#a78bfa' },
                    ].map(t => (
                      <>
                        <rect x={t.x} y={t.y} width={t.w} height={26} rx="8"
                          fill={t.color} fill-opacity="0.2" stroke={t.color}
                          stroke-width="1.5" />
                        <rect x={t.x} y={t.y + 26} width={t.w}
                          height={t.rows.length * 22 + 10} rx="0"
                          fill="#0f172a" stroke={t.color} stroke-width="1" stroke-opacity="0.4" />
                        <text x={t.x + t.w/2} y={t.y + 17} text-anchor="middle"
                          fill={t.color} font-size="11" font-weight="700"
                          font-family="ui-monospace,monospace">{t.title}</text>
                        {t.rows.map((r, i) => (
                          <text x={t.x + 10} y={t.y + 42 + i * 22}
                            fill="#94a3b8" font-size="10"
                            font-family="ui-monospace,monospace">{r}</text>
                        ))}
                      </>
                    ))}
                    <!-- relation lines -->
                    <path d="M 174 152 L 174 182 Q 174 200 201 200"
                      stroke="#34d399" stroke-width="1.5" fill="none"
                      stroke-opacity="0.6" stroke-dasharray="4 3" />
                    <path d="M 230 152 L 230 182 Q 230 200 266 200"
                      stroke="#06b6d4" stroke-width="1.5" fill="none"
                      stroke-opacity="0.6" stroke-dasharray="4 3" />
                  </svg>
                )}

                {p.slug === 'cursor' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="cuGl" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#06b6d4" stop-opacity="0" />
                      </radialGradient>
                      <linearGradient id="cuCur" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#06b6d4" />
                        <stop offset="100%" stop-color="#6366f1" />
                      </linearGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#cuGl)" />
                    <!-- editor -->
                    <rect x="48" y="44" width="304" height="218" rx="12" fill="#0f172a"
                      stroke="#06b6d4" stroke-opacity="0.4" stroke-width="1.5" />
                    <rect x="48" y="44" width="304" height="26" rx="12" fill="#1e293b" />
                    <circle cx="66" cy="57" r="4" fill="#f87171" />
                    <circle cx="80" cy="57" r="4" fill="#fbbf24" />
                    <circle cx="94" cy="57" r="4" fill="#34d399" />
                    <text x="200" y="61" text-anchor="middle" fill="#64748b"
                      font-size="10" font-family="ui-monospace,monospace">one-stack.astro</text>
                    <g font-family="ui-monospace,monospace" font-size="11">
                      <text x="68" y="95"  fill="#94a3b8">1</text>
                      <text x="86" y="95"  fill="#c084fc">const</text>
                      <text x="126" y="95" fill="#67e8f9">platform</text>
                      <text x="180" y="95" fill="#94a3b8">=</text>
                      <text x="192" y="95" fill="#fbbf24">{'{'}</text>
                      <text x="68" y="115" fill="#94a3b8">2</text>
                      <text x="100" y="115" fill="#67e8f9">tools</text>
                      <text x="132" y="115" fill="#94a3b8">:</text>
                      <text x="142" y="115" fill="#86efac">7</text>
                      <text x="68" y="135" fill="#94a3b8">3</text>
                      <text x="100" y="135" fill="#67e8f9">vendors</text>
                      <text x="148" y="135" fill="#94a3b8">:</text>
                      <text x="158" y="135" fill="#86efac">1</text>
                      <text x="68" y="155" fill="#94a3b8">4</text>
                      <text x="100" y="155" fill="#67e8f9">deploys</text>
                      <text x="148" y="155" fill="#94a3b8">:</text>
                      <text x="158" y="155" fill="#86efac">'weekly'</text>
                      <text x="68" y="175" fill="#94a3b8">5</text>
                      <text x="86" y="175" fill="#fbbf24">{'}'}</text>
                    </g>
                    <!-- cursor blink -->
                    <rect x="124" y="167" width="2.5" height="14" fill="url(#cuCur)" />
                    <!-- AI suggestion -->
                    <rect x="134" y="168" width="130" height="14" rx="3"
                      fill="#06b6d4" fill-opacity="0.12" stroke="#06b6d4"
                      stroke-opacity="0.45" stroke-width="0.8" stroke-dasharray="3,3" />
                    <text x="141" y="179" fill="#06b6d4" font-size="10"
                      font-family="ui-monospace,monospace" opacity="0.85">uptime: '99.99%'</text>
                    <!-- status bar -->
                    <rect x="48" y="236" width="304" height="26" rx="0" fill="#0b1220" />
                    <circle cx="66" cy="249" r="4" fill="#10a37f" />
                    <text x="78" y="253" fill="#94a3b8" font-size="10"
                      font-family="ui-monospace,monospace">{t.visuals.cursorAgents}</text>
                    <text x="340" y="253" text-anchor="end" fill="#06b6d4"
                      font-size="10" font-family="ui-monospace,monospace">{t.visuals.cursorReady}</text>
                  </svg>
                )}

                {p.slug === 'claude' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="clGl" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#d97757" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#d97757" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#clGl)" />
                    <!-- human message -->
                    <g transform="translate(56,54)">
                      <rect width="220" height="56" rx="14" fill="#1e293b"
                        stroke="#334155" stroke-width="1" />
                      <rect x="16" y="16" width="160" height="8" rx="4" fill="#cbd5e1" fill-opacity="0.7" />
                      <rect x="16" y="30" width="110" height="8" rx="4" fill="#94a3b8" fill-opacity="0.5" />
                    </g>
                    <!-- Claude response -->
                    <g transform="translate(116,130)">
                      <rect width="240" height="90" rx="14" fill="#d97757" fill-opacity="0.12"
                        stroke="#d97757" stroke-width="1" />
                      <rect x="16" y="16" width="190" height="8" rx="4" fill="#fbbf24" fill-opacity="0.7" />
                      <rect x="16" y="30" width="210" height="8" rx="4" fill="#fdba74" fill-opacity="0.55" />
                      <rect x="16" y="44" width="170" height="8" rx="4" fill="#fdba74" fill-opacity="0.4" />
                      <rect x="16" y="58" width="130" height="8" rx="4" fill="#fdba74" fill-opacity="0.3" />
                      <!-- Claude avatar -->
                      <circle cx="-18" cy="45" r="16" fill="#d97757" />
                      <text x="-18" y="50" text-anchor="middle" fill="#fff"
                        font-size="12" font-weight="700" font-family="system-ui">C</text>
                    </g>
                    <!-- thinking dots -->
                    <g transform="translate(116,240)">
                      <rect width="88" height="32" rx="14" fill="#d97757" fill-opacity="0.1"
                        stroke="#d97757" stroke-opacity="0.45" stroke-width="1" />
                      <circle cx="24" cy="16" r="4" fill="#d97757" fill-opacity="0.55" />
                      <circle cx="44" cy="16" r="4" fill="#d97757" fill-opacity="0.75" />
                      <circle cx="64" cy="16" r="4" fill="#d97757" />
                    </g>
                    <!-- spark -->
                    <path d="M 330 72 L 333 63 L 336 72 L 345 75 L 336 78 L 333 87 L 330 78 L 321 75 Z"
                      fill="#fbbf24" fill-opacity="0.85" />
                  </svg>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ BENEFITS -->
    <section class="section os-benefits fade-in">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">{t.benefits.sectionLabel}</span>
          <h2 class="headline-md">{t.benefits.headline}</h2>
          <p>{t.benefits.intro}</p>
        </div>
        <div class="os-benefits-grid">
          {benefits.map((b) => (
            <div class="os-benefit-card">
              <span class="os-benefit-icon">{b.icon}</span>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ COMPARISON -->
    <section class="section os-comparison fade-in">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">{t.comparison.sectionLabel}</span>
          <h2 class="headline-md">{t.comparison.headline}</h2>
          <p>{t.comparison.intro}</p>
        </div>

        <div class="os-comparison-grid">
          <div class="os-comp-col os-comp-col--bad">
            <div class="os-comp-header">
              <span class="os-comp-label os-comp-label--bad">{t.comparison.badLabel}</span>
            </div>
            {t.comparison.rows.map((row) => (
              <div class="os-comp-row">
                <span class="os-comp-cat">{row.category}</span>
                <span class="os-comp-val os-comp-val--bad">✕ {row.bad}</span>
              </div>
            ))}
          </div>

          <div class="os-comp-col os-comp-col--good">
            <div class="os-comp-header">
              <span class="os-comp-label os-comp-label--good">{t.comparison.goodLabel}</span>
            </div>
            {t.comparison.rows.map((row) => (
              <div class="os-comp-row">
                <span class="os-comp-cat">{row.category}</span>
                <span class="os-comp-val os-comp-val--good">✓ {row.good}</span>
              </div>
            ))}
          </div>
        </div>

        <p class="os-comparison-note">
          {t.comparison.note}
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ THE RIPPLE -->
    <section class="section os-ripple fade-in">
      <div class="container">
        <div class="os-ripple-inner">
          <div class="section-header">
            <span class="section-label">{t.ripple.sectionLabel}</span>
            <h2 class="headline-md">{t.ripple.headline}</h2>
          </div>
          <div class="os-ripple-steps">
            {t.ripple.steps.map((s) => (
              <div class="os-ripple-step">
                <div class="os-ripple-num">{s.step}</div>
                <div class="os-ripple-content">
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ NUMBERS -->
    <section class="section os-numbers fade-in">
      <div class="container">
        <div class="os-numbers-grid">
          {t.numbers.items.map((n) => (
            <div class="os-number-card">
              <span class="os-number-val">{n.val}</span>
              <span class="os-number-label">{n.label}</span>
              <span class="os-number-sub">{n.sub}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═════════════════════════════════════════════════ CLOSING CTA -->
    <section class="section os-closing fade-in">
      <div class="container narrow">
        <span class="section-label">{t.closing.sectionLabel}</span>
        <h2 class="headline-md">
          {t.closing.headlineLine1}<br />{t.closing.headlineLine2}
        </h2>
        {t.closing.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        <a href="https://start.pagayo.app/register" class="btn btn-primary btn-lg os-closing-cta">
          {t.closing.cta}
        </a>
        <p class="os-closing-links">
          {t.closing.linksPrefix}
          <a href={t.closing.linksHref}>{t.closing.linksText}</a>
        </p>
      </div>
    </section>

    <FinalCta locale={locale} />
  </main>
