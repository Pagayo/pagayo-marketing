---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'gym' | 'ngo' | 'partner';
  size?: 'md' | 'lg';
  className?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  className = ''
} = Astro.props as Props;
---
<a href={href} class={`btn btn-${variant} ${size === 'lg' ? 'btn-lg' : ''} ${className}`.trim()}>
  <slot />
</a>
