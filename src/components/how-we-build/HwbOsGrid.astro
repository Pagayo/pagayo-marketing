---
import content from '../../content/how-we-build.json';

const { operatingSystem: os } = content;
---

<section class="section hwb-os fade-in" aria-labelledby="hwb-os-heading">
  <div class="container">
    <div class="section-header center hwb-os-header">
      <span class="section-label">{os.label}</span>
      <h2 class="headline-md" id="hwb-os-heading">{os.headline}</h2>
      <p class="text-lg hwb-os-intro">{os.intro}</p>
    </div>

    <div class="hwb-os-diagram" aria-hidden="true">
      <svg viewBox="0 0 800 120" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="hwbHubLine" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#6366f1" stop-opacity="0.08" />
            <stop offset="50%" stop-color="#818cf8" stop-opacity="0.45" />
            <stop offset="100%" stop-color="#6366f1" stop-opacity="0.08" />
          </linearGradient>
        </defs>
        <line x1="80" y1="60" x2="720" y2="60" stroke="url(#hwbHubLine)" stroke-width="1.5" />
        <circle cx="400" cy="60" r="36" fill="#18181b" stroke="#635BFF" stroke-width="1.5" stroke-opacity="0.6" />
        <circle cx="400" cy="60" r="36" fill="#635BFF" fill-opacity="0.08" />
        <text x="400" y="56" text-anchor="middle" fill="#fafafa" font-size="11" font-weight="700"
          font-family="ui-monospace, monospace">dev</text>
        <text x="400" y="70" text-anchor="middle" fill="#71717a" font-size="9"
          font-family="ui-monospace, monospace">system</text>
        {[80, 200, 320, 480, 600, 720].map((x) => (
          <>
            <line x1={x} y1="60" x2={x} y2={x === 80 || x === 720 ? 28 : x === 200 || x === 600 ? 92 : 20}
              stroke="#27272a" stroke-width="1" />
            <circle cx={x} cy={x === 80 || x === 720 ? 28 : x === 200 || x === 600 ? 92 : 20} r="6"
              fill="#6366f1" fill-opacity="0.35" />
          </>
        ))}
      </svg>
    </div>

    <ul class="hwb-os-grid">
      {os.pillars.map((pillar) => (
        <li class="hwb-os-card">
          <span class="hwb-os-num">{pillar.num}</span>
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
          {pillar.proofHref && (
            <a href={pillar.proofHref} class="hwb-os-proof">{pillar.proofLabel}</a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
