---
import MarketingLayout from '../layouts/Marketing.astro';
import PageHero from '../components/layout/PageHero.astro';
import storyData from '../content/build-log.json';

const pageTitle = 'Build Log — Pagayo';
const pageDescription = 'How Pagayo was built: from a single repository to a fully edge-native multi-tenant platform. A transparent week-by-week log of continuous development.';
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main class="build-log">

    <!-- Hero -->
    <PageHero label="Build Log" headingSize="lg">
      <Fragment slot="title">Built every day.<br />Shipped every week.</Fragment>
      <p class="text-lg" slot="intro">
        Pagayo is a living platform. New features, new modules, new
        improvements ship continuously — driven by what the people who
        actually use it ask for. This is a transparent week-by-week log
        of how the platform grew, and how it keeps growing.
      </p>

      <div class="os-stats">
        {storyData.stats.map((stat) => (
          <div class="os-stat-card">
            <span class="os-stat-value">{stat.value}</span>
            <span class="os-stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </PageHero>

    <!-- Intro -->
    <section class="os-intro section">
      <div class="container">
        <div class="os-intro-text">
          <p>
            From day one, every change went through a pull request. Every
            deployment was automated. Every piece of infrastructure was
            provisioned as code — not because it was the easy path, but
            because it was the right one.
          </p>
          <p>
            The result is a platform built on Cloudflare's global edge
            network: no servers to manage, no downtime windows, no single
            point of failure. CI/CD from commit one. Automated testing from
            the start. A codebase built to ship weekly, indefinitely.
          </p>
          <p>
            The timeline below is not marketing. It is what actually
            happened — and it keeps getting longer.
          </p>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="os-timeline-section section">
      <div class="container">
        <div class="os-timeline">
          {storyData.timeline.map((item, i) => (
            <div class="os-timeline-item fade-in">
              <div class="os-timeline-marker-col">
                <span class="os-marker">{item.marker}</span>
                {i < storyData.timeline.length - 1 && (
                  <div class="os-timeline-connector" />
                )}
              </div>
              <div class="os-timeline-content">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="os-closing section">
      <div class="container">
        <div class="os-closing-inner">
          <p class="text-lg">
            Got an idea, a question, or a feature you wish existed? Pagayo
            grows from what the people using it ask for — we'd love to
            hear from you.
          </p>
          <a href="/contact" class="os-contact-link">
            Get in touch →
          </a>
        </div>
      </div>
    </section>

  </main>
</MarketingLayout>
