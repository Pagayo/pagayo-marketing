---
import MarketingLayout from '../layouts/Marketing.astro';
import PoweredByContactMain from '../components/powered-by/PoweredByContactMain.astro';
import { loadPoweredByContact } from '../lib/powered-by-contact';
import { SITE_ORIGIN } from '../lib/site-seo';

const locale = 'en';
const content = loadPoweredByContact(locale);

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: content.title,
  description: content.description,
  url: new URL('/powered-by-contact', SITE_ORIGIN).href,
  inLanguage: content.inLanguage,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Pagayo',
    url: SITE_ORIGIN,
  },
};
---

<MarketingLayout
  locale={locale}
  alternatePageId="poweredByContact"
  title={content.title}
  description={content.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <PoweredByContactMain content={content} privacyPath="/privacy-policy" />
</MarketingLayout>
