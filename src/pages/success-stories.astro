---
import MarketingLayout from '../layouts/Marketing.astro';
import PageBackdrop from '../components/layout/PageBackdrop.astro';
import PageHero from '../components/layout/PageHero.astro';
import SuccessStoriesFeed from '../components/success-stories/SuccessStoriesFeed.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import i18nEn from '../content/i18n/en.json';

const t = i18nEn.successStoriesPage;
---

<MarketingLayout title={t.title} description={t.description}>
  <PageBackdrop variant="partners" />

  <main class="success-stories-page">
    <PageHero label={t.sectionLabel} headingId="success-stories-title">
      <Fragment slot="title">{t.headline}</Fragment>
      <p class="text-lg" slot="intro">{t.intro}</p>
    </PageHero>

    <section class="section success-stories-body" aria-label={t.feedAriaLabel}>
      <div class="container">
        <SuccessStoriesFeed />
      </div>
    </section>

    <FinalCta />
  </main>
</MarketingLayout>
