---
import MarketingLayout from '../layouts/Marketing.astro';
import PageBackdrop from '../components/layout/PageBackdrop.astro';
import SuccessStoriesFeed from '../components/success-stories/SuccessStoriesFeed.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import i18nEn from '../content/i18n/en.json';

const t = i18nEn.successStoriesPage;
---

<MarketingLayout title={t.title} description={t.description}>
  <PageBackdrop variant="partners" />

  <main class="success-stories-page">
    <section class="section success-stories-hero fade-in" aria-labelledby="success-stories-title">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">{t.sectionLabel}</span>
          <h1 class="headline-xl" id="success-stories-title">{t.headline}</h1>
          <p class="text-lg">{t.intro}</p>
        </div>
      </div>
    </section>

    <section class="section success-stories-body" aria-label={t.feedAriaLabel}>
      <div class="container">
        <SuccessStoriesFeed />
      </div>
    </section>

    <FinalCta />
  </main>
</MarketingLayout>

<style>
  .success-stories-hero {
    padding-top: calc(var(--nav-height) + 3rem);
    padding-bottom: 1rem;
    text-align: center;
  }

  .success-stories-body {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
</style>
