---
/**
 * IE Home Page - /ie/
 * Loads content from src/content/pages/en/home.json
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import homeContent from '../../content/pages/en/home.json';
import headerContent from '../../content/header.json';
import footerContent from '../../content/footer.json';
---

<BaseLayout 
  title={homeContent.title}
  description={homeContent.description}
  lang="en"
  alternates={homeContent.seo.alternates}
  ogImage={homeContent.seo.ogImage}
  ogType={homeContent.seo.ogType}
  twitterCard={homeContent.seo.twitterCard}
  noIndex={homeContent.seo.noIndex}
  structuredData={[{ type: homeContent.seo.structuredData.type as 'WebSite', data: { name: homeContent.seo.structuredData.name, url: homeContent.seo.structuredData.url } }]}
>
  <!-- Header -->
  <header class="header">
    <div class="header-container">
      <a href="/ie/" class="logo">{headerContent.logo}</a>
      <nav class="nav">
        {headerContent.nav.en.map(item => (
          <a href={item.url} class="nav-link">{item.label}</a>
        ))}
      </nav>
      <a href={headerContent.cta.en.url} class="header-cta">
        {headerContent.cta.en.label}
      </a>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-container">
        <span class="eyebrow">{homeContent.hero.eyebrow}</span>
        <h1>{homeContent.hero.headline}</h1>
        <p class="subheadline">{homeContent.hero.subheadline}</p>
        <div class="hero-cta">
          <a href={homeContent.hero.primaryCta.url} class="btn btn-primary">
            {homeContent.hero.primaryCta.label}
          </a>
          <a href={homeContent.hero.secondaryCta.url} class="btn btn-secondary">
            {homeContent.hero.secondaryCta.label}
          </a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features">
      <div class="features-container">
        <div class="features-grid">
          {homeContent.features.map(feature => (
            <div class="feature-card">
              <span class="feature-icon">{feature.icon}</span>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Social Proof -->
    <section class="social-proof">
      <div class="social-proof-container">
        <h2>{homeContent.socialProof.headline}</h2>
        <div class="stats-grid">
          {homeContent.socialProof.stats.map(stat => (
            <div class="stat">
              <span class="stat-number">{stat.number}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="cta-container">
        <h2>{homeContent.cta.headline}</h2>
        <p>{homeContent.cta.description}</p>
        <a href="https://start.pagayo.app/register" class="btn btn-primary">
          {homeContent.cta.buttonLabel}
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-container">
      <p class="footer-tagline">{footerContent.tagline.en}</p>
      <p class="footer-copyright">{footerContent.copyright.en}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Header */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    z-index: 100;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: #667eea;
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: #4a5568;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #667eea;
  }

  .header-cta {
    background: #667eea;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .header-cta:hover {
    background: #5a67d8;
    transform: translateY(-1px);
  }

  /* Hero */
  .hero {
    padding: 10rem 2rem 6rem;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, white 100%);
  }

  .hero-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    background: #eef2ff;
    color: #667eea;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #1a202c;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .subheadline {
    font-size: 1.25rem;
    color: #4a5568;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #667eea;
    color: white;
  }

  .btn-primary:hover {
    background: #5a67d8;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
  }

  .btn-secondary {
    background: white;
    color: #667eea;
    border: 2px solid #e2e8f0;
  }

  .btn-secondary:hover {
    border-color: #667eea;
  }

  /* Features */
  .features {
    padding: 6rem 2rem;
  }

  .features-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    background: white;
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    transition: all 0.3s;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
  }

  .feature-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 0.75rem;
  }

  .feature-card p {
    color: #4a5568;
    line-height: 1.6;
  }

  /* Social Proof */
  .social-proof {
    padding: 6rem 2rem;
    background: #f8fafc;
  }

  .social-proof-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .social-proof h2 {
    font-size: 2rem;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 3rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 800;
    color: #667eea;
  }

  .stat-label {
    color: #4a5568;
    font-size: 1rem;
  }

  /* CTA Section */
  .cta-section {
    padding: 6rem 2rem;
    text-align: center;
  }

  .cta-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-section h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #1a202c;
    margin-bottom: 1rem;
  }

  .cta-section p {
    color: #4a5568;
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  /* Footer */
  .footer {
    padding: 3rem 2rem;
    background: #1a202c;
    text-align: center;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.5rem;
  }

  .footer-copyright {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav {
      display: none;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding: 8rem 1rem 4rem;
    }
  }
</style>
