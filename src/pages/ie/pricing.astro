---
/**
 * IE Pricing Page - /ie/pricing
 * Loads content from src/content/pages/en/pricing.json
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import pricingContent from '../../content/pages/en/pricing.json';
import headerContent from '../../content/header.json';
import footerContent from '../../content/footer.json';
---

<BaseLayout 
  title={pricingContent.title}
  description={pricingContent.description}
  lang="en"
  alternates={pricingContent.seo.alternates}
  ogImage={pricingContent.seo.ogImage}
  ogType={pricingContent.seo.ogType}
  twitterCard={pricingContent.seo.twitterCard}
  noIndex={pricingContent.seo.noIndex}
  structuredData={[{ type: pricingContent.seo.structuredData.type as 'WebPage', data: { name: pricingContent.seo.structuredData.name, url: pricingContent.seo.structuredData.url } }]}
>
  <!-- Header -->
  <header class="header">
    <div class="header-container">
      <a href="/ie/" class="logo">{headerContent.logo}</a>
      <nav class="nav">
        {headerContent.nav.en.map(item => (
          <a href={item.url} class="nav-link">{item.label}</a>
        ))}
      </nav>
      <a href={headerContent.cta.en.url} class="header-cta">
        {headerContent.cta.en.label}
      </a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-container">
        <h1>{pricingContent.hero.headline}</h1>
        <p class="subheadline">{pricingContent.hero.subheadline}</p>
      </div>
    </section>

    <!-- Pricing Cards -->
    <section class="pricing">
      <div class="pricing-container">
        <div class="pricing-grid">
          {pricingContent.plans.map(plan => (
            <div class={`pricing-card ${plan.highlighted ? 'highlighted' : ''}`}>
              {plan.highlighted && <span class="popular-badge">Most Popular</span>}
              <h3>{plan.name}</h3>
              <div class="price">
                <span class="amount">{plan.price}</span>
                {plan.period && <span class="period">{plan.period}</span>}
              </div>
              <p class="plan-description">{plan.description}</p>
              <ul class="features-list">
                {plan.features.map(feature => (
                  <li>✓ {feature}</li>
                ))}
              </ul>
              <a href={plan.cta.url} class={`btn ${plan.highlighted ? 'btn-primary' : 'btn-secondary'}`}>
                {plan.cta.label}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="faq-container">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-grid">
          {pricingContent.faq.map(item => (
            <div class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-container">
      <p class="footer-tagline">{footerContent.tagline.en}</p>
      <p class="footer-copyright">{footerContent.copyright.en}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Header */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    z-index: 100;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: #667eea;
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: #4a5568;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #667eea;
  }

  .header-cta {
    background: #667eea;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .header-cta:hover {
    background: #5a67d8;
  }

  /* Hero */
  .hero {
    padding: 10rem 2rem 4rem;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, white 100%);
  }

  .hero-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #1a202c;
    margin-bottom: 1rem;
  }

  .subheadline {
    font-size: 1.25rem;
    color: #4a5568;
  }

  /* Pricing */
  .pricing {
    padding: 4rem 2rem 6rem;
  }

  .pricing-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    align-items: start;
  }

  .pricing-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2.5rem;
    position: relative;
    transition: all 0.3s;
  }

  .pricing-card.highlighted {
    border-color: #667eea;
    box-shadow: 0 8px 32px rgba(102, 126, 234, 0.15);
    transform: scale(1.02);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #667eea;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .pricing-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 1rem;
  }

  .price {
    margin-bottom: 1rem;
  }

  .amount {
    font-size: 3rem;
    font-weight: 800;
    color: #667eea;
  }

  .period {
    color: #4a5568;
    font-size: 1rem;
  }

  .plan-description {
    color: #4a5568;
    margin-bottom: 1.5rem;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin-bottom: 2rem;
  }

  .features-list li {
    padding: 0.5rem 0;
    color: #4a5568;
  }

  .btn {
    display: block;
    text-align: center;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #667eea;
    color: white;
  }

  .btn-primary:hover {
    background: #5a67d8;
  }

  .btn-secondary {
    background: white;
    color: #667eea;
    border: 2px solid #e2e8f0;
  }

  .btn-secondary:hover {
    border-color: #667eea;
  }

  /* FAQ */
  .faq {
    padding: 6rem 2rem;
    background: #f8fafc;
  }

  .faq-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq h2 {
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
  }

  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-item {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  .faq-item h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1a202c;
    margin-bottom: 0.5rem;
  }

  .faq-item p {
    color: #4a5568;
  }

  /* Footer */
  .footer {
    padding: 3rem 2rem;
    background: #1a202c;
    text-align: center;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.5rem;
  }

  .footer-copyright {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .nav { display: none; }
    .pricing-card.highlighted { transform: none; }
  }
</style>
