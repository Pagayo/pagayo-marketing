---
import MarketingLayout from '../layouts/Marketing.astro';

const pageTitle = 'Start a Cohort Program — Pagayo';
const pageDescription = 'Request a cohort proposal, book a sponsor demo, or ask about country coverage. We respond within one business day.';
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main class="ic-page">

    <section class="ic-hero section">
      <div class="container">
        <a href="/impact" class="ic-back">← Back to Impact Engine</a>
        <div class="section-header center">
          <span class="section-label impact-label">For Organisations That Fund Entrepreneurship</span>
          <h1 class="headline-lg">
            Let's build your<br />
            <span class="ic-headline-accent">cohort program.</span>
          </h1>
          <p class="text-lg">
            Tell us your region, sector, and cohort size. We'll confirm country
            coverage and send a concrete program outline — before any commitment.
          </p>
        </div>
      </div>
    </section>

    <section class="ic-body section">
      <div class="container">
        <div class="ic-layout">

          <!-- Info column -->
          <div class="ic-info">
            <div class="ic-info-item">
              <span class="ic-info-icon">📋</span>
              <div>
                <strong>Cohort Proposal</strong>
                <p>Pricing, timeline, and coverage for your board or steering committee.</p>
              </div>
            </div>
            <div class="ic-info-item">
              <span class="ic-info-icon">📺</span>
              <div>
                <strong>Sponsor Demo</strong>
                <p>Live walkthrough of the Impact Dashboard — no commitment required.</p>
              </div>
            </div>
            <div class="ic-info-item">
              <span class="ic-info-icon">🌍</span>
              <div>
                <strong>Country Coverage</strong>
                <p>We operate in West and East Africa. Ask about your specific market.</p>
              </div>
            </div>
            <div class="ic-info-item">
              <span class="ic-info-icon">⚡</span>
              <div>
                <strong>Response time</strong>
                <p>Within one business day.</p>
              </div>
            </div>

            <div class="ic-tagline">
              <p>
                Pagayo is a single-developer platform built entirely on
                Cloudflare's edge network. You will always talk to someone who
                actually built it.
              </p>
            </div>
          </div>

          <!-- Form column -->
          <div class="ic-form-wrap">
            <form id="ic-form" class="ic-form" novalidate>
              <!-- Honeypot -->
              <div style="display:none" aria-hidden="true">
                <label for="website">Leave this empty</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <div class="ic-row">
                <div class="ic-field">
                  <label for="name">Full name <span class="required">*</span></label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Jane Smith"
                    autocomplete="name"
                    required
                    maxlength="120"
                  />
                </div>
                <div class="ic-field">
                  <label for="email">Work email <span class="required">*</span></label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="jane@organisation.org"
                    autocomplete="email"
                    required
                    maxlength="254"
                  />
                </div>
              </div>

              <div class="ic-row">
                <div class="ic-field">
                  <label for="company">Organisation <span class="optional">(optional)</span></label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    placeholder="Your NGO, foundation, or agency"
                    autocomplete="organization"
                    maxlength="120"
                  />
                </div>
                <div class="ic-field">
                  <label for="region">Region <span class="optional">(optional)</span></label>
                  <input
                    type="text"
                    id="region"
                    name="region"
                    placeholder="e.g. Nairobi, Ghana, West Africa"
                    maxlength="120"
                  />
                </div>
              </div>

              <div class="ic-field">
                <label for="subject">I'm interested in <span class="required">*</span></label>
                <select id="subject" name="subject" required>
                  <option value="" disabled selected>Select a topic…</option>
                  <option value="Cohort Proposal Request">Cohort Proposal Request</option>
                  <option value="Sponsor Demo">Sponsor Demo</option>
                  <option value="Country Coverage Question">Country Coverage Question</option>
                  <option value="Partner Organisation Inquiry">Partner Organisation Inquiry</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="ic-field">
                <label for="message">Tell us about your program <span class="required">*</span></label>
                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  placeholder="Region, sector, estimated cohort size, timeline…"
                  required
                  minlength="10"
                  maxlength="5000"
                ></textarea>
              </div>

              <div class="ic-form-footer">
                <p class="ic-privacy-note">
                  By submitting you agree to our
                  <a href="/privacy-policy">Privacy Policy</a>.
                  We only use your information to respond to your enquiry.
                </p>
                <button type="submit" class="ic-submit" id="submit-btn">
                  <span class="ic-submit-label">Send message</span>
                  <span class="ic-submit-spinner" aria-hidden="true" hidden>…</span>
                </button>
              </div>

              <div id="ic-success" class="ic-status ic-success" hidden role="status">
                <strong>Message sent!</strong> We will get back to you within one business day.
              </div>
              <div id="ic-error" class="ic-status ic-error" hidden role="alert">
                Something went wrong. Please try again or email
                <a href="mailto:info@pagayo.com">info@pagayo.com</a>.
              </div>
            </form>
          </div>

        </div>
      </div>
    </section>

  </main>
</MarketingLayout>

<script src="../scripts/pages/impact-contact.ts"></script>
