---
import MarketingLayout from '../layouts/Marketing.astro';
import FinalCta from '../components/sections/FinalCta.astro';

const pageTitle = 'Pagayo on Stripe — Payments that simply work';
const pageDescription =
  'How Pagayo uses Stripe to handle every payment, subscription, invoice and payout — securely, globally, and with zero PCI burden on you.';

const methods = [
  { code: 'Cards',        tag: 'Global',  desc: 'Visa, Mastercard, Amex, Discover. Every country, one integration.' },
  { code: 'iDEAL',        tag: 'NL',      desc: 'The default checkout for every Dutch shopper.' },
  { code: 'Bancontact',   tag: 'BE',      desc: 'One-click bank payments for Belgian customers.' },
  { code: 'SEPA',         tag: 'EU',      desc: 'Direct debits across the eurozone, fully mandated.' },
  { code: 'Apple Pay',    tag: 'Wallet',  desc: 'One-touch checkout on iPhone and Mac, biometric auth.' },
  { code: 'Google Pay',   tag: 'Wallet',  desc: 'Saved cards in any Android or Chrome environment.' },
  { code: 'Klarna',       tag: 'BNPL',    desc: 'Pay later, in 3, or in 30 days — Stripe handles the risk.' },
  { code: 'Link',         tag: 'Express', desc: 'Saved Stripe checkout across millions of merchants.' },
  { code: 'PayPal',       tag: 'Wallet',  desc: 'Familiar checkout for international shoppers.' },
  { code: 'SOFORT',       tag: 'EU',      desc: 'Bank-redirect payments for Germany, Austria, Switzerland.' },
  { code: 'EPS · P24',    tag: 'EU',      desc: 'Local bank methods for Austria and Poland.' },
  { code: 'Multibanco',   tag: 'PT',      desc: 'Reference-based payments for Portuguese shoppers.' },
];

const layers = [
  {
    slug: 'checkout',
    title: 'Checkout that converts',
    role: 'Payment Element · Checkout',
    accent: '#635BFF',
    accentSoft: 'rgba(99, 91, 255, 0.18)',
    tagline: 'The right payment method, in the right currency, every time.',
    body: `Pagayo uses Stripe's Payment Element — the same checkout engine that powers Shopify, Substack, and Amazon. It detects the customer's country and shows the methods they actually use: iDEAL in Amsterdam, Bancontact in Brussels, Klarna in Berlin, Apple Pay everywhere a Mac or iPhone is involved. One integration, every market, automatic localisation, and a checkout that gets better every time Stripe ships an update.`,
    bullets: [
      'Auto-detects country, language, and best methods',
      'Apple Pay, Google Pay, Link with one toggle',
      '3D Secure handled invisibly when required',
    ],
  },
  {
    slug: 'subscriptions',
    title: 'Subscriptions, done right',
    role: 'Billing · Invoicing',
    accent: '#06b6d4',
    accentSoft: 'rgba(6, 182, 212, 0.18)',
    tagline: 'Recurring revenue without the spreadsheets.',
    body: `Memberships, family plans, sponsored access, monthly boxes — every recurring product in Pagayo runs on Stripe Billing. Stripe handles renewals, retries on failed cards, dunning emails, proration when someone upgrades, and refunds when they don't. The Pagayo admin shows the result; Stripe does the work behind the scenes. Cancellations are one click and immediate.`,
    bullets: [
      'Automatic retries with smart dunning',
      'Proration on upgrades, downgrades, plan changes',
      'Mandates stored — no card re-entry on renewal',
    ],
  },
  {
    slug: 'webhooks',
    title: 'Webhooks, durably handled',
    role: 'Webhooks · Workers',
    accent: '#10a37f',
    accentSoft: 'rgba(16, 163, 127, 0.18)',
    tagline: 'Every event, signed, verified, and processed exactly once.',
    body: `Stripe fires a webhook for everything that matters — payment succeeded, charge refunded, subscription updated, dispute opened, invoice paid. Pagayo receives them on a Cloudflare Worker, verifies the signature, makes the change idempotent, and either updates the database immediately or hands the work off to a Queue. Retries are safe. Replays are safe. Nothing happens twice.`,
    bullets: [
      'Signature verification on every event',
      'Idempotent handlers, safe to retry',
      'Queues + Workflows for heavy follow-up work',
    ],
  },
  {
    slug: 'payouts',
    title: 'Money in your bank account',
    role: 'Connect · Payouts',
    accent: '#d97757',
    accentSoft: 'rgba(217, 119, 87, 0.18)',
    tagline: 'From customer card to your IBAN, on schedule.',
    body: `Stripe takes the customer's payment, settles it, deducts the fee, and deposits the rest in your bank account on the schedule you set. Daily, weekly, monthly — your choice. You see every payout, every fee, every refund, broken down by order in both the Stripe dashboard and Pagayo's own reporting. No reconciliation spreadsheets. No "what was that deposit on the 14th?".`,
    bullets: [
      'Daily, weekly, or monthly payout cadence',
      'Per-order fee breakdown inside Pagayo',
      'Multi-currency settlement where supported',
    ],
  },
  {
    slug: 'tax',
    title: 'Tax, calculated correctly',
    role: 'Stripe Tax',
    accent: '#818cf8',
    accentSoft: 'rgba(129, 140, 248, 0.2)',
    tagline: 'The right rate, the right country, the right invoice.',
    body: `VAT rules are not getting simpler. Stripe Tax watches the customer's location, the product type, and the latest rates in every country, and applies the correct tax at checkout — reverse-charge for B2B, OSS for cross-border EU, the local rate at home. Pagayo passes the totals straight into the invoice and the books. You handle the rest with your accountant; the numbers are already right.`,
    bullets: [
      'Live VAT rates in 40+ countries',
      'Reverse-charge and OSS handled automatically',
      'Invoice totals always match the payment',
    ],
  },
  {
    slug: 'security',
    title: 'Security you never see',
    role: 'PCI · 3DS · Radar',
    accent: '#fbbf24',
    accentSoft: 'rgba(251, 191, 36, 0.2)',
    tagline: 'PCI compliance, fraud protection, all of it — included.',
    body: `Card numbers never touch a Pagayo server. They go directly from the customer's browser to Stripe, tokenised, vaulted, and returned as a reference Pagayo can charge later. That puts Pagayo at the lowest PCI tier (SAQ-A) by design. On top of that, Stripe Radar scores every transaction for fraud risk, 3D Secure is triggered when needed, and chargebacks come with the evidence template already filled in.`,
    bullets: [
      'Card data never enters the Pagayo platform',
      'Radar fraud scoring on every transaction',
      'Strong Customer Authentication built in',
    ],
  },
];
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main class="st-page">

    <!-- Hero -->
    <section class="hero section st-hero" id="hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1" style="background: #635BFF;"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-orb hero-orb-3"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse" style="background:#635BFF;"></span>
          Every payment, powered by Stripe
        </div>

        <h1 class="headline-xl">
          Payments that<br />
          <span class="text-gradient st-gradient">simply work.</span>
        </h1>

        <p>
          Pagayo doesn't write payment code — Pagayo writes commerce code,
          and lets Stripe do the part that absolutely must be right. Every
          card, every wallet, every subscription, every payout. From the
          customer's tap to your bank account, Stripe handles the entire
          path.
        </p>

        <!-- Money flow -->
        <div class="st-flow" aria-hidden="true">
          <svg viewBox="0 0 900 260" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="stFlowLine" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#635BFF" stop-opacity="0" />
                <stop offset="50%" stop-color="#635BFF" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
              </linearGradient>
              <radialGradient id="stFlowGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#635BFF" stop-opacity="0.18" />
                <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
              </radialGradient>
            </defs>
            <ellipse cx="450" cy="130" rx="430" ry="110" fill="url(#stFlowGlow)" />

            <!-- Connecting path -->
            <path d="M 80 130 Q 280 60, 450 130 T 820 130"
              stroke="url(#stFlowLine)" stroke-width="2" fill="none" />

            <!-- 4 nodes -->
            <!-- Customer -->
            <g transform="translate(80,130)">
              <circle r="38" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
              <circle cx="0" cy="-6" r="7" fill="#06b6d4" />
              <path d="M -13 14 Q 0 4 13 14 L 13 22 L -13 22 Z" fill="#06b6d4" />
              <text x="0" y="68" text-anchor="middle" fill="#cbd5e1" font-size="11" font-weight="600" font-family="system-ui">Customer</text>
            </g>
            <!-- Pagayo -->
            <g transform="translate(330,90)">
              <circle r="38" fill="#0f172a" stroke="#6366f1" stroke-width="1.5" />
              <text x="0" y="5" text-anchor="middle" fill="#a5b4fc" font-size="11" font-weight="700" font-family="ui-monospace, monospace">Pagayo</text>
              <text x="0" y="-44" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="system-ui">checkout</text>
            </g>
            <!-- Stripe -->
            <g transform="translate(570,130)">
              <circle r="44" fill="#0f172a" stroke="#635BFF" stroke-width="2" />
              <text x="0" y="5" text-anchor="middle" fill="#818cf8" font-size="12" font-weight="700" font-family="ui-monospace, monospace">Stripe</text>
              <text x="0" y="74" text-anchor="middle" fill="#cbd5e1" font-size="11" font-weight="600" font-family="system-ui">tokenise · charge</text>
            </g>
            <!-- Bank -->
            <g transform="translate(820,130)">
              <circle r="38" fill="#0f172a" stroke="#10a37f" stroke-width="1.5" />
              <!-- bank icon -->
              <path d="M -16 -4 L 0 -16 L 16 -4 L 16 0 L -16 0 Z" fill="#10a37f" />
              <line x1="-12" y1="2" x2="-12" y2="16" stroke="#10a37f" stroke-width="2.5" />
              <line x1="-4" y1="2" x2="-4" y2="16" stroke="#10a37f" stroke-width="2.5" />
              <line x1="4" y1="2" x2="4" y2="16" stroke="#10a37f" stroke-width="2.5" />
              <line x1="12" y1="2" x2="12" y2="16" stroke="#10a37f" stroke-width="2.5" />
              <line x1="-16" y1="18" x2="16" y2="18" stroke="#10a37f" stroke-width="2.5" />
              <text x="0" y="68" text-anchor="middle" fill="#cbd5e1" font-size="11" font-weight="600" font-family="system-ui">Your bank</text>
            </g>

            <!-- Step labels -->
            <text x="195" y="200" text-anchor="middle" fill="#64748b" font-size="10" font-family="ui-monospace, monospace">1 · pays</text>
            <text x="430" y="50" text-anchor="middle" fill="#64748b" font-size="10" font-family="ui-monospace, monospace">2 · tokenise</text>
            <text x="690" y="200" text-anchor="middle" fill="#64748b" font-size="10" font-family="ui-monospace, monospace">3 · payout</text>
          </svg>
        </div>

        <!-- Stat row -->
        <div class="st-stats">
          <div class="st-stat">
            <div class="st-stat-num">15+</div>
            <div class="st-stat-label">Payment methods, one toggle</div>
          </div>
          <div class="st-stat">
            <div class="st-stat-num">SAQ-A</div>
            <div class="st-stat-label">Lowest PCI burden, by design</div>
          </div>
          <div class="st-stat">
            <div class="st-stat-num">0</div>
            <div class="st-stat-label">Card numbers on Pagayo servers</div>
          </div>
          <div class="st-stat">
            <div class="st-stat-num">40+</div>
            <div class="st-stat-label">Countries with live tax rates</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Methods strip -->
    <section class="section st-methods-section">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">Payment methods</span>
          <h2 class="headline-md">Whatever your customer wants to pay with.</h2>
          <p class="text-lg">
            Cards, wallets, bank redirects, buy-now-pay-later, local
            methods — every payment method Stripe supports is one toggle
            away in Pagayo. New methods land in your shop the same day
            Stripe ships them.
          </p>
        </div>

        <ul class="st-methods-grid">
          {methods.map((m) => (
            <li class="st-method">
              <div class="st-method-head">
                <span class="st-method-code">{m.code}</span>
                <span class="st-method-tag">{m.tag}</span>
              </div>
              <p>{m.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Layers -->
    <section class="section st-layers">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">How it fits together</span>
          <h2 class="headline-lg">Six layers, end to end.</h2>
          <p class="text-lg">
            Checkout, subscriptions, webhooks, payouts, tax, security —
            every part of the money flow runs on Stripe primitives. Here
            is what each one does for you.
          </p>
        </div>

        {layers.map((l, idx) => (
          <article
            class={`st-row ${idx % 2 === 1 ? 'reverse' : ''}`}
            id={l.slug}
            style={`--accent: ${l.accent}; --accent-soft: ${l.accentSoft};`}
          >
            <div class="st-text">
              <div class="st-meta">
                <span class="st-tag">0{idx + 1}</span>
                <span class="st-role">{l.role}</span>
              </div>
              <h3 class="st-title">{l.title}</h3>
              <p class="st-tagline">{l.tagline}</p>
              <p class="st-body">{l.body}</p>
              <ul class="st-bullets">
                {l.bullets.map((b) => (
                  <li><span class="st-dot"></span>{b}</li>
                ))}
              </ul>
            </div>

            <div class="st-visual">
              <div class="st-frame">
                {l.slug === 'checkout' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="chkGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.32" />
                        <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
                      </radialGradient>
                      <linearGradient id="chkPay" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#635BFF" />
                        <stop offset="100%" stop-color="#818cf8" />
                      </linearGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#chkGlow)" />
                    <!-- Phone -->
                    <rect x="100" y="30" width="200" height="270" rx="22" fill="#0f172a" stroke="#635BFF" stroke-width="1.5" />
                    <rect x="160" y="40" width="80" height="6" rx="3" fill="#1e293b" />
                    <!-- Order summary -->
                    <text x="120" y="78" fill="#94a3b8" font-size="9" font-family="ui-monospace, monospace">ORDER · €48.50</text>
                    <line x1="118" y1="86" x2="282" y2="86" stroke="#334155" />
                    <!-- Pay buttons stack -->
                    <rect x="118" y="100" width="164" height="34" rx="8" fill="#000" />
                    <text x="200" y="121" text-anchor="middle" fill="#fff" font-size="11" font-weight="700" font-family="system-ui">Apple Pay</text>
                    <rect x="118" y="142" width="164" height="34" rx="8" fill="#fff" />
                    <text x="200" y="163" text-anchor="middle" fill="#5f6368" font-size="11" font-weight="700" font-family="system-ui">G Pay</text>
                    <!-- divider -->
                    <line x1="118" y1="190" x2="186" y2="190" stroke="#334155" />
                    <text x="200" y="194" text-anchor="middle" fill="#64748b" font-size="9" font-family="system-ui">or</text>
                    <line x1="214" y1="190" x2="282" y2="190" stroke="#334155" />
                    <!-- iDEAL -->
                    <rect x="118" y="204" width="164" height="34" rx="8" fill="rgba(99,91,255,0.15)" stroke="#635BFF" stroke-width="1" />
                    <text x="135" y="225" fill="#818cf8" font-size="11" font-weight="700" font-family="system-ui">iDEAL</text>
                    <circle cx="265" cy="221" r="4" fill="#635BFF" />
                    <!-- Card -->
                    <rect x="118" y="246" width="164" height="34" rx="8" fill="#1e293b" stroke="#475569" stroke-width="1" />
                    <text x="135" y="267" fill="#cbd5e1" font-size="11" font-weight="700" font-family="system-ui">Card · •••• 4242</text>
                    <!-- Country tag -->
                    <rect x="118" y="60" width="40" height="14" rx="4" fill="rgba(99,91,255,0.18)" stroke="#635BFF" stroke-opacity="0.5" />
                    <text x="138" y="70" text-anchor="middle" fill="#818cf8" font-size="9" font-family="ui-monospace, monospace">NL</text>
                  </svg>
                )}

                {l.slug === 'subscriptions' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="subGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#06b6d4" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#subGlow)" />
                    <!-- Calendar -->
                    <rect x="60" y="50" width="280" height="220" rx="14" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
                    <rect x="60" y="50" width="280" height="36" rx="14" fill="#1e293b" />
                    <text x="80" y="74" fill="#cbd5e1" font-size="12" font-weight="700" font-family="system-ui">Membership · €19/mo</text>
                    <text x="320" y="74" text-anchor="end" fill="#10a37f" font-size="10" font-family="ui-monospace, monospace">active</text>
                    <!-- Grid of dates -->
                    <g font-family="ui-monospace, monospace" font-size="9" fill="#475569">
                      <text x="92" y="108">M</text><text x="124" y="108">T</text><text x="156" y="108">W</text><text x="188" y="108">T</text><text x="220" y="108">F</text><text x="252" y="108">S</text><text x="284" y="108">S</text>
                    </g>
                    {[0,1,2,3].map((row) => (
                      [0,1,2,3,4,5,6].map((col) => {
                        const day = row * 7 + col + 1;
                        const isCharge = day === 5 || day === 12 || day === 19 || day === 26;
                        const isToday = day === 19;
                        return (
                          <g>
                            <rect x={78 + col * 32} y={118 + row * 32} width="24" height="24" rx="4"
                              fill={isToday ? '#06b6d4' : (isCharge ? 'rgba(6,182,212,0.18)' : '#1e293b')}
                              stroke={isCharge ? '#06b6d4' : '#334155'} stroke-width="0.8" />
                            <text x={90 + col * 32} y={134 + row * 32} text-anchor="middle"
                              fill={isToday ? '#0f172a' : (isCharge ? '#67e8f9' : '#94a3b8')}
                              font-size="9" font-weight={isToday ? '700' : '400'} font-family="ui-monospace, monospace">{day}</text>
                          </g>
                        );
                      })
                    ))}
                    <!-- Bottom row -->
                    <text x="80" y="252" fill="#94a3b8" font-size="10" font-family="ui-monospace, monospace">next charge</text>
                    <text x="320" y="252" text-anchor="end" fill="#67e8f9" font-size="10" font-weight="700" font-family="ui-monospace, monospace">Jun 26 · €19.00</text>
                  </svg>
                )}

                {l.slug === 'webhooks' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="whGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#10a37f" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#10a37f" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#whGlow)" />
                    <!-- Stripe source -->
                    <g transform="translate(30,140)">
                      <rect width="90" height="40" rx="10" fill="rgba(99,91,255,0.18)" stroke="#635BFF" stroke-width="1.2" />
                      <text x="45" y="25" text-anchor="middle" fill="#818cf8" font-size="11" font-weight="700" font-family="ui-monospace, monospace">Stripe</text>
                    </g>
                    <!-- Arrow + signature -->
                    <line x1="120" y1="160" x2="170" y2="160" stroke="#10a37f" stroke-opacity="0.6" stroke-width="1.5" stroke-dasharray="4,3" />
                    <polygon points="170,160 162,156 162,164" fill="#10a37f" fill-opacity="0.8" />
                    <text x="145" y="148" text-anchor="middle" fill="#64748b" font-size="9" font-family="ui-monospace, monospace">signed</text>
                    <!-- Worker -->
                    <g transform="translate(175,135)">
                      <rect width="100" height="50" rx="10" fill="#0f172a" stroke="#10a37f" stroke-width="1.5" />
                      <text x="50" y="22" text-anchor="middle" fill="#6ee7b7" font-size="11" font-weight="700" font-family="ui-monospace, monospace">Worker</text>
                      <text x="50" y="38" text-anchor="middle" fill="#64748b" font-size="9" font-family="ui-monospace, monospace">verify · idem</text>
                    </g>
                    <!-- Event list -->
                    {[
                      { y: 40, label: 'payment_intent.succeeded', color: '#10a37f' },
                      { y: 80, label: 'invoice.paid', color: '#10a37f' },
                      { y: 200, label: 'charge.refunded', color: '#fbbf24' },
                      { y: 240, label: 'customer.subscription.updated', color: '#06b6d4' },
                      { y: 280, label: 'charge.dispute.created', color: '#ef4444' },
                    ].map((e) => (
                      <g>
                        <line x1="275" y1="160" x2="290" y2={e.y + 15} stroke={e.color} stroke-opacity="0.45" stroke-width="1" />
                        <rect x="290" y={e.y} width="100" height="28" rx="6" fill="#0f172a" stroke={e.color} stroke-width="1" stroke-opacity="0.7" />
                        <circle cx="302" cy={e.y + 14} r="3" fill={e.color} />
                        <text x="310" y={e.y + 18} fill={e.color} font-size="8.5" font-family="ui-monospace, monospace">{e.label}</text>
                      </g>
                    ))}
                  </svg>
                )}

                {l.slug === 'payouts' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="poGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#d97757" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#d97757" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#poGlow)" />
                    <!-- Statement card -->
                    <rect x="40" y="40" width="320" height="240" rx="14" fill="#0f172a" stroke="#d97757" stroke-width="1.5" />
                    <text x="58" y="68" fill="#cbd5e1" font-size="12" font-weight="700" font-family="system-ui">Payout · Jun 5, 2026</text>
                    <text x="342" y="68" text-anchor="end" fill="#fdba74" font-size="14" font-weight="700" font-family="ui-monospace, monospace">€2,847.12</text>
                    <line x1="58" y1="80" x2="342" y2="80" stroke="#334155" />
                    {[
                      { y: 100, label: 'Sales',             v: '€3,020.00', col: '#10a37f' },
                      { y: 128, label: 'Refunds',           v: '−€45.00',   col: '#ef4444' },
                      { y: 156, label: 'Stripe fees',       v: '−€87.88',   col: '#94a3b8' },
                      { y: 184, label: 'Disputes',          v: '€0.00',     col: '#94a3b8' },
