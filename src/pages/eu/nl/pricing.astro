---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeaderDynamic from '../../../components/HeaderDynamic.astro';
import FooterDynamic from '../../../components/FooterDynamic.astro';
import nlCountry from '../../../data/countries/nl.json';

const country = nlCountry;
---

<BaseLayout title="Prijzen - Pagayo" description="Eenvoudige prijzen die lager worden naarmate je meer omzet maakt." lang="nl">
	<HeaderDynamic country={country} />
	<main class="page-container container-narrow">
		<section class="section">
			<div class="section-header">
				<p class="eyebrow">Prijzen</p>
				<h1 class="section-title">Simpele, schaalbare prijzen</h1>
				<p class="section-subtitle">
					Je betaalt een klein percentage van je omzet. Hoe meer je verkoopt, hoe minder je procent wordt. Geen
					startkosten, geen verborgen regels.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="section-header">
				<p class="eyebrow">Prijsopbouw</p>
				<h2 class="section-title">Je betaalt alleen over wat je verkoopt</h2>
				<p class="section-subtitle">Geen omzet = geen kosten.</p>
			</div>

			<div class="feature-grid feature-grid--two">
				<div class="feature-card">
					<div class="feature-icon">1%</div>
					<h3>Tot €5.000 / maand</h3>
					<p>1% over de omzet tot €5.000 per maand.</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">0,8%</div>
					<h3>€5.000 – €10.000</h3>
					<p>0,8% over het deel tussen €5.000 en €10.000.</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">0,6%</div>
					<h3>€10.000 – €50.000</h3>
					<p>0,6% over het deel tussen €10.000 en €50.000.</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">0,5%</div>
					<h3>€50.000 – €100.000</h3>
					<p>0,5% over het deel tussen €50.000 en €100.000.</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-header">
				<p class="eyebrow">Inbegrepen</p>
				<h2 class="section-title">Altijd inbegrepen</h2>
				<p class="section-subtitle">Alles wat je nodig hebt om te starten en te schalen.</p>
			</div>

			<div class="feature-grid feature-grid--two">
				<div class="feature-card">
					<div class="feature-icon">✓</div>
					<p>Onbeperkt webshops, hotels, abonnementen en verhuur</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">✓</div>
					<p>Onbeperkt kassa's (POS) en eigen domeinen</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">✓</div>
					<p>Betalingen via Stripe, Mollie en Bunq</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">✓</div>
					<p>Backups, monitoring en support</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-header">
				<p class="eyebrow">FAQ</p>
				<h2 class="section-title">Veelgestelde vragen</h2>
				<p class="section-subtitle">Kort en duidelijk.</p>
			</div>

			<div class="feature-grid feature-grid--two">
				<div class="feature-card">
					<div class="feature-icon">💡</div>
					<p>Geen contractplicht: je kunt maandelijks stoppen.</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">💳</div>
					<p>Uitbetalingen lopen via je eigen betaalproviders.</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">🇳🇱</div>
					<p>Support in het Nederlands.</p>
				</div>
			</div>
		</section>

		<section class="cta">
			<div class="cta__content">
				<h2>Klaar om te starten?</h2>
				<p>Maak je account aan en je draait binnen 30 seconden. Geen gesprek nodig.</p>
				<div class="cta__actions">
					<a class="btn btn-primary" href="https://app.pagayo.com/register/">Start gratis</a>
					<a class="btn btn-ghost" href="/eu/nl/contact">Heb je vragen? Neem contact op</a>
				</div>
			</div>
		</section>
	</main>

	<FooterDynamic country={country} />
</BaseLayout>
