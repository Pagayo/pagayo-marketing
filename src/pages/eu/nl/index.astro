---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeaderDynamic from '../../../components/HeaderDynamic.astro';
import FooterDynamic from '../../../components/FooterDynamic.astro';
import { languages, switchLanguage, type Language } from '../../utils/i18n';
import nlCountry from '../../../data/countries/nl.json';
import '../../../styles/pages/home.css';

const currentLang: Language = 'nl';
const currentPath = '/nl';
const country = nlCountry;

// Hreflang alternates voor multi-language SEO
const alternates = [
  { lang: 'nl', hreflang: 'nl-NL', href: 'https://pagayo.com/eu/nl/' },
  { lang: 'de', hreflang: 'de-DE', href: 'https://pagayo.com/eu/de/' },
  { lang: 'en', hreflang: 'en-US', href: 'https://pagayo.com/us/en/' }
];

// Schema.org structured data voor Organization + WebSite
const structuredData = [
  {
    type: 'Organization',
    data: {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Pagayo',
      url: 'https://pagayo.com',
      logo: 'https://pagayo.com/og-image.svg',
      description: 'Multi-Tenant E-commerce Platform voor webshops, hotels en POS systemen',
      sameAs: [
        'https://www.linkedin.com/company/pagayo',
        'https://twitter.com/pagayo',
        'https://github.com/pagayo'
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Customer Service',
        email: 'support@pagayo.com',
        availableLanguage: ['nl', 'de', 'en']
      }
    }
  },
  {
    type: 'WebSite',
    data: {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Pagayo',
      url: 'https://pagayo.com',
      description: 'Bouw en schaal moderne webshops, hotels, en POS systemen op één krachtig multi-tenant platform',
      inLanguage: ['nl-NL', 'de-DE', 'en-US'],
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://app.pagayo.com/search?q={search_term_string}',
        'query-input': 'required name=search_term_string'
      }
    }
  }
];
---

<BaseLayout 
  title="Pagayo - Multi-Tenant E-commerce Platform" 
  description="Bouw en schaal moderne webshops, hotels, en POS systemen op één krachtig multi-tenant platform." 
  lang="nl"
  alternates={alternates}
  structuredData={structuredData}
>
  <HeaderDynamic country={country} />

  <main class="page-container">
      <!-- HERO -->
      <section class="hero-main">
        <div class="hero__content">
          <p class="eyebrow">Platform</p>
          <h1>E-commerce
          Zonder gedoe<span class="stat-value">.</span></h1>
          <p class="lead">
            Verkoop van artikelen, verhuur of abonnementen zonder ingewikkelde techniek. Online of kassa. Alles in één.
          </p>
          <div class="hero__actions">
            <a class="btn btn-primary" href="https://app.pagayo.com/register/">Start gratis</a>
            <a class="btn btn-ghost" href="/eu/nl/pricing">Bekijk prijzen</a>
          </div>
          <div class="hero__meta">
            <span class="pill">Altijd online (99,98%)</span>
            <span class="pill">Super snel! Order afhandeling onder de 150MS</span>
          </div>
                    <div class="stat-card">
            <p class="stat-label">API verbindingen met alles</p>
            <p class="stat-value">Pagayo API</p>
            <p class="stat-footnote">Pagayo heeft <b>GRATIS</b> API verbindingen met honderden partijen. Zoals; PostNL, iDEAL, Stripe, PayPal, Mollie, Buackaroo, Multisafepay, Google, Facebook, TikTok, Exact, Snelstart en nog veel meer.</p>
            <a href="/eu/nl/api-connections" class="stat-link">Lees meer →</a>
          </div>
        </div>

        <div class="hero__panel">
          <div class="stat-card">
            <p class="stat-label">Onbeperkte systemen</p>
            <p class="stat-value">Jouw bedrijf</p>
            <p class="stat-footnote">Zoveel webshops, hotels, winkels en kassa's als je wilt</p>
            <a href="/eu/nl/unlimited-stores" class="stat-link">Lees meer →</a>
          </div>
          <div class="stat-card">
            <p class="stat-label">Mis je een koppeling?</p>
            <p class="stat-value">API aanvragen</p>
            <p class="stat-footnote">Vraag gratis jouw favoriete API aan</p>
            <a href="/eu/nl/api-request" class="stat-link">Dien aanvraag in →</a>
          </div>
          <div class="stat-card">
            <p class="stat-label">Vertrouwd door</p>
            <p class="stat-value">50.000+</p>
            <p class="stat-footnote">Bedrijven gebruiken Pagayo iedere dag</p>
            <a href="/eu/nl/trusted-by" class="stat-link">Lees meer →</a>
          </div>
        </div>
      </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">Alles wat je nodig hebt</h2>
      <p class="section-subtitle">Een moderne platform voor jouw groeiende business</p>
    </div>
    <div class="feature-grid">
      <div class="feature-card">
        <div class="feature-icon">💳</div>
        <h3>Stripe betalingen</h3>
        <p>iDEAL, Bancontact, kaarten en wallets met slimme retries. <a href="/eu/nl/stripe">Lees meer</a>.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🪙</div>
        <h3>Mollie betalingen</h3>
        <p>Populaire betaalmethoden actief in één keer, inclusief lokale voorkeuren en rapportages per merk.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🧮</div>
        <h3>Checkout & btw</h3>
        <p>Kies een standaard checkout of eigen design. Btw en verzendkosten worden per land juist berekend.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">📡</div>
        <h3>Betalingen volgen</h3>
        <p>Elke stap van een betaling wordt vastgelegd. Bij storingen proberen we het opnieuw en krijg je een seintje.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🧾</div>
        <h3>Kassa en online in sync</h3>
        <p>Voorraad, bestellingen en retouren lopen gelijk tussen kassa en webshop. Bonnen komen automatisch mee.</p>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section class="social-proof">
    <div class="social-proof-content">
      <h3>Vertrouwd door duizenden e-commerce ondernemers</h3>
      <div class="trust-badges">
        <div class="trust-item">
          <div class="trust-number">50.000+</div>
          <div class="trust-label">Actieve webshops</div>
        </div>
        <div class="trust-item">
          <div class="trust-number">99.9%</div>
          <div class="trust-label">Historische uptime</div>
        </div>
        <div class="trust-item">
          <div class="trust-number">24/7</div>
          <div class="trust-label">Support beschikbaar</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="pricing" id="pricing">
    <div class="section-header">
      <h2 class="section-title">Simpele, schaalbare prijzen</h2>
      <p class="section-subtitle">Betaal alleen voor je succes. Hoe meer je omzet, hoe minder je betaalt.</p>
    </div>
    <div class="pricing-grid">
      <div class="pricing-card">
        <div class="pricing-badge">Pagayo Platform</div>
        <div class="pricing-columns">
          <!-- Pricing Column -->
          <div class="pricing-column">
            <h4>Prijzen</h4>
            <div class="pricing-tier">
              <span class="percentage">1%</span>
              <span class="range">tot €5.000/maand</span>
            </div>
            <div class="pricing-tier">
              <span class="percentage">0,8%</span>
              <span class="range">€5.000-€10.000</span>
            </div>
            <div class="pricing-tier">
              <span class="percentage">0,6%</span>
              <span class="range">€10.000-€50.000</span>
            </div>
            <div class="pricing-tier">
              <span class="percentage">0,5%</span>
              <span class="range">€50.000-€100.000</span>
            </div>
          </div>
          
          <!-- Features Column -->
          <div class="pricing-column features">
            <h4>Wat je krijgt</h4>
            <div class="feature-item">
              <span class="checkmark">✓</span> Onbeperkt webwinkels
            </div>
            <div class="feature-item">
              <span class="checkmark">✓</span> Onbeperkt hotels
            </div>
            <div class="feature-item">
              <span class="checkmark">✓</span> Onbeperkt abonnementen
            </div>
            <div class="feature-item">
              <span class="checkmark">✓</span> Onbeperkt verhuur
            </div>
            <div class="feature-item">
              <span class="checkmark">✓</span> Onbeperkt POS-systemen
            </div>
            <div class="feature-item">
              <span class="checkmark">✓</span> Eigen domeinnamen
            </div>
          </div>
        </div>
        
        <div class="pricing-footer">
          <p>Start gratis - geen proefperiode</p>
          <a href="https://app.pagayo.com" class="btn btn-primary">
            Start nu gratis
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 1l6 6-6 6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">Klaar om te starten?</h2>
      <p class="section-subtitle">
		Start direct en je krijgt binnen 30 seconden je eigen omgeving. Hulp nodig? We staan klaar.
      </p>
    </div>
    <div class="btn-group">
      <a href="https://app.pagayo.com" class="btn btn-primary">
        Start gratis
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 1l6 6-6 6"/>
        </svg>
      </a>
      <a href="/eu/nl/contact" class="btn btn-ghost">
	Heb je vragen? Neem contact op
	</a>
    </div>
  </section>
  </main>

  <FooterDynamic country={country} />
</BaseLayout>
