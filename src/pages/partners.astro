---
import MarketingLayout from '../layouts/Marketing.astro';
import PageBackdrop from '../components/layout/PageBackdrop.astro';

const pageTitle = 'Partner Program — Earn 50% by referring your clients to Pagayo';
const pageDescription =
  'You already know businesses that sell products. Introduce them to Pagayo and earn 50% of their subscription every month — for as long as they stay. No sales experience needed.';

const scenarios = [
  {
    num: '01',
    icon: '✂️',
    sector: 'Hairdressing & Barber supply',
    headline: 'You supply 200 salons. Each one needs a way to sell.',
    body: `You sell scissors, chairs, colour, shampoo and styling products to hairdressers and barber shops across the region. Every single one of those shops needs a way to take bookings, sell retail products, run a loyalty card and send appointment reminders. Right now they piece it together themselves — badly. You introduce them to Pagayo, they get a webshop, POS and WhatsApp sales in one. You earn 50% of their subscription every month without lifting a finger after the intro.`,
    example: '80 salons on Professional → €9,120/yr passive income',
    accent: '#a855f7',
    accentSoft: 'rgba(168, 85, 247, 0.12)',
  },
  {
    num: '02',
    icon: '🏋️',
    sector: 'Sports nutrition & supplement brands',
    headline: "You supply 300 gyms. They're all sitting on untapped online revenue.",
    body: `Your protein shakes, supplements and sports nutrition line up in the fridges of hundreds of gyms and fitness studios. Those same gyms want to sell memberships online, take class bookings, offer their own branded merchandise and send promotional messages to members. Pagayo gives them a complete commerce stack — webshop, POS, WhatsApp, digital products. You become the brand that helped their business grow. That relationship pays you back every month.`,
    example: '60 gyms on Advanced → €14,040/yr passive income',
    accent: '#22c55e',
    accentSoft: 'rgba(34, 197, 94, 0.12)',
  },
  {
    num: '03',
    icon: '🍺',
    sector: 'Horeca wholesale & beverage distributors',
    headline: 'Every café and restaurant on your delivery route is a potential tenant.',
    body: `You deliver drinks, coffee, ingredients and packaging to cafés, restaurants and food businesses. These owners know you, trust you, and see you regularly. When you mention that you can also set them up with an online webshop, a table-order QR code and a WhatsApp ordering system — all in one — they listen. Pagayo plugs into their daily operations immediately. Your delivery relationship becomes a revenue stream that never needs a delivery van.`,
    example: '50 cafés on Supporter → €1,200/yr — 120 restaurants on Professional → €13,680/yr',
    accent: '#f59e0b',
    accentSoft: 'rgba(245, 158, 11, 0.12)',
  },
  {
    num: '04',
    icon: '💼',
    sector: 'Accountants & bookkeepers',
    headline: "Your clients trust your advice. That's the only sales pitch you need.",
    body: `You manage the books for dozens of small businesses — retail shops, service providers, sole traders. You already know exactly who among them is struggling to sell online or losing money to clunky payment setups. A short recommendation from you carries more weight than any advertisement. Pagayo integrates cleanly with financial workflows. Your clients get a better commerce system; you earn a passive income on every subscription, month after month, without any additional work after the initial referral.`,
    example: '40 small business clients → avg. €228/yr each → €4,560/yr',
    accent: '#3b82f6',
    accentSoft: 'rgba(59, 130, 246, 0.12)',
  },
  {
    num: '05',
    icon: '🏪',
    sector: 'Franchise organisations',
    headline: 'You have 50 franchisees. Roll out Pagayo once. Earn on all 50.',
    body: `You run or consult for a franchise concept — a chain of car washes, specialty food stores, boutique fitness studios or service shops. You control the tech stack. By making Pagayo the standard commerce platform for your franchisee network, you give every location a consistent, professional online and in-store experience — and you earn a share of every subscription automatically. One decision. Fifty revenue streams.`,
    example: '50 franchisees on Advanced → €11,700/yr recurring',
    accent: '#06b6d4',
    accentSoft: 'rgba(6, 182, 212, 0.12)',
  },
  {
    num: '06',
    icon: '🎨',
    sector: 'Web agencies & digital consultants',
    headline: "You build the website. We run the commerce. Both of you get paid forever.",
    body: `You design and build websites for small businesses. Your clients always ask: "How do I sell online? How do I take payments? How do we set up WhatsApp ordering?" You can now answer that question with a Pagayo setup, earn the setup fee yourself, and then collect 50% of their subscription every month going forward. Pagayo handles all the complexity — payments, logistics integrations, inventory, subscriptions — so you can stay focused on design and growth, not platform maintenance.`,
    example: '30 client sites on Professional → €3,420/yr recurring from existing client work',
    accent: '#ec4899',
    accentSoft: 'rgba(236, 72, 153, 0.12)',
  },
];

const steps = [
  {
    num: '1',
    title: 'Apply in two minutes.',
    body: 'Fill in the short form. We review every application personally and respond within one business day. No pitch deck, no revenue proof required.',
  },
  {
    num: '2',
    title: 'Get your link and materials.',
    body: 'You receive a unique referral link, a one-page PDF you can share with clients, and optional co-branded introduction materials for your sector.',
  },
  {
    num: '3',
    title: 'Introduce Pagayo to your clients.',
    body: "An email, a conversation, a mention at your next delivery or meeting. Your clients sign up through your link at their own pace. You don't need to do demos or sales calls.",
  },
  {
    num: '4',
    title: 'Earn 50%, every month, forever.',
    body: 'As soon as a referral subscribes, 50% of their monthly fee lands in your partner account. Automatic. Paid via Stripe. Withdraw any time, no minimum threshold.',
  },
];

const faqs = [
  {
    q: 'Do my clients pay more because I referred them?',
    a: 'No. Your clients pay exactly the same price they would if they signed up directly. Your commission comes entirely from our margin, not from a surcharge on their subscription.',
  },
  {
    q: 'How long do I earn on a referral?',
    a: "For as long as your client stays subscribed. There is no end date, no cliff, no reduced rate after year one. If they're on Pagayo in year five, you're still earning 50% in year five.",
  },
  {
    q: 'What if I refer someone who upgrades their plan later?',
    a: 'You earn 50% of whatever they pay at the time of billing. If they upgrade from Supporter to Professional, your earnings upgrade automatically.',
  },
  {
    q: 'I supply a specific sector — do you have materials in my industry language?',
    a: "Yes. Once you're accepted, we can produce co-branded materials that use the right terminology for your sector. A barber supply company needs different language than a software agency.",
  },
  {
    q: 'How does payout work?',
    a: 'Payouts run through Stripe Connect. You connect your bank account once during onboarding. Earnings accumulate in your partner dashboard and you request a withdrawal whenever you want.',
  },
  {
    q: 'Can I refer businesses in any country?',
    a: 'Pagayo currently operates in the Netherlands, Belgium, Germany, France, Spain and several African markets. If your clients are based there, the answer is yes.',
  },
];
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <PageBackdrop variant="partners" />

  <main class="pp-page">

    <!-- ══════════════════════════════════════════════════ HERO -->
    <section class="hero section pp-hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-orb hero-orb-3"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse"></span>
          Partner Program — 50% recurring commission
        </div>

        <h1 class="headline-xl">
          Your clients already sell.<br />
          <span class="text-gradient">Help them sell better.</span>
        </h1>

        <p class="pp-hero-intro">
          You have a customer base. Some of them run a shop, a salon, a gym,
          a café. Introduce them to Pagayo and earn half of what they pay,
          every month, for as long as they stay — without ever handling a
          support ticket or writing a line of code.
        </p>

        <div class="pp-hero-ctas">
          <a href="/contact?subject=Partner+Program" class="btn btn-partner btn-lg">
            Apply to become a partner →
          </a>
          <a href="#scenarios" class="btn btn-secondary btn-lg">
            See if this fits your business
          </a>
        </div>

        <div class="pp-trust-row">
          <div class="pp-trust-item">
            <span class="pp-trust-val">50%</span>
            <span class="pp-trust-label">commission, recurring</span>
          </div>
          <div class="pp-trust-sep" aria-hidden="true">·</div>
          <div class="pp-trust-item">
            <span class="pp-trust-val">€0</span>
            <span class="pp-trust-label">cost to join</span>
          </div>
          <div class="pp-trust-sep" aria-hidden="true">·</div>
          <div class="pp-trust-item">
            <span class="pp-trust-val">No</span>
            <span class="pp-trust-label">minimum referrals</span>
          </div>
          <div class="pp-trust-sep" aria-hidden="true">·</div>
          <div class="pp-trust-item">
            <span class="pp-trust-val">Forever</span>
            <span class="pp-trust-label">no end date on earnings</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════ THE MODEL -->
    <section class="section pp-model fade-in">
      <div class="container">
        <div class="pp-model-inner">
          <div class="pp-model-text">
            <span class="section-label">How it works</span>
            <h2 class="headline-md">You refer. We handle the rest. You earn.</h2>
            <p>
              Most affiliate programs pay a one-off bounty and move on.
              Ours pays you every month for the lifetime of the customer.
              There is a significant difference between a €50 sign-up bonus
              and €114 per year, every year, from a single customer —
              automatically deposited without any further action from you.
            </p>
            <p>
              You do not need to sell. You do not need to demo the product.
              You do not need to handle support. You make the introduction
              and we take care of onboarding, support, and renewal.
            </p>
          </div>
          <div class="pp-model-cards">
            <div class="pp-model-card">
              <div class="pp-model-icon">🤝</div>
              <h3>You refer</h3>
              <p>Share your unique link. An email, a mention, a QR code at your next delivery — whatever fits how you work.</p>
            </div>
            <div class="pp-model-card">
              <div class="pp-model-icon">🛍️</div>
              <h3>They subscribe</h3>
              <p>Your client signs up for Pagayo. We handle onboarding, training, and support from day one. You're not involved unless you want to be.</p>
            </div>
            <div class="pp-model-card pp-model-card--highlight">
              <div class="pp-model-icon">💶</div>
              <h3>You earn, monthly</h3>
              <p>50% of their subscription lands in your partner account every billing cycle. Automatically. For as long as they stay.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ SCENARIOS -->
    <section class="section pp-scenarios" id="scenarios">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">Who this is for</span>
          <h2 class="headline-md">
            If your clients run a business,<br />you are a natural partner.
          </h2>
          <p class="pp-scenarios-sub">
            You don't need to be a tech company. You need a relationship with
            businesses that sell — and a reason to mention Pagayo.
            Here's what that looks like in practice.
          </p>
        </div>

        <div class="pp-scenarios-grid">
          {scenarios.map((s, idx) => (
            <article
              class={`pp-scenario-card ${idx === 0 ? 'pp-scenario-card--wide' : ''}`}
              style={`--accent: ${s.accent}; --accent-soft: ${s.accentSoft};`}
            >
              <div class="pp-scenario-top">
                <div class="pp-scenario-icon-wrap">
                  <span class="pp-scenario-num">{s.num}</span>
                  <span class="pp-scenario-icon">{s.icon}</span>
                </div>
                <span class="pp-scenario-sector">{s.sector}</span>
              </div>
              <h3 class="pp-scenario-headline">{s.headline}</h3>
              <p class="pp-scenario-body">{s.body}</p>
              <div class="pp-scenario-example">
                <span class="pp-scenario-example-label">Example earnings</span>
                <span class="pp-scenario-example-val">{s.example}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ EARNINGS -->
    <section class="section pp-earnings fade-in">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">The numbers</span>
          <h2 class="headline-md">Small introductions. Serious income.</h2>
          <p class="pp-earnings-sub">
            These are not projections. These are the exact numbers based on
            current Pagayo pricing — with 50% going to you, every month.
          </p>
        </div>

        <div class="pp-earnings-table">
          <div class="pp-earnings-header">
            <span>Referrals</span>
            <span>Plan</span>
            <span>Their monthly fee</span>
            <span>Your monthly cut</span>
            <span>Your annual income</span>
          </div>

          {[
            { refs: 10,  plan: 'Supporter',    monthly: '€4',   cut: '€2',    annual: '€240' },
            { refs: 25,  plan: 'Professional', monthly: '€19',  cut: '€9.50', annual: '€2,850' },
            { refs: 50,  plan: 'Professional', monthly: '€19',  cut: '€9.50', annual: '€5,700' },
            { refs: 30,  plan: 'Advanced',     monthly: '€39',  cut: '€19.50', annual: '€7,020' },
            { refs: 100, plan: 'Mixed',        monthly: '—',    cut: '—',     annual: '€11,400+', highlight: true },
          ].map((r) => (
            <div class={`pp-earnings-row ${r.highlight ? 'pp-earnings-row--highlight' : ''}`}>
              <span class="pp-er-refs">{r.refs} referrals</span>
              <span class="pp-er-plan">{r.plan}</span>
              <span class="pp-er-monthly">{r.monthly}</span>
              <span class="pp-er-cut">{r.cut}</span>
              <span class="pp-er-annual">{r.annual}</span>
            </div>
          ))}
        </div>

        <p class="pp-earnings-note">
          Numbers based on annual billing. Monthly billing yields the same total split over 12 payments.
          Commission is paid on net subscription revenue after any applicable taxes.
        </p>
      </div>
    </section>

    <!-- ══════════════════════════════════════════ HOW IT WORKS -->
    <section class="section pp-steps fade-in">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">Getting started</span>
          <h2 class="headline-md">From application to first payout in four steps.</h2>
        </div>

        <div class="pp-steps-grid">
          {steps.map((s) => (
            <div class="pp-step">
              <div class="pp-step-num">{s.num}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════ WHAT YOU'RE SELLING -->
    <section class="section pp-product fade-in">
      <div class="container">
        <div class="pp-product-inner">
          <div class="pp-product-text">
            <span class="section-label">What your clients get</span>
            <h2 class="headline-md">
              A complete commerce platform.<br />Not another subscription to manage.
            </h2>
            <p>
              The hardest part of recommending a product is standing behind it.
              Pagayo is easy to recommend because what it does is immediately
              visible: your client gets a professional webshop, an in-store
              payment terminal, WhatsApp ordering, and a dashboard with
              everything in one place — live within 24 hours of signing up.
            </p>
            <p>
              There are no six-month implementation projects. There is no IT
              consultant to hire. Most clients are fully operational within
              a day. That makes your referral feel effortless and your
              recommendation look smart.
            </p>
          </div>
          <div class="pp-product-features">
            {[
              { icon: '🛒', label: 'Webshop', desc: 'Fully branded, live in hours.' },
              { icon: '💳', label: 'Point of Sale', desc: 'In-store payments via any device.' },
              { icon: '💬', label: 'WhatsApp Commerce', desc: 'Orders and broadcasts via WhatsApp.' },
              { icon: '📦', label: 'Inventory', desc: 'One stock level, all channels.' },
              { icon: '📊', label: 'Dashboard', desc: 'Sales, customers, payouts in one view.' },
              { icon: '🔔', label: 'Subscriptions & loyalty', desc: 'Recurring revenue for your clients.' },
            ].map((f) => (
              <div class="pp-product-feature">
                <span class="pp-feature-icon">{f.icon}</span>
                <div>
                  <strong>{f.label}</strong>
                  <span>{f.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ FAQ -->
    <section class="section pp-faq fade-in">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">Frequently asked</span>
          <h2 class="headline-md">Good questions deserve straight answers.</h2>
        </div>

        <div class="pp-faq-grid">
          {faqs.map((f) => (
            <div class="pp-faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════ FINAL CTA -->
    <section class="section pp-cta fade-in">
      <div class="container">
        <div class="pp-cta-inner">
          <div class="pp-cta-bg" aria-hidden="true"></div>
          <span class="section-label pp-cta-label">Join the program</span>
          <h2 class="headline-lg">
            You already have the clients.<br />
            <span class="pp-cta-accent">Start earning on them.</span>
          </h2>
          <p>
            Apply in two minutes. We'll review your application personally
            and get back to you within one business day. No commitment,
            no exclusivity, no minimum referrals required.
          </p>
          <div class="pp-cta-buttons">
            <a href="/contact?subject=Partner+Program" class="btn btn-partner btn-lg">
              Apply now — it's free →
            </a>
            <a href="https://start.pagayo.app/register" class="btn btn-secondary btn-lg">
              Test us first
            </a>
          </div>
          <p class="pp-cta-note">
            Questions about a specific sector or earning structure?
            Email <a href="mailto:partners@pagayo.com">partners@pagayo.com</a> — we reply the same day.
          </p>
        </div>
      </div>
    </section>

  </main>
</MarketingLayout>
