---
/**
 * Root Portal - pagayo.com
 * Minimale portal met login, registratie, en link naar meer informatie
 *
 * CSS Architecture:
 * - @pagayo/design: Single CSS source of truth (revolutionary theme tokens + BEM component classes)
 * - Scoped styles: Portal-specifieke layout, theme toggle, logo, light theme overrides
 * - BEM: .btn--primary, .btn--secondary, .btn--ghost, .badge (uit design system)
 *
 * i18n-ready: Alle teksten komen uit content/pages/nl/portal.json
 * Voor nieuwe taal: maak content/pages/{lang}/portal.json + pages/{lang-route}/index.astro
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import portalContent from '../content/pages/nl/portal.json';
import { urls } from '../config/urls';

// Pagayo Design System — lokale CSS kopie (bron: @pagayo/design dist/revolutionary/admin.css)
// Bij design updates: kopieer opnieuw vanuit pagayo-design/dist/revolutionary/admin.css
import '../styles/pagayo-design.css';

const { title, description, lang, badge, tagline, actions, seo } = portalContent;

// Environment-aware URLs: localhost in dev, production URLs in prod
const actionUrls = {
  createOrder: urls.createOrder,
  signIn: urls.signIn,
  createAccount: urls.createAccount,
  learnMore: actions.learnMore.url, // blijft relatief pad
};
---

<BaseLayout 
  title={title}
  description={description}
  lang={lang}
  alternates={seo.alternates}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
  twitterCard={seo.twitterCard}
  noIndex={seo.noIndex}
  structuredData={[{ type: seo.structuredData.type as 'WebSite', data: { name: seo.structuredData.name, url: seo.structuredData.url } }]}
>
  <main class="portal" data-theme="dark">
    <!-- Main navigation -->
    <nav class="main-nav">
      <a href="/" class="main-nav__logo">
        <span class="logo-p">P</span>agayo<span class="logo-dot">.</span>
      </a>
      <button class="main-nav__menu" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </nav>

    <div class="portal-container">

      <!-- Portal card — .badge from design system, portal-specific card styling -->
      <div class="portal-card">
        <span class="badge card-badge">{badge}</span>
        <div class="portal-actions">
          <a href={actionUrls.createOrder} class="btn btn--primary btn--lg btn--full">
            {actions.createOrder.label}
          </a>
          <a href={actionUrls.signIn} class="btn btn--secondary btn--lg btn--full">
            {actions.signIn.label}
          </a>
          <a href={actionUrls.createAccount} class="btn btn--secondary btn--lg btn--full">
            {actions.createAccount.label}
          </a>
          <a href={actionUrls.learnMore} class="btn btn--ghost btn--full">
            {actions.learnMore.label}
          </a>
        </div>
      </div>

      <p class="portal-tagline">{tagline.channels}<br/><strong>{tagline.punch}</strong></p>

      <div class="portal-channels">
        <!-- WhatsApp -->
        <svg class="channel-icon" viewBox="0 0 24 24" fill="currentColor" aria-label="WhatsApp"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <!-- TikTok -->
        <svg class="channel-icon" viewBox="0 0 24 24" fill="currentColor" aria-label="TikTok"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        <!-- Facebook -->
        <svg class="channel-icon" viewBox="0 0 24 24" fill="currentColor" aria-label="Facebook"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* Override global styles for portal page */
  body:has(.portal) {
    background: #0a0a0f !important;
  }
</style>

<style>
  /* ─────────────────────────────────────────────────
   * PORTAL TOKEN SCOPE
   *
   * Design system tokens op :root worden overschreven door
   * global.css continent-theme (:root --accent: #00ff88).
   * Daarom scopen we tokens op .portal tot global.css
   * is opgeschoond. Waarden zijn 1:1 met @pagayo/design
   * revolutionary theme.
   *
   * TODO: Verwijder deze scope wanneer global.css alleen
   * design system tokens gebruikt.
   * ───────────────────────────────────────────────── */
  .portal {
    --bg-deep: #0a0a0f;
    --bg-surface: #0e0e14;
    --bg-elevated: #111118;
    --bg-hover: #1a1a23;
    --bg-active: #292a36;
    --accent: #f5a623;
    --accent-light: #ffbe3f;
    --accent-dim: #d98e00;
    --accent-glow: rgb(245 166 35 / 0.15);
    --text-primary: #f0f0f5;
    --text-secondary: rgb(240 240 245 / 0.7);
    --text-muted: rgb(240 240 245 / 0.45);
    --text-disabled: rgb(240 240 245 / 0.3);
    --border: rgb(240 240 245 / 0.06);
    --border-light: rgb(240 240 245 / 0.09);
    --border-strong: rgb(240 240 245 / 0.15);
  }

  /* ─── PORTAL LAYOUT ─── */
  .portal {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    background: var(--bg-deep) !important;
    padding: 6rem var(--space-8) var(--space-8);
    transition: background var(--transition-slow), color var(--transition-slow);
  }

  .portal-container {
    text-align: center;
    max-width: 400px;
    width: 100%;
    position: relative;
  }

  /* ─── Portal Card ─── */
  .portal-card {
    position: relative;
    background: linear-gradient(135deg, var(--bg-surface), var(--accent-glow));
    border: 2px solid var(--accent);
    border-radius: var(--radius-2xl);
    padding: var(--space-10) var(--space-6) var(--space-6);
    margin-bottom: var(--space-6);
    transition: background var(--transition-slow), border-color var(--transition-slow);
  }

  /* ─── Card Badge — volledig zelfstandig, onafhankelijk van design .badge ─── */
  .card-badge {
    position: absolute;
    top: -0.85em;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    padding: 0.4em 1.2em;
    background: var(--accent);
    color: var(--bg-deep);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    border-radius: var(--radius-full);
    z-index: 1;
  }

  /* ─── Portal Action Buttons ─── */
  /* Design system build mist button variant CSS (primary/secondary/ghost).
     Daarom hier volledig gedefinieerd met portal tokens. */
  .portal-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .portal-actions .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-lg);
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
    text-decoration: none;
    height: auto;
    border: 2px solid transparent;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .portal-actions .btn--primary {
    background: var(--accent);
    color: var(--bg-deep);
    border-color: var(--accent);
  }

  .portal-actions .btn--primary:hover {
    background: var(--accent-light);
    border-color: var(--accent-light);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px var(--accent-glow);
  }

  .portal-actions .btn--secondary {
    background: transparent;
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .portal-actions .btn--secondary:hover {
    border-color: var(--accent);
    background: var(--bg-hover);
  }

  .portal-actions .btn--ghost {
    background: transparent;
    color: var(--text-secondary);
    border-color: transparent;
    padding: var(--space-3);
  }

  .portal-actions .btn--ghost:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  /* ─── Tagline ─── */
  .portal-tagline {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
    font-style: italic;
    letter-spacing: 0.02em;
    transition: color var(--transition-slow);
  }

  .tagline-separator {
    display: inline-block;
    margin: 0 0.1em;
    color: var(--accent);
    font-style: normal;
  }

  /* ─── Channel Icons ─── */
  .portal-channels {
    display: flex;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-2);
  }

  .channel-icon {
    width: 20px;
    height: 20px;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .channel-icon:hover {
    color: var(--accent);
  }

  /* ─── Main Navigation ─── */
  .main-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    z-index: 100;
  }

  .main-nav__logo {
    font-size: 1.5rem;
    font-weight: var(--font-bold);
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: color var(--transition-slow);
  }

  .main-nav__logo .logo-p,
  .main-nav__logo .logo-dot {
    color: var(--accent);
    font-weight: 800;
  }

  .main-nav__menu {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .main-nav__menu:hover {
    color: var(--accent);
    background: var(--bg-hover);
  }

</style>
