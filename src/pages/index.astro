---
import MarketingLayout from '../layouts/Marketing.astro';
import Hero from '../components/sections/Hero.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import AlwaysShipping from '../components/sections/AlwaysShipping.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ProductPreview from '../components/sections/ProductPreview.astro';
import ChannelStrip from '../components/sections/ChannelStrip.astro';
import FeaturesGrid from '../components/sections/FeaturesGrid.astro';
import MotorsGrid from '../components/sections/MotorsGrid.astro';
import CompetitorTable from '../components/sections/CompetitorTable.astro';
import PricingTable from '../components/sections/PricingTable.astro';
import StepsGrid from '../components/sections/StepsGrid.astro';
import ImpactSection from '../components/sections/ImpactSection.astro';
import PartnerCalc from '../components/sections/PartnerCalc.astro';
import TestimonialsGrid from '../components/sections/TestimonialsGrid.astro';
import TrustSecurity from '../components/sections/TrustSecurity.astro';
import GlobalReach from '../components/sections/GlobalReach.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { loadMessages } from '../lib/i18n';
import { DEFAULT_DESCRIPTION, SITE_ORIGIN } from '../lib/site-seo';

const locale = 'en';
const messages = loadMessages(locale);

const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_ORIGIN}/#organization`,
      name: 'Pagayo',
      url: SITE_ORIGIN,
      description: DEFAULT_DESCRIPTION,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_ORIGIN}/#website`,
      name: 'Pagayo',
      url: SITE_ORIGIN,
      description: DEFAULT_DESCRIPTION,
      publisher: { '@id': `${SITE_ORIGIN}/#organization` },
      inLanguage: 'en-US',
    },
  ],
};
---
<MarketingLayout
  locale={locale}
  alternatePageId="home"
  title={messages.homePage.title}
  description={messages.homePage.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  <Hero locale={locale} home={messages.homePage} />
  <Manifesto />
  <AlwaysShipping />
  <TrustBar />
  <ProductPreview />
  <ChannelStrip />
  <div class="section-divider"></div>
  <FeaturesGrid />
  <MotorsGrid />
  <CompetitorTable />
  <div class="section-divider"></div>
  <PricingTable locale={locale} pricingPage={messages.pricingPage} />
  <StepsGrid />
  <div class="section-divider"></div>
  <ImpactSection compact />
  <div class="section-divider"></div>
  <PartnerCalc />
  <TestimonialsGrid limit={3} showViewAllLink />
  <TrustSecurity />
  <GlobalReach />
  <FinalCta locale={locale} home={messages.homePage} />
</MarketingLayout>
