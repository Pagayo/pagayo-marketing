---
/**
 * Root Portal - pagayo.com
 * Minimal portal with sign in, registration, and more information
 *
 * CSS Architecture:
 * - @pagayo/design: Single CSS source of truth (revolutionary theme tokens + BEM component classes)
 * - Scoped styles: Portal-specifieke layout, theme toggle, logo, light theme overrides
 * - BEM: .btn--primary, .btn--secondary, .btn--ghost, .badge (uit design system)
 *
 * i18n-ready: Alle teksten komen uit content/pages/nl/portal.json
 * Voor nieuwe taal: maak content/pages/{lang}/portal.json + pages/{lang-route}/index.astro
 */

// Server-rendered: nodig voor cf-ipcountry header (landnaam in nav)
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import portalContent from '../content/pages/nl/portal.json';
import { urls } from '../config/urls';

// Pagayo Design System — lokale CSS kopie (bron: @pagayo/design dist/revolutionary/admin.css)
// Bij design updates: kopieer opnieuw vanuit pagayo-design/dist/revolutionary/admin.css
import '../styles/pagayo-design.css';

const { title, description, lang, hero, badge, tagline, actions, sections, seo } = portalContent;

// Landnaam detectie via middleware visitorContext (cf-ipcountry op Cloudflare, 'XX' fallback)
// In dev mode: geen cf-ipcountry header → fallback 'NL' voor lokale preview
const isDev = import.meta.env.DEV;
const visitorCountry = Astro.locals.visitorContext?.country;
const countryCode = (visitorCountry && visitorCountry !== 'XX') ? visitorCountry : (isDev ? 'NL' : '');
const countryNames: Record<string, string> = {
  NL: 'Nederland', BE: 'België', DE: 'Deutschland', AT: 'Österreich', CH: 'Schweiz',
  FR: 'France', ES: 'España', IT: 'Italia', PT: 'Portugal', GB: 'United Kingdom',
  US: 'United States', CA: 'Canada', MX: 'México', BR: 'Brasil', AR: 'Argentina',
  CO: 'Colombia', CL: 'Chile', PE: 'Perú', VE: 'Venezuela', EC: 'Ecuador',
  UY: 'Uruguay', PY: 'Paraguay', BO: 'Bolivia', CR: 'Costa Rica', PA: 'Panamá',
  DO: 'República Dominicana', GT: 'Guatemala', HN: 'Honduras', SV: 'El Salvador',
  NI: 'Nicaragua', CU: 'Cuba', PR: 'Puerto Rico', JM: 'Jamaica', TT: 'Trinidad and Tobago',
  SR: 'Suriname', GY: 'Guyana', BZ: 'Belize', HT: 'Haïti', BB: 'Barbados',
  AW: 'Aruba', CW: 'Curaçao', BQ: 'Bonaire', SX: 'Sint Maarten',
  IE: 'Ireland', SE: 'Sverige', NO: 'Norge', DK: 'Danmark', FI: 'Suomi',
  PL: 'Polska', CZ: 'Česko', SK: 'Slovensko', HU: 'Magyarország',
  RO: 'România', BG: 'България', HR: 'Hrvatska', SI: 'Slovenija',
  GR: 'Ελλάδα', TR: 'Türkiye', RU: 'Россия', UA: 'Україна',
  JP: '日本', CN: '中国', KR: '한국', IN: 'India', ID: 'Indonesia',
  TH: 'ประเทศไทย', VN: 'Việt Nam', PH: 'Pilipinas', MY: 'Malaysia', SG: 'Singapore',
  AU: 'Australia', NZ: 'New Zealand', ZA: 'South Africa', NG: 'Nigeria',
  KE: 'Kenya', GH: 'Ghana', EG: 'مصر', MA: 'المغرب', TN: 'تونس',
  SA: 'السعودية', AE: 'الإمارات', IL: 'ישראל',
};
const countryName = countryNames[countryCode] || '';

// Environment-aware URLs: localhost in dev, production URLs in prod
const actionUrls = {
  signIn: urls.signIn,
  createAccount: urls.createAccount,
};
---

<BaseLayout 
  title={title}
  description={description}
  lang={lang}
  alternates={seo.alternates}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
  twitterCard={seo.twitterCard}
  noIndex={seo.noIndex}
  structuredData={[{ type: seo.structuredData.type as 'WebSite', data: { name: seo.structuredData.name, url: seo.structuredData.url } }]}
>
  <main class="portal" data-theme="dark">
    <!-- Main navigation -->
    <nav class="main-nav">
      <a href="/" class="main-nav__logo">
        <span class="logo-p">P</span>agayo<span class="logo-dot">.</span>{countryName && <span class="logo-country">{countryName}</span>}
      </a>
      <button class="main-nav__menu" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </nav>

    <!-- Section 1: Hero -->
    <section class="section section--hero">
      <div class="section__inner">
        <div class="portal-hero">
          <h1 class="portal-hero__headline" set:html={hero.headline} />
          <p class="portal-hero__sub" set:html={hero.sub} />
        </div>

        <div class="portal-video-wrap" id="videoWrap">
          <video class="portal-video" id="portalVideo" preload="metadata" playsinline>
            <source src="/movies/anna-over-pagayo-nl.mp4" type="video/mp4" />
          </video>
          <button class="video-play-btn" id="videoPlayBtn" aria-label="Play">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>

        <div class="portal-actions-row">
          <a href={actionUrls.signIn} class="btn btn--secondary btn--lg">
            {actions.signIn.label}
          </a>
          <a href={actionUrls.createAccount} class="btn btn--secondary btn--lg">
            {actions.createAccount.label}
          </a>
        </div>
      </div>
      <button class="scroll-down" aria-label="Scroll to next section">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </section>

    <!-- Section 2: Social Selling -->
    <section class="section section--social">
      <div class="section__inner">
        <h2 class="section__title" set:html={sections.social.title} />
        <p class="section__subtitle">{sections.social.subtitle}</p>
        <div class="section__cards">
          {sections.social.items.map((item: { icon: string; name: string; text: string }) => (
            <div class="card">
              <div class="card__icon" data-icon={item.icon}>
                {item.icon === 'whatsapp' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>}
                {item.icon === 'tiktok' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>}
                {item.icon === 'facebook' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>}
                {item.icon === 'instagram' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>}

              </div>
              <p class="card__text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
      <button class="scroll-down" aria-label="Scroll to next section">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </section>

    <!-- Section 3: One Dashboard -->
    <section class="section section--dashboard">
      <div class="section__inner">
        <h2 class="section__title" set:html={sections.dashboard.title} />
        <p class="section__subtitle">{sections.dashboard.subtitle}</p>
        <div class="section__features">
          {sections.dashboard.items.map((item: { label: string; text: string }) => (
            <div class="feature">
              <span class="feature__label">{item.label}</span>
              <p class="feature__text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
      <button class="scroll-down" aria-label="Scroll to next section">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </section>

    <!-- Section 4: Get Started -->
    <section class="section section--start">
      <div class="section__inner">
        <h2 class="section__title" set:html={sections.start.title} />
        <p class="section__subtitle">{sections.start.subtitle}</p>
        <ol class="steps">
          {sections.start.items.map((step: string) => (
            <li class="steps__item">{step}</li>
          ))}
        </ol>
        <a href={actionUrls.createAccount} class="btn btn--accent btn--lg">
          {sections.start.cta}
        </a>
      </div>
      <button class="scroll-down" aria-label="Scroll to next section">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </section>

    <!-- Section 6: Payments (Stripe) -->
    <section class="section section--payments">
      <div class="section__inner">
        <h2 class="section__title" set:html={sections.payments.title} />
        <p class="section__subtitle">{sections.payments.subtitle}</p>
        <div class="payments">
          {sections.payments.items.map((item: { icon: string; label: string; text: string }) => (
            <div class="payments__item">
              <div class="payments__icon" data-payment-icon={item.icon}>
                {item.icon === 'credit-card' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>}
                {item.icon === 'globe' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>}
                {item.icon === 'shield' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              </div>
              <span class="payments__label">{item.label}</span>
              <p class="payments__text">{item.text}</p>
            </div>
          ))}
        </div>
        <div class="payments__stripe-badge">
          <svg viewBox="0 0 468 222.5" fill="currentColor" class="stripe-logo" role="img" aria-label="Stripe"><path d="M414 113.4c0-25.6-12.4-45.8-36.1-45.8-23.8 0-38.2 20.2-38.2 45.6 0 30.1 17 45.3 41.4 45.3 11.9 0 20.9-2.7 27.7-6.5v-20c-6.8 3.4-14.6 5.5-24.5 5.5-9.7 0-18.3-3.4-19.4-15.2h48.9c0-1.3.2-6.5.2-8.9zm-49.4-9.5c0-11.3 6.9-16 13.2-16 6.1 0 12.6 4.7 12.6 16h-25.8zM301.1 67.6c-9.8 0-16.1 4.6-19.6 7.8l-1.3-6.2h-22v116.6l25-5.3.1-28.3c3.6 2.6 8.9 6.3 17.7 6.3 17.9 0 34.2-14.4 34.2-46.1-.1-29-16.6-44.8-34.1-44.8zm-6 68.9c-5.9 0-9.4-2.1-11.8-4.7l-.1-37.1c2.6-2.9 6.2-4.9 11.9-4.9 9.1 0 15.4 10.2 15.4 23.3 0 13.4-6.2 23.4-15.4 23.4zM223.8 61.7l25.1-5.4V36l-25.1 5.3zM223.8 69.3h25.1v87.5h-25.1zM196.9 76.7l-1.6-7.4h-21.6v87.5h25V97.5c5.9-7.7 15.9-6.3 19-5.2v-23c-3.2-1.2-14.9-3.4-20.8 7.4zM146.9 47.6l-24.4 5.2-.1 80.1c0 14.8 11.1 25.7 25.9 25.7 8.2 0 14.2-1.5 17.5-3.3V135c-3.2 1.3-19 5.9-19-8.9V90.6h19V69.3h-19l.1-21.7zM79.3 94.7c0-3.9 3.2-5.4 8.5-5.4 7.6 0 17.2 2.3 24.8 6.4V72.2c-8.3-3.3-16.5-4.6-24.8-4.6C67.5 67.6 52 78.8 52 97.4c0 28.9 39.8 24.3 39.8 36.7 0 4.6-4 6.1-9.6 6.1-8.3 0-18.9-3.4-27.3-8v23.8c9.3 4 18.7 5.7 27.3 5.7 20.8 0 35.1-10.3 35.1-28.2-.1-31.2-40-25.7-40-37.8z"/></svg>
        </div>
      </div>
      <button class="scroll-down" aria-label="Scroll to next section">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </section>

    <!-- Section 6: Free Forever -->
    <section class="section section--free">
      <div class="section__inner">
        <h2 class="section__title" set:html={sections.free.title} />
        <p class="section__subtitle">{sections.free.subtitle}</p>
        <div class="stats">
          {sections.free.stats.map((stat: { value: string; label: string }) => (
            <div class="stats__item">
              <span class="stats__value">{stat.value}</span>
              <span class="stats__label">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
      <button class="scroll-down" aria-label="Scroll to next section">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </section>

    <!-- Section 7: Multi-channel -->
    <section class="section section--multichannel">
      <div class="section__inner">
        <h2 class="section__title" set:html={sections.multichannel.title} />
        <p class="section__subtitle">{sections.multichannel.subtitle}</p>
        <ul class="checklist">
          {sections.multichannel.items.map((item: string) => (
            <li class="checklist__item">{item}</li>
          ))}
        </ul>
      </div>
      <button class="scroll-down" aria-label="Scroll to next section">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </section>

    <!-- Section 8: Use Cases -->
    <section class="section section--usecases">
      <div class="section__inner">
        <h2 class="section__title" set:html={sections.usecases.title} />
        <p class="section__subtitle">{sections.usecases.subtitle}</p>
        <div class="section__cards">
          {sections.usecases.items.map((item: { emoji: string; name: string; text: string }) => (
            <div class="card">
              <span class="card__emoji">{item.emoji}</span>
              <h3 class="card__name">{item.name}</h3>
              <p class="card__text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
      <button class="scroll-down" aria-label="Scroll to next section">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </section>

    <!-- Section 9: Final CTA -->
    <section class="section section--cta">
      <div class="section__inner">
        <h2 class="section__title" set:html={sections.cta.title} />
        <p class="section__subtitle">{sections.cta.subtitle}</p>
        <blockquote class="testimonial">
          <p class="testimonial__quote">{sections.cta.quote}</p>
          <cite class="testimonial__author">{sections.cta.quoteAuthor}</cite>
        </blockquote>
        <a href={actionUrls.createAccount} class="btn btn--accent btn--lg">
          {sections.cta.cta}
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="main-footer">
      <p class="main-footer__channels">{tagline.channels}</p>
    </footer>
  </main>
</BaseLayout>

<style is:global>
  /* Override global styles for portal page */
  body:has(.portal) {
    background: #0a0a0f !important;
  }

  /* Gold accent letters in headline */
  .portal-hero__headline .gold {
    color: var(--accent);
  }
</style>

<style>
  /* ─────────────────────────────────────────────────
   * PORTAL TOKEN SCOPE
   *
   * Design system tokens op :root worden overschreven door
   * global.css continent-theme (:root --accent: #00ff88).
   * Daarom scopen we tokens op .portal tot global.css
   * is opgeschoond. Waarden zijn 1:1 met @pagayo/design
   * revolutionary theme.
   *
   * TODO: Verwijder deze scope wanneer global.css alleen
   * design system tokens gebruikt.
   * ───────────────────────────────────────────────── */
  .portal {
    --bg-deep: #0a0a0f;
    --bg-surface: #0e0e14;
    --bg-elevated: #111118;
    --bg-hover: #1a1a23;
    --bg-active: #292a36;
    --accent: #f5a623;
    --accent-light: #ffbe3f;
    --accent-dim: #d98e00;
    --accent-glow: rgb(245 166 35 / 0.15);
    --text-primary: #f0f0f5;
    --text-secondary: rgb(240 240 245 / 0.7);
    --text-muted: rgb(240 240 245 / 0.45);
    --text-disabled: rgb(240 240 245 / 0.3);
    --border: rgb(240 240 245 / 0.06);
    --border-light: rgb(240 240 245 / 0.09);
    --border-strong: rgb(240 240 245 / 0.15);
  }

  /* ─── PORTAL LAYOUT — Scroll Snap ─── */
  .portal {
    height: 100vh;
    overflow-y: auto;
    scroll-snap-type: y proximity;
    -webkit-overflow-scrolling: touch;
    background: var(--bg-deep) !important;
    transition: background var(--transition-slow), color var(--transition-slow);
  }

  /* ─── Sections ─── */
  .section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
    padding: 6rem var(--space-8) 4rem;
  }

  .section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
