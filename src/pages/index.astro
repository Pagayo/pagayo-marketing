      { name: 'Johannesburg', lat: -26.2041, lon: 28.0473 },
      { name: 'Cape Town', lat: -33.9249, lon: 18.4241 },
      { name: 'Mumbai', lat: 19.076, lon: 72.8777 },
      { name: 'Delhi', lat: 28.6139, lon: 77.209 },
      { name: 'Bengaluru', lat: 12.9716, lon: 77.5946 },
      { name: 'Karachi', lat: 24.8607, lon: 67.0011 },
      { name: 'Dhaka', lat: 23.8103, lon: 90.4125 },
      { name: 'Bangkok', lat: 13.7563, lon: 100.5018 },
      { name: 'Singapore', lat: 1.3521, lon: 103.8198 },
      { name: 'Jakarta', lat: -6.2088, lon: 106.8456 },
      { name: 'Hong Kong', lat: 22.3193, lon: 114.1694 },
      { name: 'Shanghai', lat: 31.2304, lon: 121.4737 },
      { name: 'Beijing', lat: 39.9042, lon: 116.4074 },
      { name: 'Seoul', lat: 37.5665, lon: 126.978 },
      { name: 'Tokyo', lat: 35.6762, lon: 139.6503 },
      { name: 'Osaka', lat: 34.6937, lon: 135.5023 },
      { name: 'Sydney', lat: -33.8688, lon: 151.2093 },
      { name: 'Melbourne', lat: -37.8136, lon: 144.9631 },
      { name: 'Auckland', lat: -36.8509, lon: 174.7645 },
      { name: 'New York', lat: 40.7128, lon: -74.006 },
      { name: 'Toronto', lat: 43.6532, lon: -79.3832 },
      { name: 'Chicago', lat: 41.8781, lon: -87.6298 },
      { name: 'San Francisco', lat: 37.7749, lon: -122.4194 },
      { name: 'Los Angeles', lat: 34.0522, lon: -118.2437 },
      { name: 'Sao Paulo', lat: -23.5558, lon: -46.6396 },
      { name: 'Rio de Janeiro', lat: -22.9068, lon: -43.1729 },
      { name: 'Buenos Aires', lat: -34.6037, lon: -58.3816 },
      { name: 'Santiago', lat: -33.4489, lon: -70.6693 },
      { name: 'Lima', lat: -12.0464, lon: -77.0428 },
      { name: 'Bogota', lat: 4.711, lon: -74.0721 }
    ];
    const cityMarkers = keyCities.map((city, index) => {
      const latRad = (city.lat * Math.PI) / 180;
      const lonRad = (city.lon * Math.PI) / 180;
      return {
        ...city,
        x: Math.sin(lonRad) * Math.cos(latRad),
        y: Math.sin(latRad),
        z: Math.cos(lonRad) * Math.cos(latRad),
        phase: index * 0.47
      };
    });
    const cityLookup = new Map(cityMarkers.map((city) => [city.name, city]));
    const badgeDuration = 12400;
    const badgeDefinitions = [
      { city: 'Amsterdam', amount: '€365 EUR', offsetX: -92, offsetY: -28, delay: 0 },
      { city: 'London', amount: '£420 GBP', offsetX: 46, offsetY: -38, delay: 1200 },
      { city: 'New York', amount: '$615 USD', offsetX: -104, offsetY: 34, delay: 2600 },
      { city: 'Dubai', amount: 'AED 980', offsetX: 54, offsetY: -34, delay: 4100 },
      { city: 'Lagos', amount: '₦92,000 NGN', offsetX: 72, offsetY: -22, delay: 5500 },
      { city: 'Nairobi', amount: 'KSh 18,400', offsetX: 60, offsetY: 24, delay: 6800 },
      { city: 'Sao Paulo', amount: 'R$480 BRL', offsetX: 72, offsetY: -20, delay: 1900 },
      { city: 'Buenos Aires', amount: 'ARS 54.000', offsetX: -112, offsetY: -22, delay: 4900 },
      { city: 'Singapore', amount: 'S$240 SGD', offsetX: 62, offsetY: -26, delay: 8100 },
      { city: 'Tokyo', amount: '¥8,200 JPY', offsetX: 56, offsetY: 30, delay: 9500 }
    ]
      .map((badge) => {
        const marker = cityLookup.get(badge.city);
        if (!marker) return null;
        return {
          ...badge,
          marker,
          renderX: null,
          renderY: null
        };
      })
      .filter(Boolean);
    let maskReady = false;

    function normalizedDeltaLon(a, b) {
      let d = Math.abs(a - b);
      if (d > 180) d = 360 - d;
      return d;
    }

    const landMasses = [
      { lon: -102, lat: 47, rx: 34, ry: 20 },
      { lon: -72, lat: 20, rx: 18, ry: 12 },
      { lon: -60, lat: -14, rx: 24, ry: 32 },
      { lon: -42, lat: 72, rx: 14, ry: 9 },
      { lon: 12, lat: 50, rx: 22, ry: 12 },
      { lon: 22, lat: 8, rx: 26, ry: 30 },
      { lon: 47, lat: 28, rx: 17, ry: 12 },
      { lon: 78, lat: 22, rx: 13, ry: 11 },
      { lon: 98, lat: 42, rx: 40, ry: 20 },
      { lon: 136, lat: -24, rx: 20, ry: 14 },
      { lon: 122, lat: 11, rx: 12, ry: 10 },
      { lon: 137, lat: 37, rx: 9, ry: 7 }
    ];

    function isLand(latDeg, lonDeg) {
      for (const mass of landMasses) {
        const dx = normalizedDeltaLon(lonDeg, mass.lon) / mass.rx;
        const dy = Math.abs(latDeg - mass.lat) / mass.ry;
        if ((dx * dx) + (dy * dy) <= 1) return true;
      }
      return false;
    }

    function wrapLonBin(bin) {
      if (bin < 0) return bin + 720;
      if (bin >= 720) return bin - 720;
      return bin;
    }

    function maskHasLand(latDeg, lonDeg) {
      const latBand = Math.max(-90, Math.min(90, Math.round(latDeg)));
      const lonNorm = ((lonDeg + 180 + 360) % 360) - 180;
      const lonBin = wrapLonBin(Math.floor((lonNorm + 180) * 2));

      // Sample nearby latitude bands as well to avoid visible horizontal mask artifacts.
      for (let latOffset = -2; latOffset <= 2; latOffset += 1) {
        const row = maskBands[latBand + latOffset + 90];
        if (!row) continue;

        if (
          row[lonBin] ||
          row[wrapLonBin(lonBin - 1)] ||
          row[wrapLonBin(lonBin + 1)] ||
          row[wrapLonBin(lonBin - 2)] ||
          row[wrapLonBin(lonBin + 2)]
        ) {
          return true;
        }
      }

      return false;
    }

    function pointLand(latDeg, lonDeg) {
      if (maskReady) return maskHasLand(latDeg, lonDeg);
      return isLand(latDeg, lonDeg);
    }

    function setPointStyle(point) {
      const hue = 204 + ((point.lon + 180) / 360) * 110;
      point.landFrontColor = `hsl(${hue.toFixed(1)} 84% 59%)`;
      point.landBackColor = `hsl(${hue.toFixed(1)} 66% 42%)`;
    }

    function createPoints(count) {
      points.length = 0;
      for (let i = 0; i < count; i += 1) {
        const y = 1 - (2 * i + 1) / count;
        const radius = Math.sqrt(1 - y * y);
        const theta = i * 2.399963229728653;
        const x = Math.cos(theta) * radius;
        const z = Math.sin(theta) * radius;
        const lon = (Math.atan2(x, z) * 180) / Math.PI;
        const lat = (Math.asin(y) * 180) / Math.PI;
        points.push({
          x,
          y,
          z,
          lat,
          lon,
          land: pointLand(lat, lon)
        });
        setPointStyle(points[points.length - 1]);
      }
    }

    function refreshPointLandMask() {
      for (const p of points) {
        p.land = pointLand(p.lat, p.lon);
        setPointStyle(p);
      }
    }

    function buildMaskFromImage(image) {
      const offscreen = document.createElement('canvas');
      offscreen.width = image.width;
      offscreen.height = image.height;
      const offctx = offscreen.getContext('2d');
      if (!offctx) return;

      offctx.drawImage(image, 0, 0);
      const { data, width, height } = offctx.getImageData(0, 0, offscreen.width, offscreen.height);

      for (let y = 0; y < height; y += 1) {
        const lat = 90 - (y / (height - 1)) * 180;
        const latBand = Math.max(-90, Math.min(90, Math.round(lat)));
        const row = maskBands[latBand + 90];

        for (let x = 0; x < width; x += 1) {
          const idx = (y * width + x) * 4;
          const r = data[idx];
          const g = data[idx + 1];
          const b = data[idx + 2];
          const isDarkLand = r < 96 && g < 96 && b < 96;
          if (!isDarkLand) continue;

          const lon = -180 + (x / (width - 1)) * 360;
          const lonBin = wrapLonBin(Math.floor((lon + 180) * 2));
          row[lonBin] = 1;
        }
      }

      maskReady = true;
      refreshPointLandMask();
      render();
    }

    function loadWorldMask() {
      const image = new Image();
      image.crossOrigin = 'anonymous';
      image.decoding = 'async';
      image.onload = () => {
        try {
          buildMaskFromImage(image);
        } catch (err) {
          console.warn('[globe] mask build failed, using fallback:', err);
          maskReady = false;
          refreshPointLandMask();
          render();
        }
      };
      image.onerror = () => {
        console.warn('[globe] mask image failed to load');
        maskReady = false;
        refreshPointLandMask();
        render();
      };
      image.src = worldMaskUrl;
    }

    let dotsPerFrame = 0;

    function dotsForViewport(width) {
      if (width >= 1200) return 84000;
      if (width >= 900) return 48000;
      return 12000;
    }

    const amsterdamLongitudeDeg = 4.9041;
    const startAngleOffset = (-amsterdamLongitudeDeg * Math.PI) / 180;

    let cssWidth = 0;
    let cssHeight = 0;
    let sphereRadius = 0;
    let pixelRatio = 1;
    let angle = 0;
    let raf = 0;
    let startTs = 0;

    function resize() {
      const rect = container.getBoundingClientRect();
      cssWidth = Math.max(1, rect.width);
      cssHeight = Math.max(1, rect.height);
      sphereRadius = Math.min(cssWidth, cssHeight) * 0.46;
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.round(cssWidth * pixelRatio);
      canvas.height = Math.round(cssHeight * pixelRatio);
      canvas.style.width = `${cssWidth}px`;
      canvas.style.height = `${cssHeight}px`;
      ctx.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    }

    function projectMarker(marker, cosA, sinA, cosTilt, sinTilt, cx, cy) {
      const x = marker.x * cosA + marker.z * sinA;
      const z = -marker.x * sinA + marker.z * cosA;
      const y = marker.y;

      const yTilt = y * cosTilt - z * sinTilt;
      const zTilt = y * sinTilt + z * cosTilt;
      const depth = (zTilt + 1) * 0.5;
      const scale = 0.72 + depth * 0.45;
      const sx = cx + x * sphereRadius * scale;
      const sy = cy - yTilt * sphereRadius * scale;
      const dx = sx - cx;
      const dy = sy - cy;

      return {
        sx,
        sy,
        depth,
        zTilt,
        hidden: zTilt < -0.1 || ((dx * dx) + (dy * dy) > sphereRadius * sphereRadius)
      };
    }

    function badgeProgress(ts, delay) {
      const raw = (ts - delay) % badgeDuration;
      return raw < 0 ? raw + badgeDuration : raw;
    }

    function badgeOpacity(progress) {
      const normalized = progress / badgeDuration;
      if (normalized < 0.12) return 0;
      if (normalized < 0.2) return (normalized - 0.12) / 0.08;
      if (normalized < 0.76) return 1;
      if (normalized < 0.9) return 1 - ((normalized - 0.76) / 0.14);
      return 0;
    }

    function drawBoxIcon(iconX, iconY, iconSize, alpha) {
      const topColor = '#d9b28a';
      const leftColor = '#c58c54';
      const rightColor = '#b6773f';
      const tapeColor = '#f6e5cf';
      const shadowColor = '#86582d';
      const x = iconX;
      const y = iconY;
      const s = iconSize;

      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.beginPath();
      ctx.moveTo(x + s * 0.12, y + s * 0.34);
      ctx.lineTo(x + s * 0.5, y + s * 0.14);
      ctx.lineTo(x + s * 0.88, y + s * 0.34);
      ctx.lineTo(x + s * 0.5, y + s * 0.54);
      ctx.closePath();
      ctx.fillStyle = topColor;
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(x + s * 0.12, y + s * 0.34);
      ctx.lineTo(x + s * 0.5, y + s * 0.54);
      ctx.lineTo(x + s * 0.5, y + s * 0.92);
      ctx.lineTo(x + s * 0.12, y + s * 0.72);
      ctx.closePath();
      ctx.fillStyle = leftColor;
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(x + s * 0.88, y + s * 0.34);
      ctx.lineTo(x + s * 0.5, y + s * 0.54);
      ctx.lineTo(x + s * 0.5, y + s * 0.92);
      ctx.lineTo(x + s * 0.88, y + s * 0.72);
      ctx.closePath();
      ctx.fillStyle = rightColor;
      ctx.fill();

      ctx.strokeStyle = tapeColor;
      ctx.lineWidth = Math.max(0.8, s * 0.06);
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(x + s * 0.35, y + s * 0.25);
      ctx.lineTo(x + s * 0.68, y + s * 0.43);
      ctx.stroke();

      ctx.strokeStyle = shadowColor;
      ctx.globalAlpha = alpha * 0.35;
      ctx.lineWidth = Math.max(0.6, s * 0.045);
      ctx.beginPath();
      ctx.moveTo(x + s * 0.5, y + s * 0.15);
      ctx.lineTo(x + s * 0.5, y + s * 0.88);
      ctx.stroke();

      ctx.globalAlpha = alpha * 0.8;
      ctx.fillStyle = shadowColor;
      ctx.fillRect(x + s * 0.68, y + s * 0.6, s * 0.12, s * 0.16);
      ctx.strokeStyle = '#e8d8c4';
      ctx.lineWidth = Math.max(0.4, s * 0.03);
      ctx.beginPath();
      ctx.moveTo(x + s * 0.715, y + s * 0.66);
      ctx.lineTo(x + s * 0.765, y + s * 0.66);
      ctx.stroke();
      ctx.restore();
    }

    function drawBadge(ts, badge, drawX, drawY) {
      const progress = badgeProgress(ts, badge.delay);
      const opacity = badgeOpacity(progress);
      if (opacity <= 0) return;

      const badgeX = Math.round(drawX * 2) / 2;
      const badgeY = Math.round(drawY * 2) / 2;
      const iconSize = 18;
      const horizontalPadding = 10;
      const badgeHeight = 28;
      const gap = 7;

      ctx.save();
      ctx.font = '700 12.3px Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif';
      const textWidth = ctx.measureText(badge.amount).width;
      const badgeWidth = horizontalPadding + iconSize + gap + textWidth + horizontalPadding;
      const x = badgeX - (badgeWidth / 2);
      const y = badgeY - (badgeHeight / 2);

      ctx.globalAlpha = opacity * 0.18;
      ctx.fillStyle = '#0f172a';
      if (typeof ctx.roundRect === 'function') {
        ctx.beginPath();
        ctx.roundRect(x, y + 5, badgeWidth, badgeHeight, 14);
        ctx.fill();
      } else {
        ctx.fillRect(x, y + 5, badgeWidth, badgeHeight);
      }

      ctx.globalAlpha = opacity;
      ctx.fillStyle = 'rgba(15, 23, 42, 0.36)';
      if (typeof ctx.roundRect === 'function') {
        ctx.beginPath();
        ctx.roundRect(x, y, badgeWidth, badgeHeight, 14);
        ctx.fill();
        ctx.strokeStyle = 'rgba(191, 219, 254, 0.45)';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      } else {
        ctx.fillRect(x, y, badgeWidth, badgeHeight);
      }

      drawBoxIcon(x + horizontalPadding, y + 5, iconSize, opacity);

      ctx.fillStyle = '#f8fafc';
      ctx.textBaseline = 'middle';
      ctx.fillText(badge.amount, x + horizontalPadding + iconSize + gap, y + (badgeHeight / 2) + 0.5);
      ctx.restore();
    }

    function drawFrame(ts) {
      const cx = cssWidth * 0.5;
      const cy = cssHeight * 0.5;
      const mobileDotScale = cssWidth <= 768 ? 0.74 : 1;

      if (!startTs) startTs = ts;
      if (!reduceMotion.matches) {
        angle = startAngleOffset + ((ts - startTs) * rotationSpeed);
      } else {
        angle = startAngleOffset;
      }

      ctx.clearRect(0, 0, cssWidth, cssHeight);

      const cosA = Math.cos(angle);
      const sinA = Math.sin(angle);
      const cosTilt = Math.cos(northTiltRad);
      const sinTilt = Math.sin(northTiltRad);

      for (const p of points) {
        if (!p.land) continue;

        const x = p.x * cosA + p.z * sinA;
        const z = -p.x * sinA + p.z * cosA;
        const y = p.y;

        const yTilt = y * cosTilt - z * sinTilt;
        const zTilt = y * sinTilt + z * cosTilt;

        if (zTilt < -0.96) continue;

        const depth = (zTilt + 1) * 0.5;
        const scale = 0.72 + depth * 0.45;
        const sx = cx + x * sphereRadius * scale;
        const sy = cy - yTilt * sphereRadius * scale;

        const dx = sx - cx;
        const dy = sy - cy;
        if ((dx * dx) + (dy * dy) > sphereRadius * sphereRadius) continue;

        const radius = (0.58 + depth * 1.28) * mobileDotScale;
        const backSide = depth < 0.45;
        const color = backSide ? p.landBackColor : p.landFrontColor;

        ctx.beginPath();
        ctx.arc(sx, sy, radius, 0, Math.PI * 2);
        ctx.globalAlpha = 1;
        ctx.fillStyle = color;
        ctx.fill();
      }

      // Key city markers: white core dot + pulsing ring.
      const markerScale = cssWidth <= 768 ? 0.58 : 1;
      for (const marker of cityMarkers) {
        const projection = projectMarker(marker, cosA, sinA, cosTilt, sinTilt, cx, cy);
        if (projection.hidden) continue;

        const pulse = 0.5 + 0.5 * Math.sin(ts * 0.004 + marker.phase);
        const coreRadius = (1.8 + projection.depth * 1.2) * markerScale;
        const ringRadius = coreRadius + 2 + pulse * 2.4;
        const ringAlpha = 0.35 + projection.depth * 0.45;

        ctx.beginPath();
        ctx.arc(projection.sx, projection.sy, ringRadius, 0, Math.PI * 2);
        ctx.globalAlpha = ringAlpha;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = cssWidth <= 768 ? 0.8 : 1;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(projection.sx, projection.sy, coreRadius, 0, Math.PI * 2);
        ctx.globalAlpha = 0.95;
        ctx.fillStyle = '#ffffff';
        ctx.fill();
      }

      if (cssWidth > 600) {
        const visibleBadges = [];
        for (const badge of badgeDefinitions) {
          const projection = projectMarker(badge.marker, cosA, sinA, cosTilt, sinTilt, cx, cy);
          if (projection.zTilt < 0.14 || projection.hidden) {
            badge.renderX = null;
            badge.renderY = null;
            continue;
          }

          const targetX = projection.sx + badge.offsetX;
          const targetY = projection.sy + badge.offsetY;

          if (badge.renderX === null || badge.renderY === null) {
            badge.renderX = targetX;
            badge.renderY = targetY;
          } else {
            const smooth = reduceMotion.matches ? 1 : 0.16;
            badge.renderX += (targetX - badge.renderX) * smooth;
            badge.renderY += (targetY - badge.renderY) * smooth;
          }

          visibleBadges.push({
            badge,
            projection,
            drawX: badge.renderX,
            drawY: badge.renderY
          });
        }

        visibleBadges.sort((a, b) => a.projection.depth - b.projection.depth);
        for (const entry of visibleBadges) {
          drawBadge(ts, entry.badge, entry.drawX, entry.drawY);
        }
      }

      ctx.globalAlpha = 1;

      if (!reduceMotion.matches) {
        raf = window.requestAnimationFrame(drawFrame);
      }
    }

    function render() {
      if (raf) window.cancelAnimationFrame(raf);
      raf = window.requestAnimationFrame(drawFrame);
    }

    resize();
    dotsPerFrame = dotsForViewport(cssWidth);
    createPoints(dotsPerFrame);
    render();
    loadWorldMask();

    const observer = new ResizeObserver(() => {
      resize();
      const nextDots = dotsForViewport(cssWidth);
      if (nextDots !== dotsPerFrame) {
        dotsPerFrame = nextDots;
        createPoints(dotsPerFrame);
      }
      render();
    });
    observer.observe(container);

    const motionChange = () => {
      startTs = performance.now() - ((angle - startAngleOffset) / rotationSpeed);
      render();
    };

    if (typeof reduceMotion.addEventListener === 'function') {
      reduceMotion.addEventListener('change', motionChange);
    } else {
      reduceMotion.addListener(motionChange);
    }

    window.addEventListener('beforeunload', () => {
      if (raf) window.cancelAnimationFrame(raf);
      observer.disconnect();
      if (typeof reduceMotion.removeEventListener === 'function') {
        reduceMotion.removeEventListener('change', motionChange);
      } else {
        reduceMotion.removeListener(motionChange);
      }
    }, { once: true });
  })();
</script>

