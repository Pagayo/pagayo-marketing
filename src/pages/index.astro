---
/**
 * Root Portal - pagayo.com
 * Minimale portal met login, registratie, en link naar meer informatie
 *
 * CSS Architecture:
 * - @pagayo/design: Single CSS source of truth (revolutionary theme tokens + BEM component classes)
 * - Scoped styles: Portal-specifieke layout, theme toggle, logo, light theme overrides
 * - BEM: .btn--primary, .btn--secondary, .btn--ghost, .badge (uit design system)
 *
 * i18n-ready: Alle teksten komen uit content/pages/en/portal.json
 * Voor nieuwe taal: maak content/pages/{lang}/portal.json + pages/{lang-route}/index.astro
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import portalContent from '../content/pages/en/portal.json';

// Pagayo Design System — single CSS source of truth
// Bevat: CSS reset, base tokens, revolutionary theme tokens, BEM component classes
import '@pagayo/design';

const { title, description, lang, countryFlag, tagline, actions, themeToggle, footer, languages, seo } = portalContent;
---

<BaseLayout 
  title={title}
  description={description}
  lang={lang}
  alternates={seo.alternates}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
  twitterCard={seo.twitterCard}
  noIndex={seo.noIndex}
  structuredData={[{ type: seo.structuredData.type as 'WebSite', data: { name: seo.structuredData.name, url: seo.structuredData.url } }]}
>
  <main class="portal" data-theme="dark">
    <div class="portal-container">
      <!-- Country flag -->
      <span class="country-flag">{countryFlag}</span>

      <!-- Theme toggle -->
      <button class="theme-toggle" id="themeToggle" aria-label={themeToggle.ariaLabel}>
        <span class="toggle-icon sun">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </span>
        <span class="toggle-track">
          <span class="toggle-thumb"></span>
        </span>
        <span class="toggle-icon moon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </span>
      </button>

      <div class="portal-logo">
        <h1><span class="logo-p">P</span>agayo<span class="logo-dot">.</span></h1>
      </div>

      <p class="portal-tagline">"{tagline.before}<span class="tagline-separator">{tagline.separator}</span>{tagline.after}"</p>

      <!-- Portal card — .badge from design system, portal-specific card styling -->
      <div class="portal-card">
        <span class="badge card-badge">100% free</span>
        <div class="portal-actions">
          <a href={actions.createOrder.url} class="btn btn--primary btn--lg btn--full">
            {actions.createOrder.label}
          </a>
          <a href={actions.signIn.url} class="btn btn--secondary btn--lg btn--full">
            {actions.signIn.label}
          </a>
          <a href={actions.createAccount.url} class="btn btn--secondary btn--lg btn--full">
            {actions.createAccount.label}
          </a>
          <a href={actions.learnMore.url} class="btn btn--ghost btn--full">
            {actions.learnMore.label}
          </a>
        </div>
      </div>

      <!-- Language flags -->
      <div class="languages">
        {languages.flags.map(flag => (
          <span class="lang">{flag}</span>
        ))}
        <span class="lang-more">{languages.moreLabel}</span>
      </div>

      <footer class="portal-footer">
        <p>{footer.helpText} <a href={footer.helpLink.url}>{footer.helpLink.label}</a></p>
        <div class="portal-footer-brand">
          <p>{footer.brand}</p>
          <p>{footer.copyright}</p>
        </div>
      </footer>
    </div>
  </main>
</BaseLayout>

<script>
  const toggle = document.getElementById('themeToggle');
  const portal = document.querySelector('.portal');
  
  // Read saved preference
  const saved = localStorage.getItem('portal-theme') || 'dark';
  portal?.setAttribute('data-theme', saved);
  
  toggle?.addEventListener('click', () => {
    const current = portal?.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    portal?.setAttribute('data-theme', next);
    localStorage.setItem('portal-theme', next);
  });
</script>

<style is:global>
  /* Override global styles for portal page */
  body:has(.portal) {
    background: #0a0a0f !important;
  }
  body:has(.portal[data-theme="light"]) {
    background: #f5f5f7 !important;
  }
</style>

<style>
  /* ─────────────────────────────────────────────────
   * PORTAL TOKEN SCOPE
   *
   * Design system tokens op :root worden overschreven door
   * global.css continent-theme (:root --accent: #00ff88).
   * Daarom scopen we tokens op .portal tot global.css
   * is opgeschoond. Waarden zijn 1:1 met @pagayo/design
   * revolutionary theme.
   *
   * TODO: Verwijder deze scope wanneer global.css alleen
   * design system tokens gebruikt.
   * ───────────────────────────────────────────────── */
  .portal {
    --bg-deep: #0a0a0f;
    --bg-surface: #0e0e14;
    --bg-elevated: #111118;
    --bg-hover: #1a1a23;
    --bg-active: #292a36;
    --accent: #f5a623;
    --accent-light: #ffbe3f;
    --accent-dim: #d98e00;
    --accent-glow: rgb(245 166 35 / 0.15);
    --text-primary: #f0f0f5;
    --text-secondary: rgb(240 240 245 / 0.7);
    --text-muted: rgb(240 240 245 / 0.45);
    --text-disabled: rgb(240 240 245 / 0.3);
    --border: rgb(240 240 245 / 0.06);
    --border-light: rgb(240 240 245 / 0.09);
    --border-strong: rgb(240 240 245 / 0.15);
  }

  /* LIGHT THEME — design system heeft alleen dark/revolutionary.
     Tot light theme in design system: overrides hier. */
  .portal[data-theme="light"] {
    --bg-deep: #f5f5f7;
    --bg-surface: #ffffff;
    --bg-elevated: #f0f0f2;
    --bg-hover: #e8e8ec;
    --bg-active: #dddde2;
    --accent: #e8951a;
    --accent-light: #f5a623;
    --accent-dim: #c47d10;
    --accent-glow: rgb(232 149 26 / 0.12);
    --text-primary: #1a1a2e;
    --text-secondary: rgb(26 26 46 / 0.6);
    --text-muted: rgb(26 26 46 / 0.35);
    --text-disabled: rgb(26 26 46 / 0.25);
    --border: rgb(26 26 46 / 0.08);
    --border-light: rgb(26 26 46 / 0.12);
    --border-strong: rgb(26 26 46 / 0.2);
  }

  /* ─── PORTAL LAYOUT ─── */
  .portal {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-deep) !important;
    padding: var(--space-8);
    transition: background var(--transition-slow), color var(--transition-slow);
  }

  .portal-container {
    text-align: center;
    max-width: 400px;
    width: 100%;
    position: relative;
  }

  /* ─── Country Flag ─── */
  .country-flag {
    position: absolute;
    top: calc(-1 * var(--space-4));
    left: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-none);
    z-index: var(--z-dropdown);
  }

  /* ─── Theme Toggle ─── */
  .theme-toggle {
    position: absolute;
    top: calc(-1 * var(--space-4));
    right: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-1);
    z-index: var(--z-dropdown);
  }

  .toggle-icon {
    display: flex;
    align-items: center;
    color: var(--accent);
    transition: opacity var(--transition-normal);
  }

  .toggle-track {
    width: 36px;
    height: 20px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    position: relative;
    transition: background var(--transition-slow);
  }

  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    background: var(--accent);
    border-radius: var(--radius-full);
    transition: transform var(--transition-slow);
    transform: translateX(16px);
  }

  .portal[data-theme="light"] .toggle-thumb {
    transform: translateX(0);
  }

  /* ─── Logo ─── */
  .portal-logo {
    margin-bottom: var(--space-2);
  }

  .portal-logo h1 {
    color: var(--text-primary);
    font-size: 2.75rem;
    font-weight: var(--font-bold);
    margin: 0;
    letter-spacing: -0.02em;
    transition: color var(--transition-slow);
  }

  .logo-p,
  .logo-dot {
    color: var(--accent);
    font-weight: 800;
  }

  /* ─── Tagline ─── */
  .portal-tagline {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
    font-style: italic;
    letter-spacing: 0.02em;
    transition: color var(--transition-slow);
  }

  .tagline-separator {
    display: inline-block;
    margin: 0 0.1em;
    color: var(--accent);
    font-style: normal;
  }

  /* ─── Portal Card ─── */
  .portal-card {
    position: relative;
    background: linear-gradient(135deg, var(--bg-surface), var(--accent-glow));
    border: 2px solid var(--accent);
    border-radius: var(--radius-2xl);
    padding: var(--space-10) var(--space-6) var(--space-6);
    margin-bottom: var(--space-6);
    transition: background var(--transition-slow), border-color var(--transition-slow);
  }

  /* ─── Card Badge — volledig zelfstandig, onafhankelijk van design .badge ─── */
  .card-badge {
    position: absolute;
    top: -0.85em;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    padding: 0.4em 1.2em;
    background: var(--accent);
    color: var(--bg-deep);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    border-radius: var(--radius-full);
    z-index: 1;
  }

  /* ─── Portal Action Buttons ─── */
  /* Design system build mist button variant CSS (primary/secondary/ghost).
     Daarom hier volledig gedefinieerd met portal tokens. */
  .portal-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .portal-actions .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-lg);
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
    text-decoration: none;
    height: auto;
    border: 2px solid transparent;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .portal-actions .btn--primary {
    background: var(--accent);
    color: var(--bg-deep);
    border-color: var(--accent);
  }

  .portal-actions .btn--primary:hover {
    background: var(--accent-light);
    border-color: var(--accent-light);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px var(--accent-glow);
  }

  .portal-actions .btn--secondary {
    background: transparent;
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .portal-actions .btn--secondary:hover {
    border-color: var(--accent);
    background: var(--bg-hover);
  }

  .portal-actions .btn--ghost {
    background: transparent;
    color: var(--text-secondary);
    border-color: transparent;
    padding: var(--space-3);
  }

  .portal-actions .btn--ghost:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  /* ─── Language Flags ─── */
  .languages {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
  }

  .lang {
    font-size: var(--text-xl);
  }

  .lang-more {
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: flex;
    align-items: center;
  }

  /* ─── Footer ─── */
  .portal-footer {
    text-align: center;
    padding: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .portal-footer a {
    color: var(--accent);
    text-decoration: none;
  }

  .portal-footer a:hover {
    text-decoration: underline;
  }

  .portal-footer-brand {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .portal-footer-brand p {
    color: var(--text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }
</style>
