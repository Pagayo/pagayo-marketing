<script>
  const video = document.getElementById('portalVideo') as HTMLVideoElement;
  const btn = document.getElementById('videoPlayBtn')!;

  // Toon frame op 1 seconde als thumbnail
  video.addEventListener('loadedmetadata', () => {
    video.currentTime = 0.001;
  });

  btn.addEventListener('click', () => {
    if (video.paused) {
      video.play();
      btn.setAttribute('data-playing', '');
    } else {
      video.pause();
      btn.removeAttribute('data-playing');
    }
  });

  video.addEventListener('ended', () => {
    btn.removeAttribute('data-playing');
  });

  // Scroll-down buttons: scroll to next section
  document.querySelectorAll('.scroll-down').forEach((button) => {
    button.addEventListener('click', () => {
      const section = button.closest('.section');
      const next = section?.nextElementSibling as HTMLElement | null;
      if (next) {
        next.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
