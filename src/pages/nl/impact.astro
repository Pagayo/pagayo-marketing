---
import MarketingLayout from '../../layouts/Marketing.astro';
import ImpactPageMain from '../../components/impact/ImpactPageMain.astro';
import { loadMessages } from '../../lib/i18n';
import { SITE_ORIGIN } from '../../lib/site-seo';
import { localizedPath } from '../../lib/locale-routes';

const locale = 'nl';
const messages = loadMessages(locale);
const t = messages.impactPage;

const impactSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t.title,
  description: t.description,
  url: new URL(localizedPath('impact', locale), SITE_ORIGIN).href,
  inLanguage: t.inLanguage,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Pagayo',
    url: SITE_ORIGIN,
  },
};
---

<MarketingLayout
  locale={locale}
  alternatePageId="impact"
  title={t.title}
  description={t.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(impactSchema)} />
  <ImpactPageMain impact={t} />
</MarketingLayout>
