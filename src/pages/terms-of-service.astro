---
import MarketingLayout from '../layouts/Marketing.astro';

const pageTitle = 'Terms of Service — Pagayo';
const pageDescription =
  'Terms governing your access to and use of the Pagayo commerce platform, website, and related services.';

const lastUpdated = 'June 8, 2026';
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main class="privacy-page">
    <section class="pp-hero section">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">Legal</span>
          <h1 class="headline-lg">Terms of Service</h1>
          <p class="text-secondary">Last updated {lastUpdated}</p>
        </div>
      </div>
    </section>

    <section class="pp-body section">
      <div class="container">
        <div class="pp-layout">

          <nav class="pp-toc" aria-label="Table of contents">
            <h2>Contents</h2>
            <ol>
              <li><a href="#agreement">Agreement</a></li>
              <li><a href="#access-and-use">Access and use</a></li>
              <li><a href="#eligibility">Eligibility</a></li>
              <li><a href="#accounts">Accounts</a></li>
              <li><a href="#payment">Payment terms</a></li>
              <li><a href="#ownership">Ownership and licenses</a></li>
              <li><a href="#tenant-responsibilities">Tenant responsibilities</a></li>
              <li><a href="#third-party">Third-party services</a></li>
              <li><a href="#beta">Beta features</a></li>
              <li><a href="#communications">Communications</a></li>
              <li><a href="#changes">Changes to these Terms</a></li>
              <li><a href="#termination">Termination</a></li>
              <li><a href="#service-changes">Changes to the Service</a></li>
              <li><a href="#copyright">Copyright complaints</a></li>
              <li><a href="#privacy">Privacy</a></li>
              <li><a href="#indemnity">Indemnity</a></li>
              <li><a href="#disclaimers">Disclaimers</a></li>
              <li><a href="#liability">Limitation of liability</a></li>
              <li><a href="#disputes">Dispute resolution</a></li>
              <li><a href="#general">General</a></li>
              <li><a href="#contact">Contact</a></li>
            </ol>
          </nav>

          <div class="pp-content">

            <section id="agreement">
              <h2>Agreement</h2>
              <p>
                Welcome, and thank you for your interest in Pagayo ("Pagayo", "we", or "us").
                These Terms of Service ("Terms") govern your access to and use of Pagayo's
                software platform, APIs, documentation, and related tools, including at{' '}
                <a href="https://www.pagayo.com">www.pagayo.com</a>, tenant storefronts and admin
                environments, and all related software made available by Pagayo to build, manage,
                and operate online and in-person sales ("Service").
              </p>
              <p>
                By accessing or using the Service, you agree to these Terms. Please also read our{' '}
                <a href="/privacy-policy">Privacy Policy</a>, which explains how we collect, use,
                disclose, and process personal data.
              </p>
              <p>
                If you use the Service on behalf of a company or other organisation, you represent
                that you have authority to bind that entity. In that case, "you" refers to that
                entity.
              </p>
              <p>
                If you have a separate written agreement with Pagayo (for example, an enterprise or
                partner agreement), that agreement controls where it conflicts with these Terms.
              </p>
            </section>

            <section id="access-and-use">
              <h2>1. Access and use</h2>

              <h3>1.1 Provision of access</h3>
              <p>
                Pagayo is a multi-channel commerce platform. The Service lets you operate a webshop,
                point-of-sale flows, and other sales channels, manage orders, products, customers,
                payments, and related business operations. Subject to your compliance with these
                Terms, Pagayo grants you a limited, non-exclusive, non-transferable right to access
                and use the Service for your internal business purposes.
              </p>

              <h3>1.2 Your content</h3>
              <p>
                You may submit or store information through the Service, including product
                catalogues, orders, customer records, media, configuration, and messages
                ("Tenant Content"). You retain ownership of Tenant Content. You grant Pagayo the
                rights necessary to host, process, transmit, display, and back up Tenant Content
                solely to provide, secure, and improve the Service, comply with law, and enforce
                these Terms.
              </p>
              <p>
                You represent and warrant that you have all rights, licences, and permissions needed
                for Pagayo to process Tenant Content under these Terms and to provide the Service to
                you, and that Tenant Content does not violate applicable law or third-party rights.
              </p>

              <h3>1.3 AI-assisted features</h3>
              <p>
                The Service may include optional AI-assisted features (for example, content
                suggestions or operational insights). Output from such features is generated
                automatically and may be inaccurate or incomplete. You are responsible for reviewing
                any AI-generated output before relying on it in your business. Pagayo does not use
                your Tenant Content to train machine learning models unless you explicitly opt in
                where such a feature is offered.
              </p>

              <h3>1.4 Acceptable use</h3>
              <p>Except where prohibited by applicable law, you may not:</p>
              <ul>
                <li>
                  Reverse engineer, decompile, or attempt to derive the source code or underlying
                  structure of the Service, except to the extent such restriction is not permitted
                  by law.
                </li>
                <li>
                  Copy, modify, or create derivative works of the Service, or resell, rent, or
                  sublicense access to the Service.
                </li>
                <li>
                  Probe, scan, or attempt to penetrate the Service, interfere with its operation,
                  or circumvent access controls or usage limits.
                </li>
                <li>
                  Use the Service to transmit malware, spam, or unlawful, harmful, or fraudulent
                  content or activity.
                </li>
                <li>
                  Use the Service in a manner that infringes intellectual property or other rights
                  of any person, or that violates applicable laws or regulations (including consumer,
                  payment, tax, and marketing laws).
                </li>
                <li>
                  Misrepresent your identity, your business, or the origin of goods or services sold
                  through the Service.
                </li>
                <li>
                  Knowingly permit any third party to do any of the foregoing.
                </li>
              </ul>
              <p>
                You will promptly notify Pagayo of any unauthorised use of your account and
                cooperate reasonably to prevent or stop such use.
              </p>
            </section>

            <section id="eligibility">
              <h2>2. Eligibility</h2>
              <p>
                You must be at least 18 years old (or the age of majority in your jurisdiction,
                whichever is higher) to use the Service. By agreeing to these Terms, you represent
                that you meet this requirement, that you have not previously been suspended or
                removed from the Service for cause, and that your use of the Service complies with
                all applicable laws in your region.
              </p>
              <p>
                If you operate a business that sells to consumers, you are responsible for complying
                with laws that apply to your customers, including age restrictions for certain
                products or services.
              </p>
            </section>

            <section id="accounts">
              <h2>3. Accounts</h2>
              <p>
                Most features require a Pagayo account. When you register, you may be asked for
                information such as your name, email address, business name, and billing details.
                You agree to provide accurate, complete information and to keep it up to date.
              </p>
              <p>
                You are responsible for maintaining the confidentiality of your credentials and for
                all activity under your account. If you believe your account is no longer secure,
                notify us immediately at{' '}
                <a href="mailto:legal@pagayo.com">legal@pagayo.com</a>.
              </p>
              <p>
                Pagayo may offer role-based access for team members. You are responsible for
                permissions you grant and for actions taken by users you authorise.
              </p>
            </section>

            <section id="payment">
              <h2>4. Payment terms</h2>

              <h3>4.1 Plans and fees</h3>
              <p>
                Certain features require a paid plan. Current fees are described on our{' '}
                <a href="/pricing">Pricing</a> page or in the Service. Unless stated otherwise,
                paid plans are billed annually in advance. Fees are shown in euros unless we
                indicate otherwise at checkout. Fees are non-refundable except where required by
                applicable law.
              </p>

              <h3>4.2 Price changes</h3>
              <p>
                We may change fees for the Service. If we increase fees for a paid plan you already
                subscribe to, we will give you reasonable advance notice before the change applies
                to your next billing cycle. Your continued use after the effective date constitutes
                acceptance of the new fees. If you do not agree, you may cancel before renewal.
              </p>

              <h3>4.3 Payment processing</h3>
              <p>
                Platform subscription fees are processed by third-party payment providers, including
                Stripe and Mollie. Your use of those payment services is subject to the provider's
                terms and privacy policies. Pagayo does not store full payment card numbers.
              </p>
              <p>
                <strong>End-customer payments.</strong> When you accept payments from your own
                customers through the Service, those transactions are typically processed through
                your connected payment account (for example, Stripe Connect). Pagayo is not the
                merchant of record for your sales to end customers unless we expressly state
                otherwise in writing.
              </p>

              <h3>4.4 Subscriptions and renewal</h3>
              <p>
                Paid subscriptions renew automatically for successive periods of the same duration
                unless you cancel before the renewal date. You authorise Pagayo or its payment
                processors to charge applicable fees and taxes on each renewal. Cancel through your
                account billing settings or by contacting us before renewal to avoid the next charge.
              </p>

              <h3>4.5 Taxes</h3>
              <p>
                You are responsible for taxes associated with your use of the Service, other than
                taxes based on Pagayo's net income. Where required, we will collect VAT or similar
                taxes at checkout.
              </p>

              <h3>4.6 Delinquent accounts</h3>
              <p>
                If fees are due but unpaid, we may suspend or limit access to paid features until
                payment is received. We may terminate accounts that remain delinquent after notice.
              </p>
            </section>

            <section id="ownership">
              <h2>5. Ownership and licenses</h2>

              <h3>5.1 The Service</h3>
              <p>
                Pagayo and its licensors own all rights in the Service, including software, design,
                documentation, and trademarks. No rights are granted except as expressly stated in
                these Terms.
              </p>

              <h3>5.2 Tenant Content</h3>
              <p>
                As between you and Pagayo, you retain all rights in Tenant Content. Pagayo does not
                claim ownership of your product data, orders, or customer records.
              </p>

              <h3>5.3 Feedback</h3>
              <p>
                If you provide suggestions or feedback about the Service ("Feedback"), you grant
                Pagayo a perpetual, irrevocable, worldwide, royalty-free licence to use and exploit
                Feedback without restriction or compensation to you.
              </p>

              <h3>5.4 Usage data</h3>
              <p>
                We may collect and analyse technical logs and usage information about how the
                Service is accessed and used ("Usage Data") to operate, secure, and improve the
                Service. Usage Data does not include Tenant Content. We may disclose Usage Data only
                in aggregated or de-identified form that does not identify you.
              </p>
            </section>

            <section id="tenant-responsibilities">
              <h2>6. Tenant responsibilities</h2>
              <p>When you use Pagayo to sell goods or services, you are the operator of your store
                or business. You are solely responsible for:</p>
              <ul>
                <li>
                  The products and services you offer, including descriptions, pricing, availability,
                  and legal compliance.
                </li>
                <li>
                  Your terms, policies, and notices to your customers (including refund, shipping,
                  and privacy policies where required).
                </li>
                <li>
                  Collecting and remitting applicable taxes, duties, and regulatory fees.
                </li>
                <li>
                  Handling customer support, disputes, chargebacks, and returns for your sales.
                </li>
                <li>
                  Ensuring that payment methods and customer data are handled in compliance with
                  applicable law and payment network rules.
                </li>
              </ul>
              <p>
                Where Pagayo processes personal data on your behalf as a processor, our processing
                is described in our Privacy Policy and, where applicable, a data processing
                agreement.
              </p>
            </section>

            <section id="third-party">
              <h2>7. Third-party services</h2>
              <p>
                The Service integrates with third-party services, including Cloudflare
                (infrastructure), Stripe and Mollie (payments), and other providers you may enable
                (for example, email, analytics, or import tools). Third-party services are governed
                by their own terms. Pagayo does not control and is not responsible for third-party
                services. Your decision to enable an integration is at your own discretion and
                risk.
              </p>
            </section>

            <section id="beta">
              <h2>8. Beta features</h2>
              <p>
                We may offer features labelled beta, preview, early access, or similar. Beta
                features may be incomplete, change without notice, or be withdrawn. Beta features are
                provided "as is" without warranty or support commitments. Use beta features at your
                own risk.
              </p>
            </section>

            <section id="communications">
              <h2>9. Communications</h2>
              <p>
                We may send you service-related emails (for example, security alerts, billing
                notices, or material changes to these Terms). You may opt out of promotional emails
                using the unsubscribe link in those messages. You may not opt out of essential
                service communications while you maintain an account.
              </p>
            </section>

            <section id="changes">
              <h2>10. Changes to these Terms</h2>
              <p>
                We may update these Terms from time to time. When we make material changes, we will
                update the date at the top of this page and, where appropriate, notify you by email
                or through the Service. Changes take effect when posted unless stated otherwise.
                Your continued use after the effective date constitutes acceptance. If you do not
                agree, you must stop using the Service.
              </p>
            </section>

            <section id="termination">
              <h2>11. Termination</h2>
              <p>
                You may stop using the Service at any time. We may suspend or terminate your access
                if you violate these Terms, if required by law, to address security or abuse, or if
                fees remain unpaid after notice. We will strive to give reasonable advance notice
                before terminating paid access, except where immediate action is necessary.
              </p>
              <p>
                If we terminate your paid subscription without cause, we will refund unused prepaid
                fees on a pro rata basis. If termination results from your breach of these Terms,
                no refund is owed.
              </p>
              <p>
                Upon termination, your right to access the Service ends. We may delete or retain
                Tenant Content as described in our Privacy Policy and applicable law. You should
                export data you need before closing your account.
              </p>
              <p>
                Sections that by their nature should survive termination (including payment
                obligations, ownership, indemnity, disclaimers, limitation of liability, and dispute
                resolution) will survive.
              </p>
            </section>

            <section id="service-changes">
              <h2>12. Changes to the Service</h2>
              <p>
                We may modify, suspend, or discontinue any part of the Service at any time. We are
                not liable for changes to the Service, including paid features, or for temporary
                unavailability. We do not guarantee that any particular feature will remain
                available indefinitely.
              </p>
            </section>

            <section id="copyright">
              <h2>13. Copyright complaints</h2>
              <p>
                If you believe content on the Service infringes your copyright, send a notice to{' '}
                <a href="mailto:legal@pagayo.com">legal@pagayo.com</a> including:
              </p>
              <ul>
                <li>Your physical or electronic signature.</li>
                <li>Identification of the copyrighted work claimed to have been infringed.</li>
                <li>
                  Identification of the material claimed to be infringing and information reasonably
                  sufficient to locate it.
                </li>
                <li>Your contact details.</li>
                <li>
                  A statement of good-faith belief that the use is not authorised by the copyright
                  owner, its agent, or the law.
                </li>
                <li>
                  A statement, under penalty of perjury where applicable, that the information in
                  the notice is accurate and that you are authorised to act on behalf of the
                  copyright owner.
                </li>
              </ul>
              <p>
                We may remove or disable access to material that we believe violates these Terms or
                applicable law and may terminate repeat infringers where appropriate.
              </p>
            </section>

            <section id="privacy">
              <h2>14. Privacy</h2>
              <p>
                Our collection and use of personal data is described in the{' '}
                <a href="/privacy-policy">Privacy Policy</a>. By using the Service, you acknowledge
                that you have read it.
              </p>
            </section>

            <section id="indemnity">
              <h2>15. Indemnity</h2>
              <p>
                To the fullest extent permitted by law, you will defend, indemnify, and hold
                harmless Pagayo and its affiliates, officers, directors, employees, and agents from
                any claims, damages, losses, liabilities, and expenses (including reasonable legal
                fees) arising out of or relating to: (a) your use of the Service; (b) Tenant
                Content; (c) your sales or business operations conducted through the Service; (d)
                your violation of these Terms or applicable law; or (e) any claim that Tenant
                Content infringes third-party rights.
              </p>
            </section>

            <section id="disclaimers">
              <h2>16. Disclaimers</h2>
              <p>
                THE SERVICE IS PROVIDED "AS IS" AND "AS AVAILABLE". TO THE FULLEST EXTENT PERMITTED
                BY LAW, PAGAYO DISCLAIMS ALL WARRANTIES, WHETHER EXPRESS, IMPLIED, OR STATUTORY,
                INCLUDING IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE,
                TITLE, AND NON-INFRINGEMENT. PAGAYO DOES NOT WARRANT THAT THE SERVICE WILL BE
                UNINTERRUPTED, ERROR-FREE, SECURE, OR FREE OF HARMFUL COMPONENTS.
              </p>
              <p>
                Some jurisdictions do not allow certain disclaimers, so some of the above may not
                apply to you.
              </p>
            </section>

            <section id="liability">
              <h2>17. Limitation of liability</h2>
              <p>
                TO THE FULLEST EXTENT PERMITTED BY LAW, PAGAYO WILL NOT BE LIABLE FOR ANY INDIRECT,
                INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, OR FOR LOSS OF PROFITS,
                REVENUE, DATA, GOODWILL, OR BUSINESS OPPORTUNITIES, ARISING OUT OF OR RELATED TO
                THESE TERMS OR THE SERVICE, WHETHER BASED ON WARRANTY, CONTRACT, TORT, OR ANY OTHER
                LEGAL THEORY, EVEN IF PAGAYO HAS BEEN ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.
              </p>
              <p>
                TO THE FULLEST EXTENT PERMITTED BY LAW, PAGAYO'S TOTAL LIABILITY FOR ALL CLAIMS
                ARISING OUT OF OR RELATING TO THESE TERMS OR THE SERVICE WILL NOT EXCEED THE GREATER
                OF (A) THE AMOUNTS YOU PAID TO PAGAYO FOR THE SERVICE IN THE SIX (6) MONTHS BEFORE
                THE EVENT GIVING RISE TO THE CLAIM, OR (B) EUR 100.
              </p>
              <p>
                Nothing in these Terms limits liability that cannot be limited under applicable law,
                including liability for fraud or wilful misconduct, or statutory consumer rights
                where you use the Service as a consumer.
              </p>
            </section>

            <section id="disputes">
              <h2>18. Dispute resolution</h2>
              <p>
                We prefer to resolve concerns informally. Contact us first at{' '}
                <a href="mailto:legal@pagayo.com">legal@pagayo.com</a> and allow a reasonable
                opportunity to address your concern.
              </p>
              <p>
                If you are a consumer in the European Economic Area, you may also use the European
                Commission's Online Dispute Resolution platform at{' '}
                <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener noreferrer">
                  ec.europa.eu/consumers/odr
                </a>.
              </p>
              <p>
                These Terms are governed by the laws of the Netherlands, without regard to conflict
                of law principles. Unless mandatory law requires otherwise, disputes that cannot be
                resolved informally will be submitted to the competent courts in the Netherlands.
              </p>
            </section>

            <section id="general">
              <h2>19. General</h2>
              <ul>
                <li>
                  <strong>Entire agreement.</strong> These Terms, together with the Privacy Policy
                  and any plan-specific terms presented at checkout, form the entire agreement
                  between you and Pagayo regarding the Service.
                </li>
                <li>
                  <strong>Assignment.</strong> You may not assign these Terms without our prior
                  written consent. We may assign these Terms in connection with a merger,
                  acquisition, or sale of assets.
                </li>
                <li>
                  <strong>Export controls.</strong> You must comply with applicable export control
                  and sanctions laws. You may not use the Service in violation of such laws.
                </li>
                <li>
                  <strong>Electronic communications.</strong> You consent to receive communications
                  from us electronically. Electronic communications satisfy legal writing
                  requirements where permitted by law.
                </li>
                <li>
                  <strong>Severability.</strong> If any provision is held invalid or unenforceable,
                  the remaining provisions remain in effect.
                </li>
                <li>
                  <strong>No waiver.</strong> Failure to enforce a provision is not a waiver of that
                  provision or any other provision.
                </li>
              </ul>
            </section>

            <section id="contact">
              <h2>20. Contact</h2>
              <p>Questions about these Terms? Contact us:</p>
              <address>
                <strong>Pagayo</strong><br />
                Email: <a href="mailto:legal@pagayo.com">legal@pagayo.com</a><br />
                General enquiries: <a href="mailto:info@pagayo.com">info@pagayo.com</a>
              </address>
              <p>
                See also our <a href="/contact">contact page</a> for other ways to reach us.
              </p>
            </section>

          </div>
        </div>
      </div>
    </section>
  </main>
</MarketingLayout>

<style>
  .privacy-page {
    padding-top: 2rem;
  }

  .pp-hero {
    padding-bottom: 2rem;
  }

  .pp-hero .text-secondary {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  .pp-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .pp-toc {
    position: sticky;
    top: 6rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    padding: 1.5rem;
  }

  .pp-toc h2 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 1rem 0;
  }

  .pp-toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pp-toc a {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.4;
    display: block;
    transition: color 0.2s;
  }

  .pp-toc a:hover {
    color: var(--text-primary);
  }

  .pp-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .pp-content section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pp-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
  }

  .pp-content h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0.5rem 0 0 0;
  }

  .pp-content p,
  .pp-content address {
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0;
    font-style: normal;
  }

  .pp-content a {
    color: var(--pagayo-purple, #a78bfa);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pp-content a:hover {
    color: var(--text-primary);
  }

  .pp-content ul,
  .pp-content ol {
    color: var(--text-secondary);
    line-height: 1.75;
    padding-left: 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pp-content strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .pp-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .pp-toc {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .pp-content h2 {
      font-size: 1.25rem;
    }
  }
</style>
