---
import MarketingLayout from '../layouts/Marketing.astro';
import PageHero from '../components/layout/PageHero.astro';

const pageTitle = 'Contact — Pagayo';
const pageDescription = 'Get in touch with the Pagayo team. Questions about pricing, integrations, or a custom setup? We are happy to help.';
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main class="contact-page">

    <PageHero label="Contact" headingSize="lg">
      <Fragment slot="title">Let's talk.</Fragment>
      <p class="text-lg" slot="intro">
        Questions about pricing, a custom setup, or a partnership?
        Fill in the form and we will get back to you within one business day.
      </p>
    </PageHero>

    <section class="ct-body section">
      <div class="container">
        <div class="ct-layout">

          <!-- Info column -->
          <div class="ct-info">
            <div class="ct-info-item">
              <span class="ct-info-icon">✉</span>
              <div>
                <strong>Email</strong>
                <p><a href="mailto:info@pagayo.com">info@pagayo.com</a></p>
              </div>
            </div>
            <div class="ct-info-item">
              <span class="ct-info-icon">⚡</span>
              <div>
                <strong>Response time</strong>
                <p>Within one business day</p>
              </div>
            </div>
            <div class="ct-info-item">
              <span class="ct-info-icon">🌍</span>
              <div>
                <strong>Language</strong>
                <p>English, Dutch, German</p>
              </div>
            </div>

            <div class="ct-tagline">
              <p>
                Pagayo is a single-developer platform built entirely on Cloudflare's
                edge network. We are a small team — so you will always talk to
                someone who actually built it.
              </p>
            </div>
          </div>

          <!-- Form column -->
          <div class="ct-form-wrap">
            <form
              id="contact-form"
              class="ct-form"
              novalidate
            >
              <!-- Honeypot (hidden from humans) -->
              <div style="display:none" aria-hidden="true">
                <label for="website">Leave this empty</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <div class="ct-row">
                <div class="ct-field">
                  <label for="name">Full name <span class="required">*</span></label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Jane Smith"
                    autocomplete="name"
                    required
                    maxlength="120"
                  />
                </div>
                <div class="ct-field">
                  <label for="email">Work email <span class="required">*</span></label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="jane@company.com"
                    autocomplete="email"
                    required
                    maxlength="254"
                  />
                </div>
              </div>

              <div class="ct-field">
                <label for="company">Company <span class="optional">(optional)</span></label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  placeholder="Your company name"
                  autocomplete="organization"
                  maxlength="120"
                />
              </div>

              <div class="ct-field">
                <label for="subject">Subject <span class="required">*</span></label>
                <select id="subject" name="subject" required>
                  <option value="" disabled selected>Select a topic…</option>
                  <option value="Pricing question">Pricing question</option>
                  <option value="Integration question">Integration question</option>
                  <option value="Partner program">Partner program</option>
                  <option value="Technical question">Technical question</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="ct-field">
                <label for="message">Message <span class="required">*</span></label>
                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  placeholder="Tell us what you need…"
                  required
                  minlength="10"
                  maxlength="5000"
                ></textarea>
              </div>

              <div class="ct-form-footer">
                <p class="ct-privacy-note">
                  By submitting this form you agree to our
                  <a href="/privacy-policy">Privacy Policy</a>.
                  We will only use your information to respond to your enquiry.
                </p>
                <button type="submit" class="ct-submit" id="submit-btn">
                  <span class="ct-submit-label">Send message</span>
                  <span class="ct-submit-spinner" aria-hidden="true" hidden>…</span>
                </button>
              </div>

              <!-- Status messages -->
              <div id="ct-success" class="ct-status ct-success" hidden role="status">
                <strong>Message sent!</strong> We will get back to you within one business day.
              </div>
              <div id="ct-error" class="ct-status ct-error" hidden role="alert">
                Something went wrong. Please try again or email us directly at
                <a href="mailto:info@pagayo.com">info@pagayo.com</a>.
              </div>
            </form>
          </div>

        </div>
      </div>
    </section>

  </main>
</MarketingLayout>

<script src="../scripts/pages/contact.ts"></script>
