---
import MarketingLayout from '../layouts/Marketing.astro';
import PageBackdrop from '../components/layout/PageBackdrop.astro';
import PageHero from '../components/layout/PageHero.astro';
import FeaturesGrid from '../components/sections/FeaturesGrid.astro';
import ProductPreview from '../components/sections/ProductPreview.astro';
import ChannelStrip from '../components/sections/ChannelStrip.astro';
import CompetitorTable from '../components/sections/CompetitorTable.astro';
import StepsGrid from '../components/sections/StepsGrid.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import i18nEn from '../content/i18n/en.json';

const t = i18nEn.featuresPage;
const pageTitle = t.title;
const pageDescription = t.description;

const featureSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://www.pagayo.com/features',
  inLanguage: t.inLanguage,
  about: t.about,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Pagayo',
    url: 'https://www.pagayo.com'
  }
};
---
<MarketingLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(featureSchema)} />
  <PageBackdrop variant="features" />

  <PageHero label={t.sectionLabel} headingId="features-page-title">
    <Fragment slot="title">
      {t.headlineTop}<br />
      <span class="text-gradient">{t.headlineBottom}</span>
    </Fragment>
    <p class="text-lg" slot="intro">{t.intro}</p>

    <div class="feature-points" aria-label={t.pointsAriaLabel}>
      {t.points.map((point) => (
        <div class="feature-point-card">
          <h2>{point.title}</h2>
          <p>{point.description}</p>
        </div>
      ))}
    </div>
  </PageHero>

  <FeaturesGrid />
  <ProductPreview />
  <ChannelStrip />

  <div class="section-divider"></div>
  <CompetitorTable />

  <StepsGrid />
  <FinalCta />
</MarketingLayout>

<style>
  .feature-points {
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .feature-point-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.2rem;
  }

  .feature-point-card h2 {
    font-size: 0.95rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .feature-point-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .feature-points {
      grid-template-columns: 1fr;
    }
  }
</style>
