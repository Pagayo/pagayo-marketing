---
import MarketingLayout from '../layouts/Marketing.astro';
import FinalCta from '../components/sections/FinalCta.astro';

const pageTitle = 'Pagayo in Cursor — A single operator, moving like a team';
const pageDescription =
  'Pagayo is built inside Cursor. Twelve repositories, dozens of agents, one window. How an AI-first editor turns a single founder into a development organisation.';

const capabilities = [
  { code: 'Tab',            tag: 'Autocomplete', desc: 'Multi-line predictive edits that learn your repo and finish your thought.' },
  { code: 'Agent',          tag: 'Autonomous',   desc: 'A coding agent that plans, edits, runs commands, fixes its own mistakes.' },
  { code: 'Composer',       tag: 'Multi-file',   desc: 'Refactors that span dozens of files in one reviewable diff.' },
  { code: 'Chat',           tag: 'Q&A',          desc: 'Ask anything about the codebase. Cursor answers with file citations.' },
  { code: '@ mentions',     tag: 'Context',      desc: 'Pull files, folders, docs, git diffs and the web into any prompt.' },
  { code: 'Cmd+K',          tag: 'Inline edit',  desc: 'Select a block, describe a change, get a clean diff to accept or reject.' },
  { code: 'Codebase index', tag: 'Semantic',     desc: 'Every repo is embedded once. Cursor finds the right file instantly.' },
  { code: 'Apply',          tag: 'Patches',      desc: 'A model-suggested patch lands as a precise diff, not a copy-paste.' },
  { code: 'Rules',          tag: 'AGENTS.md',    desc: 'Project rules become guardrails the agent reads on every turn.' },
  { code: 'Subagents',      tag: 'Parallel',     desc: 'Fan out independent tasks. The main thread stays focused.' },
  { code: 'MCP',            tag: 'Tools',        desc: 'Custom servers expose Cloudflare, D1, GitHub and Stripe to the agent.' },
  { code: 'BugBot',         tag: 'Review',       desc: 'AI review on every PR — catches the small things before they merge.' },
];

const layers = [
  {
    slug: 'multi-repo',
    title: 'Twelve repos, one window',
    role: 'Multi-root workspace',
    accent: '#06b6d4',
    accentSoft: 'rgba(6, 182, 212, 0.2)',
    tagline: 'The whole platform, always in context.',
    body: `Pagayo lives in twelve repositories — storefront, api-stack, edge, workflows, schema, config, design, marketing, proxy, maintenance, docs and vault. Cursor opens them as a single multi-root workspace. One @ symbol reaches any file. One Composer prompt refactors across packages. There is no "context switch" because everything is already in context.`,
    bullets: [
      'Multi-root workspace = no jumping between editors',
      'Cross-repo @-mentions for shared types and schemas',
      'Codebase index spans every package, every branch',
    ],
  },
  {
    slug: 'agents',
    title: 'Parallel agents, one operator',
    role: 'Subagent fan-out',
    accent: '#6366f1',
    accentSoft: 'rgba(99, 102, 241, 0.2)',
    tagline: 'One prompt out. Many workstreams back.',
    body: `Pagayo defines specialised subagents — BackendDev, FrontendDev, DatabaseReview, CloudflareOps, SecurityAudit, Tester, Explore — each with their own scope and rules. When a task fans out into independent pieces, the main agent dispatches them in parallel. A schema change, a UI update, a smoke test and a config bump can all run at the same time, in the same session.`,
    bullets: [
      '19 specialised agents, each with their own AGENTS.md',
      'Read-only Explore agents for safe, fast research',
      'TaskDispatcher routes work to the right specialist',
    ],
  },
  {
    slug: 'edit-flow',
    title: 'From idea to deploy, in one window',
    role: 'The full loop',
    accent: '#10a37f',
    accentSoft: 'rgba(16, 163, 127, 0.18)',
    tagline: 'Write. Run. Test. Build. Ship. Same tab.',
    body: `Cursor is not just an editor. It is the terminal, the test runner, the build, the wrangler deploy, the git status. The agent writes the code, runs the tests, reads the output, fixes the failure, builds the bundle and triggers the staging deploy — all without leaving the chat. The loop that used to take five tools takes one window.`,
    bullets: [
      'Integrated terminal: agent reads its own command output',
      'Inline test results, lint warnings and type errors',
      'wrangler dev, build and deploy all live in-session',
    ],
  },
  {
    slug: 'rules',
    title: 'The platform writes its own rules',
    role: 'AGENTS.md · Instructions',
    accent: '#fbbf24',
    accentSoft: 'rgba(251, 191, 36, 0.18)',
    tagline: 'Every repo teaches the agent how to behave in it.',
    body: `Every Pagayo repository ships an AGENTS.md and a .github/copilot-instructions.md. The agent reads them on every turn: deploy policy, branch naming, schema ownership, Order-First rules, design system contracts, security boundaries. The rules are version-controlled, reviewable in PRs, and apply automatically — Pagayo's standards are encoded once, enforced everywhere.`,
    bullets: [
      'AGENTS.md per repo — scope, boundaries, verification',
      'applyTo patterns target the right instructions',
      'Workspace-wide PAGAYO-NIVEAU.md as the canon',
    ],
  },
  {
    slug: 'context',
    title: 'Deep codebase context',
    role: 'Indexing · @-mentions',
    accent: '#d97757',
    accentSoft: 'rgba(217, 119, 87, 0.18)',
    tagline: 'Ask in English. Cursor finds the file.',
    body: `Every repository is embedded into a semantic index. When a prompt mentions "the order status webhook" or "the bunq sync service", Cursor pulls the right files without you typing a path. @ symbols layer in more: a folder, a Git diff, a doc, a Notion page, a web result. The agent never starts a turn cold — it starts with the relevant code already loaded.`,
    bullets: [
      'Semantic codebase index, recomputed on save',
      '@file · @folder · @docs · @git · @web — one syntax',
      'Memory files (/memories/) for cross-session knowledge',
    ],
  },
  {
    slug: 'review',
    title: 'AI that reviews AI',
    role: 'BugBot · CodeReview',
    accent: '#ef4444',
    accentSoft: 'rgba(239, 68, 68, 0.18)',
    tagline: 'Every PR gets a second pair of eyes — automatically.',
    body: `Cursor's BugBot scans every pull request and leaves structured review comments — security risks, regressions, missing tests, accidental any-casts, broken contracts. The CodeReview subagent runs a deeper architectural pass. Pagayo merges what the bots confirm. The five-pillar standard (consistency, testability, fault handling, single source of truth, edge-first) gets enforced before code ever reaches main.`,
    bullets: [
      'Automatic PR review on every open pull request',
      'CodeReview subagent for architectural deep-dives',
      'Catches Prisma drift, schema mismatch, missing tests',
    ],
  },
];
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main class="cu-page">

    <!-- Hero -->
    <section class="hero section cu-hero" id="hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1" style="background: #06b6d4;"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-orb hero-orb-3"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse" style="background:#06b6d4;"></span>
          Pagayo is built inside Cursor.
        </div>

        <h1 class="headline-xl">
          A single operator,<br />
          <span class="text-gradient cu-gradient">moving like a team.</span>
        </h1>

        <p>
          Pagayo is built by one founder, in one editor, across twelve
          repositories and nineteen subagents. Cursor turns a single
          window into a development organisation — write, refactor,
          review, test, deploy, all in the same tab, all in parallel.
        </p>

        <a class="giant-external" style="--giant-accent:#06b6d4" href="https://cursor.com" target="_blank" rel="noopener">
          Visit cursor.com <span class="ext-arrow">↗</span>
        </a>

        <!-- Workspace constellation: 12 repos → 1 cursor → N agents -->
        <div class="cu-constellation" aria-hidden="true">
          <svg viewBox="0 0 1200 480" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <radialGradient id="cuCoreGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.45" />
                <stop offset="60%" stop-color="#06b6d4" stop-opacity="0.10" />
                <stop offset="100%" stop-color="#06b6d4" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="cuHaloGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.20" />
                <stop offset="100%" stop-color="#06b6d4" stop-opacity="0" />
              </radialGradient>
              <linearGradient id="cuEdgeIn" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#06b6d4" stop-opacity="0" />
                <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.65" />
              </linearGradient>
              <linearGradient id="cuEdgeOut" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#6366f1" stop-opacity="0.65" />
                <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
              </linearGradient>
              <radialGradient id="cuRepoGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.18" />
                <stop offset="100%" stop-color="#06b6d4" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="cuAgentGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#6366f1" stop-opacity="0.18" />
                <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
              </radialGradient>
            </defs>

            <ellipse cx="600" cy="240" rx="580" ry="220" fill="url(#cuHaloGlow)" />

            <!-- Column headings -->
            <text x="135"  y="36" text-anchor="middle" fill="#67e8f9" font-size="18" font-weight="700" font-family="ui-monospace, monospace">12 REPOS</text>
            <text x="600"  y="36" text-anchor="middle" fill="#94a3b8" font-size="18" font-weight="700" font-family="ui-monospace, monospace">CURSOR</text>
            <text x="1065" y="36" text-anchor="middle" fill="#a5b4fc" font-size="18" font-weight="700" font-family="ui-monospace, monospace">19 AGENTS</text>

            <!-- Repos column (left) -->
            {[
              { y:  80, label: 'storefront' },
              { y: 122, label: 'api-stack' },
              { y: 164, label: 'edge' },
              { y: 206, label: 'workflows' },
              { y: 248, label: 'schema' },
              { y: 290, label: 'config' },
              { y: 332, label: 'design' },
              { y: 374, label: 'marketing' },
              { y: 416, label: 'maintenance' },
            ].map((r) => (
              <g>
                <line x1="240" y1={r.y + 18} x2="500" y2="240" stroke="url(#cuEdgeIn)" stroke-width="1.2" />
                <rect x="40" y={r.y} width="200" height="36" rx="8" fill="url(#cuRepoGlow)" />
                <rect x="40" y={r.y} width="200" height="36" rx="8" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
                <circle cx="60" cy={r.y + 18} r="5" fill="#06b6d4" />
                <text x="76" y={r.y + 23} fill="#67e8f9" font-size="16" font-weight="600" font-family="ui-monospace, monospace">{r.label}</text>
              </g>
            ))}

            <!-- Agents column (right) -->
            {[
              { y:  80, label: 'BackendDev' },
              { y: 122, label: 'FrontendDev' },
              { y: 164, label: 'DatabaseReview' },
              { y: 206, label: 'CloudflareOps' },
              { y: 248, label: 'SecurityAudit' },
              { y: 290, label: 'CodeReview' },
              { y: 332, label: 'Tester' },
              { y: 374, label: 'DevOps' },
              { y: 416, label: 'Explore' },
            ].map((a) => (
              <g>
                <line x1="700" y1="240" x2="960" y2={a.y + 18} stroke="url(#cuEdgeOut)" stroke-width="1.2" />
                <rect x="960" y={a.y} width="200" height="36" rx="8" fill="url(#cuAgentGlow)" />
                <rect x="960" y={a.y} width="200" height="36" rx="8" fill="#0f172a" stroke="#6366f1" stroke-width="1.5" />
                <circle cx="980" cy={a.y + 18} r="5" fill="#6366f1" />
                <text x="996" y={a.y + 23} fill="#c7d2fe" font-size="16" font-weight="600" font-family="ui-monospace, monospace">{a.label}</text>
              </g>
            ))}

            <!-- Core: Cursor editor -->
            <circle cx="600" cy="240" r="170" fill="url(#cuCoreGlow)" />
            <circle cx="600" cy="240" r="118" fill="none" stroke="#06b6d4" stroke-opacity="0.12" stroke-width="1" />
            <circle cx="600" cy="240" r="100" fill="none" stroke="#06b6d4" stroke-opacity="0.22" stroke-width="1" />
            <rect x="500" y="180" width="200" height="120" rx="14" fill="#0f172a" stroke="#06b6d4" stroke-width="2.5" />
            <rect x="500" y="180" width="200" height="26" rx="14" fill="rgba(6,182,212,0.15)" />
            <circle cx="516" cy="193" r="4" fill="#ef4444" opacity="0.7" />
            <circle cx="528" cy="193" r="4" fill="#fbbf24" opacity="0.7" />
            <circle cx="540" cy="193" r="4" fill="#10a37f" opacity="0.7" />
            <text x="600" y="240" text-anchor="middle" fill="#67e8f9" font-size="28" font-weight="700" font-family="ui-monospace, monospace">cursor</text>
            <text x="600" y="266" text-anchor="middle" fill="#94a3b8" font-size="15" font-family="ui-monospace, monospace">one operator</text>
            <text x="600" y="288" text-anchor="middle" fill="#94a3b8" font-size="15" font-family="ui-monospace, monospace">one window</text>
          </svg>
        </div>

        <!-- Stat row -->
        <div class="cu-stats">
          <div class="cu-stat">
            <div class="cu-stat-num">12</div>
            <div class="cu-stat-label">Repos in one workspace</div>
          </div>
          <div class="cu-stat">
            <div class="cu-stat-num">19</div>
            <div class="cu-stat-label">Subagents on call</div>
          </div>
          <div class="cu-stat">
            <div class="cu-stat-num">1</div>
            <div class="cu-stat-label">Operator, end to end</div>
          </div>
          <div class="cu-stat">
            <div class="cu-stat-num">∞</div>
            <div class="cu-stat-label">Parallel tabs, no context switch</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capabilities strip -->
    <section class="section cu-capabilities-section">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">The toolkit</span>
          <h2 class="headline-md">Twelve Cursor features. One workflow.</h2>
          <p class="text-lg">
            Tab, Agent, Composer, Chat, @-mentions, Cmd+K, codebase
            indexing — every Cursor feature is a piece of the daily
            Pagayo loop. Here is the full set.
          </p>
        </div>

        <ul class="cu-capabilities-grid">
          {capabilities.map((c) => (
            <li class="cu-capability">
              <div class="cu-capability-head">
                <span class="cu-capability-code">{c.code}</span>
                <span class="cu-capability-tag">{c.tag}</span>
              </div>
              <p>{c.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Layers -->
    <section class="section cu-layers">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">How it fits together</span>
          <h2 class="headline-lg">Six layers, one workflow.</h2>
          <p class="text-lg">
            Multi-repo, parallel agents, the full edit-to-deploy loop,
            project rules, deep context, and AI review. Here is what
            each layer of the Cursor workflow does for Pagayo.
          </p>
        </div>

        {layers.map((l, idx) => (
          <article
            class={`cu-row ${idx % 2 === 1 ? 'reverse' : ''}`}
            id={l.slug}
            style={`--accent: ${l.accent}; --accent-soft: ${l.accentSoft};`}
          >
            <div class="cu-text">
              <div class="cu-meta">
                <span class="cu-tag">0{idx + 1}</span>
                <span class="cu-role">{l.role}</span>
              </div>
              <h3 class="cu-title">{l.title}</h3>
              <p class="cu-tagline">{l.tagline}</p>
              <p class="cu-body">{l.body}</p>
              <ul class="cu-bullets">
                {l.bullets.map((b) => (
                  <li><span class="cu-dot"></span>{b}</li>
                ))}
              </ul>
            </div>

            <div class="cu-visual">
              <div class="cu-frame">
                {l.slug === 'multi-repo' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="mrGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#06b6d4" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#mrGlow)" />
                    <!-- Workspace sidebar -->
                    <rect x="20" y="30" width="150" height="260" rx="10" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
                    <text x="34" y="50" fill="#67e8f9" font-size="10" font-weight="700" font-family="ui-monospace, monospace">WORKSPACE</text>
                    {[
                      'storefront', 'api-stack', 'edge', 'workflows',
                      'schema', 'config', 'design', 'marketing',
                      'proxy', 'maintenance', 'docs', 'vault'
                    ].map((repo, i) => (
                      <g>
                        <rect x="28" y={62 + i * 18} width="3" height="12" rx="1" fill="#06b6d4" opacity={0.5 + (i % 3) * 0.15} />
                        <text x="38" y={72 + i * 18} fill="#cbd5e1" font-size="9" font-family="ui-monospace, monospace">{repo}</text>
                      </g>
                    ))}
                    <!-- Editor pane -->
                    <rect x="190" y="30" width="190" height="260" rx="10" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
                    <rect x="190" y="30" width="190" height="22" rx="10" fill="rgba(6,182,212,0.15)" />
                    <text x="202" y="46" fill="#67e8f9" font-size="9" font-weight="700" font-family="ui-monospace, monospace">order.service.ts × 3 repos</text>
                    <!-- Code lines -->
                    {[
                      { y: 72,  c: '#a5b4fc', w: 130 },
                      { y: 86,  c: '#cbd5e1', w: 100 },
                      { y: 100, c: '#67e8f9', w: 150 },
                      { y: 114, c: '#cbd5e1', w: 80 },
                      { y: 128, c: '#cbd5e1', w: 130 },
                      { y: 142, c: '#fbbf24', w: 110 },
                      { y: 156, c: '#cbd5e1', w: 90 },
                      { y: 170, c: '#67e8f9', w: 140 },
                      { y: 184, c: '#cbd5e1', w: 100 },
                      { y: 198, c: '#cbd5e1', w: 60 },
                    ].map((l) => (
                      <rect x="202" y={l.y} width={l.w} height="4" rx="2" fill={l.c} opacity="0.45" />
                    ))}
                    <!-- Diff strip -->
                    <rect x="190" y="222" width="190" height="46" rx="6" fill="rgba(16,163,127,0.1)" stroke="rgba(16,163,127,0.4)" stroke-width="1" />
                    <text x="202" y="240" fill="#6ee7b7" font-size="9" font-weight="700" font-family="ui-monospace, monospace">+ 3 files updated</text>
                    <text x="202" y="254" fill="#94a3b8" font-size="9" font-family="ui-monospace, monospace">storefront · api-stack · edge</text>
                  </svg>
                )}

                {l.slug === 'agents' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="agGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#6366f1" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#agGlow)" />
                    <!-- Operator prompt -->
                    <rect x="20" y="140" width="100" height="40" rx="10" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
                    <text x="70" y="158" text-anchor="middle" fill="#67e8f9" font-size="10" font-weight="700" font-family="ui-monospace, monospace">prompt</text>
                    <text x="70" y="172" text-anchor="middle" fill="#94a3b8" font-size="9" font-family="ui-monospace, monospace">"ship this"</text>
                    <!-- Dispatch arrows + agents -->
                    {[
                      { y: 40,  name: 'BackendDev',     status: 'running', color: '#6366f1' },
                      { y: 88,  name: 'DatabaseReview', status: 'done',    color: '#10a37f' },
                      { y: 136, name: 'Tester',         status: 'running', color: '#6366f1' },
                      { y: 184, name: 'CloudflareOps',  status: 'done',    color: '#10a37f' },
                      { y: 232, name: 'SecurityAudit',  status: 'queued',  color: '#94a3b8' },
                      { y: 280, name: 'Explore',        status: 'done',    color: '#10a37f' },
                    ].map((a) => (
                      <g>
                        <line x1="120" y1="160" x2="200" y2={a.y + 16} stroke="#6366f1" stroke-opacity="0.4" stroke-width="1" stroke-dasharray="3,2" />
                        <rect x="200" y={a.y} width="180" height="32" rx="8" fill="#0f172a" stroke={a.color} stroke-opacity="0.7" stroke-width="1.2" />
                        <circle cx="216" cy={a.y + 16} r="5" fill={a.color} />
                        <text x="230" y={a.y + 20} fill="#cbd5e1" font-size="10" font-weight="600" font-family="ui-monospace, monospace">{a.name}</text>
                        <text x="370" y={a.y + 20} text-anchor="end" fill={a.color} font-size="9" font-family="ui-monospace, monospace">{a.status}</text>
                      </g>
                    ))}
                  </svg>
                )}

                {l.slug === 'edit-flow' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="efGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#10a37f" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#10a37f" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#efGlow)" />
                    {[
                      { y: 30,  label: 'write',    tool: 'Tab + Composer',     ok: true },
                      { y: 78,  label: 'run',      tool: 'wrangler dev',       ok: true },
                      { y: 126, label: 'test',     tool: 'vitest',             ok: true },
                      { y: 174, label: 'build',    tool: 'npm run build',      ok: true },
                      { y: 222, label: 'review',   tool: 'BugBot + CodeReview', ok: true },
                      { y: 270, label: 'ship',     tool: 'wrangler deploy',    ok: true },
                    ].map((s, i) => (
                      <g>
                        <!-- step number -->
                        <circle cx="40" cy={s.y + 18} r="14" fill="#10a37f" />
                        <text x="40" y={s.y + 22} text-anchor="middle" fill="#0f172a" font-size="11" font-weight="700" font-family="ui-monospace, monospace">{(i + 1).toString().padStart(2, '0')}</text>
                        <!-- step card -->
                        <rect x="68" y={s.y} width="280" height="36" rx="8" fill="#0f172a" stroke="#10a37f" stroke-opacity="0.5" stroke-width="1.2" />
                        <text x="82" y={s.y + 18} fill="#f8fafc" font-size="12" font-weight="700" font-family="system-ui">{s.label}</text>
                        <text x="82" y={s.y + 30} fill="#94a3b8" font-size="9" font-family="ui-monospace, monospace">{s.tool}</text>
                        <!-- check tick on right -->
                        <circle cx="358" cy={s.y + 18} r="10" fill="rgba(16,163,127,0.18)" stroke="#10a37f" stroke-width="1" />
