---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeaderDynamic from '../../../components/HeaderDynamic.astro';
import FooterDynamic from '../../../components/FooterDynamic.astro';

import enHome from '../../../content/home/en.json';
import nlHome from '../../../content/home/nl.json';
import deHome from '../../../content/home/de.json';

type NavItem = string | { label: string; path: string };

type CountryData = {
  code: string;
  region: string;
  name: string;
  locale?: string;
  nav?: {
    features?: NavItem;
    pricing?: NavItem;
    contact?: NavItem;
    cta?: NavItem;
  };
};

type HomeFeatureItem = {
  icon: string;
  title: string;
  description: string;
  link?: string;
  linkText?: string;
};

type HeroStat = {
  label: string;
  value: string;
  description: string;
  link?: string;
  linkText?: string;
};

type HomeContent = {
  hero: {
    badges: string[];
    stats: HeroStat[];
  };
  features: {
    title: string;
    subtitle: string;
    items: HomeFeatureItem[];
  };
  cta: {
    title: string;
    subtitle: string;
    primary: string;
    secondary: string;
    secondary_link: string;
  };
};

function getBaseLang(locale: string | undefined): string {
  if (!locale) return 'en';
  const [base] = locale.split('-');
  return base || 'en';
}

function getLangAttribute(baseLang: string): string {
  // Bewust: matcht bestaand gedrag in de oude landpagina's.
  if (baseLang === 'es') return 'en';
  if (baseLang === 'ar') return 'en';
  return baseLang || 'en';
}

function getNavLabel(item: NavItem | undefined, fallback: string): string {
  if (!item) return fallback;
  return typeof item === 'string' ? item : item.label;
}

function pickHomeContent(baseLang: string): HomeContent {
  if (baseLang === 'nl') return nlHome as HomeContent;
  if (baseLang === 'de') return deHome as HomeContent;
  return enHome as HomeContent;
}

function localizeLink(basePath: string, link: string | undefined): string | undefined {
  if (!link) return undefined;
  const parts = link.split('/').filter(Boolean);
  const last = parts.at(-1);
  if (!last) return undefined;
  return `${basePath}/${last}`;
}

export async function getStaticPaths() {
  const normalizeCountry = (data: unknown): CountryData => {
    const record = data as { default?: unknown };
    return (record.default ?? data) as CountryData;
  };

  const countryModules = import.meta.glob('../../../data/countries/*.json', { eager: true });
  const countries = Object.values(countryModules).map((module) => normalizeCountry(module));

  return countries
    .filter((country) => !(country.region === 'eu' && country.code === 'nl'))
    .map((country) => ({
      params: { region: country.region, country: country.code },
      props: { country }
    }));
}

const { region, country: countryCode } = Astro.params;
const country = Astro.props.country as CountryData;

const basePath = `/${region}/${countryCode}`;
const baseLang = getBaseLang(country.locale);
const langAttr = getLangAttribute(baseLang);

const home = pickHomeContent(baseLang);
const title = `${getNavLabel(country.nav?.features, 'Features')} - Pagayo ${country.name}`;
const description = home.features.subtitle;

const structuredData = [
  {
    type: 'WebPage',
    data: {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      inLanguage: langAttr,
      url: `https://pagayo.com${basePath}/features`
    }
  }
];
---

<BaseLayout title={title} description={description} lang={langAttr} structuredData={structuredData}>
  <HeaderDynamic country={country} />

  <main class="page-container">
    <section class="hero-main">
      <div class="hero__content">
        <p class="eyebrow">{getNavLabel(country.nav?.features, 'Features')}</p>
        <h1>{home.features.title}</h1>
        <p class="lead">{home.features.subtitle}</p>
        <div class="hero__actions">
          <a class="btn btn-primary" href="https://app.pagayo.com/register/">
            {getNavLabel(country.nav?.cta, home.cta.primary)}
          </a>
          <a class="btn btn-ghost" href={`${basePath}/pricing`}>
            {getNavLabel(country.nav?.pricing, 'Pricing')}
          </a>
        </div>
        <div class="hero__meta">
          {home.hero.badges.slice(0, 3).map((badge) => (
            <span class="pill">{badge}</span>
          ))}
        </div>
      </div>

      <div class="hero__panel">
        {home.hero.stats.slice(0, 3).map((stat) => (
          <div class="stat-card">
            <p class="stat-label">{stat.label}</p>
            <p class="stat-value">{stat.value}</p>
            <p class="stat-footnote">{stat.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">

      <div class="feature-grid">
        {home.features.items.map((item) => {
          const href = localizeLink(basePath, item.link);
          return (
            <div class="feature-card">
              <div class="feature-icon">{item.icon}</div>
              <h3>{item.title}</h3>
              <p>
                {item.description}
                {href && item.linkText ? (
                  <>
                    {' '}
                    <a href={href}>{item.linkText}</a>
                    .
                  </>
                ) : null}
              </p>
            </div>
          );
        })}
      </div>
    </section>

    <section class="cta">
      <div class="cta__content">
        <h2>{home.cta.title}</h2>
        <p>{home.cta.subtitle}</p>
        <div class="cta__actions">
          <a class="btn btn-primary" href="https://app.pagayo.com/register/">
            {getNavLabel(country.nav?.cta, home.cta.primary)}
          </a>
          <a class="btn btn-ghost" href={`${basePath}/contact`}>
            {getNavLabel(country.nav?.contact, home.cta.secondary)}
          </a>
        </div>
      </div>
    </section>
  </main>

  <FooterDynamic country={country} />
</BaseLayout>
