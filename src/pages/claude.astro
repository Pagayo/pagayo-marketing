---
import MarketingLayout from '../layouts/Marketing.astro';
import FinalCta from '../components/sections/FinalCta.astro';

const pageTitle = 'Pagayo with Claude — The engineer in the chair next to mine';
const pageDescription =
  'Claude is the pair programmer behind Pagayo: long-context reasoning, careful diffs, thoughtful reviews. The model that explains itself before it ships.';

const capabilities = [
  { code: 'Opus 4.7',        tag: 'Reasoning',   desc: 'The flagship model behind the careful refactors and architectural reviews.' },
  { code: 'Sonnet',          tag: 'Fast',        desc: 'Quick, balanced edits for the everyday loop — small features, small fixes.' },
  { code: 'Haiku',           tag: 'Instant',     desc: 'Snappy inline help, tagging and rewording with sub-second latency.' },
  { code: 'Tool use',        tag: 'Agents',      desc: 'Claude picks the right Pagayo agent tool — file edit, shell, search.' },
  { code: 'Long context',    tag: '200k',        desc: 'Pulls whole repos into a single turn — no lossy summarisation.' },
  { code: 'Vision',          tag: 'Multimodal',  desc: 'Reads screenshots, design mocks, error dialogs — fixes UI by eye.' },
  { code: 'Artifacts',       tag: 'Outputs',     desc: 'Self-contained code blocks that drop straight into the repo.' },
  { code: 'Computer use',    tag: 'Autonomy',    desc: 'Drives the editor when the loop is mechanical — open, edit, save.' },
  { code: 'Prompt caching',  tag: 'Efficient',   desc: 'Codebase context is cached across turns — fast, cheap, repeatable.' },
  { code: 'Citations',       tag: 'Grounded',    desc: 'Answers cite the file and line — no invented APIs, no guesses.' },
  { code: 'Constitutional',  tag: 'Safety',      desc: 'Refuses destructive ops by default — no `rm -rf`, no force-push.' },
  { code: 'MCP',             tag: 'Connectors',  desc: 'Custom servers expose Cloudflare, D1 and Stripe directly to Claude.' },
];

const layers = [
  {
    slug: 'pair-programmer',
    title: 'The engineer in the chair next to mine',
    role: 'Pair programming',
    accent: '#d97757',
    accentSoft: 'rgba(217, 119, 87, 0.2)',
    tagline: 'Not autocomplete. A colleague.',
    body: `Most of what gets built at Pagayo is built in conversation with Claude. Pagayo describes the intent — "rework the order-detail header so it works for POS too" — Claude reads the files it needs, proposes an approach, points out the edge case Pagayo missed, and writes the diff. Every turn is a small design review. The platform is sharper for it.`,
    bullets: [
      'Conversational design review on every change',
      'Explains the trade-off before it picks one',
      'Points out the second-order effect, every time',
    ],
  },
  {
    slug: 'long-context',
    title: 'Reads the whole codebase, every turn',
    role: 'Long context · Citations',
    accent: '#6366f1',
    accentSoft: 'rgba(99, 102, 241, 0.2)',
    tagline: 'Twelve repos. One window. No lossy summary.',
    body: `Claude's long-context window swallows the relevant files whole. When the conversation touches the order service, it reads the schema, the service, the route, the test, the consumer in storefront and the contract in api-stack — all in the same turn. Citations point to the file and line. No invented APIs. No "I think this exists somewhere".`,
    bullets: [
      '200k tokens — entire packages in one prompt',
      'Cites the file and the line, every answer',
      'Sees the whole call chain across repos',
    ],
  },
  {
    slug: 'careful-diffs',
    title: 'Diffs you can actually review',
    role: 'Edits · Artifacts',
    accent: '#10a37f',
    accentSoft: 'rgba(16, 163, 127, 0.18)',
    tagline: 'Small, contained, reviewable.',
    body: `Claude writes diffs the way a senior engineer does: smallest possible change, no opportunistic refactors, no rewriting code it wasn't asked to touch. Variable names match the file. Imports stay sorted. Comments stay rare. When a change is genuinely big, Claude breaks it into reviewable chunks and stops between them to confirm — no surprise 800-line PRs.`,
    bullets: [
      'Minimal-diff edits — no drive-by refactors',
      'Matches the file\'s existing style and patterns',
      'Stops mid-task to confirm before big leaps',
    ],
  },
  {
    slug: 'reasoning',
    title: 'Reasons out loud — no black box',
    role: 'Extended thinking',
    accent: '#fbbf24',
    accentSoft: 'rgba(251, 191, 36, 0.18)',
    tagline: 'You can see the trade-off being weighed.',
    body: `When the question is hard, Claude shows its work. The plan comes before the code. Trade-offs are named: "Cache-first is faster but breaks under tenant rotation — going with KV-keyed-by-version instead." It is the engineering reasoning a senior reviewer wants to see in a PR description, written before the PR exists. Every decision is reviewable, every assumption is checkable.`,
    bullets: [
      'Plans the change before it writes the code',
      'Names trade-offs in plain language',
      'Flags assumptions — you can correct them early',
    ],
  },
  {
    slug: 'review',
    title: 'Catches the bugs I would have shipped',
    role: 'Code review',
    accent: '#ef4444',
    accentSoft: 'rgba(239, 68, 68, 0.18)',
    tagline: 'A second pair of eyes — pessimistic by design.',
    body: `Pagayo's CodeReview subagent runs on Claude Opus. It reads the diff, walks the consumers, checks the tests, and flags what humans miss: missing idempotency keys, accidentally awaited promises, schema mismatches with @pagayo/schema, broken cache invalidation, Order-First violations. Pagayo merges what Claude clears. The five-pillar standard gets enforced before main.`,
    bullets: [
      'Architectural review on every meaningful PR',
      'Spots Order-First violations and schema drift',
      'Verifies test coverage — refuses uncovered diffs',
    ],
  },
  {
    slug: 'safety',
    title: 'Careful by default',
    role: 'Constitutional AI',
    accent: '#06b6d4',
    accentSoft: 'rgba(6, 182, 212, 0.18)',
    tagline: 'Refuses destructive ops without confirmation.',
    body: `Claude is trained to be cautious where it matters. \`rm -rf\`, \`git push --force\`, dropping a table, deleting a branch — it stops and asks. Production deploys are explicit, not implicit. Secrets stay in the vault. The agent rules in every Pagayo AGENTS.md are read on every turn, and the model genuinely behaves differently because of them. Safety is not a wrapper, it is a property of the model.`,
    bullets: [
      'Stops before destructive shell commands',
      'Respects AGENTS.md rules per repository',
      'Production deploys are always opt-in, never default',
    ],
  },
];
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main class="cl-page">

    <!-- Hero -->
    <section class="hero section cl-hero" id="hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1" style="background: #d97757;"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-orb hero-orb-3"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse" style="background:#d97757;"></span>
          Claude is the pair programmer behind Pagayo.
        </div>

        <h1 class="headline-xl">
          The engineer in<br />
          <span class="text-gradient cl-gradient">the chair next to mine.</span>
        </h1>

        <p>
          Claude reads the codebase, weighs trade-offs, writes careful
          changes, catches the bugs I would have shipped, and explains
          its reasoning along the way. Most of what gets built at
          Pagayo is built in conversation with Claude — and the
          platform is sharper for it.
        </p>

        <a class="giant-external" style="--giant-accent:#d97757" href="https://www.anthropic.com/claude" target="_blank" rel="noopener">
          Visit anthropic.com <span class="ext-arrow">↗</span>
        </a>

        <!-- Conversation visual: prompt → thinking → diff -->
        <div class="cl-conversation" aria-hidden="true">
          <svg viewBox="0 0 1200 480" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <radialGradient id="clHalo" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#d97757" stop-opacity="0.20" />
                <stop offset="100%" stop-color="#d97757" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="clCoreGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#d97757" stop-opacity="0.45" />
                <stop offset="60%" stop-color="#d97757" stop-opacity="0.10" />
                <stop offset="100%" stop-color="#d97757" stop-opacity="0" />
              </radialGradient>
              <linearGradient id="clEdgeIn" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#d97757" stop-opacity="0" />
                <stop offset="100%" stop-color="#d97757" stop-opacity="0.7" />
              </linearGradient>
              <linearGradient id="clEdgeOut" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#10a37f" stop-opacity="0.7" />
                <stop offset="100%" stop-color="#10a37f" stop-opacity="0" />
              </linearGradient>
            </defs>

            <ellipse cx="600" cy="240" rx="580" ry="220" fill="url(#clHalo)" />

            <!-- Column headings -->
            <text x="155"  y="36" text-anchor="middle" fill="#fdba74" font-size="18" font-weight="700" font-family="ui-monospace, monospace">PAGAYO</text>
            <text x="600"  y="36" text-anchor="middle" fill="#94a3b8" font-size="18" font-weight="700" font-family="ui-monospace, monospace">CLAUDE</text>
            <text x="1045" y="36" text-anchor="middle" fill="#6ee7b7" font-size="18" font-weight="700" font-family="ui-monospace, monospace">DIFF</text>

            <!-- Prompts column (left) -->
            {[
              { y:  68, label: 'rework order header' },
              { y: 120, label: 'check tenant cache' },
              { y: 172, label: 'add bunq webhook' },
              { y: 224, label: 'refactor cart store' },
              { y: 276, label: 'ship the release' },
              { y: 328, label: 'review the PR' },
              { y: 380, label: 'fix the flaky test' },
            ].map((p) => (
              <g>
                <line x1="290" y1={p.y + 18} x2="500" y2="240" stroke="url(#clEdgeIn)" stroke-width="1.2" />
                <rect x="40" y={p.y} width="250" height="36" rx="8" fill="#0f172a" stroke="#d97757" stroke-width="1.5" />
                <circle cx="60" cy={p.y + 18} r="5" fill="#d97757" />
                <text x="76" y={p.y + 23} fill="#fdba74" font-size="15" font-family="system-ui">{p.label}</text>
              </g>
            ))}

            <!-- Output diffs column (right) -->
            {[
              { y:  68, label: '+ 42 / − 12',  files: '3 files' },
              { y: 120, label: '+ 18 / − 6',   files: '1 file'  },
              { y: 172, label: '+ 86 / − 4',   files: '5 files' },
              { y: 224, label: '+ 31 / − 28',  files: '2 files' },
              { y: 276, label: '+ 0 / − 0',    files: 'deploy ok' },
              { y: 328, label: '2 comments',   files: 'approved' },
              { y: 380, label: '+ 12 / − 3',   files: 'green' },
            ].map((d) => (
              <g>
                <line x1="700" y1="240" x2="910" y2={d.y + 18} stroke="url(#clEdgeOut)" stroke-width="1.2" />
                <rect x="910" y={d.y} width="250" height="36" rx="8" fill="#0f172a" stroke="#10a37f" stroke-width="1.5" />
                <text x="926" y={d.y + 23} fill="#6ee7b7" font-size="14" font-weight="600" font-family="ui-monospace, monospace">{d.label}</text>
                <text x="1148" y={d.y + 23} text-anchor="end" fill="#94a3b8" font-size="13" font-family="ui-monospace, monospace">{d.files}</text>
              </g>
            ))}

            <!-- Core: Claude reasoning -->
            <circle cx="600" cy="240" r="170" fill="url(#clCoreGlow)" />
            <circle cx="600" cy="240" r="118" fill="none" stroke="#d97757" stroke-opacity="0.12" stroke-width="1" />
            <circle cx="600" cy="240" r="100" fill="none" stroke="#d97757" stroke-opacity="0.22" stroke-width="1" />
            <!-- Thinking bubble -->
            <g transform="translate(500,180)">
              <rect x="0" y="0" width="200" height="120" rx="20" fill="#0f172a" stroke="#d97757" stroke-width="2.5" />
              <path d="M 90 120 L 100 138 L 110 120 Z" fill="#0f172a" stroke="#d97757" stroke-width="2.5" />
              <rect x="90" y="120" width="20" height="3" fill="#0f172a" />
              <!-- thinking dots -->
              <text x="100" y="48" text-anchor="middle" fill="#fdba74" font-size="22" font-weight="700" font-family="ui-monospace, monospace">claude</text>
              <text x="100" y="72" text-anchor="middle" fill="#94a3b8" font-size="13" font-family="ui-monospace, monospace">thinking…</text>
              <g fill="#d97757">
                <circle cx="78"  cy="98" r="5"><animate attributeName="opacity" values="0.3;1;0.3" dur="1.4s" repeatCount="indefinite" /></circle>
                <circle cx="100" cy="98" r="5"><animate attributeName="opacity" values="0.3;1;0.3" dur="1.4s" begin="0.35s" repeatCount="indefinite" /></circle>
                <circle cx="122" cy="98" r="5"><animate attributeName="opacity" values="0.3;1;0.3" dur="1.4s" begin="0.7s"  repeatCount="indefinite" /></circle>
              </g>
            </g>
          </svg>
        </div>

        <!-- Stat row -->
        <div class="cl-stats">
          <div class="cl-stat">
            <div class="cl-stat-num">200k</div>
            <div class="cl-stat-label">Token context per turn</div>
          </div>
          <div class="cl-stat">
            <div class="cl-stat-num">12</div>
            <div class="cl-stat-label">Claude capabilities in use</div>
          </div>
          <div class="cl-stat">
            <div class="cl-stat-num">1</div>
            <div class="cl-stat-label">Pair programmer, always on</div>
          </div>
          <div class="cl-stat">
            <div class="cl-stat-num">0</div>
            <div class="cl-stat-label">Black-box edits, ever</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capabilities strip -->
    <section class="section cl-capabilities-section">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">The toolkit</span>
          <h2 class="headline-md">Twelve Claude capabilities. One workflow.</h2>
          <p class="text-lg">
            Opus, Sonnet, Haiku, tool use, long context, vision,
            artifacts, computer use, prompt caching, citations —
            every Claude feature plays a role in the daily Pagayo
            loop. Here is the full set.
          </p>
        </div>

        <ul class="cl-capabilities-grid">
          {capabilities.map((c) => (
            <li class="cl-capability">
              <div class="cl-capability-head">
                <span class="cl-capability-code">{c.code}</span>
                <span class="cl-capability-tag">{c.tag}</span>
              </div>
              <p>{c.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Layers -->
    <section class="section cl-layers">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">How it fits together</span>
          <h2 class="headline-lg">Six layers, one collaborator.</h2>
          <p class="text-lg">
            Pair programmer, long context, careful diffs, reasoning,
            review, safety. Here is what each layer of working with
            Claude looks like at Pagayo.
          </p>
        </div>

        {layers.map((l, idx) => (
          <article
            class={`cl-row ${idx % 2 === 1 ? 'reverse' : ''}`}
            id={l.slug}
            style={`--accent: ${l.accent}; --accent-soft: ${l.accentSoft};`}
          >
            <div class="cl-text">
              <div class="cl-meta">
                <span class="cl-tag">0{idx + 1}</span>
                <span class="cl-role">{l.role}</span>
              </div>
              <h3 class="cl-title">{l.title}</h3>
              <p class="cl-tagline">{l.tagline}</p>
              <p class="cl-body">{l.body}</p>
              <ul class="cl-bullets">
                {l.bullets.map((b) => (
                  <li><span class="cl-dot"></span>{b}</li>
                ))}
              </ul>
            </div>

            <div class="cl-visual">
              <div class="cl-frame">
                {l.slug === 'pair-programmer' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="ppGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#d97757" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#d97757" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#ppGlow)" />
                    <!-- Two chairs / two screens metaphor -->
                    <g transform="translate(40,40)">
                      <rect width="140" height="100" rx="10" fill="#0f172a" stroke="#d97757" stroke-width="1.5" />
                      <rect width="140" height="20" rx="10" fill="rgba(217,119,87,0.18)" />
                      <text x="70" y="14" text-anchor="middle" fill="#fdba74" font-size="9" font-weight="700" font-family="ui-monospace, monospace">PAGAYO</text>
                      <text x="14" y="44" fill="#cbd5e1" font-size="10" font-family="ui-monospace, monospace">"rework header for POS"</text>
                      <rect x="14" y="56" width="100" height="4" rx="2" fill="rgba(217,119,87,0.4)" />
                      <rect x="14" y="66" width="80" height="4" rx="2" fill="rgba(217,119,87,0.3)" />
                      <rect x="14" y="76" width="60" height="4" rx="2" fill="rgba(217,119,87,0.2)" />
                    </g>
                    <g transform="translate(220,40)">
                      <rect width="140" height="100" rx="10" fill="#0f172a" stroke="#d97757" stroke-width="1.5" />
                      <rect width="140" height="20" rx="10" fill="rgba(217,119,87,0.18)" />
                      <text x="70" y="14" text-anchor="middle" fill="#fdba74" font-size="9" font-weight="700" font-family="ui-monospace, monospace">CLAUDE</text>
                      <text x="14" y="44" fill="#cbd5e1" font-size="10" font-family="ui-monospace, monospace">"reading 3 files…"</text>
                      <rect x="14" y="56" width="120" height="4" rx="2" fill="rgba(16,163,127,0.5)" />
                      <rect x="14" y="66" width="110" height="4" rx="2" fill="rgba(16,163,127,0.4)" />
                      <rect x="14" y="76" width="90" height="4" rx="2" fill="rgba(16,163,127,0.3)" />
                    </g>
                    <!-- Dialog flow -->
                    <line x1="180" y1="90" x2="220" y2="90" stroke="#d97757" stroke-opacity="0.5" stroke-dasharray="3,3" />
                    <polygon points="220,90 213,86 213,94" fill="#d97757" />
                    <!-- Diff result -->
                    <rect x="40" y="180" width="320" height="110" rx="12" fill="#0f172a" stroke="#10a37f" stroke-width="1.5" />
                    <rect x="40" y="180" width="320" height="24" rx="12" fill="rgba(16,163,127,0.18)" />
                    <text x="54" y="198" fill="#6ee7b7" font-size="10" font-weight="700" font-family="ui-monospace, monospace">order-header.tsx · 42 + / 12 −</text>
                    {[
                      { y: 218, c: '#10a37f', s: '+', w: 220 },
                      { y: 234, c: '#10a37f', s: '+', w: 180 },
                      { y: 250, c: '#ef4444', s: '−', w: 140 },
                      { y: 266, c: '#10a37f', s: '+', w: 240 },
                    ].map((d) => (
                      <g>
                        <text x="54" y={d.y + 8} fill={d.c} font-size="11" font-weight="700" font-family="ui-monospace, monospace">{d.s}</text>
                        <rect x="68" y={d.y} width={d.w} height="9" rx="2" fill={d.c} opacity="0.3" />
                      </g>
                    ))}
                  </svg>
                )}

                {l.slug === 'long-context' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="lcGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#6366f1" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#lcGlow)" />
                    <!-- Stack of file cards being absorbed -->
                    {[
                      { x:  20, y:  30, label: 'order.service.ts',     repo: 'storefront' },
                      { x:  20, y:  64, label: 'order.schema.ts',      repo: 'schema' },
                      { x:  20, y:  98, label: 'order.route.ts',       repo: 'api-stack' },
                      { x:  20, y: 132, label: 'order.cache.ts',       repo: 'edge' },
                      { x:  20, y: 166, label: 'order.workflow.ts',    repo: 'workflows' },
                      { x:  20, y: 200, label: 'order.spec.ts',        repo: 'maintenance' },
                      { x:  20, y: 234, label: 'order.config.ts',      repo: 'config' },
                      { x:  20, y: 268, label: 'order.admin.tsx',      repo: 'storefront' },
                    ].map((f) => (
                      <g>
                        <rect x={f.x} y={f.y} width="170" height="28" rx="6" fill="#0f172a" stroke="#6366f1" stroke-width="1.2" />
                        <text x={f.x + 12} y={f.y + 12} fill="#a5b4fc" font-size="9" font-weight="700" font-family="ui-monospace, monospace">{f.label}</text>
                        <text x={f.x + 12} y={f.y + 22} fill="#94a3b8" font-size="8" font-family="ui-monospace, monospace">{f.repo}</text>
                        <line x1={f.x + 175} y1={f.y + 14} x2="290" y2="160" stroke="#6366f1" stroke-opacity="0.35" stroke-width="0.8" stroke-dasharray="3,3" />
                      </g>
                    ))}
                    <!-- Context vessel -->
                    <g transform="translate(260,100)">
                      <rect width="120" height="120" rx="16" fill="#0f172a" stroke="#6366f1" stroke-width="2" />
                      <text x="60" y="34" text-anchor="middle" fill="#a5b4fc" font-size="11" font-weight="700" font-family="ui-monospace, monospace">CONTEXT</text>
                      <text x="60" y="68" text-anchor="middle" fill="#c7d2fe" font-size="26" font-weight="700" font-family="ui-monospace, monospace">200k</text>
                      <text x="60" y="92" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="ui-monospace, monospace">tokens</text>
                      <!-- fill bar -->
                      <rect x="14" y="100" width="92" height="6" rx="3" fill="rgba(99,102,241,0.18)" />
                      <rect x="14" y="100" width="62" height="6" rx="3" fill="#6366f1" />
                    </g>
                  </svg>
                )}

                {l.slug === 'careful-diffs' && (
                  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="cdGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="#10a37f" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#10a37f" stop-opacity="0" />
                      </radialGradient>
                    </defs>
                    <rect width="400" height="320" fill="url(#cdGlow)" />
                    <!-- File frame -->
                    <rect x="20" y="20" width="360" height="280" rx="12" fill="#0f172a" stroke="#10a37f" stroke-width="1.5" />
                    <rect x="20" y="20" width="360" height="26" rx="12" fill="rgba(16,163,127,0.18)" />
                    <circle cx="36" cy="33" r="4" fill="#ef4444" opacity="0.7" />
                    <circle cx="48" cy="33" r="4" fill="#fbbf24" opacity="0.7" />
                    <circle cx="60" cy="33" r="4" fill="#10a37f" opacity="0.7" />
                    <text x="200" y="38" text-anchor="middle" fill="#6ee7b7" font-size="10" font-weight="700" font-family="ui-monospace, monospace">order.service.ts</text>
                    <!-- Diff lines -->
                    {[
                      { y:  58, n: '12', s: ' ', c: '#cbd5e1', w: 240 },
                      { y:  76, n: '13', s: ' ', c: '#cbd5e1', w: 200 },
