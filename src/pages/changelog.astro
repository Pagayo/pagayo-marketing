---
import MarketingLayout from '../layouts/Marketing.astro';
import PageBackdrop from '../components/layout/PageBackdrop.astro';
import PageHero from '../components/layout/PageHero.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import ChangelogRelease from '../components/changelog/ChangelogRelease.astro';
import changelogRaw from '../content/changelog.json';
import i18nEn from '../content/i18n/en.json';
import { parseChangelog } from '../lib/changelog-schema';

const t = i18nEn.changelogPage;
const changelog = parseChangelog(changelogRaw);

const typeLabels = {
  new: t.typeNew,
  improved: t.typeImproved,
  fixed: t.typeFixed,
  removed: t.typeRemoved,
} as const;

const latestDate = changelog.releases[0]?.date ?? changelog.meta.projectStartDate;

const changelogSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t.title,
  description: t.description,
  url: 'https://www.pagayo.com/changelog',
  inLanguage: t.inLanguage,
  dateModified: latestDate,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: changelog.meta.entryCount,
    itemListElement: changelog.releases.slice(0, 20).map((release, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: release.date,
    })),
  },
};
---

<MarketingLayout title={t.title} description={t.description}>
  <script type="application/ld+json" set:html={JSON.stringify(changelogSchema)} />
  <PageBackdrop variant="changelog" />

  <main class="changelog-page">
    <PageHero label={t.sectionLabel} headingId="changelog-page-title">
      <Fragment slot="title">{t.headline}</Fragment>
      <p class="text-lg" slot="intro">{t.intro}</p>

      <div class="changelog-stats">
        <div class="changelog-stat-card">
          <span class="changelog-stat-value">{changelog.meta.entryCount}</span>
          <span class="changelog-stat-label">{t.statUpdates}</span>
        </div>
        <div class="changelog-stat-card">
          <span class="changelog-stat-value">{changelog.releases.length}</span>
          <span class="changelog-stat-label">{t.statReleaseDays}</span>
        </div>
        <div class="changelog-stat-card">
          <span class="changelog-stat-value">{changelog.meta.projectStartDate.slice(0, 4)}</span>
          <span class="changelog-stat-label">{t.statSince}</span>
        </div>
      </div>
    </PageHero>

    <section class="section changelog-feed-section" aria-label={t.feedAriaLabel}>
      <div class="container">
        <div class="changelog-feed">
          {changelog.releases.map((release) => (
            <ChangelogRelease release={release} typeLabels={typeLabels} />
          ))}
        </div>
      </div>
    </section>

    <FinalCta />
  </main>
</MarketingLayout>
