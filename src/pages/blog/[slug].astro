---
import MarketingLayout from '../../layouts/Marketing.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import i18nEn from '../../content/i18n/en.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = i18nEn.blogPage;

const pageTitle = `${post.data.title} — Pagayo Blog`;
const canonicalUrl = `https://www.pagayo.com/blog/${post.slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  url: canonicalUrl,
  inLanguage: t.inLanguage,
  author: {
    '@type': 'Person',
    name: post.data.author.name,
    jobTitle: post.data.author.role,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Pagayo',
    url: 'https://www.pagayo.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  articleSection: post.data.category,
};
---

<MarketingLayout title={pageTitle} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <main class="blog-post-page">
    <article class="section blog-post-section fade-in">
      <div class="container">
        <div class="blog-post-layout">
          <a href="/blog" class="blog-back-link">← {t.backToBlog}</a>

          <header class="blog-post-header">
            <span class="blog-category-pill">{post.data.category}</span>
            <h1 class="blog-post-title">{post.data.title}</h1>
            <div class="blog-post-meta">
              <span class="blog-post-author">{post.data.author.name}</span>
              <span class="blog-post-role">{post.data.author.role}</span>
            </div>
          </header>

          <div class="blog-prose">
            <Content />
          </div>
        </div>
      </div>
    </article>

    <FinalCta />
  </main>
</MarketingLayout>

<style>
  .blog-post-section {
    padding-top: calc(var(--nav-height) + 3rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
</style>
