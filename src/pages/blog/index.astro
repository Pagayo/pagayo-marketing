---
import MarketingLayout from '../../layouts/Marketing.astro';
import PageBackdrop from '../../components/layout/PageBackdrop.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import i18nEn from '../../content/i18n/en.json';
import { getCollection } from 'astro:content';

const t = i18nEn.blogPage;

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPosts = allPosts.filter((post) => post.data.featured);
const featuredSlugs = new Set(featuredPosts.map((post) => post.slug));
const gridPosts = allPosts.filter((post) => !featuredSlugs.has(post.slug));
const showGrid = gridPosts.length > 0;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t.title,
  description: t.description,
  url: 'https://www.pagayo.com/blog',
  inLanguage: t.inLanguage,
  publisher: {
    '@type': 'Organization',
    name: 'Pagayo',
    url: 'https://www.pagayo.com',
  },
};
---

<MarketingLayout title={t.title} description={t.description}>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  <PageBackdrop variant="blog" />

  <main class="blog-page">
    <section class="section blog-hero fade-in" aria-labelledby="blog-page-title">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">{t.sectionLabel}</span>
          <h1 class="headline-xl" id="blog-page-title">{t.headline}</h1>
          <p class="text-lg">{t.intro}</p>
        </div>
      </div>
    </section>

    {featuredPosts.length > 0 && (
      <section class="section blog-featured-section fade-in" aria-labelledby="blog-featured-heading">
        <div class="container">
          <h2 class="headline-md" id="blog-featured-heading">{t.featuredLabel}</h2>
          <div class="blog-featured-grid">
            {featuredPosts.map((post) => (
              <BlogCard
                slug={post.slug}
                title={post.data.title}
                description={post.data.description}
                category={post.data.category}
                authorName={post.data.author.name}
                authorRole={post.data.author.role}
                variant="featured"
                readLabel={t.readArticle}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    {showGrid && (
      <section class="section blog-grid-section fade-in" aria-labelledby="blog-all-heading">
        <div class="container">
          <h2 class="headline-md" id="blog-all-heading">{t.allPostsLabel}</h2>
          <div class="blog-grid">
            {gridPosts.map((post) => (
              <BlogCard
                slug={post.slug}
                title={post.data.title}
                description={post.data.description}
                category={post.data.category}
                authorName={post.data.author.name}
                authorRole={post.data.author.role}
                readLabel={t.readArticle}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <FinalCta />
  </main>
</MarketingLayout>

<style>
  .blog-featured-section,
  .blog-grid-section {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .blog-featured-section .headline-md,
  .blog-grid-section .headline-md {
    margin-bottom: 1.5rem;
  }
</style>
