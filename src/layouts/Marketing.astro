---
import '../styles/site.css';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import StickyFooter from '../components/layout/StickyFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pagayo — Every Sale. One Platform.',
  description = 'Webshop, POS, WhatsApp, QR — all orders flow into one dashboard. Free forever.'
} = Astro.props as Props;

const isHomepage = Astro.url.pathname === '/';
const bodyClass = isHomepage ? '' : 'standard-sections-ssot';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body class={bodyClass}>
    <Nav />
    <slot />
    <Footer />
    <StickyFooter />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
