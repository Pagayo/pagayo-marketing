---
import '../styles/global.css';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import StickyFooter from '../components/layout/StickyFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pagayo — Every Sale. One Platform.',
  description = 'Webshop, POS, WhatsApp, QR — all orders flow into one dashboard. Free forever.'
} = Astro.props as Props;

const isHomepage = Astro.url.pathname === '/';
const bodyClass = isHomepage ? '' : 'standard-sections-ssot';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body class={bodyClass}>
    <Nav />
    <slot />
    <Footer />
    <StickyFooter />
    <script is:inline>
      const nav = document.getElementById('nav');
      const navToggle = nav?.querySelector('.nav-toggle');
      const navLinks = nav?.querySelector('.nav-links');

      const closeNavMenu = () => {
        if (!nav || !navToggle) return;
        nav.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
      };

      if (navToggle && nav && navLinks) {
        navToggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('open');
          navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });

        navLinks.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeNavMenu);
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 768) {
            closeNavMenu();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeNavMenu();
          }
        });
      }

      const updateNavScrolled = () => {
        if (nav) nav.classList.toggle('scrolled', window.scrollY > 50);
      };
      updateNavScrolled();
      window.addEventListener('scroll', updateNavScrolled, { passive: true });

      const faders = document.querySelectorAll('.fade-in');
      const appearOptions = { threshold: 0.1, rootMargin: '0px 0px -60px 0px' };

      const appearOnScroll = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, appearOptions);

      faders.forEach((fader) => appearOnScroll.observe(fader));

      const pricingSwitch = document.querySelector('.pricing-switch');
      if (pricingSwitch) {
        pricingSwitch.addEventListener('click', () => {
          pricingSwitch.classList.toggle('annual');
        });
      }

      // Country detection — cookie from Pages middleware, timezone fallback
      (function () {
        const el = document.getElementById('nav-country');
        if (!el) return;
        const match = document.cookie.match(/(?:^|;\s*)pagayo_country=([A-Z]{2})/);
        let code = match ? match[1] : null;
        if (!code) {
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          const tzMap = {
            'Europe/Amsterdam':'NL','Europe/Berlin':'DE','Europe/Vienna':'AT',
            'Europe/Zurich':'CH','Europe/Brussels':'BE','Europe/Paris':'FR',
            'Europe/Luxembourg':'LU','Europe/Madrid':'ES','Europe/Rome':'IT',
            'Europe/Lisbon':'PT','Europe/Athens':'GR','Europe/Zagreb':'HR',
            'Europe/Ljubljana':'SI','Europe/London':'GB','Europe/Dublin':'IE',
            'Europe/Stockholm':'SE','Europe/Oslo':'NO','Europe/Copenhagen':'DK',
            'Europe/Helsinki':'FI','Europe/Warsaw':'PL','Europe/Prague':'CZ',
            'Europe/Bratislava':'SK','Europe/Budapest':'HU','Europe/Bucharest':'RO',
            'Europe/Sofia':'BG','Europe/Istanbul':'TR','Europe/Kiev':'UA',
            'Europe/Moscow':'RU','America/New_York':'US','America/Chicago':'US',
            'America/Denver':'US','America/Los_Angeles':'US','America/Phoenix':'US',
            'America/Anchorage':'US','Pacific/Honolulu':'US','America/Toronto':'CA',
            'America/Vancouver':'CA','America/Mexico_City':'MX',
            'America/Sao_Paulo':'BR','America/Argentina/Buenos_Aires':'AR',
            'America/Bogota':'CO','America/Santiago':'CL','America/Lima':'PE',
            'America/Caracas':'VE','America/Montevideo':'UY','America/Asuncion':'PY',
            'America/Paramaribo':'SR','America/Curacao':'CW','America/Aruba':'AW',
            'Asia/Tokyo':'JP','Asia/Shanghai':'CN','Asia/Seoul':'KR',
            'Asia/Kolkata':'IN','Asia/Jakarta':'ID','Asia/Bangkok':'TH',
            'Asia/Ho_Chi_Minh':'VN','Asia/Manila':'PH','Asia/Kuala_Lumpur':'MY',
            'Asia/Singapore':'SG','Asia/Riyadh':'SA','Asia/Dubai':'AE',
            'Asia/Jerusalem':'IL','Australia/Sydney':'AU','Pacific/Auckland':'NZ',
            'Africa/Johannesburg':'ZA','Africa/Lagos':'NG','Africa/Nairobi':'KE',
            'Africa/Cairo':'EG','Africa/Casablanca':'MA'
          };
          code = tzMap[tz] || null;
        }
        if (!code) return;
        const names = {
          NL:"Nederland",BE:"België",DE:"Deutschland",AT:"Österreich",CH:"Schweiz",
          FR:"France",LU:"Luxembourg",ES:"España",IT:"Italia",PT:"Portugal",
          GR:"Ελλάδα",HR:"Hrvatska",SI:"Slovenija",GB:"United Kingdom",IE:"Ireland",
          SE:"Sverige",NO:"Norge",DK:"Danmark",FI:"Suomi",PL:"Polska",CZ:"Česko",
          SK:"Slovensko",HU:"Magyarország",RO:"România",BG:"България",TR:"Türkiye",
          US:"United States",CA:"Canada",MX:"México",BR:"Brasil",AR:"Argentina",
          CO:"Colombia",CL:"Chile",PE:"Perú",VE:"Venezuela",EC:"Ecuador",
          UY:"Uruguay",PY:"Paraguay",BO:"Bolivia",CR:"Costa Rica",PA:"Panamá",
          DO:"República Dominicana",GT:"Guatemala",HN:"Honduras",SV:"El Salvador",
          NI:"Nicaragua",CU:"Cuba",PR:"Puerto Rico",JM:"Jamaica",
          TT:"Trinidad and Tobago",SR:"Suriname",GY:"Guyana",BZ:"Belize",
          HT:"Haïti",BB:"Barbados",AW:"Aruba",CW:"Curaçao",BQ:"Bonaire",
          SX:"Sint Maarten",JP:"日本",CN:"中国",KR:"한국",IN:"India",
          ID:"Indonesia",TH:"ประเทศไทย",VN:"Việt Nam",PH:"Pilipinas",
          MY:"Malaysia",SG:"Singapore",KH:"Cambodia",LA:"Laos",MM:"Myanmar",
          BD:"Bangladesh",LK:"Sri Lanka",NP:"Nepal",PK:"Pakistan",
          SA:"السعودية",AE:"الإمارات",IL:"ישראל",QA:"قطر",KW:"الكويت",
          BH:"البحرين",OM:"عُمان",JO:"الأردن",LB:"لبنان",IQ:"العراق",
          AU:"Australia",NZ:"New Zealand",ZA:"South Africa",NG:"Nigeria",
          KE:"Kenya",GH:"Ghana",EG:"مصر",MA:"المغرب",TN:"تونس",GM:"Gambia",
          SN:"Sénégal",CI:"Côte d'Ivoire",CM:"Cameroun",TZ:"Tanzania",
          UG:"Uganda",ET:"Ethiopia",RW:"Rwanda",MZ:"Moçambique",AO:"Angola",
          CD:"Congo-Kinshasa",CG:"Congo-Brazzaville",ML:"Mali",BF:"Burkina Faso",
          NE:"Niger",TD:"Tchad",MG:"Madagascar",MW:"Malawi",ZM:"Zambia",
          ZW:"Zimbabwe",BW:"Botswana",NA:"Namibia",SL:"Sierra Leone",LR:"Liberia",
          GN:"Guinée",BJ:"Bénin",TG:"Togo",MR:"Mauritanie",SO:"Soomaaliya",
          SD:"Sudan",SS:"South Sudan",ER:"Eritrea",DJ:"Djibouti",LY:"Libya",
          DZ:"الجزائر",MU:"Mauritius",SC:"Seychelles",CV:"Cabo Verde",
          RU:"Россия",UA:"Україна"
        };
        const name = names[code];
        if (name) el.textContent = name;
      })();
    </script>
  </body>
</html>
