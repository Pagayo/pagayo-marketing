{
  "name": "pagayo-marketing",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 4321",
    "dev:wrangler": "npm run build && wrangler pages dev dist --port 4321",
    "build": "astro build",
    "preview": "wrangler pages dev dist --port 4321",
    "deploy": "npm run build && wrangler pages deploy dist",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,astro,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,astro,md,json}\"",
    "type-check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/markdoc": "^0.15.10",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.6.0",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.48",
    "@pagayo/config": "^1.4.0",
    "astro": "^5.17.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "prettier-plugin-astro": "^0.14.1",
    "wrangler": "^4.65.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
